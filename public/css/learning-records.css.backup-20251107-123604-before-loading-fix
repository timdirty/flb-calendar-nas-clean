                font-size: 9px;
            }
        }

        /* ============================================
           🔥 評語儲存視覺反饋（邊框閃爍綠色）
           ============================================ */
        @keyframes commentSavedFlash {
            0% {
                border-color: var(--primary);
                box-shadow: 0 2px 8px rgba(58, 141, 255, 0.15);
            }
            15% {
                border-color: #34a853;
                box-shadow: 0 0 0 3px rgba(52, 168, 83, 0.3),
                            0 2px 12px rgba(52, 168, 83, 0.4);
            }
            30% {
                border-color: #34a853;
                box-shadow: 0 0 0 6px rgba(52, 168, 83, 0.2),
