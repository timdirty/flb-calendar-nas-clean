* {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-start: #f0f7ff;
            --bg-end: #d8ecff;
            --card-bg: rgba(255, 255, 255, 0.92);
            --card-border: rgba(93, 169, 255, 0.25);
            --card-shadow: 0 8px 28px rgba(82, 160, 255, 0.18);
            --primary: #3a8dff;
            --primary-dark: #1f6ee6;
            --primary-light: #6ab4ff;
            --accent: #ffd66b;
            --danger: #ff6666;
            --text-main: #1a2a4a;
            --text-secondary: rgba(26, 42, 74, 0.6);
            --surface: rgba(255, 255, 255, 0.98);
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
            min-height: 100vh;
            padding: 20px 20px 20px;
            color: var(--text-main);
            position: relative;
        }

        body::before {
            content: '';
            position: fixed;
            top: -20%;
            left: -10%;
            width: 140%;
            height: 140%;
            background: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.45), transparent 65%),
                        radial-gradient(circle at 80% 0%, rgba(58, 141, 255, 0.25), transparent 70%),
                        radial-gradient(circle at 50% 100%, rgba(116, 192, 255, 0.35), transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            border-radius: 18px;
            border: 1px solid var(--card-border);
            box-shadow: var(--card-shadow);
            padding: 24px;
            margin-bottom: 24px;
            position: relative;
            z-index: 1;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .glass-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(58, 141, 255, 0.18);
        }

        /* 🧹 防呆：若有空的區塊節點，不顯示（避免出現空白膠囊） */
        .container > .glass-card:empty { display: none !important; }
        .mode-switch-inner:empty { display: none !important; }

        /* ==================== 低階手機優化（降噪） ==================== */
        /* 說明：當 <body> 有 .low-end 時，關閉濾鏡/縮短動畫/減少陰影，降低重排與重繪成本 */
        body.low-end .glass-card {
            backdrop-filter: none;              /* ⚠️ 移除昂貴的背景模糊 */
            -webkit-backdrop-filter: none;
            box-shadow: 0 2px 10px rgba(0,0,0,.08); /* 降低陰影半徑與層級 */
            transition: transform 0.12s ease, box-shadow 0.12s ease;
        }
        body.low-end .glass-card:hover { transform: none; box-shadow: 0 2px 10px rgba(0,0,0,.08); }
        body.low-end .capbar .fill::after { animation: none; }   /* 關閉持續流光動畫 */
        body.low-end .capbar .fill { filter: none; }             /* 移除光暈濾鏡 */
        body.low-end * { text-shadow: none !important; }
        body.low-end img, body.low-end video { image-rendering: auto; }
        body.low-end video { will-change: auto; }
        /* 手機上縮小影片預覽高度，避免大量重排 */
        @media (max-width: 480px) {
          body.low-end #videoTemplatesPanel #videoTemplateList .template-item video { height: 96px; }
        }

        /* 若使用者系統偏好減少動畫，亦一併關閉主要動畫效果 */
        @media (prefers-reduced-motion: reduce) {
          .capbar .fill::after { animation: none !important; }
          .glass-card { transition: none !important; }
        }

        /* ==================== 可訪問性（A11y） ==================== */
        /* 螢幕閱讀器專用文字（視覺隱藏但可被讀取） */
        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border-width: 0;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .header {
            text-align: center;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.85), rgba(237, 246, 255, 0.92));
            color: var(--text-main);
            margin-bottom: 32px;
            padding: 32px 24px;
            border-radius: 24px;
            border: 1px solid rgba(90, 160, 255, 0.25);
            box-shadow: 0 20px 40px rgba(58, 141, 255, 0.12);
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 20% 20%, rgba(255, 214, 107, 0.3), transparent 55%),
                        radial-gradient(circle at 80% 20%, rgba(116, 192, 255, 0.25), transparent 55%);
            opacity: 0.7;
            pointer-events: none;
        }

        .header h1 {
            font-size: clamp(26px, 3vw, 36px);
            margin-bottom: 8px;
            font-weight: 700;
            letter-spacing: 1px;
            position: relative;
            z-index: 1;
        }

        .header .date {
            font-size: 18px;
            color: var(--text-secondary);
            position: relative;
            z-index: 1;
        }

        .header-content {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            width: 100%;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 15px;
            justify-content: center;
            flex: 1;
            text-align: left;
        }

        .header-logo {
            height: 50px;
            width: auto;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            flex-shrink: 0;
            align-self: flex-start;
            margin-top: -5px;
        }

        /* 導航按鈕 */
        .nav-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
        }

        .nav-btn {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(242, 250, 255, 0.95));
            border: 1px solid rgba(58, 141, 255, 0.2);
            padding: 12px 18px;
            border-radius: 14px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 600;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 10px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 6px 16px rgba(93, 169, 255, 0.12);
        }

        .nav-btn i {
            font-size: 16px;
            color: var(--primary);
        }

        .nav-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(58, 141, 255, 0.18);
        }

        .nav-btn:active {
            transform: translateY(0);
            box-shadow: 0 4px 12px rgba(58, 141, 255, 0.18);
        }

        /* 課程選擇器 */
        .course-selector {
            margin-bottom: 30px;
        }

        .course-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            background: rgba(255, 255, 255, 0.85);
            border: 1px solid rgba(58, 141, 255, 0.15);
            border-radius: 14px;
            padding: 14px 18px;
            margin-top: 18px;
        }

        .toolbar-left {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        .filter-group label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
        }

        .filter-select {
            border: 1px solid rgba(58, 141, 255, 0.25);
            border-radius: 10px;
            padding: 8px 12px;
            font-size: 14px;
            background: rgba(255, 255, 255, 0.92);
            color: var(--text-main);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .filter-select:focus {
            outline: none;
            border-color: rgba(58, 141, 255, 0.55);
            box-shadow: 0 0 0 3px rgba(58, 141, 255, 0.15);
        }

        .toolbar-right {
            display: flex;
            align-items: center;
        }

        .summary-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            background: rgba(58, 141, 255, 0.12);
            color: var(--primary);
            font-weight: 600;
            font-size: 14px;
        }

        .summary-chip i {
            font-size: 14px;
        }

        .course-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 15px;
            margin-top: 15px;
        }

        .filter-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 12px;
            font-size: 13px;
            color: var(--text-secondary);
        }

        .filter-meta span {
            background: rgba(255, 255, 255, 0.65);
            border: 1px solid rgba(58, 141, 255, 0.18);
            padding: 6px 10px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            line-height: 1;
        }

        .course-item {
            background: linear-gradient(160deg, rgba(255, 255, 255, 0.96), rgba(237, 246, 255, 0.92));
            border-radius: 16px;
            padding: 22px;
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
            border: 1px solid rgba(58, 141, 255, 0.18);
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 24px rgba(93, 169, 255, 0.12);
        }

        .course-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 24px;
            right: 24px;
            height: 3px;
            border-radius: 999px;
            background: linear-gradient(90deg, var(--primary), var(--primary-light));
            opacity: 0.75;
        }

        .course-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 28px rgba(58, 141, 255, 0.18);
            border-color: rgba(58, 141, 255, 0.35);
        }

        .course-item.highlighted {
            border-color: #ffd43b;
            border-width: 3px;
            box-shadow: 0 20px 40px rgba(255, 193, 7, 0.5), 
                        0 0 0 4px rgba(255, 214, 107, 0.3);
            transform: scale(1.05) translateY(-6px);
            background: linear-gradient(160deg, rgba(255, 251, 235, 0.98), rgba(255, 243, 205, 0.95));
            animation: highlightPulse 2s ease-in-out infinite;
        }

        .course-item.highlighted::before {
            background: linear-gradient(90deg, #ffd43b, #ffa726);
            opacity: 1;
            height: 5px;
        }

        .course-item.highlighted::after {
            content: '⭐ 從日曆跳轉的課程';
            position: absolute;
            top: 12px;
            right: 12px;
            background: linear-gradient(135deg, #ffd43b, #ffa726);
            color: #5d4e00;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.4);
        }

        @keyframes highlightPulse {
            0%, 100% {
                box-shadow: 0 20px 40px rgba(255, 193, 7, 0.5), 
                            0 0 0 4px rgba(255, 214, 107, 0.3);
            }
            50% {
                box-shadow: 0 24px 48px rgba(255, 193, 7, 0.6), 
                            0 0 0 6px rgba(255, 214, 107, 0.5);
            }
        }

        .course-item.selected {
            border-color: rgba(58, 141, 255, 0.75);
            box-shadow: 0 18px 32px rgba(58, 141, 255, 0.2);
        }

        .course-item h3 {
            color: var(--text-main);
            font-size: 18px;
            margin-bottom: 6px;
            font-weight: 700;
        }

        .course-item .date,
        .course-item .time {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            margin-bottom: 12px;
        }

        .course-item .date {
            color: var(--text-secondary);
            font-weight: 600;
        }

        .course-item .time {
            color: var(--primary);
            font-weight: 600;
        }

        .course-item .status-tag {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 12px;
            background: rgba(58, 141, 255, 0.12);
            color: var(--primary);
        }

        .course-item .status-tag.completed {
            background: rgba(56, 193, 114, 0.15);
            color: #2f9e44;
        }

        .course-item .status-tag.upcoming {
            background: rgba(255, 214, 107, 0.2);
            color: #b36b00;
        }

        .course-item .status-tag.ongoing {
            background: rgba(58, 141, 255, 0.2);
            color: var(--primary-dark);
        }

        .course-item .progress {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            color: var(--text-secondary);
        }

        .course-item .progress span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .progress .uploaded {
            color: #2ecc71;
            font-weight: 600;
        }

        .progress .pending {
            color: var(--accent);
            font-weight: 600;
        }

        .course-empty-state {
            grid-column: 1 / -1;
            background: rgba(255, 255, 255, 0.92);
            border-radius: 16px;
            padding: 40px 20px;
            border: 1px dashed rgba(58, 141, 255, 0.25);
            text-align: center;
            color: var(--text-secondary);
        }

        .course-empty-state i {
            font-size: 42px;
            color: var(--primary);
            margin-bottom: 12px;
        }

        /* 學生卡片區 */
        .students-section {
            display: none;
        }

        .students-section.active {
            display: block;
        }

        #topTabsSentinel {
            width: 100%;
            height: 1px;
        }

        /* 頂部學生籤列（Mobile） */
        .lr-top-tabs {
            background: rgba(255,255,255,0.85);
            border: 1px solid rgba(58,141,255,0.18);
            border-radius: 10px;
            box-shadow: 0 6px 16px rgba(58,141,255,0.12);
            padding: 6px 8px;
            /* 顯示由 JS 控制為 flex；此處設定單排不換行 */
            display: flex;
            flex-wrap: nowrap;         /* ⛓️ 維持一排，不換行 */
            justify-content: center;   /* 寬度足夠時置中 */
            overflow-x: auto;          /* 超出時可水平滑動 */
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
            position: relative;
            top: auto;
            bottom: auto;
            transition: box-shadow 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
            z-index: 5;
        }
        .lr-top-tabs::-webkit-scrollbar { display: none; }
        .lr-top-tabs.is-sticky {
            position: sticky;
            top: calc(env(safe-area-inset-top, 0px) + 10px);
            background: rgba(255,255,255,0.95);
            box-shadow: 0 14px 30px rgba(15,118,110,0.18);
            opacity: 0.92;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .lr-top-tabs .tab-item {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 16px;
            border-radius: 999px;
            border: 1.5px solid rgba(255,255,255,0.45);
            background: linear-gradient(135deg, rgba(255,255,255,0.82), rgba(226,232,240,0.45));
            color: #0f172a;
            font-size: 13px;
            font-weight: 700;
            margin-right: 10px;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
            cursor: pointer;
            white-space: nowrap;
            flex: 0 0 auto;
            box-shadow: 0 12px 26px rgba(15,23,42,0.12);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        .lr-top-tabs .tab-item:last-child { margin-right: 0; }
        .lr-top-tabs .tab-item .tab-shell { display:flex; align-items:center; gap:6px; }
        .lr-top-tabs .tab-item .att-icon { font-size:14px; line-height:1; }
        .lr-top-tabs .tab-item .name { font-weight:700; letter-spacing:0.2px; }
.lr-top-tabs .tab-item .optional-pill {
            position: absolute;
            top: -9px;
            right: 12px;
            padding: 2px 6px;
            font-size: 10px;
            line-height: 1.1;
            border-radius: 999px;
            color: #854d0e;
            background: rgba(251,191,36,0.22);
            border: 1px solid rgba(251,191,36,0.45);
            box-shadow: 0 4px 12px rgba(251,191,36,0.2);
            letter-spacing: 0.2px;
            pointer-events: none;
        }
.lr-top-tabs .tab-item.needs-video { padding-right: 34px; }
.lr-top-tabs .tab-item.needs-video .tab-shell { gap:6px; }
        .lr-top-tabs .tab-item.active {
            transform: translateY(-2px) scale(1.04);
            border-color: rgba(59,130,246,0.78);
            box-shadow: 0 20px 42px rgba(59,130,246,0.28);
            background: linear-gradient(135deg, rgba(226, 243, 255, 0.96), rgba(191, 219, 254, 0.9));
            color: #0f172a;
        }
        .lr-top-tabs .tab-item.active .name { color: #0f172a; }
        .lr-top-tabs .tab-item.att-present {
            border-color: rgba(34,197,94,0.45);
            color: #047857;
            box-shadow: 0 16px 34px rgba(16,185,129,0.16);
        }
        .lr-top-tabs .tab-item.att-present.active {
            box-shadow: 0 20px 42px rgba(16,185,129,0.26);
        }
        .lr-top-tabs .tab-item.att-leave {
            border-color: rgba(59,130,246,0.45);
            color: #1d4ed8;
        }
        .lr-top-tabs .tab-item.att-absent {
            border-color: rgba(248,113,113,0.55);
            color: #b91c1c;
        }
        .lr-top-tabs .tab-item.att-unknown {
            border-color: rgba(148,163,184,0.45);
            color: #0f172a;
        }
        .lr-top-tabs .tab-item.done:not(.att-absent):not(.att-leave) {
            box-shadow: inset 0 0 0 1.5px rgba(34,197,94,0.3);
        }
        .lr-top-tabs .tab-item.todo { opacity: 0.95; }

        /* 膠囊中的「建議」字樣弱化顯示 */
        .lr-capsule .capsule-stats .suggest {
            color: #94a3b8; /* slate-400 */
            font-size: 12px;
            font-weight: 500;
            margin-left: 2px;
        }

        .optional-tag {
            font-size: 0.72em;
            color: #94a3b8;
            font-weight: 600;
            margin-left: 2px;
        }

        .students-grid {
            display: block;
            margin-top: 12px;
            overflow: hidden;
            position: relative;
            width: 100%;
            max-width: 100%;
        }

        .student-slide-viewport {
            width: 100%;
            max-width: 100%;
            overflow: hidden;
            position: relative;
            touch-action: pan-y; /* ✅ 立即可滑，避免與垂直滾動衝突 */
        }

        .student-slide-track {
            display: flex;
            min-width: 100%;
            transform: translateX(-100%);
            /* 🚫 取消初始進場過場動畫，保留滑動功能 */
            transition: none;
            will-change: transform;
            gap: 0;
        }
        .student-slide-track.no-transition { transition: none; }
        .student-slide {
            flex: 0 0 100%;
            padding: 0;
            box-sizing: border-box;
            display: flex;
            justify-content: center;
        }
        .student-slide.placeholder {
            pointer-events: none;
            opacity: 0;
        }
        .student-slide .student-card {
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
            margin: 0;
        }

        .student-slide[data-role="current"] .student-card {
            box-shadow: 0 24px 48px rgba(59,130,246,0.28);
            border-color: rgba(59,130,246,0.6);
            transform: translateY(-6px);
        }

        .student-card {
            background: linear-gradient(155deg, rgba(255, 255, 255, 0.96), rgba(237, 246, 255, 0.94));
            border-radius: 18px;
            padding: 20px;
            box-shadow: 0 14px 30px rgba(93, 169, 255, 0.15);
            border: 1px solid rgba(58, 141, 255, 0.18);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .student-card:hover {
            box-shadow: 0 20px 36px rgba(58, 141, 255, 0.22);
            transform: translateY(-4px);
        }

        .student-slide[data-role="current"] .student-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 26px 52px rgba(59,130,246,0.32);
        }

        .student-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(58, 141, 255, 0.12);
        }

        .student-name {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: 0.5px;
        }

        .student-remaining {
            background: linear-gradient(135deg, rgba(255, 214, 107, 0.9), rgba(255, 191, 71, 0.9));
            color: rgba(70, 50, 20, 0.85);
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 13px;
            font-weight: 700;
            box-shadow: 0 4px 12px rgba(255, 214, 107, 0.45);
        }

        .progress-indicators {
            display: flex;
            gap: 12px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .indicator {
            flex: 1;
            min-width: 110px;
            background: rgba(244, 248, 255, 0.9);
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            font-size: 13px;
            border: 1px solid transparent;
            transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .indicator.complete {
            background: linear-gradient(140deg, rgba(90, 200, 140, 0.18), rgba(90, 200, 140, 0.08));
            color: #2f9e44;
            border-color: rgba(47, 158, 68, 0.35);
