            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        /* 手機端優化 */
        @media (max-width: 768px) {
            .overview-stats {
                flex-wrap: wrap;
                gap: 8px;
                font-size: 13px;
            }

            .media-stat {
                padding: 5px 10px;
                font-size: 12px;
