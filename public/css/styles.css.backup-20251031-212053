            /* 移除 infinite 動畫，改用有限次數 */
            animation: highlightPulse 1.5s ease-in-out 3 !important;
            z-index: 50 !important;
            position: relative !important;
            /* 🔥 移除 margin，使用 grid gap 處理間距 */
            margin: 0 !important;
