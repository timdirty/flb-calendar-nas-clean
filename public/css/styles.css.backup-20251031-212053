                background: transparent;
            }
            25% { 
                transform: scale(1.1);
                background: rgba(255, 215, 0, 0.2);
            }
            50% { 
                transform: scale(0.95);
                background: rgba(255, 215, 0, 0.3);
            }
            75% { 
                transform: scale(1.05);
                background: rgba(255, 215, 0, 0.1);
            }
            100% { 
                transform: scale(1);
                background: transparent;
            }
        }
        
