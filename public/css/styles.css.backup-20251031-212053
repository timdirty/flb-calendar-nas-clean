        .loading-logo {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            margin-bottom: 25px;
            background: rgba(0, 0, 0, 0.4);
            /* 🔥 GPU 優化：移除 backdrop-filter */
            /* backdrop-filter: blur(8px); */
