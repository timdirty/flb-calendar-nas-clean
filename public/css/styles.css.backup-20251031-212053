        /* 🔥 快速響應的自訂 Tooltip 系統 - 液態玻璃風格（輕量優化版，提高可讀性） */
        .custom-tooltip {
            position: fixed;
            background: linear-gradient(135deg, 
                rgba(255, 255, 255, 0.85) 0%, 
                rgba(255, 255, 255, 0.78) 50%, 
                rgba(255, 255, 255, 0.85) 100%);
