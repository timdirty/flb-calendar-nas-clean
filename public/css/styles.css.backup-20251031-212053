        /* 🔥 效能優化：大幅減少動畫延遲，從 0.05-0.5s 降至 0.01-0.05s */
        .student-card:nth-child(1) { animation-delay: 0.01s; }
        .student-card:nth-child(2) { animation-delay: 0.02s; }
        .student-card:nth-child(3) { animation-delay: 0.03s; }
