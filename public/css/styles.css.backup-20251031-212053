        /* ============================================
           🎨 解除綁定按鈕 - 液態玻璃風格
           ============================================ */
        
        .unbind-button-container {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 999;
            animation: fadeInUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        
        .unbind-glass-button {
            padding: 14px 28px;
            background: linear-gradient(145deg,
                rgba(245, 87, 108, 0.95) 0%,
                rgba(240, 147, 251, 0.90) 100%);
            backdrop-filter: blur(12px) saturate(180%);
            -webkit-backdrop-filter: blur(12px) saturate(180%);
            color: white;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 28px;
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            box-shadow: 
                0 0 0 1px rgba(255, 255, 255, 0.4) inset,
                0 16px 40px rgba(245, 87, 108, 0.45),
                0 8px 20px rgba(240, 147, 251, 0.3),
                0 4px 12px rgba(0, 0, 0, 0.15);
            position: relative;
            overflow: hidden;
            letter-spacing: 0.3px;
        }
        
        /* 玻璃質感光澤效果 */
        .unbind-glass-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg,
                transparent 0%,
                rgba(255, 255, 255, 0.3) 50%,
                transparent 100%);
            transition: left 0.6s ease;
        }
        
        .unbind-glass-button:hover::before {
            left: 100%;
        }
        
        .unbind-glass-button:hover {
            transform: translateY(-3px) scale(1.03);
            box-shadow: 
                0 0 0 1px rgba(255, 255, 255, 0.5) inset,
                0 20px 50px rgba(245, 87, 108, 0.55),
                0 12px 28px rgba(240, 147, 251, 0.4),
                0 6px 16px rgba(0, 0, 0, 0.2);
            border-color: rgba(255, 255, 255, 0.5);
        }
        
        .unbind-glass-button:active {
            transform: translateY(-1px) scale(0.98);
            box-shadow: 
                0 0 0 1px rgba(255, 255, 255, 0.3) inset,
                0 12px 32px rgba(245, 87, 108, 0.45),
                0 6px 16px rgba(240, 147, 251, 0.3),
                0 3px 8px rgba(0, 0, 0, 0.15);
        }
        
        .unbind-glass-button i {
            font-size: 1.1rem;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
        }
        
        .unbind-glass-button span {
            position: relative;
            z-index: 1;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        }
        
        /* 手機版優化 */
        @media (max-width: 768px) {
            .unbind-button-container {
                bottom: 20px;
            }
            
            .unbind-glass-button {
                padding: 12px 24px;
                font-size: 0.9rem;
                border-radius: 24px;
                box-shadow: 
                    0 0 0 1px rgba(255, 255, 255, 0.3) inset,
                    0 12px 32px rgba(245, 87, 108, 0.4),
                    0 6px 16px rgba(240, 147, 251, 0.25),
                    0 3px 8px rgba(0, 0, 0, 0.12);
            }
            
            .unbind-glass-button:hover {
                transform: translateY(-2px) scale(1.02);
            }
        }
        
        /* 動畫 */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
