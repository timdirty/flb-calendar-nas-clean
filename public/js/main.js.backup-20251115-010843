        // 從本地CSV文件獲取講師Web API（備用方案）
        async function getTeacherWebApiFromCSV(teacherName) {
            try {
                console.log('🔍 從CSV文件查找講師Web API:', teacherName);
                
                // 讀取CSV文件
                const response = await fetch('teacher_list_data.csv');
                if (!response.ok) {
                    throw new Error('無法讀取講師API配置文件');
                }
                
                const csvText = await response.text();
                const lines = csvText.split('\n');
                
                // 跳過標題行，從第二行開始處理
                for (let i = 1; i < lines.length; i++) {
                    const line = lines[i].trim();
                    if (!line) continue;
                    
                    const columns = line.split(',');
                    if (columns.length >= 3) {
                        const csvTeacherName = columns[0].trim();
                        const webApi = columns[2].trim();
                        
                        // 模糊匹配講師名稱（忽略空格、大小寫、特殊符號）
                        const cleanCsvName = csvTeacherName.toLowerCase().replace(/[\s🙏🏻*]+/g, '').trim();
                        const cleanTeacherName = teacherName.toLowerCase().replace(/[\s🙏🏻*]+/g, '').trim();
                        
                        // 檢查是否匹配
                        let isMatch = false;
                        if (cleanCsvName === cleanTeacherName) {
                            console.log('✅ 完全匹配:', csvTeacherName, '->', teacherName);
                            isMatch = true;
                        } else if (cleanCsvName.includes(cleanTeacherName) || cleanTeacherName.includes(cleanCsvName)) {
                            console.log('✅ 部分匹配:', csvTeacherName, '->', teacherName);
                            isMatch = true;
                        }
                        
                        if (isMatch) {
                            if (webApi && webApi !== '') {
                                console.log('✅ 從CSV找到講師Web API:', webApi);
                                return webApi;
                            } else {
                                console.log('⚠️ 講師沒有配置Web API:', csvTeacherName);
                                return null;
                            }
                        }
                    }
                }
                
                console.log('❌ 在CSV中找不到講師:', teacherName);
                return null;
                
            } catch (error) {
                console.error('❌ 從CSV獲取講師Web API失敗:', error);
                return null;
            }
        }

