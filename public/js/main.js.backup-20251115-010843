        // ==================== 課程顏色載入函數 ====================
        async function loadCourseColors() {
            const status = getCourseColorStatus();
            const now = Date.now();

            // 如果最近確認 API 不可用，且尚未到重試時間，直接使用快取/預設值
            if (status && status.status === 'unavailable' && now - status.checkedAt < COURSE_COLOR_RETRY_INTERVAL) {
                console.warn('ℹ️ 課程顏色 API 近期不可用，使用預設顏色');
                    COURSE_TYPE_COLORS = getFallbackCourseColors();
                    if (!COURSE_TYPE_COLORS.OTHER && COURSE_TYPE_COLORS.other) {
                        COURSE_TYPE_COLORS.OTHER = COURSE_TYPE_COLORS.other;
                    }
                return false;
            }

            try {
                console.error('🎨 嘗試從本地 API 載入課程顏色...');
                const response = await fetch('/api/course-colors', {
                    method: 'GET'
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const data = await response.json();

                // 🔥 支援兩種格式：{ success: true, data: {...} } 或 { colors: {...} }
                const colors = data.data || data.colors || data;
                
                if (colors && typeof colors === 'object') {
                    COURSE_TYPE_COLORS = {
                        ...colors,
                        OTHER: colors.other || colors.OTHER || '#9E9E9E'
                    };
                    setCourseColorStatus('available');
                    console.error('✅ 課程顏色載入成功:', Object.keys(COURSE_TYPE_COLORS).length, '種類型');
                    return true;
                }
                throw new Error('API 返回格式錯誤');
            } catch (error) {
                console.error('ℹ️ 課程顏色 API 不可用（CORS 或網路問題），已切換為預設值:', error.message);
                setCourseColorStatus('unavailable');
                COURSE_TYPE_COLORS = getFallbackCourseColors();
                if (!COURSE_TYPE_COLORS.OTHER && COURSE_TYPE_COLORS.other) {
                    COURSE_TYPE_COLORS.OTHER = COURSE_TYPE_COLORS.other;
                }
                return false;
            }
        }

