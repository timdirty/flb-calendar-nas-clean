        // ==================== 課程類型解析與顏色獲取 ====================
        // 🔥 課程類型解析 - 使用共用模組
        function parseCourseType(title) {
            if (!title) return 'UNKNOWN';
            
            // 使用共用模組的 extractCourseName 函數
            if (window.CourseStudentMatcher) {
                const courseName = window.CourseStudentMatcher.extractCourseName(title);
                return courseName || 'UNKNOWN';
            }
            
            // 備用邏輯
            const match = title.match(/^([A-Z]+)/i);
            return match ? match[1].toUpperCase() : 'UNKNOWN';
        }

        function getCourseColor(title, instructor) {
            // 🔥 課程方塊顏色：根據課程類型決定（不使用講師顏色）
            // 講師顏色只用於課程卡片中的講師標籤
            const type = parseCourseType(title);
            
            // 優先使用課程類型顏色
            if (COURSE_TYPE_COLORS[type]) {
                return COURSE_TYPE_COLORS[type];
            }

            if (COURSE_TYPE_COLORS.other || COURSE_TYPE_COLORS.OTHER) {
                return COURSE_TYPE_COLORS.other || COURSE_TYPE_COLORS.OTHER;
            }
            
            // 如果找不到課程類型顏色，使用預設灰色
            return '#94a3b8';
        }

        // 🔥 統一使用時間工具模組處理時區（優先使用 TaipeiTimeUtils）
        function formatTimeForDisplay(dateStr) {
            if (window.TaipeiTimeUtils && window.TaipeiTimeUtils.formatTimeForDisplay) {
                return window.TaipeiTimeUtils.formatTimeForDisplay(dateStr);
            }
            // 備份方案：使用本地時間
            const d = new Date(dateStr);
            return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
        }

        function formatDateForDisplay(date) {
            if (window.TaipeiTimeUtils && window.TaipeiTimeUtils.formatDateForDisplay) {
                return window.TaipeiTimeUtils.formatDateForDisplay(date);
            }
            // 備份方案：使用本地時間
            return `${date.getFullYear()}/${String(date.getMonth() + 1).padStart(2, '0')}/${String(date.getDate()).padStart(2, '0')}`;
        }

        /**
         * 將 Date 物件格式化為 YYYY-MM-DD 格式（統一使用台北時區）
         * 🔥 修復：使用時間工具模組，確保時區一致性
         * @param {Date} date - 日期物件
         * @returns {string} YYYY-MM-DD 格式的日期字串
         */
        function formatDateKey(date) {
            if (window.TaipeiTimeUtils && window.TaipeiTimeUtils.formatDateKey) {
                return window.TaipeiTimeUtils.formatDateKey(date);
            }
            // 備份方案：使用本地時間
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
