            const viewButtons = document.querySelector('.view-buttons');
            const todayEventsSection = document.getElementById('todayEventsSection');
            
            if (!floatingMenu) return;
            
            let isFloatingVisible = false;
            let ticking = false;
            
            // 滾動監聽函數
            function handleScroll() {
                if (!ticking) {
                    requestAnimationFrame(() => {
                        // 🔥 手機端專用邏輯（≤ 768px）
                        const isMobile = window.innerWidth <= 768;
                        
                        if (!isMobile) {
                            // 電腦端：不顯示懸浮選單
                            if (isFloatingVisible) {
                                hideFloatingMenu();
                                isFloatingVisible = false;
                            }
                            ticking = false;
                            return;
                        }
                        
                        // 🔥 新邏輯：當主要篩選區塊的視圖按鈕（今日/本週/本月/全部）消失時顯示懸浮選單
                        let shouldShow = false;
                        
                        // 檢查視圖按鈕是否離開視窗頂部
                        if (viewButtons) {
                            const viewButtonsRect = viewButtons.getBoundingClientRect();
                            // 🎯 核心邏輯：當視圖按鈕完全離開視窗頂部時，顯示懸浮選單
                            shouldShow = viewButtonsRect.bottom < 0;
                            
                            // 🔍 調試日誌：僅在狀態變化時輸出
                            if ((shouldShow && !isFloatingVisible) || (!shouldShow && isFloatingVisible)) {
                                console.log('📍 懸浮選單狀態變化:', {
                                    視圖按鈕位置: `top: ${Math.round(viewButtonsRect.top)}, bottom: ${Math.round(viewButtonsRect.bottom)}`,
                                    應顯示: shouldShow,
                                    當前顯示: isFloatingVisible
                                });
                            }
                        }
                        
                        // 根據判斷結果顯示或隱藏
                        if (shouldShow && !isFloatingVisible) {
                            showFloatingMenu();
                            isFloatingVisible = true;
                        } else if (!shouldShow && isFloatingVisible) {
                            hideFloatingMenu();
                            isFloatingVisible = false;
                        }
                        
                        ticking = false;
                    });
                    ticking = true;
                }
            }
            
            // 添加滾動監聽器
            window.addEventListener('scroll', handleScroll, { passive: true });
            
            // 🔥 添加視窗大小變化監聽器（響應式調整）
