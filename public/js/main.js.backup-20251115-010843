            let animationDelay = 0.05; // 預設每張延遲（秒）
            
            // 🔥 根據課程數量調整策略
            if (totalCards > 150) {
                // 超過 150 個：只動畫前 10 張，極速模式
                maxAnimatedCards = 10;
                animationDuration = 0.3;
                animationDelay = 0.03;
                console.log('⚡ 極速動畫模式：課程數量', totalCards, '只動畫前', maxAnimatedCards, '張');
            } else if (totalCards > 100) {
                // 100-150 個：只動畫前 15 張
