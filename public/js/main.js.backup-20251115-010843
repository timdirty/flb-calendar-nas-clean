        // 智能篩選：自動選擇有行事曆的模式
        function smartViewSelection() {
            console.log('🧠 開始智能篩選視圖模式...');
            
            // 🔥 檢測設備類型（電腦端 vs 手機端）
            const isDesktop = window.innerWidth > 768;
            
            // 📱 若已存在綁定講師，優先使用講師智慧篩選避免顯示「今日無課」空白畫面
            if (!isDesktop) {
                let storedInstructor = '';
                try {
                    storedInstructor = localStorage.getItem('selected_instructor') || '';
                    if (!storedInstructor) {
                        storedInstructor = localStorage.getItem('bound_teacher_name') || '';
                    }
                } catch (error) {
                    console.warn('⚠️ 讀取已綁定講師資訊失敗，改用全域智慧篩選:', error);
                }

                const candidateInstructor = (storedInstructor || '').trim();
                if (candidateInstructor) {
                    const normalizedCandidate = candidateInstructor.toLowerCase();
                    const instructorEvents = allEvents.filter(event => {
                        if (!event || !event.instructor) return false;
                        return event.instructor.trim().toLowerCase() === normalizedCandidate;
                    });

                    if (instructorEvents.length > 0) {
                        const smartViewForBound = smartInstructorViewSelection(instructorEvents);
                        if (smartViewForBound) {
                            console.log(`📱 手機端：使用已綁定講師「${candidateInstructor}」的智慧視圖結果：${smartViewForBound}`);
                            return smartViewForBound;
                        }
                    } else {
                        console.log(`ℹ️ 已綁定講師「${candidateInstructor}」在目前資料集中沒有課程，改用全域智慧篩選`);
                    }
                }
            }
            
            if (!allEvents || allEvents.length === 0) {
                // 🔥 電腦端預設本週，手機端預設今日
                const defaultView = isDesktop ? '本週' : '今日';
                console.log(`⚠️ 沒有事件資料，保持${defaultView}視圖 (${isDesktop ? '電腦端' : '手機端'})`);
                return defaultView;
            }
            
            const now = new Date();
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            
            // 🔥 電腦端：跳過今日檢查，從本週開始
            // 🔥 手機端：檢查今日，但如果沒課就直接跳到本週
            if (!isDesktop) {
                // 檢查今日是否有課程（僅手機端）
                const todayEvents = allEvents.filter(event => {
                    if (!event || !event.start) return false;
                    const eventDate = new Date(event.start);
                    const eventDay = new Date(eventDate.getFullYear(), eventDate.getMonth(), eventDate.getDate());
                    return eventDay.getTime() === today.getTime();
                });
                
                if (todayEvents.length > 0) {
                    console.log(`✅ 今日有 ${todayEvents.length} 個課程，選擇今日視圖 (手機端)`);
                    return '今日';
                } else {
                    console.log(`📅 今日沒有課程，直接跳過今日視圖 (手機端)`);
                    // 🔥 今日沒課，直接跳到本週檢查（不停留在今日）
                }
            } else {
                console.log('💻 電腦端模式：跳過今日檢查，直接檢查本週');
            }
            
            // 檢查本週是否有課程（包含已過期的）- 本週日到下週日
            const weekStart = new Date(today);
            const dayOfWeek = today.getDay();
            weekStart.setDate(today.getDate() - dayOfWeek); // 本週週日
            weekStart.setHours(0, 0, 0, 0);
            const weekEnd = new Date(weekStart);
            weekEnd.setDate(weekStart.getDate() + 7); // 下週日
            weekEnd.setHours(23, 59, 59, 999);
            
            const weekEvents = allEvents.filter(event => {
                if (!event || !event.start || !event.end) return false;
                const eventDate = new Date(event.start);
                const eventEndDate = new Date(event.end);
                // 包含本週內所有課程，包括已過期的
                return (eventDate >= weekStart && eventDate <= weekEnd) || 
                       (eventEndDate >= weekStart && eventEndDate <= weekEnd) ||
                       (eventDate <= weekStart && eventEndDate >= weekEnd);
            });
            
            if (weekEvents.length > 0) {
                console.log(`✅ 本週有 ${weekEvents.length} 個課程，選擇本週視圖`);
                return '本週';
            }
            
            // 檢查本月是否有課程
            const monthEvents = allEvents.filter(event => {
                if (!event || !event.start) return false;
                const eventDate = new Date(event.start);
                return eventDate.getFullYear() === now.getFullYear() &&
                       eventDate.getMonth() === now.getMonth();
            });
            
            if (monthEvents.length > 0) {
                console.log(`✅ 本月有 ${monthEvents.length} 個課程，選擇本月視圖`);
                return '本月';
