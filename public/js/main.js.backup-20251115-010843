                isStudentListLoading = false;
                studentListLoadPromise = null;
                return;
            }
            
            studentListLoadPromise = new Promise(async (resolve) => {
                try {
                    // 實際載入學生資料
                    await loadCourseStudents(
                        currentData.teacher,
                        currentData.course,
                        currentData.time,
                        currentData.start,
                        currentData.end,
                        currentData.minutesUntilStart
                    );
                    
                    console.log('✅ 背景載入學生名單完成');
                    isStudentListLoading = false;
                    studentListLoadPromise = null;
                    
                    // 顯示載入完成通知
                    showToast('學生名單載入完成！', 'success');
                    
                    resolve();
                } catch (error) {
                    console.error('❌ 背景載入學生名單失敗:', error);
                    isStudentListLoading = false;
                    studentListLoadPromise = null;
                    
                    // 顯示載入失敗通知
                    showToast('學生名單載入失敗，請重試', 'error');
                    
                    resolve(); // 即使失敗也要resolve，避免Promise pending
