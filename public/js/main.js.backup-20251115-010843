        // 🔥 更新出缺席統計數字（包含臨時學生）
        async function updateAttendanceStats() {
            console.log('📊 開始更新出缺席統計（包含臨時學生）...');
            
            try {
                // 🔥 從 /api/students 獲取最新的學生資料（已包含臨時學生）
                const response = await fetch('/api/students');
                const studentData = await response.json();
                
                if (!studentData.success || !studentData.students) {
                    console.error('❌ 無法獲取學生資料');
                    return;
                }
                
                const allStudents = studentData.students;
                const today = formatDateKey(new Date());
                
                console.log(`📊 獲取到 ${allStudents.length} 位學生（包含 ${studentData.temporaryCount || 0} 位臨時學生）`);
                
                // 統計各種狀態的學生數量
                let presentCount = 0;
                let absentCount = 0;
                let leaveCount = 0;
                let unselectedCount = 0;
                
                allStudents.forEach(student => {
                    if (!student.attendance || !Array.isArray(student.attendance)) {
                        unselectedCount++;
                        return;
                    }
                    
                    const todayAttendance = student.attendance.find(record => record.date === today);
                    
                    if (!todayAttendance) {
                        unselectedCount++;
                    } else if (todayAttendance.present === true) {
                        presentCount++;
                    } else if (todayAttendance.present === false) {
                        absentCount++;
                    } else if (todayAttendance.present === 'leave') {
                        leaveCount++;
                    } else {
                        unselectedCount++;
                    }
                });
                
                // 更新 UI 顯示
                const presentEl = document.getElementById('presentCount');
                const absentEl = document.getElementById('absentCount');
                const leaveEl = document.getElementById('leaveCount');
                const unselectedEl = document.getElementById('unselectedCount');
                
                if (presentEl) presentEl.textContent = presentCount;
                if (absentEl) absentEl.textContent = absentCount;
                if (leaveEl) leaveEl.textContent = leaveCount;
                if (unselectedEl) unselectedEl.textContent = unselectedCount;
                
                console.log('✅ 出缺席統計更新完成:', {
                    出席: presentCount,
                    缺席: absentCount,
                    請假: leaveCount,
                    未選擇: unselectedCount,
                    總計: allStudents.length
                });
                
            } catch (error) {
                console.error('❌ 更新出缺席統計失敗:', error);
            }
        }

