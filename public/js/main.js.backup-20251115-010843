        // 🚀 預載入學生資料（在長按 0.5 秒時觸發）
        async function preloadStudentData(course) {
            try {
                // 如果已經在預載入相同課程，不重複觸發
                if (isPreloading && preloadCourse === course) {
                    console.log('⏳ 已經在預載入該課程資料，跳過重複請求');
                    return Promise.resolve();
                }
                
                // 🔒 參數驗證
                if (!course || typeof course !== 'string') {
                    console.warn('⚠️ [預載入] 無效的課程名稱:', course);
                    return Promise.resolve();
                }
                
                // 取消之前的預載入請求
                if (preloadAbortController) {
                    preloadAbortController.abort();
                    console.log('🚫 取消上一次預載入請求');
                }
                
                // 創建新的 AbortController
                preloadAbortController = new AbortController();
                isPreloading = true;
                preloadCourse = course;
                preloadedData = null;
                
                console.log('🚀 [預載入] 開始預載入學生資料:', course);
                const startTime = performance.now();
                
                // 並行請求學生資料和臨時學生資料
                const [studentResponse, tempResponse] = await Promise.all([
                    fetch(`/api/students/by-course?course=${encodeURIComponent(course)}`, {
                        cache: 'no-cache',
                        headers: {
                            'Cache-Control': 'no-cache',
                            'Pragma': 'no-cache'
                        },
                        signal: preloadAbortController.signal
                    }),
                    fetch('/api/temporary-students', {
                        cache: 'no-cache',
                        headers: {
                            'Cache-Control': 'no-cache',
                            'Pragma': 'no-cache'
                        },
                        signal: preloadAbortController.signal
                    })
                ]);
                
                if (!studentResponse.ok) {
                    throw new Error(`HTTP error! status: ${studentResponse.status}`);
                }
                
                const [apiResult, tempResult] = await Promise.all([
                    studentResponse.json(),
                    tempResponse.ok ? tempResponse.json() : { success: false, data: [] }
                ]);
                
                const elapsed = performance.now() - startTime;
                console.log(`✅ [預載入] 學生資料預載入完成！耗時: ${Math.round(elapsed)}ms`);
                
                if (!apiResult.success) {
                    throw new Error(apiResult.error || '讀取學生資料失敗');
                }
                
                // 處理學生資料
                const studentData = {
                    success: true,
                    count: apiResult.count,
                    students: apiResult.students || []
                };
                
                // 標記原始索引
                studentData.students.forEach((student, index) => {
                    student.originalIndexInSheet = index;
                });
                
                // 處理臨時學生
                let tempStudents = [];
                if (tempResult.success && tempResult.data) {
                    tempStudents = tempResult.data;
                    tempStudents.forEach(ts => {
                        ts.originalIndexInSheet = -1;
                    });
                }
                
                // 儲存預載入資料
                preloadedData = {
                    studentData,
                    tempStudents,
                    timestamp: Date.now()
                };
                
                console.log('💾 [預載入] 資料已快取:', {
                    課程: course,
                    學生數: studentData.students.length,
                    臨時學生數: tempStudents.length,
                    總耗時: `${Math.round(elapsed)}ms`
                });
                
            } catch (error) {
                if (error.name === 'AbortError') {
                    console.log('🚫 [預載入] 請求已中斷');
                } else {
                    console.error('❌ [預載入] 預載入失敗:', error);
                }
                preloadedData = null;
            } finally {
                isPreloading = false;
            }
        }
        
