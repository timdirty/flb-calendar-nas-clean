                    studentCountSelection.style.display = 'none';
                    // 有學生資料時，自動設置人數為實際出席的學生數量
                    const allStudents = window.loadedStudentsData.students;
                    const today = formatDateKey(new Date());
                    
                    // 計算今天實際出席的學生人數（需要根據課程和時間過濾）
                    const currentCourse = window.currentAttendanceData?.course || '';
                    const currentTime = window.currentAttendanceData?.time || '';
                    
                    const presentStudents = allStudents.filter(student => {
                        if (!student.attendance || !Array.isArray(student.attendance)) {
                            return false;
                        }
                        
                        // 首先檢查課程和時間是否匹配
                        const courseMatch = student.course.replace(/\s+/g, '').toLowerCase() === currentCourse.replace(/\s+/g, '').toLowerCase();
                        
                        // 精準比對時間（移除週次並忽略空白）
                        let timeMatch = false;
                        if (student.period && currentTime) {
                            // 標準化時間格式的函數
                            const normalizeTimeFormat = (timeStr) => {
                                if (window.CourseStudentMatcher && typeof window.CourseStudentMatcher.normalizeTimeFormat === 'function') {
                                    return window.CourseStudentMatcher.normalizeTimeFormat(timeStr);
                                }
                                if (!timeStr) return '';
                                
                                return timeStr
                                    .replace(/\s*第[一二三四五六七八九十\d]+周\s*/gi, '')
                                    .replace(/\s*Week\s*\d+\s*/gi, '')
                                    .replace(/\s*week\s*\d+\s*/gi, '')
                                    .replace(/\s+/g, '')
                                    .toLowerCase()
                                    // 標準化時間格式：將 HH:MM 轉換為 HHMM，但保留已經是 HHMM 格式的
                                    .replace(/(\d{1,2}):(\d{2})/g, (match, h, m) => {
                                        return h.padStart(2, '0') + m;
                                    });
                            };
                            
                            const cleanStudentPeriod = normalizeTimeFormat(student.period);
                            const cleanTargetTime = normalizeTimeFormat(currentTime);
                            
                            timeMatch = cleanStudentPeriod === cleanTargetTime;
                        }
                        
                        // 只有課程和時間都匹配的學生才進行出席檢查
                        if (!courseMatch || !timeMatch) {
                            return false;
                        }
                        
                        const todayAttendance = student.attendance.find(record => record.date === today);
                        return todayAttendance && todayAttendance.present === true;
                    });
                    
                    const studentCount = presentStudents.length;
                    selectedStudentCount = studentCount;
                    console.log('📊 自動設置學生人數（根據實際出席）:', {
