            // 🔥 動態計算 baseTop，考慮懸浮選單的位置（手機端專用）
            getDynamicBaseTop() {
                const isMobile = window.innerWidth <= 768;
                
                if (!isMobile) {
                    return this.baseTop; // 桌面版不需要調整
                }
                // 🔎 多組可能的懸浮/置頂元素（從上到下取最大 bottom）
                const candidateSelectors = [
                    '#floatingStatsMenu',
                    '#dateRangeTabs',
                    '.today-tabs',
                    '.top-sticky',
                    '.filter-toolbar',
                    '.floating-bar'
                ];

                const viewportTopOffset = 0; // 以視窗頂端作為基準
                let maxBottom = this.baseTop; // 預設安全邊距

                candidateSelectors.forEach(selector => {
                    const els = Array.from(document.querySelectorAll(selector));
                    els.forEach(el => {
                        if (!el) return;
                        const style = window.getComputedStyle(el);
                        // 跳過不可見元素
                        const hidden = style.display === 'none' || style.visibility === 'hidden' || el.offsetParent === null;
                        if (hidden) return;
                        const rect = el.getBoundingClientRect();
                        // 只考慮靠近視窗頂部的元素（例如 sticky/fixed 工具列）
                        const isNearTop = rect.top <= 120; // 120px 內視為頂部懸浮區
                        if (!isNearTop) return;
                        const bottom = Math.max(viewportTopOffset, rect.bottom);
                        maxBottom = Math.max(maxBottom, Math.ceil(bottom));
                    });
                });

                // 額外安全間距；480px 以下加大
                // 🔧 手機 480px 自動下移距離加倍，以避免被懸浮列遮擋
                const extraGap = (window.innerWidth <= 480) ? 80 : 48;
                const adjustedTop = maxBottom + extraGap;

                return Math.max(adjustedTop, this.baseTop);
            },
            
            // 計算新 toast 的位置
            getNextPosition() {
                const dynamicBaseTop = this.getDynamicBaseTop();
                
                if (this.toasts.length === 0) {
                    return dynamicBaseTop;
                }
                
                // 計算所有現有 toast 的總高度
                let totalHeight = dynamicBaseTop;
                this.toasts.forEach(toast => {
                    if (toast && toast.offsetHeight) {
                        totalHeight += toast.offsetHeight + this.gap;
                    }
                });
                
                return totalHeight;
            },
            
            // 添加 toast 到管理器（延遲計算位置以確保高度正確）
            addToast(toast) {
                // 🔥 如果已有最多數量的 toast，移除最舊的一個（用替換方式）
                if (this.toasts.length >= this.maxToasts) {
                    const oldestToast = this.toasts[0];
                    console.log(`⚠️ Toast 數量已達上限 (${this.maxToasts})，移除最舊的通知`);
                    
                    // 淡出並移除最舊的 toast
                    if (oldestToast && oldestToast.parentNode) {
                        oldestToast.style.setProperty('opacity', '0', 'important');
                        oldestToast.style.setProperty('transform', 'translateX(-50%) scale(0.8)', 'important');
                        setTimeout(() => {
                            if (oldestToast.parentNode) {
                                oldestToast.parentNode.removeChild(oldestToast);
                            }
                        }, 300);
                    }
                    
                    // 從陣列移除
                    this.toasts.shift();
                }
                
                this.toasts.push(toast);
                // 使用 requestAnimationFrame 確保 DOM 已經渲染
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        this.updatePositions();
                    });
                });
            },
            
            // 從管理器移除 toast
            removeToast(toast) {
                const index = this.toasts.indexOf(toast);
                if (index > -1) {
                    this.toasts.splice(index, 1);
                    // 立即更新位置，讓其他 toast 平滑上移
                    requestAnimationFrame(() => {
                        this.updatePositions();
                    });
                }
            },
            
            // 更新所有 toast 的位置（平滑動畫）
            updatePositions() {
                let currentTop = this.getDynamicBaseTop(); // 🔥 使用動態計算的 baseTop
                this.toasts.forEach(toast => {
                    if (toast && toast.parentNode) {
                        toast.style.setProperty('top', currentTop + 'px', 'important');
                        currentTop += (toast.offsetHeight || 70) + this.gap; // 如果高度為 0，使用預設值 70
                    }
                });
            }
        };

