                }
                
                // 重置按鈕（如果存在）
                if (submitBtn) {
                    submitBtn.innerHTML = '<i class="fas fa-paper-plane" style="margin-right: 8px;"></i>提交講師報表';
                    submitBtn.disabled = false;
                }
                
                console.log('✅ 講師報表提交完成');
                
                // 完全重置所有狀態
                window.isSubmittingReport = false;
