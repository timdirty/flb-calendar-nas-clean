        // 🔥 優化：等待資料載入完成的輔助函數（使用事件機制）
        async function waitForDataLoading(timeout = 10000) {
            console.log('⏳ 等待資料載入完成...', {
                dataLoadingComplete: window.dataLoadingComplete,
                allEventsCount: allEvents.length,
                allInstructorsCount: allInstructors.length
            });
            
            // 如果已經載入完成，直接返回
            if (window.dataLoadingComplete && allEvents.length > 0 && allInstructors.length > 0) {
                console.log('✅ 資料已載入完成');
                return true;
            }
            
            // 🔥 優化：使用事件監聽取代輪詢，更即時響應
            return new Promise((resolve, reject) => {
                console.log('⏳ 等待 dataLoadingComplete 事件，最多等待', timeout, 'ms');
                
                let timeoutId;
                let eventListenerAdded = false;
                
                function onDataLoaded(event) {
                    cleanup();
                    console.log('✅ 接收到資料載入完成事件', event.detail);
                    resolve(true);
                }
                
                function cleanup() {
                    if (timeoutId) clearTimeout(timeoutId);
                    if (eventListenerAdded) {
                        window.removeEventListener('dataLoadingComplete', onDataLoaded);
                    }
                    window.dataLoadingPromiseResolve = null;
                }
                
                // 設置超時
                timeoutId = setTimeout(() => {
                    cleanup();
                    console.warn('⏰ 等待資料載入超時');
                    reject(new Error('等待資料載入超時'));
                }, timeout);
                
                // 監聽載入完成事件
                window.addEventListener('dataLoadingComplete', onDataLoaded, { once: true });
                eventListenerAdded = true;
                
                // 保存 resolve 函數作為後備方案
                window.dataLoadingPromiseResolve = () => {
                    cleanup();
                    console.log('✅ 資料載入完成（後備 Promise）');
                    resolve(true);
                };
            });
        }
        
