            name: s.name,
            remaining: s.remaining,
            attendance: s.attendance
        })));
    }
    
    // 🔥 優化：檢查並更新學生資料（使用場景化 API）
    async function checkAndUpdateStudentData() {
        // 只有當學生列表正在顯示時才檢查
        const studentsList = document.getElementById('studentsList');
        const attendanceModal = document.getElementById('attendanceModal');
        
        if (!studentsList || !attendanceModal || attendanceModal.style.display === 'none') {
            return;
        }
        
        if (!window.loadedStudentsData) {
            return;
        }
        
        // 🔥 獲取當前課程名稱
        const currentCourse = window.loadedStudentsData.course || window.currentCourseData?.course;
        if (!currentCourse) {
            console.warn('⚠️ 無法獲取當前課程名稱，跳過更新');
            return;
        }
        
        try {
            // 🚀 使用場景化 API（只讀取該課程學生，更快更精準）
            const response = await fetch(`/api/students/by-course?course=${encodeURIComponent(currentCourse)}`, {
                cache: 'no-cache',
                headers: {
                    'Cache-Control': 'no-cache',
                    'Pragma': 'no-cache',
                    'Expires': '0'
                }
            });
            
            if (!response.ok) {
                return;
            }
            
            const newData = await response.json();
            
            if (!newData.success || !newData.students) {
                return;
            }
            
            // 🔥 使用純資料 hash（不含時間戳）
            const newHash = getDataHash({ students: newData.students });
            
            // 檢查資料是否有變化
            if (lastStudentDataHash && lastStudentDataHash !== newHash) {
                console.log('✨ 偵測到學生資料更新，靜默同步中...');
                
                // 更新全局學生資料
                const oldData = window.loadedStudentsData;
                
                // 🔥 合併新資料（使用場景化 API 的完整資料）
                const updatedStudents = oldData.students.map(oldStudent => {
                    const newStudent = newData.students.find(s => s.name === oldStudent.name);
                    if (newStudent) {
                        return {
                            ...oldStudent,
                            remaining: newStudent.remaining,
                            remainingFromCourseSheet: newStudent.remainingFromCourseSheet,
                            attendance: newStudent.attendance
                        };
                    }
                    return oldStudent;
                });
                
                // 更新全局資料
                window.loadedStudentsData.students = updatedStudents;
                
                // 🔥 靜默更新 UI（不重新渲染整個列表，只更新剩餘堂數）
                updatedStudents.forEach(student => {
                    const studentCard = document.querySelector(`.student-card[data-student-id="${student.name}"]`);
                    if (studentCard) {
                        const remainingDisplay = studentCard.querySelector('.remaining-classes');
                        if (remainingDisplay && student.remaining !== undefined) {
                            const currentRemaining = parseInt(remainingDisplay.getAttribute('data-count'));
                            if (currentRemaining !== student.remaining) {
                                remainingDisplay.setAttribute('data-count', student.remaining);
                                remainingDisplay.innerHTML = `
                                    <span style="font-size: 0.7rem;">📚</span>
                                    <span class="remaining-text">剩餘 ${student.remaining} 堂</span>
                                `;
                                remainingDisplay.style.color = student.remaining > 0 ? '#2E7D32' : '#D32F2F';
                                remainingDisplay.style.background = student.remaining > 0 ? 'rgba(46, 125, 50, 0.1)' : 'rgba(211, 47, 47, 0.1)';
                                remainingDisplay.style.borderColor = student.remaining > 0 ? 'rgba(46, 125, 50, 0.3)' : 'rgba(211, 47, 47, 0.3)';
                                console.log(`📚 同步更新 ${student.name} 剩餘堂數: ${student.remaining} 堂`);
                            }
                        }
                    }
                });
                
                console.log('🔄 學生資料已靜默同步完成');
            }
            
            lastStudentDataHash = newHash;
            
        } catch (error) {
            console.error('❌ 檢查學生資料更新失敗:', error);
        }
    }
    
    // 啟動學生資料輪詢
    function startStudentDataPolling() {
        console.log('▶️ 啟動學生資料輪詢（每 3 秒）');
        
        // 停止現有的輪詢
        stopStudentDataPolling();
        
        // 立即檢查一次
        checkAndUpdateStudentData();
        
        // 每 3 秒檢查一次
        studentDataPollingTimer = setInterval(checkAndUpdateStudentData, 3000);
    }
    
    // 停止學生資料輪詢
    function stopStudentDataPolling() {
        if (studentDataPollingTimer) {
            console.log('⏹️ 停止學生資料輪詢');
            clearInterval(studentDataPollingTimer);
            studentDataPollingTimer = null;
            lastStudentDataHash = null;
        }
    }
    
    // 導出輪詢函數到全局
    window.startStudentDataPolling = startStudentDataPolling;
    window.stopStudentDataPolling = stopStudentDataPolling;
    
    // 🔥 講師綁定相關函數已在定義時直接綁定到 window 對象
    console.error('✅ 講師綁定函數檢查:', {
        showTeacherBindModal: typeof window.showTeacherBindModal,
        closeTeacherBindModal: typeof window.closeTeacherBindModal,
        confirmTeacherBinding: typeof window.confirmTeacherBinding,
        showUnbindConfirm: typeof window.showUnbindConfirm,
        closeUnbindConfirm: typeof window.closeUnbindConfirm,
        confirmUnbind: typeof window.confirmUnbind
    });
    
    console.log('✅ 學生資料即時同步機制已初始化');
})();
