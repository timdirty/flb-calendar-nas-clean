         */
        function extractLessonInfoSync(event) {
            // 🎯 第一步：優先使用後端提供的 lessonPlanUrl（如果存在）
            if (event.lessonPlanUrl && typeof event.lessonPlanUrl === 'string' && event.lessonPlanUrl.trim() !== '') {
                const lessonUrl = event.lessonPlanUrl.trim();
                // 驗證是否為有效的 Notion 連結
                if (lessonUrl.includes('notion.so/')) {
                    console.log('✅ 使用後端提供的教案連結:', lessonUrl);
                    return extractLessonInfoFromUrl(lessonUrl, event);
                }
            }
            
            // 🎯 第二步：從描述中提取
            if (!event.description) {
                return null;
            }
            
            // 🔥 智慧尋找教案連結（支持多種格式）
            let lessonUrl = null;
            
            // 方式1：匹配 Notion URL（包括參數），最通用的方式
            // 匹配 https://www.notion.so/ 後跟任意非空白字符，直到遇到空白、換行或結尾
            const notionUrlPattern = /https:\/\/www\.notion\.so\/[^\s\n\r\)\uFF09]+/;
            const urlMatch = event.description.match(notionUrlPattern);
            
            if (urlMatch) {
                lessonUrl = urlMatch[0];
            }
            
            // 方式2：如果方式1失敗，嘗試匹配更寬鬆的格式（包含參數的情況）
            if (!lessonUrl) {
                // 匹配 Notion URL，允許 URL 參數中包含特殊字符
                const generalPattern = /https:\/\/www\.notion\.so\/[^\s\n\r]+/;
                const generalMatch = event.description.match(generalPattern);
                if (generalMatch) {
                    // 清理 URL（移除可能的尾隨括號）
                    lessonUrl = generalMatch[0].replace(/[)）]+$/, '').trim();
                }
            }
            
            // 如果找不到連結，返回 null
            if (!lessonUrl) {
                return null;
            }
            
            // 從連結中提取 Notion ID（去除參數）
            const urlIdMatch = lessonUrl.match(/notion\.so\/([^?\s]+)/);
            if (!urlIdMatch) {
                return null;
            }
            
            // 提取教案名稱和類型
            return extractLessonInfoFromUrl(lessonUrl, event);
        }

        function extractCourseTopic(event, lessonInfo) {
            if (!event) return '';
            if (event.topic && String(event.topic).trim().length > 0) {
                return String(event.topic).trim();
            }
            if (lessonInfo && lessonInfo.name && lessonInfo.name.trim().length > 0) {
                return lessonInfo.name.trim();
            }
            const description = event.description || '';
            const topicPatterns = [
                /課程主題\s*[：:\-]\s*([^\n\r]+)/i,
                /主題\s*[：:\-]\s*([^\n\r]+)/i
            ];
            for (const pattern of topicPatterns) {
                const match = description.match(pattern);
                if (match && match[1]) {
                    const candidate = match[1].trim();
                    if (candidate) {
                        return candidate;
                    }
                }
            }
            if (event.title) {
                const sanitizedTitle = event.title.replace(/\s+/g, ' ').trim();
                const separatorMatch = sanitizedTitle.match(/[｜|－—–-]\s*([^｜|－—–-]+)$/);
                if (separatorMatch && separatorMatch[1]) {
                    const candidate = separatorMatch[1].trim();
                    if (candidate && !/^\d{1,2}:?\d{2}/.test(candidate)) {
                        return candidate;
                    }
                }
            }
            return '';
        }

        /**
         * 從 URL 和事件資訊中提取教案詳細資訊
         */
        function extractLessonInfoFromUrl(lessonUrl, event) {
            let lessonName = '查看教案';
            let lessonType = '教案';
            let lessonColor = '#667eea';
            let matched = false;
            
            const description = event.description || '';
            
            // 使用全域快取的課程類別配置
            const courseCategories = window.courseCategoriesCache || getDefaultCourseCategoriesForRendering();
            
            // 🔥 第一步：嘗試匹配預定義的課程類別
            for (const category of courseCategories) {
                if (!category.enabled) continue;
                
                const courseTypeName = category.name.toUpperCase();
                const keyword = category.keyword || `${courseTypeName}教案`;
                
                // 🔥 改進匹配規則：支持更多格式
                // 1. "{keyword}: 教案名稱 (https://..."
                // 2. "{keyword}: 教案名稱((https://..." （注意雙括號）
                // 3. "{類型}教案: 教案名稱..."
                // 4. "{類型} xxx 教案: 教案名稱..."
                // 5. 教案名稱後可能有括號、冒號等多種分隔符
                const escapedKeyword = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                
                // 🔥 改進：教案名稱應該在遇到開括號前停止，避免包含括號
                // 匹配模式1：keyword: 教案名稱 (連結) - 教案名稱不包含開括號，但可以包含空格
                const regex1 = new RegExp(`(${escapedKeyword})[:\\：\\s]+([^（(\n]*?)(?:[（(]+https:\\/\\/www\\.notion\\.so)`, 'i');
                // 匹配模式2：類型教案: 教案名稱 (連結)
                const regex2 = new RegExp(`(${courseTypeName}教案)[:\\：\\s]+([^（(\n]*?)(?:[（(]+https:\\/\\/www\\.notion\\.so)`, 'i');
                // 匹配模式3：類型 xxx 教案: 教案名稱 (連結)
                const regex3 = new RegExp(`(${courseTypeName})[^：:\n]*教案[：:\\s]+([^（(\n]*?)(?:[（(]+https:\\/\\/www\\.notion\\.so)`, 'i');
                // 匹配模式4：更寬鬆的匹配（教案名稱在 keyword 附近）
                const regex4 = new RegExp(`(${escapedKeyword})[^（(]*?[:\\：]?\\s+([^（(\n]{1,50})(?:[（(]+https:\\/\\/www\\.notion\\.so)`, 'i');
                
                let lessonMatch = description.match(regex1) || 
                                 description.match(regex2) || 
                                 description.match(regex3) ||
                                 description.match(regex4);
                
                if (lessonMatch && lessonMatch[2]) {
                    let extracted = lessonMatch[2].trim();
                    
                    // 🔥 更徹底的清理：移除所有尾部括號（包括中英文）
                    extracted = extracted.replace(/[（(]+$/, '');
                    // 移除尾部冒號
                    extracted = extracted.replace(/[:：]+$/, '');
                    // 移除尾部空格和特殊字符
                    extracted = extracted.replace(/[\s　]+$/, '');
                    extracted = extracted.trim();
                    
                    // 🔥 如果提取的內容包含開括號，嘗試更精確提取
                    if (extracted.includes('(') || extracted.includes('（')) {
                        // 在開括號前截取
                        const bracketIndex = Math.min(
                            extracted.indexOf('(') !== -1 ? extracted.indexOf('(') : Infinity,
                            extracted.indexOf('（') !== -1 ? extracted.indexOf('（') : Infinity
                        );
                        if (bracketIndex !== Infinity && bracketIndex > 0) {
                            extracted = extracted.substring(0, bracketIndex).trim();
                        }
                    }
                    
                    if (extracted && extracted.length > 0 && extracted !== '查看教案' && !extracted.includes('http')) {
                        lessonName = extracted;
                        lessonType = category.name;
                        lessonColor = COURSE_TYPE_COLORS[lessonType] || category.color || '#667eea';
                        matched = true;
                        console.log(`✅ 識別預定義課程類別: ${category.name}, 教案名稱: ${lessonName}`);
                        break;
                    }
                }
            }
            
            // 🔥 第二步：如果沒有匹配預定義類別，智能識別任意課程類別
            if (!matched && event.title) {
                const extractedCourseName = window.CourseStudentMatcher && window.CourseStudentMatcher.extractCourseName
                    ? window.CourseStudentMatcher.extractCourseName(event.title)
                    : (event.title.match(/^([A-Z0-9]+(?:\s+[A-Z0-9]+)*|[一-龥]+(?:\d+)?)/i)?.[1]?.trim().toUpperCase() || '');
                
                if (extractedCourseName) {
                    // 匹配多種格式
                    const smartRegex1 = new RegExp(`(${extractedCourseName}教案)[:\\：\\s]+([^（(\n]*?)(?:[（(]+https:\\/\\/www\\.notion\\.so)`, 'i');
                    const smartRegex2 = new RegExp(`(${extractedCourseName})[^：:\n]*教案[：:\\s]+([^（(\n]*?)(?:[（(]+https:\\/\\/www\\.notion\\.so)`, 'i');
                    const smartRegex3 = new RegExp(`(${extractedCourseName}教案)[^（(]*?[:\\：]?\\s+([^（(\n]{1,50})(?:[（(]+https:\\/\\/www\\.notion\\.so)`, 'i');
                    
                    const smartMatch = description.match(smartRegex1) || 
                                     description.match(smartRegex2) ||
                                     description.match(smartRegex3);
                    
                    if (smartMatch && smartMatch[2]) {
                        let extracted = smartMatch[2].trim();
                        
                        // 🔥 更徹底的清理
                        extracted = extracted.replace(/[（(]+$/, '');
                        extracted = extracted.replace(/[:：]+$/, '');
                        extracted = extracted.replace(/[\s　]+$/, '');
                        extracted = extracted.trim();
                        
                        // 🔥 如果包含開括號，在開括號前截取
                        if (extracted.includes('(') || extracted.includes('（')) {
                            const bracketIndex = Math.min(
                                extracted.indexOf('(') !== -1 ? extracted.indexOf('(') : Infinity,
                                extracted.indexOf('（') !== -1 ? extracted.indexOf('（') : Infinity
                            );
                            if (bracketIndex !== Infinity && bracketIndex > 0) {
                                extracted = extracted.substring(0, bracketIndex).trim();
                            }
                        }
                        
                        if (extracted && extracted.length > 0 && extracted !== '查看教案' && !extracted.includes('http')) {
                            lessonName = extracted;
                            lessonType = extractedCourseName;
                            lessonColor = COURSE_TYPE_COLORS[lessonType] || generateCourseColor(extractedCourseName);
                            console.log(`🧠 智能識別新課程類別: ${extractedCourseName}, 教案名稱: ${lessonName}`);
                        }
                    }
                }
            }
            
            // 🔥 第三步：如果還是沒找到教案名稱，嘗試更寬鬆的匹配
            if (lessonName === '查看教案' && description) {
                // 在 Notion 連結前尋找可能的教案名稱（最多 50 字）
                const beforeLinkMatch = description.match(/([^：:\n]{1,50})(?:[：:]?\s*)?(?:[（(]*)?https:\/\/www\.notion\.so/);
                if (beforeLinkMatch && beforeLinkMatch[1]) {
                    let candidate = beforeLinkMatch[1].trim();
                    // 移除常見的前綴（如 "Scratch教案"、"ESM教案" 等）
                    candidate = candidate.replace(/(?:^[^\s]*教案[：:\s]*)/i, '');
                    
                    // 🔥 更徹底的清理
                    candidate = candidate.replace(/[（(]+$/, '');
                    candidate = candidate.replace(/[:：]+$/, '');
                    candidate = candidate.replace(/[\s　]+$/, '');
                    candidate = candidate.trim();
                    
                    // 🔥 如果包含開括號，在開括號前截取
                    if (candidate.includes('(') || candidate.includes('（')) {
                        const bracketIndex = Math.min(
                            candidate.indexOf('(') !== -1 ? candidate.indexOf('(') : Infinity,
                            candidate.indexOf('（') !== -1 ? candidate.indexOf('（') : Infinity
                        );
                        if (bracketIndex !== Infinity && bracketIndex > 0) {
                            candidate = candidate.substring(0, bracketIndex).trim();
                        }
                    }
                    
                    // 如果候選名稱合理（長度適中，不包含太多特殊字符）
                    if (candidate && candidate.length > 0 && candidate.length <= 30 && 
                        !candidate.includes('http') && !candidate.includes('班級') && !candidate.includes('講師')) {
                        lessonName = candidate;
                        console.log(`🔍 寬鬆匹配找到教案名稱: ${lessonName}`);
                    }
                }
            }
            
            // 🔥 第四步：如果 lessonType 還是"教案"，嘗試從描述中提取"教案"前的文字
            if (lessonType === '教案' && description) {
                // 匹配模式：任意文字 + "教案"（不區分大小寫）
                // 例如："Scratch教案"、"ESM教案"、"Python教案" 等
                const lessonTypePattern = /([A-Za-z0-9\u4e00-\u9fa5]+)\s*教案[：:\s]*/i;
                const typeMatch = description.match(lessonTypePattern);
                
                if (typeMatch && typeMatch[1]) {
                    let extractedType = typeMatch[1].trim();
                    
                    // 過濾掉不合適的類型（如"查看"、"課程"等）
                    const invalidTypes = ['查看', '課程', '教案', '名稱', '連結', 'http', 'https', 'www'];
                    if (!invalidTypes.includes(extractedType) && extractedType.length <= 20) {
                        lessonType = extractedType;
                        console.log(`✅ 自動識別教案類型: ${lessonType}`);
                    }
                }
            }
            
            return {
                url: lessonUrl,
                name: lessonName,
                type: lessonType,
                color: lessonColor
            };
        }
        
