                                    showEnhancedTooltip(tooltipData, this);
                                } catch (err) {
                                    console.error('❌ 解析 tooltip 資料失敗:', err);
                                }
                            }
                        });
                        element.addEventListener('mouseleave', function() {
                            scheduleHideEnhancedTooltip();
                        });
                    });
                }, 50);
            }
            
            // 🎯 渲染完成，執行回調
            setTimeout(() => {
                if (callback) {
