                            if (!T.getWeekStartInTaipei) { weekStart.setDate(dayStart.getDate() - dayStart.getDay()); weekStart.setHours(0,0,0,0); }
                            const weekEnd = new Date(weekStart); weekEnd.setDate(weekStart.getDate() + 7); weekEnd.setHours(23,59,59,999);
                            const monthStart = new Date(dayStart.getFullYear(), dayStart.getMonth(), 1, 0,0,0,0);
                            const monthEnd = new Date(dayStart.getFullYear(), dayStart.getMonth()+1, 0, 23,59,59,999);

                            const inRange = (e, s, e2) => { const d = new Date(e.start); return d >= s && d <= e2; };
                            const todayEvents = eventsArray.filter(e => inRange(e, dayStart, dayEnd));
                            const weekEvents = eventsArray.filter(e => inRange(e, weekStart, weekEnd));
                            const monthEvents = eventsArray.filter(e => inRange(e, monthStart, monthEnd));
                            window.FLB_Cache.writeEvents('today', base, todayEvents);
                            window.FLB_Cache.writeEvents('week', base, weekEvents);
                            window.FLB_Cache.writeEvents('month', base, monthEvents);
                            console.log('✅ 已寫入分層快取:', { today: todayEvents.length, week: weekEvents.length, month: monthEvents.length });
                        }
                    } catch (e) { console.warn('⚠️ 寫入快取失敗:', e.message); }
                    
                    const totalTime = performance.now() - perfStart;
                    console.log(`⚡ 載入事件總耗時: ${totalTime.toFixed(2)}ms`);
                    
                    return { success: true, fromBackend: true };
                } else {
                    throw new Error(data.message || '載入事件失敗');
                }
            } catch (error) {
                const totalTime = performance.now() - perfStart;
                console.error('❌ 載入事件錯誤:', error, `（耗時 ${totalTime.toFixed(2)}ms）`);
                addLoadingLog('❌ 載入事件失敗: ' + error.message, 'error');
                throw error;
            }
        }

