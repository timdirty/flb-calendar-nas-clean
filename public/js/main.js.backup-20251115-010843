        function updateStudentLoadingProgress(progress = null, statusText = null) {
            try {
                setupStudentLoadingElements();
                
                if (typeof progress === 'number' && !Number.isNaN(progress)) {
                    const clamped = Math.max(0, Math.min(100, Math.round(progress)));
                    studentLoadingProgressState.target = Math.max(studentLoadingProgressState.target, clamped);
                    studentLoadingProgressState.lastAutoBump = (typeof performance !== 'undefined' ? performance.now() : Date.now());
                    if (!studentLoadingProgressState.isActive) {
                        startStudentLoadingProgressLoop();
                    }
                    if (studentLoadingProgressState.target >= 100) {
                        studentLoadingProgressState.target = 100;
                    }
                }
                
                if (typeof statusText === 'string') {
                    const statusEl = studentLoadingProgressState.elements.statusText || document.getElementById('studentLoadingStatusText');
                    if (statusEl) {
                        statusEl.textContent = statusText;
                        studentLoadingProgressState.elements.statusText = statusEl;
                    }
                }
            } catch (error) {
                console.warn('⚠️ 更新學生載入進度失敗:', error);
            }
        }

        function setupStudentLoadingElements() {
            if (!studentLoadingProgressState.elements.progressFill) {
                studentLoadingProgressState.elements.progressFill = document.getElementById('studentLoadingProgressFill');
            }
            if (!studentLoadingProgressState.elements.progressValue) {
                studentLoadingProgressState.elements.progressValue = document.getElementById('studentLoadingProgressValue');
            }
            if (!studentLoadingProgressState.elements.statusText) {
                studentLoadingProgressState.elements.statusText = document.getElementById('studentLoadingStatusText');
            }
            if (!studentLoadingProgressState.elements.primaryText) {
                studentLoadingProgressState.elements.primaryText = document.getElementById('studentLoadingPrimaryText');
            }
        }

        function applyStudentLoadingProgressUI(value) {
            const safeValue = Math.max(0, Math.min(100, value));
            const { progressFill, progressValue } = studentLoadingProgressState.elements;
            if (progressFill) {
                progressFill.style.width = `${safeValue}%`;
            }
            if (progressValue) {
                progressValue.textContent = `${Math.round(safeValue)}%`;
            }
        }

        function resetStudentLoadingProgress() {
            stopStudentLoadingProgressLoop();
            studentLoadingProgressState.current = 0;
            studentLoadingProgressState.target = 0;
            studentLoadingProgressState.lastAutoBump = (typeof performance !== 'undefined' ? performance.now() : Date.now());
            studentLoadingProgressState.elements.progressFill = document.getElementById('studentLoadingProgressFill');
            studentLoadingProgressState.elements.progressValue = document.getElementById('studentLoadingProgressValue');
            studentLoadingProgressState.elements.statusText = document.getElementById('studentLoadingStatusText');
            studentLoadingProgressState.elements.primaryText = document.getElementById('studentLoadingPrimaryText');
            applyStudentLoadingProgressUI(0);
        }

        function startStudentLoadingProgressLoop() {
            if (studentLoadingProgressState.isActive) return;
            studentLoadingProgressState.isActive = true;
            
            const tick = () => {
                if (!studentLoadingProgressState.isActive) return;
                
                const diff = studentLoadingProgressState.target - studentLoadingProgressState.current;
                if (Math.abs(diff) > 0.05) {
                    const step = Math.max(Math.abs(diff) * 0.15, 0.25);
                    studentLoadingProgressState.current += Math.sign(diff) * Math.min(step, Math.abs(diff));
                } else {
                    studentLoadingProgressState.current = studentLoadingProgressState.target;
                    
                    if (studentLoadingProgressState.target >= 100) {
                        stopStudentLoadingProgressLoop(true);
                        return;
                    }
                    
                    if (studentLoadingProgressState.target < 94) {
                        const now = (typeof performance !== 'undefined' ? performance.now() : Date.now());
                        if (now - studentLoadingProgressState.lastAutoBump > 600) {
                            studentLoadingProgressState.lastAutoBump = now;
                            studentLoadingProgressState.target = Math.min(94, studentLoadingProgressState.target + 1.4);
                        }
                    }
                }
                
                applyStudentLoadingProgressUI(studentLoadingProgressState.current);
                studentLoadingProgressState.rafId = requestAnimationFrame(tick);
            };
            
            studentLoadingProgressState.rafId = requestAnimationFrame(tick);
        }

        function stopStudentLoadingProgressLoop(forceComplete = false) {
            studentLoadingProgressState.isActive = false;
            if (studentLoadingProgressState.rafId) {
                cancelAnimationFrame(studentLoadingProgressState.rafId);
                studentLoadingProgressState.rafId = null;
            }
            if (forceComplete) {
                studentLoadingProgressState.current = 100;
                studentLoadingProgressState.target = 100;
                applyStudentLoadingProgressUI(100);
            }
        }

