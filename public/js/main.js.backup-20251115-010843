        // 滑鼠放開處理
        function handleRefreshMouseUp(event) {
            const refreshButton = document.getElementById('refreshButton');
            
            if (refreshLongPressTimer) {
                clearInterval(refreshLongPressTimer);
                refreshLongPressTimer = null;
            }
            
            if (refreshIsLongPressing) {
                const elapsed = Date.now() - refreshLongPressStartTime;
                refreshIsLongPressing = false;
                
                // 移除進度環
                const progressRing = document.getElementById('refresh-progress-ring');
                if (progressRing) {
                    progressRing.remove();
                }
                
                // 恢復按鈕樣式
                refreshButton.style.transform = '';
                refreshButton.style.background = '';
                
                // 重置進度
                refreshLongPressProgress = 0;
                
                if (elapsed < 3000 && elapsed > 500) {
                    // 長按未完成但超過0.5秒，顯示提示
                    const remaining = Math.ceil((3000 - elapsed) / 1000);
                    const percentage = Math.floor((elapsed / 3000) * 100);
                    console.log(`ℹ️ 長按未完成 (${percentage}%)，還需 ${remaining} 秒可觸發完全重置`);
                    showToast(`⏱️ 長按進度 ${percentage}%，再按住 ${remaining} 秒可完全重置`, 'info', 2000);
                }
            }
        }
        
        // 觸控開始處理
