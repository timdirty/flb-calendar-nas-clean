                console.log('📊 回應標頭:', Object.fromEntries(response.headers.entries()));
                
                if (response.ok && result.success) {
                    // 簡化的成功訊息
                    const mode = currentModeDisplay ? currentModeDisplay.textContent : '講師模式';
                    // 修正：當 studentCount 為 0 時不顯示「未知」
                    const studentCount = result.data?.studentCount !== undefined ? result.data.studentCount : '未知';
                    
                    let userFriendlyMessage = `✅ 講師報表提交成功！\n\n`;
                    userFriendlyMessage += `📊 模式：${mode}\n`;
                    userFriendlyMessage += `👥 出席人數：${studentCount} 人\n`;
                    
                    if (result.data?.message) {
                        userFriendlyMessage += `💬 ${result.data.message}`;
                    }
                    
                    console.log('🎯 準備顯示成功通知:', userFriendlyMessage);
                    
                    // 立即顯示醒目的成功通知（螢幕正中央）
                    showCentralSuccessNotification(userFriendlyMessage);
                    console.log('✅ 講師報表提交成功:', result.data);
                    
                    // 🔥 已取消煙火動畫 - 節省效能
                    // createFireworks();
                    // createCelebrationEffect();
                    
                    // 構建出席統計摘要（以 by-course API 的今日出缺席為準）
                    let attendanceSummary = '無統計資料';
                    let presentNamesArr = [];
                    let absentNamesArr = [];
                    let unmarkedNamesArr = [];
                    try {
                        // 以課程類別（例如 SPIKE/ESM）讀取該課程的學生名單與出缺席資料
                        const byCourseRes = await fetch(`/api/students/by-course?course=${encodeURIComponent(currentData.course)}`, { cache: 'no-cache', headers: { 'Cache-Control': 'no-cache' }});
                        if (byCourseRes.ok) {
                            const byCourse = await byCourseRes.json();
                            const students = Array.isArray(byCourse.students) ? byCourse.students : [];

                            const jsDate = new Date(dateString);
                            const pad = n => String(n).padStart(2, '0');
                            const y = jsDate.getFullYear();
                            const m = pad(jsDate.getMonth() + 1);
                            const d = pad(jsDate.getDate());
                            const keys = new Set([`${y}/${m}/${d}`, `${y}-${m}-${d}`]);

                            const norm = (v) => (v === true || v === 'present' || v === 'attended') ? 'present' : (v === false || v === 'absent' || v === 'leave') ? 'absent' : 'unmarked';
                            const extractFromAttendance = (attendance) => {
                                if (!attendance) return 'unmarked';
                                // 1) 物件：{ 'yyyy/mm/dd': 'present' }
                                if (typeof attendance === 'object' && !Array.isArray(attendance)) {
                                    for (const k of Object.keys(attendance)) {
                                        if (keys.has(String(k))) return norm(attendance[k]);
                                    }
                                }
                                // 2) 陣列：[{ date, status/present }]
                                if (Array.isArray(attendance)) {
                                    for (const rec of attendance) {
                                        const recDate = rec?.date || rec?.dateKey || rec?.day || rec?.date_string || rec?.Date;
                                        if (recDate && keys.has(String(recDate))) {
                                            return norm(rec?.status || rec?.attendance || rec?.result || rec?.present);
                                        }
                                    }
                                }
                                return 'unmarked';
                            };

                            students.forEach(s => {
                                let st = extractFromAttendance(s.attendance);
                                if (st === 'unmarked') {
                                    // fallback：即時狀態或其他欄位
                                    if (s.status) st = norm(s.status);
                                    else if (Array.isArray(s.attendance_history)) {
                                        for (const rec of s.attendance_history) {
                                            const recDate = rec?.date || rec?.dateKey || rec?.day || rec?.date_string || rec?.Date;
                                            if (recDate && keys.has(String(recDate))) { st = norm(rec.status || rec.type || rec.attendance || rec.result); break; }
                                        }
                                    }
                                }
                                if (st === 'present') presentNamesArr.push(s.name);
                                else if (st === 'absent') absentNamesArr.push(s.name);
                                else unmarkedNamesArr.push(s.name);
                            });
                        }

                        const parts = [];
                        if (presentNamesArr.length) parts.push(`✅ 出席 ${presentNamesArr.length}人`);
                        if (absentNamesArr.length) parts.push(`❌ 缺席 ${absentNamesArr.length}人`);
                        if (unmarkedNamesArr.length) parts.push(`⏳ 未選擇 ${unmarkedNamesArr.length}人`);
                        attendanceSummary = parts.join('，') || '無統計資料';
                    } catch (e) { console.warn('⚠️ 以 by-course API 統計出缺席失敗:', e); }

                    // 發送LINE通知（講師 Flex）
                    const fullCourseTitle = (window.currentAttendanceData && window.currentAttendanceData.originalTitle)
