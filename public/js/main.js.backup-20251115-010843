                            <div class="today-event-meta">
                                <span><i class="fas fa-chalkboard-teacher"></i> ${event.instructor || '未指定'}</span>
                                ${eventSpecialType ? `<span class="special-badge" style="margin-left: 8px; color: #ffeb3b;"><i class="fas fa-star"></i> ${eventSpecialType}</span>` : ''}
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
            
            // 🔥 綁定增強版 tooltip 事件監聽器（支持 HTML 內容和連結）
            // 🔥 手機端：不綁定 tooltip 事件（避免與觸控邏輯衝突）
