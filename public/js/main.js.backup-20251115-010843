        /**
         * 執行全文搜尋（進階版，支援 Google/Spotlight 風格）
         * @param {string} query - 搜尋關鍵字
         * @returns {Array} 搜尋結果陣列
         * 
         * 支援語法：
         * - "exact phrase" : 精確匹配
         * - keyword1 keyword2 : AND 邏輯（同時包含）
         * - keyword1 OR keyword2 : OR 邏輯（任一包含）
         * - -excluded : 排除關鍵字
         * - +required : 必須包含
         */
        function performGlobalSearch(query) {
            if (!query || query.trim() === '') {
                // 清除搜尋，顯示所有課程
                searchQuery = '';
                filteredEvents = [];
                window.filteredEvents = [];
                searchContext.uniqueInstructors = [];
                searchContext.includesMultipleInstructors = false;
                searchContext.autoSwitchedToAll = false;
                searchContext.instructorStats = [];
                renderEvents();
                renderTodayEvents();
                clearCalendarFocusHighlight();
                refreshCalendarViewIfNeeded('搜尋清除');
                updateSearchInstructorSummary([]);
                return allEvents;
            }
            
            searchQuery = query.trim();
            
            console.log(`🔍 執行進階全文搜尋: "${searchQuery}"`);
            
            // 🔥 使用進階搜尋解析器
            let searchCriteria = null;
            let useAdvancedSearch = false;
            
            if (typeof window.AdvancedSearchParser !== 'undefined') {
                try {
                    const parser = new window.AdvancedSearchParser();
                    searchCriteria = parser.parse(searchQuery);
                    useAdvancedSearch = !searchCriteria.isEmpty;
                    console.log('✅ 使用進階搜尋解析器');
                } catch (error) {
                    console.warn('⚠️ 進階搜尋解析失敗，回退到基本搜尋:', error);
                    useAdvancedSearch = false;
                }
            }
            
            if (useAdvancedSearch && searchCriteria) {
                // 🔥 進階搜尋邏輯
                const parser = new window.AdvancedSearchParser();
                filteredEvents = allEvents.filter(event => {
                    return parser.matchEvent(event, searchCriteria);
                });
                
                console.log(`🎯 進階搜尋完成，找到 ${filteredEvents.length} 筆課程`);
                console.log('   搜尋條件:', {
                    一般關鍵字: searchCriteria.terms,
                    精確匹配: searchCriteria.exactPhrases,
                    必須包含: searchCriteria.requiredTerms,
                    排除關鍵字: searchCriteria.excludedTerms,
                    OR組: searchCriteria.orGroups
                });
            } else {
                // 💡 基本搜尋邏輯（回退方案）
                const lowerQuery = searchQuery.toLowerCase();
                
                // 🔥 檢測是否為多關鍵字搜尋（空格分隔）
                const keywords = lowerQuery.trim().split(/\s+/).filter(k => k.length > 0);
                const isMultiKeyword = keywords.length > 1;
                
                filteredEvents = allEvents.filter(event => {
                    // 🔥 多關鍵字搜尋：使用 OR 邏輯（任一關鍵字匹配即可）
                    if (isMultiKeyword) {
                        return keywords.some(keyword => {
                            // 1. 課程標題
                            if (event.title && event.title.toLowerCase().includes(keyword)) {
                                return true;
                            }
                            
                            // 2. 講師名稱
                            if (event.instructor && event.instructor.toLowerCase().includes(keyword)) {
                                return true;
                            }
                            
                            // 3. 地點
                            if (event.location && event.location.toLowerCase().includes(keyword)) {
                                return true;
                            }
                            
                            // 4. 描述
                            if (event.description && event.description.toLowerCase().includes(keyword)) {
                                return true;
                            }
                            
                            // 5. 課程類型
                            if (event.courseType && event.courseType.toLowerCase().includes(keyword)) {
                                return true;
                            }
                            
                            // 6. 學生姓名 (如果課程有關聯學生)
                            if (event.students && Array.isArray(event.students)) {
                                const studentMatch = event.students.some(student => {
                                    return student.name && student.name.toLowerCase().includes(keyword);
                                });
                                if (studentMatch) return true;
                            }
                            
                            // 7. 🔥 日期搜尋支援
                            if (event.start) {
                                try {
                                    const startDate = new Date(event.start);
                                    if (!isNaN(startDate.getTime())) {
                                        const year = startDate.getFullYear();
                                        const month = String(startDate.getMonth() + 1).padStart(2, '0');
                                        const day = String(startDate.getDate()).padStart(2, '0');
                                        const weekdays = ['日', '一', '二', '三', '四', '五', '六'];
                                        const weekday = weekdays[startDate.getDay()];
                                        
                                        // 支援多種日期格式
                                        const dateFormats = [
                                            `${year}-${month}-${day}`,
                                            `${year}/${month}/${day}`,
                                            `${month}-${day}`,
                                            `${month}/${day}`,
                                            `${year}年${parseInt(month)}月${parseInt(day)}日`,
                                            `${parseInt(month)}月${parseInt(day)}日`,
                                            `星期${weekday}`,
                                            weekday
                                        ];
                                        
                                        if (dateFormats.some(format => format.toLowerCase().includes(keyword))) {
                                            return true;
                                        }
                                    }
                                } catch (e) {
                                    // 日期解析失敗，跳過
                                }
                            }
                            
                            return false;
                        });
                    }
                    
                    // 💡 單一關鍵字搜尋：原有邏輯
                    // 1. 課程標題
                    if (event.title && event.title.toLowerCase().includes(lowerQuery)) {
                        return true;
                    }
                    
                    // 2. 講師名稱
                    if (event.instructor && event.instructor.toLowerCase().includes(lowerQuery)) {
                        return true;
                    }
                    
                    // 3. 地點
                    if (event.location && event.location.toLowerCase().includes(lowerQuery)) {
                        return true;
                    }
                    
                    // 4. 描述
                    if (event.description && event.description.toLowerCase().includes(lowerQuery)) {
                        return true;
                    }
                    
                    // 5. 課程類型
                    if (event.courseType && event.courseType.toLowerCase().includes(lowerQuery)) {
                        return true;
                    }
                    
                    // 6. 學生姓名 (如果課程有關聯學生)
                    if (event.students && Array.isArray(event.students)) {
                        const studentMatch = event.students.some(student => {
                            return student.name && student.name.toLowerCase().includes(lowerQuery);
                        });
                        if (studentMatch) return true;
                    }
                    
                    // 7. 🔥 日期搜尋支援
                    if (event.start) {
                        try {
                            const startDate = new Date(event.start);
                            if (!isNaN(startDate.getTime())) {
                                const year = startDate.getFullYear();
                                const month = String(startDate.getMonth() + 1).padStart(2, '0');
                                const day = String(startDate.getDate()).padStart(2, '0');
                                const weekdays = ['日', '一', '二', '三', '四', '五', '六'];
                                const weekday = weekdays[startDate.getDay()];
                                
                                // 支援多種日期格式
                                const dateFormats = [
                                    `${year}-${month}-${day}`,
                                    `${year}/${month}/${day}`,
                                    `${month}-${day}`,
                                    `${month}/${day}`,
                                    `${year}年${parseInt(month)}月${parseInt(day)}日`,
                                    `${parseInt(month)}月${parseInt(day)}日`,
                                    `星期${weekday}`,
                                    weekday
                                ];
                                
                                if (dateFormats.some(format => format.toLowerCase().includes(lowerQuery))) {
                                    return true;
                                }
                            }
                        } catch (e) {
                            // 日期解析失敗，跳過
                        }
                    }
                    
                    return false;
                });
                
                console.log(`✅ 基本搜尋完成（${isMultiKeyword ? '多關鍵字OR邏輯' : '單一關鍵字'}），找到 ${filteredEvents.length} 筆課程`);
                if (isMultiKeyword) {
                    console.log(`   關鍵字: ${keywords.join(', ')}`);
                }
            }
            
            const instructorMap = new Map();
            filteredEvents.forEach(event => {
                if (!event) return;
                const rawName = (event.instructor || event.teacher || '').trim();
                if (!rawName) return;
                const normalized = rawName.replace(/\s+/g, '').toLowerCase();
                if (!instructorMap.has(normalized)) {
                    instructorMap.set(normalized, { name: rawName, count: 0 });
                }
                const stat = instructorMap.get(normalized);
                stat.count += 1;
            });

            searchContext.uniqueInstructors = Array.from(instructorMap.values()).map(item => item.name);
            searchContext.instructorStats = Array.from(instructorMap.values());
            searchContext.includesMultipleInstructors = searchContext.uniqueInstructors.length > 1;
            searchContext.autoSwitchedToAll = false;
            updateSearchInstructorSummary(searchContext.instructorStats);

            // 🔥 優化：根據搜尋結果的講師數量，自動調整講師篩選
            if (searchContext.includesMultipleInstructors) {
                // 多位講師：切換到全部講師
                const instructorSelect = document.getElementById('instructorSelect');
                const currentInstructor = instructorSelect ? instructorSelect.value : '';
                const needSwitch = currentInstructor !== '';
                
                if (needSwitch) {
                    console.log('🔄 搜尋結果包含多位講師，自動切換到全部講師');
                    console.log(`   當前講師: ${currentInstructor || '(全部)'}`);
                    console.log(`   搜尋結果講師 (${searchContext.uniqueInstructors.length}位): ${searchContext.uniqueInstructors.join(', ')}`);
                    
                    const switched = autoSwitchToAllInstructor('搜尋結果包含多位講師');
                    if (switched) {
                        console.log('✅ 已自動切換到全部講師');
                    } else {
                        console.warn('⚠️ 自動切換全部講師未成功');
                    }
                } else {
                    console.log('ℹ️ 已是全部講師狀態，無需切換');
                    searchContext.autoSwitchedToAll = true;
                }
            } else if (searchContext.uniqueInstructors.length === 1) {
                // 單一講師：自動選擇該講師
                const singleInstructor = searchContext.uniqueInstructors[0];
                const instructorSelect = document.getElementById('instructorSelect');
                const currentInstructor = instructorSelect ? instructorSelect.value : '';
                
                if (currentInstructor !== singleInstructor) {
                    console.log('🔄 搜尋結果只有一位講師，自動選擇:', singleInstructor);
                    
                    const selected = autoSelectInstructor(singleInstructor, '搜尋結果單一講師');
                    if (selected) {
                        console.log('✅ 已自動選擇講師:', singleInstructor);
                    } else {
                        console.warn('⚠️ 自動選擇講師失敗，維持當前狀態');
                    }
                } else {
                    console.log('ℹ️ 已選擇正確講師，無需切換');
                }
            }

            window.filteredEvents = filteredEvents;
            console.log(`✅ 搜尋完成，找到 ${filteredEvents.length} 筆課程`);
            
            // 重新渲染課程列表（使用搜尋結果）
            renderEvents();
            renderTodayEvents();
            refreshCalendarViewIfNeeded('搜尋結果更新');
            
            // 🔍 為所有搜尋結果添加點擊事件（延遲執行以確保 DOM 渲染完成）
            setTimeout(() => {
                addSearchResultClickHandlers(filteredEvents);
            }, 200);

            // 🔄 搜尋完成後調整視圖與滾動
            if (typeof autoScrollToViewButtons === 'function') {
                autoScrollToViewButtons();
            }
            
            return filteredEvents;
        }
        
        /**
         * 為搜尋結果添加標記（不綁定事件，事件由 handleSearchResultClick 處理）
         * @param {Array} results - 搜尋結果陣列
         */
        function addSearchResultClickHandlers(results) {
            if (!results || results.length === 0) {
                console.log('⚠️ 沒有搜尋結果需要標記');
                return;
            }
            
            console.log(`🏷️ 開始標記 ${results.length} 個搜尋結果...`);
            
            // 先清除所有現有的搜尋結果標記
            document.querySelectorAll('[data-search-result="true"]').forEach(card => {
                card.classList.remove('search-result-item', 'search-result-highlight', 'search-result-current');
                card.removeAttribute('data-search-result');
                card.style.cursor = '';
                card.title = '';
            });
            
            let successCount = 0;
            let failedEvents = [];
            
            results.forEach((event, index) => {
                // 嘗試查找事件元素（卡片或方塊）
                let eventElement = null;
                const eventId = event.id || event.uid || event.evt_id;
                
                if (!eventId) {
                    console.warn(`⚠️ [${index + 1}/${results.length}] 事件無 ID:`, event.title);
                    failedEvents.push({ title: event.title, reason: '無ID' });
                    return;
                }
                
                // 查找事件元素（包含 .event-card 和 .event-chip）
                eventElement = document.querySelector(`[data-event-id="${eventId}"]`);
                
                if (eventElement) {
                    // ✅ 找到元素，添加搜尋結果標記
                    eventElement.classList.add('search-result-item');
                    eventElement.setAttribute('data-search-result', 'true');
                    
                    // 添加視覺提示
                    eventElement.style.cursor = 'pointer';
                    eventElement.title = `🔍 點擊跳轉到: ${event.title}`;
                    
                    // 保存完整事件資料到 dataset（供事件委派使用）
                    eventElement.setAttribute('data-search-event', JSON.stringify({
                        id: eventId,
                        title: event.title,
                        instructor: event.instructor || event.teacher,
                        start: event.start
                    }));
                    
                    successCount++;
                    
                    if (index < 3) { // 只記錄前 3 個
                        console.log(`   ✅ [${index + 1}] 已標記: ${event.title}`);
                    }
                } else {
                    if (index < 3) { // 只記錄前 3 個失敗
                        console.warn(`   ❌ [${index + 1}] 找不到卡片: ${event.title} (ID: ${eventId})`);
                    }
                    failedEvents.push({
                        title: event.title,
                        id: eventId
                    });
                }
            });
            
            console.log(`✅ 搜尋結果標記完成: 成功 ${successCount}/${results.length}`);
            
            if (failedEvents.length > 0) {
                console.warn(`⚠️ 有 ${failedEvents.length} 個事件找不到對應的卡片`);
                
                // 列出部分失敗的事件
                if (failedEvents.length <= 5) {
                    console.warn('   失敗列表:', failedEvents);
                } else {
                    console.warn(`   前 5 個失敗事件:`, failedEvents.slice(0, 5));
                }
                
                // 診斷資訊：列出當前頁面的事件卡片
                const allCards = document.querySelectorAll('[data-event-id]');
                console.log(`📋 當前頁面共有 ${allCards.length} 個事件卡片`);
                
                if (allCards.length === 0) {
                    console.error('❌ 頁面上沒有任何事件卡片！可能是渲染問題');
                }
            }
            
            // 確認標記結果
            const markedCards = document.querySelectorAll('[data-search-result="true"]');
            console.log(`🎯 最終標記的搜尋結果卡片數: ${markedCards.length}`);
        }
        
        /**
         * 初始化搜尋功能
         */
        function initializeSearch() {
            // 確保 DOM 已載入
            if (document.readyState === 'loading') {
                console.log('⏳ 等待 DOM 載入完成...');
                document.addEventListener('DOMContentLoaded', initializeSearch);
                return;
            }
            
            // 確保 SearchManager 已載入
            if (typeof window.SearchManager === 'undefined') {
                console.warn('⚠️ SearchManager 尚未載入，等待...');
                setTimeout(initializeSearch, 300);
                return;
            }
            
            // 確保搜尋輸入框存在
            const searchInput = document.getElementById('globalSearch');
            if (!searchInput) {
                console.error('❌ 找不到搜尋輸入框 #globalSearch，重試中...');
                setTimeout(initializeSearch, 300);
                return;
            }
            
            console.log('🔍 初始化搜尋功能...');
            
            try {
                searchManager = new window.SearchManager();
                searchManager.init(performGlobalSearch, highlightSearchResult);
