        // 🆕 智能視圖切換：根據課程日期自動切換到最小適合視圖
        function autoSwitchViewForEvent(eventId) {
            console.log('🔍 開始智能視圖切換，查找課程:', eventId);
            
            // 從 allEvents 中找到該課程
            const targetEvent = allEvents.find(event => {
                const eventIdToMatch = `${event.title}_${event.start}_${event.instructor || ''}`;
                return eventIdToMatch === eventId;
            });
            
            if (!targetEvent) {
                console.warn('❌ 無法在 allEvents 中找到課程:', eventId);
                return false;
            }
            
            console.log('✅ 找到課程:', {
                title: targetEvent.title,
                start: targetEvent.start,
                instructor: targetEvent.instructor
            });
            
            // 判斷課程屬於哪個最小視圖範圍
            const eventDate = new Date(targetEvent.start);
            const now = new Date();
            
            // 重置時間到當天 00:00:00 以便比較日期
            const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const eventDay = new Date(eventDate.getFullYear(), eventDate.getMonth(), eventDate.getDate());
            
            let targetView = null;
            let needUpdateViewDate = false;
            
            // 檢查是否為今日
            if (eventDay.getTime() === today.getTime()) {
                targetView = 'today';
                console.log('📅 課程在今日範圍內');
            } else {
                // 檢查是否在本週範圍內
                const currentWeekStart = new Date(today);
                currentWeekStart.setDate(today.getDate() - today.getDay()); // 週日為起始
                const currentWeekEnd = new Date(currentWeekStart);
                currentWeekEnd.setDate(currentWeekStart.getDate() + 7); // 下週日為結束
                
                if (eventDay >= currentWeekStart && eventDay <= currentWeekEnd) {
                    targetView = 'week';
                    console.log('📅 課程在本週範圍內');
                } else {
                    // 檢查是否在本月範圍內
                    if (eventDate.getFullYear() === now.getFullYear() && 
                        eventDate.getMonth() === now.getMonth()) {
                        targetView = 'month';
                        console.log('📅 課程在本月範圍內');
                    } else {
                        // 🔥 優化：如果課程在其他月份，優先使用月視圖而非全部視圖
                        // 計算課程與當前日期的時間差
                        const daysDiff = Math.abs((eventDay.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
                        
                        if (daysDiff <= 90) {
                            // 課程在 3 個月內，使用月視圖
                            targetView = 'month';
                            needUpdateViewDate = true;
                            console.log('📅 課程在其他月份（3個月內），使用月視圖');
                        } else {
                            // 課程超過 3 個月，使用全部視圖
                            targetView = 'all';
                            needUpdateViewDate = true;
                            console.log('📅 課程超過3個月，使用全部視圖');
                        }
                    }
                }
            }
            
            // 🔥 如果需要更新視圖日期，設置到課程所在的月份
            if (needUpdateViewDate) {
                specialEventsState.currentViewDate = new Date(eventDate);
                console.log('🔥 已更新 currentViewDate 到課程日期:', eventDate);
            }
            
            // 檢查是否需要切換視圖
            const viewMap = {
                'today': '今日',
                'week': '本週',
                'month': '本月',
                'all': '全部'
            };
            
            const targetChineseView = viewMap[targetView];
            
            if (currentView === targetChineseView && !needUpdateViewDate) {
                console.log('✅ 課程已在當前視圖範圍內，無需切換');
                return false;
            }
            
            // 🔥 執行視圖切換
            console.log(`🔄 自動切換視圖：${currentView} → ${targetChineseView}`);
            
            // 根據日期距離顯示更友好的提示訊息
            let toastMessage = '';
            if (targetView === 'today') {
                toastMessage = '🔄 正在切換到「今日」視圖...';
            } else if (targetView === 'week') {
                toastMessage = '🔄 正在切換到「本週」視圖...';
            } else if (targetView === 'month') {
                const monthName = `${eventDate.getFullYear()}年${eventDate.getMonth() + 1}月`;
                toastMessage = `🔄 正在切換到「${monthName}」視圖...`;
            } else {
                toastMessage = '🔄 正在切換到「全部」視圖...';
            }
            
            showToast(toastMessage, 'info');
            
            // 設置回調：視圖切換完成後高亮課程
            window._autoHighlightEventId = eventId;
            
            // 執行視圖切換
            switchView(targetView);
            
            // 等待視圖渲染完成後高亮課程
            setTimeout(() => {
                console.log('🎯 視圖切換完成，嘗試高亮課程:', eventId);
                
                // 再次嘗試找到目標卡片
                let targetCard = null;
                document.querySelectorAll('.event-card').forEach(card => {
                    if (card.getAttribute('data-event-id') === eventId) {
                        targetCard = card;
                    }
                });
                
                if (targetCard) {
                    console.log('✅ 找到課程卡片，執行高亮');
                    performHighlight(targetCard, eventId);
                    
                    // 顯示成功訊息
                    let successMessage = '';
                    if (targetView === 'month' && needUpdateViewDate) {
                        const monthName = `${eventDate.getFullYear()}年${eventDate.getMonth() + 1}月`;
                        successMessage = `✅ 已切換到「${monthName}」並定位課程`;
                    } else {
                        successMessage = `✅ 已切換到「${targetChineseView}」視圖並定位課程`;
                    }
                    showToast(successMessage, 'success');
                } else {
                    console.warn('❌ 視圖切換後仍找不到課程卡片');
                    showToast('❌ 無法定位到該課程', 'error');
                }
                
                // 清除回調標記
                window._autoHighlightEventId = null;
            }, 1500); // 等待 1.5 秒確保視圖完全渲染
            
            return true;
        }
        
        // 🔥 抽取高亮邏輯為獨立函數，避免重複代碼
        function performHighlight(targetCard, eventId) {
            // 確保卡片可見性，防止消失
            if (targetCard) {
                targetCard.style.opacity = '1';
                targetCard.style.visibility = 'visible';
                targetCard.style.display = '';
            }
            
            // 3. 高亮來源 chip
            let sourceChip = null;
            document.querySelectorAll('.event-chip').forEach(chip => {
                if (chip.getAttribute('data-event-id') === eventId) {
                    sourceChip = chip;
                }
            });
            if (sourceChip) {
                sourceChip.classList.add('highlight-source');
            }
            
            // 4. 高亮目標卡片，其他變暗
            targetCard.classList.add('highlight-target');
            document.querySelectorAll('.event-card').forEach(card => {
                if (card !== targetCard) {
                    card.classList.add('dimmed');
                }
            });
            
            // 5. 🔥 滾動到目標卡片
            const eventsContainer = document.getElementById('eventsContainer');
            const isMobile480 = window.innerWidth <= 480;
            
            if (eventsContainer && !isMobile480) {
                // 電腦版：先滾動到課程列表區塊，然後滾動到目標卡片
                eventsContainer.scrollIntoView({ 
                    behavior: 'smooth', 
                    block: 'start' 
                });
                
                // 等待滾動完成後，再滾動到目標卡片
                setTimeout(() => {
                    targetCard.scrollIntoView({ 
                        behavior: 'smooth', 
                        block: 'center' 
                    });
                }, 500); // 延遲 500ms 確保第一次滾動完成
            } else {
                // 手機版或找不到容器：直接滾動到目標卡片並置中，不要讓按鈕貼齊頂端
                targetCard.scrollIntoView({ 
                    behavior: 'smooth', 
                    block: 'center' 
                });
                if (isMobile480) {
                    console.log('📱 手機版面：直接置中卡片，不滾動容器到頂端');
                }
            }
            
            // 6. 3 秒後自動恢復
            setTimeout(() => {
                document.querySelectorAll('.event-card').forEach(card => {
                    card.classList.remove('highlight-target', 'dimmed');
                });
                document.querySelectorAll('.event-chip').forEach(chip => {
                    chip.classList.remove('highlight-source');
                });
            }, 3000);
        };

