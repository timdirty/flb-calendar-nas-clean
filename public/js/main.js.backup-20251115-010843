        // 🎉 假日資料管理
        let holidaysCache = null;
        let holidaysCacheTime = 0;
        const HOLIDAYS_CACHE_DURATION = 24 * 60 * 60 * 1000; // 24 小時快取
        
        /**
         * 載入假日資料
         */
        async function loadHolidays() {
            const now = Date.now();
            
            // 如果快取有效，直接返回
            if (holidaysCache && (now - holidaysCacheTime < HOLIDAYS_CACHE_DURATION)) {
                return holidaysCache;
            }
            
            try {
                const response = await fetch('/api/holidays');
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                
                const result = await response.json();
                
                if (result.success && result.data) {
                    holidaysCache = result.data;
                    holidaysCacheTime = now;
                    console.log(`✅ [假日] 已載入假日資料 (${result.count} 個假日)`);
                    return holidaysCache;
                }
                
                throw new Error('假日資料格式錯誤');
            } catch (error) {
                console.error('❌ [假日] 載入假日資料失敗:', error);
                
                // 如果有本地快取，返回快取
                if (holidaysCache) {
                    console.log('⚠️ [假日] 使用快取資料');
                    return holidaysCache;
                }
                
                // 返回空資料
                return {
                    holidays: [],
                    enabledDates: [],
                    year: new Date().getFullYear(),
                    customHolidays: []
                };
            }
        }
        
        /**
         * 檢查指定日期是否為假日
         * @param {string} dateStr - 日期字串 (YYYY-MM-DD)
         * @returns {object|null} 假日資訊或 null
         */
        function isHoliday(dateStr) {
            if (!holidaysCache || !holidaysCache.holidays) {
                return null;
            }
            
            return holidaysCache.holidays.find(h => h.date === dateStr) || null;
        }
        
        /**
         * 取得假日名稱的縮寫
         * @param {string} name - 假日完整名稱
         * @returns {string} 縮寫名稱
         */
        function getHolidayShortName(name) {
            // 常見假日的縮寫對應
            const shortNames = {
                '中華民國開國紀念日': '開國',
                '農曆除夕': '除夕',
                '春節': '春節',
                '和平紀念日': '和平',
                '兒童節': '兒童',
                '民族掃墓節': '清明',
                '清明節': '清明',
                '勞動節': '勞動',
                '端午節': '端午',
                '軍人節': '軍人',
                '中秋節': '中秋',
                '教師節': '教師',
                '國慶日': '國慶',
                '光復節': '光復',
                '行憲紀念日': '行憲'
            };
            
            // 嘗試完整匹配
            if (shortNames[name]) {
                return shortNames[name];
            }
            
            // 嘗試部分匹配
            for (const [full, short] of Object.entries(shortNames)) {
                if (name.includes(full)) {
                    return short;
                }
            }
            
            // 如果名稱很長，取前兩個字
            if (name.length > 4) {
                return name.substring(0, 2);
            }
            
            return name;
        }
        
        // 🎓 同步提取教案信息（使用全域快取的課程類別配置）
        // 🎨 為未知課程類別生成顏色
        function generateCourseColor(courseName) {
            const colors = [
                '#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7', 
                '#DFE6E9', '#A29BFE', '#FD79A8', '#FDCB6E', '#6C5CE7',
                '#00B894', '#E17055', '#74B9FF', '#A29BFE', '#FF7675'
            ];
            // 使用課程名稱的字符碼生成一個穩定的索引
            let hash = 0;
            for (let i = 0; i < courseName.length; i++) {
                hash = courseName.charCodeAt(i) + ((hash << 5) - hash);
            }
            return colors[Math.abs(hash) % colors.length];
        }

