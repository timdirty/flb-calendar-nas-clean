            console.log(`🚀 開始分批渲染 ${eventsToRender.length} 個課程，共 ${totalBatches} 批 (批次大小: ${BATCH_SIZE}, 延遲: ${BATCH_DELAY}ms, 設備: ${isMobile480 ? '手機480' : isMobile768 ? '平板768' : '電腦'})`);
            
            // 清空容器
            container.innerHTML = '';
            
            // 使用 DocumentFragment 提高效能
            async function renderBatch() {
                const start = currentBatch * BATCH_SIZE;
                const end = Math.min(start + BATCH_SIZE, eventsToRender.length);
                const batchEvents = eventsToRender.slice(start, end);
                
                // 計算渲染進度（50% 到 100%）
                const progress = 50 + Math.round((currentBatch / totalBatches) * 50);
                
                console.log(`📦 渲染第 ${currentBatch + 1}/${totalBatches} 批 (${start}-${end}), 進度: ${progress}%`);
                
