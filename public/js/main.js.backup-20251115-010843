        // 從標題解析時間
        function parseTimeFromTitle(title) {
            // 匹配格式如 "18:30-20:30", "14:30-15:30", "16:30-17:30", "1630-1730" 等
            const timeMatch = title.match(/(\d{1,2}):?(\d{2})-(\d{1,2}):?(\d{2})/);
            if (timeMatch) {
                const startHour = timeMatch[1];
                const startMin = timeMatch[2];
                const endHour = timeMatch[3];
                const endMin = timeMatch[4];
                
                // 格式化時間為 HH:MM 格式
                const startTime = `${startHour.padStart(2, '0')}:${startMin}`;
                const endTime = `${endHour.padStart(2, '0')}:${endMin}`;
                
                return {
                    startTime: startTime,
                    endTime: endTime,
                    timeString: `${startTime} - ${endTime}`
                };
            }
            return null;
        }

        // 從標題解析日期（根據星期幾）
        function parseDateFromTitle(title, baseDate = new Date()) {
            // 直接使用 CalDAV 的日期，不重新計算
            // 因為 CalDAV 已經提供了正確的日期
            return baseDate;
        }

        // 計算週次（ISO 8601 標準）
        function getWeekNumber(date) {
            const target = new Date(date.valueOf());
            const dayNr = (date.getDay() + 6) % 7;
            target.setDate(target.getDate() - dayNr + 3);
            const firstThursday = target.valueOf();
            target.setMonth(0, 1);
            if (target.getDay() !== 4) {
                target.setMonth(0, 1 + ((4 - target.getDay()) + 7) % 7);
            }
            return 1 + Math.ceil((firstThursday - target) / 604800000);
        }

        // 獲取星期幾（中文）
        function getWeekday(date) {
            const weekdays = ['星期日', '星期一', '星期二', '星期三', '星期四', '星期五', '星期六'];
            return weekdays[date.getDay()];
        }
        
        // 檢查是否為停課/請假
        function isCancelled(event) {
            const title = event.title.toLowerCase();
            const description = (event.description || '').toLowerCase();
            const cancelledKeywords = [
                '請假', '停課', '取消', '暫停', '休息', '放假',
                'cancelled', 'cancel', 'off', 'break', 'holiday',
                '停班', '休課', '不上課', '課程取消', '課程暫停'
            ];
            
            return cancelledKeywords.some(keyword => 
                title.includes(keyword) || description.includes(keyword)
            );
        }

        // 檢查是否為代課/帶班課程
        function isSubstitute(event) {
            const title = event.title || '';
            const description = event.description || '';
            
            const substituteKeywords = ['代課', '帶班', '代理', '支援'];
            
            return substituteKeywords.some(keyword => 
                title.includes(keyword) || description.includes(keyword)
            );
        }

        // 獲取代課/帶班信息
        function getSubstituteInfo(event) {
            const title = event.title || '';
            const description = event.description || '';
            
            // 從標題中提取代課信息
            const titleMatch = title.match(/\[(代課|帶班|代理|支援)\]([^\[\]]+)/);
            if (titleMatch) {
                return {
                    type: titleMatch[1],
                    originalInstructor: titleMatch[2].trim()
                };
            }
            
            // 從描述中提取代課信息
            const descMatch = description.match(/\[(代課|帶班|代理|支援)\]([^\[\]]+)/);
            if (descMatch) {
                return {
                    type: descMatch[1],
                    originalInstructor: descMatch[2].trim()
                };
            }
            
            return null;
        }

        // 檢查是否為體驗課程
        function isExperience(event) {
            if (!event || !event.title) return false;
            
            const title = event.title || '';
            const description = event.description || '';
            
            // 更精確的體驗關鍵字檢測，避免誤判
            const experienceKeywords = ['體驗'];
            
            return experienceKeywords.some(keyword => 
                title.includes(keyword) || description.includes(keyword)
            );
        }

        // 獲取體驗信息
        function getExperienceInfo(event) {
            if (!isExperience(event)) return null;
            
            const title = event.title || '';
            const description = event.description || '';
            
            // 從標題中提取體驗信息
            const titleMatch = title.match(/\[(體驗|體)\]([^\[\]]+)/);
            if (titleMatch) {
                return {
                    type: titleMatch[1]
                };
            }
            
            // 從描述中提取體驗信息
            const descMatch = description.match(/\[(體驗|體)\]([^\[\]]+)/);
            if (descMatch) {
                return {
                    type: descMatch[1]
                };
            }
            
            // 如果沒有方括號格式，檢查是否包含關鍵字
            if (title.includes('體驗')) {
                return { type: '體驗' };
            } else if (title.includes('體')) {
                return { type: '體' };
            }
            
            return null;
        }

        // 檢查是否為改時間課程
        function isMakeup(event) {
            if (!event || !event.title) return false;
            
            const title = event.title || '';
            const description = event.description || '';
            
            // 改時間關鍵字檢測
            const makeupKeywords = ['調課', '延後', '提前', '改時間'];
            
            return makeupKeywords.some(keyword => 
                title.includes(keyword) || description.includes(keyword)
            );
        }

        // 獲取改時間信息
        function getMakeupInfo(event) {
            if (!isMakeup(event)) return null;
            
            const title = event.title || '';
            const description = event.description || '';
            
            // 從標題中提取改時間信息
            const titleMatch = title.match(/\[(調課|延後|提前|改時間)\]([^\[\]]+)/);
            if (titleMatch) {
                return {
                    type: titleMatch[1]
                };
            }
            
            // 從描述中提取改時間信息
            const descMatch = description.match(/\[(調課|延後|提前|改時間)\]([^\[\]]+)/);
            if (descMatch) {
                return {
                    type: descMatch[1]
                };
            }
            
            // 如果沒有方括號格式，檢查是否包含關鍵字
            const makeupKeywords = ['調課', '延後', '提前', '改時間'];
            for (const keyword of makeupKeywords) {
                if (title.includes(keyword)) {
                    return { type: keyword };
                }
            }
            
            return null;
        }

        // 創建課程卡片
        async function createEventCard(event) {
            // 檢查課程是否為 null 或 undefined
            if (!event) {
                console.error('❌ createEventCard: 課程為 null 或 undefined');
                return '';
            }
            
            // 檢查必要屬性是否存在
            if (!event.start || !event.end || !event.title || !event.instructor) {
                console.error('❌ createEventCard: 課程缺少必要屬性', event);
                return '';
            }
            
            const startDate = new Date(event.start);
            const endDate = new Date(event.end);
            const isCancelledEvent = isCancelled(event);
            
            // 檢測是否為代課/帶班課程
            const isSubstituteEvent = isSubstitute(event);
            const substituteInfo = isSubstituteEvent ? getSubstituteInfo(event) : null;
            
            // 檢測是否為體驗課程
            const isExperienceEvent = isExperience(event);
            const experienceInfo = isExperienceEvent ? getExperienceInfo(event) : null;
            
            // 檢測是否為改時間課程
            const isMakeupEvent = isMakeup(event);
            const makeupInfo = isMakeupEvent ? getMakeupInfo(event) : null;
            
            // 檢測是否為即將到來的課程
            const isUpcomingEventFlag = isUpcomingEvent(event);
            const timeUntilEvent = isUpcomingEventFlag ? getTimeUntilEvent(event) : null;
            
            // 檢測是否為「改時間」特殊事件（為了兼容性保留）
            const isTimeChangeEvent = isMakeupEvent && event.title && event.title.includes('改時間');
            
            // 從標題解析時間
            const titleTime = parseTimeFromTitle(event.title);
            
            // 統一使用 CalDAV 的日期，確保日期正確
            const displayDate = startDate.toLocaleDateString('zh-TW');
            let timeString;
            
            if (isTimeChangeEvent) {
                // 改時間事件：優先使用 CalDAV 的時間（因為 CalDAV 的時間才是正確的）
                timeString = `${startDate.toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false })} - ${endDate.toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false })}`;
            } else if (titleTime) {
                // 一般事件：使用標題解析的時間，但日期使用 CalDAV
                timeString = titleTime.timeString;
            } else {
                // 備用：使用 CalDAV 的時間
                timeString = `${startDate.toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false })} - ${endDate.toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false })}`;
            }
            
            // 📝 提取公告內容
            let announcementText = '';
            const announcementMatch = (event.description || '').match(/公告[：:]\s*(.+?)(?=\n|$)/i);
            if (announcementMatch && announcementMatch[1]) {
                announcementText = announcementMatch[1].trim();
                console.log('📢 發現公告:', {
                    課程: event.title,
                    公告內容: announcementText,
                    描述全文: event.description
                });
            }
            
            // 清理描述內容
            let cleanDescription = event.description || '';
            
            // 移除技術標籤、重複資訊和公告
            cleanDescription = cleanDescription
                .replace(/\[NOTION_SYNC\]/g, '')
                .replace(/公告[：:]\s*.+?(?=\n|$)/gi, '') // 🆕 移除公告文字
                .replace(/時間:.*?講師:/g, '')
                .replace(/講師:.*?TA:/g, '')
                .replace(/TA:.*?第一期:/g, '')
                .replace(/第一期:/g, '')
                .replace(/\s+/g, ' ')
                .trim();
            
            // 🧠 使用智能教案提取函數（改進版）
            let lessonButton = '';
            const lessonInfo = extractLessonInfoSync(event);
            
            if (lessonInfo && lessonInfo.url) {
                // 🔥 智能顯示教案標題：如果類型已經是"教案"，只顯示"教案"，否則顯示"類型教案"
                const lessonLabel = lessonInfo.type === '教案' ? '教案' : `${lessonInfo.type}教案`;
                
                lessonButton = `
                    <div class="lesson-section">
                        <div class="lesson-label">${lessonLabel}</div>
                        <a href="${lessonInfo.url}" target="_blank" 
                           class="lesson-button" 
                           style="background: ${lessonInfo.color}; border-color: ${lessonInfo.color};">
                            <i class="fas fa-book"></i> ${lessonInfo.name}
                        </a>
                    </div>
                `;
            }
            
        // 處理位置資訊
        let location = event.location;
        if (!location || location === 'nan' || location === 'null' || location === '' || location.trim() === '') {
                location = '樂程坊 FunLearnBar';
            }

            // 統一地址為樂程坊 FunLearnBar
            if (location === '站前教室' || location === '台北市中正區開封街1段2號9樓' || location === '台北市中正區開封街一段2號9樓') {
                location = '樂程坊 FunLearnBar';
            }

            // 🔥 講師底色 - 從 teacher_data.json 載入的顏色
            const instructorColor = instructorColors[event.instructor] || '#667eea';
            const instructorStyle = instructorColors[event.instructor] ? 'custom-color' : '';

            const derivedCourseType = parseCourseType(event.title || '');
            const courseTopic = extractCourseTopic(event, lessonInfo);
            const escapedEventIdAttr = escapeHtmlAttr(event.id || event.uid || event.evt_id || event._raw?.uid || event._raw?.evt_id || '');
            const escapedEventTitleAttr = escapeHtmlAttr(event.title || '');
            const escapedInstructorAttr = escapeHtmlAttr(event.instructor || '');
            const escapedStartAttr = escapeHtmlAttr(event.start || '');
            const escapedEndAttr = escapeHtmlAttr(event.end || '');
            const escapedCourseTypeAttr = escapeHtmlAttr(derivedCourseType || '');
            const escapedCourseTopicAttr = escapeHtmlAttr(courseTopic || '');
            const escapedLessonUrlAttr = lessonInfo && lessonInfo.url ? escapeHtmlAttr(lessonInfo.url) : '';

            // 🎨 事件外框顏色設定 - 支援自訂顏色
            let borderColor = 'rgba(255, 215, 0, 0.3)'; // 預設金色
            let borderGlowColor = 'rgba(255, 215, 0, 0.2)';
            
            // 如果事件有自訂外框顏色屬性，則使用自訂顏色
            if (event.borderColor) {
                borderColor = event.borderColor;
                // 自動產生較淡的發光顏色
                const rgb = borderColor.match(/\d+/g);
                if (rgb && rgb.length >= 3) {
                    borderGlowColor = `rgba(${rgb[0]}, ${rgb[1]}, ${rgb[2]}, 0.2)`;
                }
            }
            
            // 根據特殊事件類型設定外框顏色
            if (isCancelledEvent) {
                borderColor = 'rgba(220, 53, 69, 0.5)';
                borderGlowColor = 'rgba(220, 53, 69, 0.3)';
            } else if (isSubstituteEvent) {
                borderColor = 'rgba(33, 150, 243, 0.5)';
                borderGlowColor = 'rgba(33, 150, 243, 0.3)';
            } else if (isExperienceEvent) {
                borderColor = 'rgba(255, 215, 0, 0.6)';
                borderGlowColor = 'rgba(255, 215, 0, 0.4)';
            } else if (isMakeupEvent) {
                borderColor = 'rgba(245, 158, 11, 0.5)';
                borderGlowColor = 'rgba(245, 158, 11, 0.3)';
            }
            
            const borderStyle = `--border-color: ${borderColor}; --border-glow-color: ${borderGlowColor};`;
            
            return `
                <div class="event-card ${isCancelledEvent ? 'cancelled-event' : ''} ${isSubstituteEvent ? 'substitute-event' : ''} ${isExperienceEvent ? 'experience-event' : ''} ${isMakeupEvent ? 'makeup-event' : ''} ${isUpcomingEventFlag ? 'upcoming-event' : ''} ${isTimeChangeEvent ? 'time-change-event' : ''}"
                     style="${borderStyle}"
                     data-event-id="${escapedEventIdAttr}"
                     data-event-title="${escapedEventTitleAttr}"
                     data-event-instructor="${escapedInstructorAttr}"
                     data-event-start="${escapedStartAttr}"
                     data-event-end="${escapedEndAttr}"
                     data-event-course-type="${escapedCourseTypeAttr}"
                     data-event-topic="${escapedCourseTopicAttr}"
                     data-event-lesson-url="${escapedLessonUrlAttr}">
                    
                    ${announcementText ? `
                    <div class="announcement-note" title="點擊展開完整公告">
                        <span class="announcement-note-icon">📢</span>
                        <span class="announcement-note-content">${announcementText}</span>
                    </div>
                    ` : ''}
                    
                    <div class="event-header">
                        <div>
                            <div class="event-title">
                                ${event.title}
                                ${isCancelledEvent ? '<span class="cancelled-badge"><i class="fas fa-ban"></i> ⚠️ 停課 ⚠️</span>' : ''}
                                ${isExperienceEvent && experienceInfo ? `<span class="experience-badge"><i class="fas fa-star"></i> ${experienceInfo.type}</span>` : ''}
                                ${isMakeupEvent && makeupInfo ? `<span class="makeup-badge"><i class="fas fa-calendar-plus"></i> ${makeupInfo.type}</span>` : ''}
                                ${isUpcomingEventFlag ? `<span class="upcoming-badge"><i class="fas fa-clock"></i> 即將上課</span>` : ''}
                            </div>
                            <div class="event-instructor ${instructorStyle}" style="--instructor-color: ${instructorColor}">
                                <i class="fas fa-user"></i> ${event.instructor}
                            </div>
                        </div>
                    </div>
                    
                    <div class="event-details">
                        <div class="event-detail">
                            <i class="fas fa-calendar"></i>
                            <span>${displayDate} (${getWeekday(startDate)}, 第${getWeekNumber(startDate)}週)</span>
                        </div>
                        <div class="event-detail ${isTimeChangeEvent ? 'time-change-highlight' : ''}">
                            <i class="fas fa-clock"></i>
                            <span class="${isTimeChangeEvent ? 'time-change-text' : ''}">${timeString}</span>
                            ${isTimeChangeEvent ? '<span class="time-change-icon">⏰</span>' : ''}
                        </div>
                        <div class="event-detail">
                            <i class="fas fa-map-marker-alt"></i>
                            <a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}" 
                               target="_blank" 
                               class="location-link"
                               title="點擊查看地圖">
                                <i class="fas fa-map-marked-alt location-map-icon"></i>
                                <span>${location}</span>
                                <i class="fas fa-external-link-alt location-external-icon"></i>
                            </a>
                        </div>
                    </div>
                    
                    <div class="countdown-timer" 
                         data-start-time="${event.start}" 
                         data-end-time="${event.end}">
                        <i class="fas fa-clock countdown-icon"></i>
                        <span class="countdown-text">計算中...</span>
                    </div>
                    
                    <div class="event-description">
                        <h4><i class="fas fa-info-circle"></i> 課程描述</h4>
                        <p>${cleanDescription || '無描述'}</p>
                    </div>
                    
                    ${lessonButton}
                    
                    <!-- 長按提示 -->
                    <div class="long-press-hint" style="
                        text-align: center; 
                        margin-top: 10px; 
                        font-size: 0.75rem; 
                        color: rgba(51, 51, 51, 0.6);
                        opacity: 0;
                        transition: opacity 0.3s ease;
                    ">
                        <i class="fas fa-hand-pointer"></i> 長按1.5秒進行簽到<br>
                        <small style="font-size: 0.6rem; color: rgba(51, 51, 51, 0.4);">
                            0.5秒集氣 → 1秒預載 → 1.5秒開啟
                        </small>
                        <small style="font-size: 0.65rem; color: rgba(51, 51, 51, 0.5);">
                            <i class="fas fa-hand-paper"></i> 移動手指可取消
                        </small>
                    </div>
                </div>
            `;
        }

        // 🆕 載入課程類別配置（用於 renderEventCard）
        let courseCategoriesCache = null;
        let courseCategoriesCacheTime = 0;
        // 🔥 從 sessionStorage 讀取 API 狀態，避免重複請求
        let courseApiAvailable = sessionStorage.getItem('courseApiAvailable') === 'true' ? true : 
                                 sessionStorage.getItem('courseApiAvailable') === 'false' ? false : null;
        const COURSE_CATEGORIES_CACHE_DURATION = 5 * 60 * 1000; // 5 分鐘快取
        
        async function loadCourseCategoriesForRendering() {
            const now = Date.now();
            
            // 如果快取有效，直接返回
            if (courseCategoriesCache && (now - courseCategoriesCacheTime < COURSE_CATEGORIES_CACHE_DURATION)) {
                window.courseCategoriesCache = courseCategoriesCache; // 🔥 同步到全域變數
                return courseCategoriesCache;
            }
            
            // 🔥 如果已知 API 不可用，直接使用 localStorage
            if (courseApiAvailable === false) {
                const saved = localStorage.getItem('flb_course_categories_config');
                if (saved) {
                    courseCategoriesCache = JSON.parse(saved);
                    courseCategoriesCacheTime = now;
                    window.courseCategoriesCache = courseCategoriesCache; // 🔥 同步到全域變數
                    console.log('✅ 從 localStorage 載入課程類別配置（已知 API 不可用）');
                    return courseCategoriesCache;
                }
                // 使用預設值
                courseCategoriesCache = getDefaultCourseCategoriesForRendering();
                courseCategoriesCacheTime = now;
                window.courseCategoriesCache = courseCategoriesCache; // 🔥 同步到全域變數
                return courseCategoriesCache;
            }
            
            try {
                // 嘗試從後端載入（僅在首次或 API 狀態未知時）
                const response = await fetch('/api/course-categories-config');
                
                // 🔥 如果 API 不存在（404），從 localStorage 讀取
                if (!response.ok) {
                    courseApiAvailable = false;
                    sessionStorage.setItem('courseApiAvailable', 'false'); // 持久化狀態
                    console.warn('⚠️ 後端 API 不存在，切換為 localStorage 模式');
                    const saved = localStorage.getItem('flb_course_categories_config');
                    if (saved) {
                        courseCategoriesCache = JSON.parse(saved);
                        courseCategoriesCacheTime = now;
                        window.courseCategoriesCache = courseCategoriesCache; // 🔥 同步到全域變數
                        console.log('✅ 從 localStorage 載入課程類別配置');
                        return courseCategoriesCache;
                    }
                    throw new Error('localStorage 無配置');
                }
                
                const result = await response.json();
                
                if (result.success && result.data) {
                    courseApiAvailable = true;
                    sessionStorage.setItem('courseApiAvailable', 'true'); // 持久化狀態
                    courseCategoriesCache = result.data;
                    courseCategoriesCacheTime = now;
                    window.courseCategoriesCache = courseCategoriesCache; // 🔥 同步到全域變數
                    console.log('✅ 從後端載入課程類別配置');
                    return courseCategoriesCache;
                } else {
                    throw new Error('後端無配置');
                }
            } catch (error) {
                courseApiAvailable = false;
                sessionStorage.setItem('courseApiAvailable', 'false'); // 持久化狀態
                console.warn('⚠️ 載入課程類別配置失敗，切換為 localStorage 模式:', error);
                
                // 嘗試從 localStorage 讀取
                const saved = localStorage.getItem('flb_course_categories_config');
                if (saved) {
                    courseCategoriesCache = JSON.parse(saved);
                    courseCategoriesCacheTime = now;
                    window.courseCategoriesCache = courseCategoriesCache; // 🔥 同步到全域變數
                    console.log('✅ 從 localStorage 載入課程類別配置（備用）');
                    return courseCategoriesCache;
                }
                
                // 使用預設值
                console.warn('⚠️ 使用預設課程類別配置');
                courseCategoriesCache = getDefaultCourseCategoriesForRendering();
                courseCategoriesCacheTime = now;
                window.courseCategoriesCache = courseCategoriesCache; // 🔥 同步到全域變數
                return courseCategoriesCache;
            }
        }
        
        // 獲取預設課程類別（用於 renderEventCard）
        // 🎨 顏色已統一使用 course-viewer API 定義 (https://course-viewer.funlearnbar.synology.me/api/course-colors)
        // 🔥 動態引用 COURSE_TYPE_COLORS，確保與 API 同步
        function getDefaultCourseCategoriesForRendering() {
            return [
                { id: 'esm', name: 'ESM', keyword: 'ESM教案', color: COURSE_TYPE_COLORS.ESM || '#FFB3D9', enabled: true },
                { id: 'spm', name: 'SPM', keyword: 'SPM教案', color: COURSE_TYPE_COLORS.SPM || '#FFA726', enabled: true },
                { id: 'spike', name: 'SPIKE', keyword: 'SPIKE教案', color: COURSE_TYPE_COLORS.SPIKE || '#FFD54F', enabled: true },
                { id: 'boost', name: 'BOOST', keyword: 'BOOST教案', color: COURSE_TYPE_COLORS.BOOST || '#4FC3F7', enabled: true },
                { id: 'ev3', name: 'EV3', keyword: 'EV3教案', color: COURSE_TYPE_COLORS.EV3 || '#66BB6A', enabled: true },
                { id: 'minecraft', name: 'MINECRAFT', keyword: 'MINECRAFT教案', color: COURSE_TYPE_COLORS.MINECRAFT || '#8BC34A', enabled: true },
                { id: 'scratch', name: 'SCRATCH', keyword: 'Scratch教案', color: COURSE_TYPE_COLORS.SCRATCH || '#FF6B6B', enabled: true }
            ];
        }

        function highlightEventInList(event, eventId) {
            const eventsContainer = document.getElementById('eventsContainer');
            if (eventsContainer) {
                eventsContainer.style.display = '';
            }

            // 使用安全的屬性匹配方式查找卡片
            let card = null;
            document.querySelectorAll('.event-card').forEach(c => {
                if (c.getAttribute('data-event-id') === eventId) {
                    card = c;
                }
            });
            
            if (!card) {
                console.warn('⚠️ highlightEventInList: 找不到對應的課程卡片', eventId);
                return;
            }

            console.log('🎯 highlightEventInList: 滑到並點亮課程卡片', eventId);
            
            // 手機版面（480px）：初次載入後卡片會置中，但不需要後續滾動
            const isMobile480 = window.innerWidth <= 480;
            const shouldScroll = !isMobile480 || !window.hasScrolledToCardOnce;
            
            if (shouldScroll) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (isMobile480) {
                    window.hasScrolledToCardOnce = true;
                    console.log('📱 手機版面：初次滾動完成，後續不再自動滾動');
                }
            } else {
                console.log('📱 手機版面：跳過後續滾動，僅高亮顯示');
            }
            
            card.classList.add('highlight-from-calendar');
            setTimeout(() => card.classList.remove('highlight-from-calendar'), 2000);

            if (typeof handleEventCardSelect === 'function') {
                handleEventCardSelect(event, card);
            }
        }

        // 更新統計信息
        function updateStats() {
            // 獲取當前篩選條件
            const instructorFilter = document.getElementById('instructorSelect').value;
            const timeFilter = document.getElementById('timeFilter').value;
            const dateFilter = document.getElementById('dateFilter').value;
            
            // 先過濾掉 null 值
            let filteredEvents = allEvents.filter(event => {
                if (!event) return false;
                if (!event.start || !event.end || !event.title || !event.instructor) return false;
                return true;
            });
            
            // 應用講師篩選
            if (instructorFilter) {
                filteredEvents = filteredEvents.filter(event => event.instructor === instructorFilter);
            }
            
            // 應用時段篩選
                if (timeFilter) {
                filteredEvents = filteredEvents.filter(event => {
                    const eventDate = new Date(event.start);
                    const hour = eventDate.getHours();
                    switch (timeFilter) {
                        case 'morning':
                            return hour >= 6 && hour < 12;
                        case 'afternoon':
                            return hour >= 12 && hour < 18;
                        case 'evening':
                            return hour >= 18 && hour < 24;
                        default:
                            return true;
                    }
                });
                }
                
            // 應用指定日期篩選
                if (dateFilter) {
                filteredEvents = filteredEvents.filter(event => {
                    const eventDate = new Date(event.start);
                    const filterDate = new Date(dateFilter);
                    return eventDate.getFullYear() === filterDate.getFullYear() &&
                           eventDate.getMonth() === filterDate.getMonth() &&
                           eventDate.getDate() === filterDate.getDate();
                });
            }
            
            // 應用視圖篩選（今日/本週/本月/全部）
                const now = new Date();
            filteredEvents = filteredEvents.filter(event => {
                const eventDate = new Date(event.start);
                
                switch (currentView) {
                    case '今日':
                        return eventDate.getFullYear() === now.getFullYear() &&
                               eventDate.getMonth() === now.getMonth() &&
                               eventDate.getDate() === now.getDate();
                    case '本週':
                        // 🔥 使用時間工具模組統一處理台北時區
                        const TimeUtils = window.TaipeiTimeUtils || {
                            getWeekStartInTaipei: (date) => {
                                const d = date || new Date();
                                const weekStart = new Date(d);
                                weekStart.setDate(d.getDate() - d.getDay());
                                weekStart.setHours(0, 0, 0, 0);
                                return weekStart;
                            },
                            getDateEndInTaipei: (date) => {
                                const d = date instanceof Date ? date : new Date(date);
                                d.setHours(23, 59, 59, 999);
                                return d;
                            },
                            isEventInDateRangeInTaipei: (event, rangeStart, rangeEnd) => {
                                if (!event || !event.start) return false;
                                const eventStart = new Date(event.start);
                                const eventEnd = event.end ? new Date(event.end) : eventStart;
                                return (eventStart <= rangeEnd && eventEnd >= rangeStart);
                            }
                        };
                        
                        // 🔥 使用 specialEventsState.currentViewDate 以支援週次導覽
                        // 🔥 本週視圖：從本週日到本週六（7天，不是8天）
