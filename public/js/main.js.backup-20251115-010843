        // 動畫管理器 - 優化動畫性能
        class AnimationManager {
            constructor() {
                this.animations = new Map();
                this.isPageVisible = true;
                this.rafId = null;
                this.performanceMode = false;
                this.frameCount = 0;
                this.lastFpsTime = 0;
                this.fps = 60;
                this.throttleMap = new Map();
                this.init();
            }
            
            init() {
                // 監聽頁面可見性變化
                document.addEventListener('visibilitychange', () => {
                    this.isPageVisible = !document.hidden;
                    if (this.isPageVisible) {
                        this.resumeAnimations();
                    } else {
                        this.pauseAnimations();
                    }
                });
                
                // 監聽設備性能
                this.detectDevicePerformance();
            }
            
            detectDevicePerformance() {
                // 檢測設備性能
                const canvas = document.createElement('canvas');
                const gl = canvas.getContext('webgl') || canvas.getContext('experimental-webgl');
                const isLowEnd = !gl || (navigator.hardwareConcurrency && navigator.hardwareConcurrency <= 2);
                
                // 檢測記憶體使用情況（安全檢查，Firefox 不支援）
                let isMemoryConstrained = false;
                try {
                    if (performance.memory && performance.memory.jsHeapSizeLimit) {
                        const memoryUsage = performance.memory.usedJSHeapSize / performance.memory.jsHeapSizeLimit;
                        isMemoryConstrained = memoryUsage > 0.8;
                        console.log(`💾 記憶體使用率: ${(memoryUsage * 100).toFixed(1)}%`);
                    }
                } catch (e) {
                    console.log('ℹ️ 此瀏覽器不支援 performance.memory');
                }
                
                // 檢測 Windows 平台（通常效能較弱）
                const isWindows = navigator.platform.toLowerCase().includes('win');
                
                // 檢測觸控設備（可能是平板或低效能裝置）
                const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
                
                // Windows 或低端設備預設啟用效能模式
                if (isWindows || isLowEnd || isMemoryConstrained) {
                    console.log('🔋 檢測到需要優化的環境，啟用性能優化模式');
                    console.log(`   - Windows: ${isWindows}`);
                    console.log(`   - 低端設備: ${isLowEnd}`);
                    console.log(`   - 記憶體受限: ${isMemoryConstrained}`);
                    this.enablePerformanceMode();
                }
                
                // 僅在有動畫時才啟動FPS監控（不要一直運行）
                this.fpsMonitoringEnabled = false;
            }
            
            startFpsMonitoring() {
                // 如果已經在監控，不要重複啟動
                if (this.fpsMonitoringEnabled) return;
                
                this.fpsMonitoringEnabled = true;
                this.fpsRafId = null;
                
                const checkFps = () => {
                    // 如果禁用監控，停止
                    if (!this.fpsMonitoringEnabled) {
                        this.fpsRafId = null;
                        return;
                    }
                    
                    this.frameCount++;
                    const now = performance.now();
                    
                    if (now - this.lastFpsTime >= 1000) {
                        this.fps = this.frameCount;
                        this.frameCount = 0;
                        this.lastFpsTime = now;
                        
                        // 如果FPS過低，啟用性能模式
                        if (this.fps < 30 && !this.performanceMode) {
                            console.log(`🔋 FPS過低 (${this.fps})，啟用性能優化模式`);
                            this.enablePerformanceMode();
                        } else if (this.fps > 50 && this.performanceMode) {
                            // FPS 恢復良好，可以考慮關閉效能模式
                            console.log(`✅ FPS已恢復 (${this.fps})，但保持效能模式以確保穩定性`);
                        }
                        
                        // 如果沒有動畫且效能良好，3秒後停止FPS監控以節省資源
                        if (this.animations.size === 0 && this.fps > 45) {
                            setTimeout(() => {
                                if (this.animations.size === 0) {
                                    console.log('💤 無動畫運行，停止FPS監控以節省資源');
                                    this.stopFpsMonitoring();
                                }
                            }, 3000);
                        }
                    }
                    
                    this.fpsRafId = requestAnimationFrame(checkFps);
                };
                
                this.fpsRafId = requestAnimationFrame(checkFps);
            }
            
            stopFpsMonitoring() {
                this.fpsMonitoringEnabled = false;
                if (this.fpsRafId) {
                    cancelAnimationFrame(this.fpsRafId);
                    this.fpsRafId = null;
                }
            }
            
            enablePerformanceMode() {
                if (this.performanceMode) return; // 避免重複啟用
                
                this.performanceMode = true;
                console.log('⚡ 啟用效能優化模式：');
                
                // 1. 大幅減少動畫時間
                document.documentElement.style.setProperty('--animation-duration', '0.15s');
                document.documentElement.style.setProperty('--transition-duration', '0.1s');
                console.log('   ✓ 減少動畫時間');
                
                // 2. 禁用陰影和模糊效果
                document.documentElement.style.setProperty('--box-shadow', 'none');
                document.documentElement.style.setProperty('--text-shadow', 'none');
                document.documentElement.style.setProperty('--filter-blur', '0');
                console.log('   ✓ 禁用陰影和模糊效果');
                
                // 3. 使用 transform 代替 position 變化（GPU加速）
                document.documentElement.style.setProperty('--use-transform', '1');
                
                // 4. 減少動畫頻率
                this.animations.forEach((animation, id) => {
                    if (animation.interval < 32) { // 低於30fps的動畫
                        animation.interval = 32; // 限制到30fps
                    }
                });
                console.log('   ✓ 限制動畫頻率到30fps');
                
                // 5. 禁用非關鍵動畫
                const nonCriticalAnimations = Array.from(this.animations.keys()).filter(id => 
                    id.includes('particle') || id.includes('confetti') || id.includes('sparkle')
                );
                nonCriticalAnimations.forEach(id => this.removeAnimation(id));
                if (nonCriticalAnimations.length > 0) {
                    console.log(`   ✓ 移除 ${nonCriticalAnimations.length} 個非關鍵動畫`);
                }
                
                // 6. 啟用 CSS containment（改善渲染效能，僅針對卡片內容）
                try {
                    const cards = document.querySelectorAll('.event-card, .calendar-day');
                    cards.forEach(card => {
                        // 使用較溫和的 containment，不影響互動
                        card.style.contain = 'layout style';
                    });
                    console.log(`   ✓ 啟用 CSS containment (${cards.length} 個元素)`);
                } catch (e) {
                    // 某些瀏覽器可能不支援
                }
                
                // 7. 減少重繪
                document.body.classList.add('performance-mode');
                console.log('   ✓ 套用效能優化 CSS 類別');
                
