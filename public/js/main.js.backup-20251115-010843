        // 🔥 執行星期搜尋（內部函數）- 返回成功/失敗狀態
        function performWeekdaySearch(weekday) {
            console.log('🔍 執行搜尋星期:', weekday);
            
            // 🔥 檢測設備類型
            const isMobile = window.innerWidth <= 768;
            const isLIFF = typeof liff !== 'undefined';
            
            // 獲取所有課程卡片
            const eventCards = document.querySelectorAll('.event-card');
            
            if (eventCards.length === 0) {
                console.log('⚠️ 沒有找到任何課程卡片');
                return false;
            }
            
            console.log(`📱 設備資訊: ${isMobile ? '手機' : '電腦'}端${isLIFF ? ' (LIFF環境)' : ''}, 共 ${eventCards.length} 張卡片`);
            
            // 搜尋包含該星期的課程卡片
            let targetCard = null;
            let foundCount = 0;
            
            for (const card of eventCards) {
                // 檢查卡片是否可見（未被篩選隱藏）
                if (card.style.display === 'none') continue;
                
                // 在卡片中搜尋日期資訊
                const dateElement = card.querySelector('.event-date');
                const timeElement = card.querySelector('.event-time');
                
                // 檢查日期或時間元素中是否包含星期文字
                if (dateElement && dateElement.textContent.includes(weekday)) {
                    if (!targetCard) targetCard = card;
                    foundCount++;
                }
                if (!targetCard && timeElement && timeElement.textContent.includes(weekday)) {
                    targetCard = card;
                    foundCount++;
                }
                
                // 🔥 也檢查整個卡片的文字內容
                if (!targetCard && (card.textContent.includes(`星期${weekday}`) || card.textContent.includes(`(${weekday})`))) {
                    targetCard = card;
                    foundCount++;
                }
                
                // 找到第一個就停止
                if (targetCard) break;
            }
            
            if (targetCard) {
                console.log(`🎯 找到星期${weekday}的課程 (共 ${foundCount} 筆符合)`);
                
                // 🔥 手機端 LIFF 環境使用 instant 行為（更穩定）
                const scrollBehavior = (isMobile && isLIFF) ? 'instant' : 'smooth';
                console.log(`📜 滾動模式: ${scrollBehavior}`);
                
                // 🔥 滾動到目標卡片
                try {
                    targetCard.scrollIntoView({
                        behavior: scrollBehavior,
                        block: 'center',
                        inline: 'nearest'
                    });
                    
                    // 🔥 手機端 LIFF 需要額外延遲後再次確認滾動位置
                    if (isMobile && isLIFF) {
                        setTimeout(() => {
                            targetCard.scrollIntoView({
                                behavior: 'instant',
                                block: 'center',
                                inline: 'nearest'
                            });
                        }, 100);
                    }
                } catch (e) {
                    console.warn('⚠️ scrollIntoView 失敗，使用替代方案:', e);
                    // 替代方案：手動滾動
                    const cardTop = targetCard.getBoundingClientRect().top;
                    const windowHeight = window.innerHeight;
                    const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                    const targetScrollTop = scrollTop + cardTop - (windowHeight / 2) + (targetCard.offsetHeight / 2);
                    
                    window.scrollTo({
                        top: targetScrollTop,
                        behavior: scrollBehavior
                    });
                }
                
                // 🔥 高亮顯示目標卡片（短暫效果）
                targetCard.style.transition = 'all 0.3s ease';
                targetCard.style.transform = 'scale(1.05)';
                targetCard.style.boxShadow = '0 8px 32px rgba(184, 134, 11, 0.5)';
                
                setTimeout(() => {
                    targetCard.style.transform = '';
                    targetCard.style.boxShadow = '';
                }, 1000);
                
                console.log(`✅ 已滾動到星期${weekday}的課程 (${isMobile ? '手機' : '電腦'}端)`);
                showToast(`📍 已導航到星期${weekday}`, 'success');
                return true; // 🔥 返回成功
            } else {
                console.log(`❌ 沒有找到星期${weekday}的課程 (檢查了 ${eventCards.length} 張卡片)`);
                // 🔥 只在最後一次嘗試時才顯示警告訊息（由呼叫者決定）
                return false; // 🔥 返回失敗
            }
        }
        
        // 🆕 更新懸浮星期導航顯示狀態（智能篩選版）
        function updateFloatingWeekdayNav() {
            const weekdayNav = document.getElementById('floatingWeekdayNav');
            if (!weekdayNav) return;
            
            // 🔥 始終顯示星期導航
            weekdayNav.style.display = 'flex';
            
            // 🔥 智能篩選：根據當前講師有課的星期，顯示/隱藏對應按鈕
            const instructorFilter = document.getElementById('instructorSelect')?.value || '';
            
            if (!instructorFilter || instructorFilter === '所有講師') {
                // 未選擇特定講師，顯示所有星期按鈕
                const weekdayButtons = weekdayNav.querySelectorAll('.floating-weekday-btn');
                weekdayButtons.forEach(btn => {
                    btn.style.display = '';
                    btn.style.opacity = '1';
                    btn.disabled = false;
                });
                console.log('📅 星期導航：顯示所有星期（未篩選講師）');
                return;
            }
            
            // 🔥 計算本週範圍
            const today = new Date();
            const startOfWeek = new Date(today);
            const dayOfWeek = today.getDay();
            startOfWeek.setDate(today.getDate() - dayOfWeek); // 本週週日
            startOfWeek.setHours(0, 0, 0, 0);
            
            const endOfWeek = new Date(startOfWeek);
            endOfWeek.setDate(startOfWeek.getDate() + 7); // 下週日
            endOfWeek.setHours(23, 59, 59, 999);
            
            // 🔥 檢查該講師在「本週日 → 下週日（8天）」各天是否有課
            const msPerDay = 24 * 60 * 60 * 1000;
            const dayIndexHasCourse = new Set(); // 0..7
            
            allEvents.forEach(event => {
                if (!event || !event.start) return;
                if (event.instructor !== instructorFilter) return;
                const eventDate = new Date(event.start);
                if (eventDate < startOfWeek || eventDate > endOfWeek) return;
                const diff = Math.floor((new Date(eventDate.getFullYear(), eventDate.getMonth(), eventDate.getDate()) - startOfWeek) / msPerDay);
                if (diff >= 0 && diff <= 7) {
                    dayIndexHasCourse.add(diff);
                }
            });
            
            console.log(`📅 講師「${instructorFilter}」在本週8天的索引有課:`, Array.from(dayIndexHasCourse).sort());
            
            // 🔥 更新按鈕顯示狀態（支援 data-week-index 0..7）
            const weekdayButtons = weekdayNav.querySelectorAll('.floating-weekday-btn');
            weekdayButtons.forEach(btn => {
                const idxAttr = btn.getAttribute('data-week-index');
                if (idxAttr !== null) {
                    const idx = parseInt(idxAttr, 10);
                    const visible = dayIndexHasCourse.has(idx);
                    btn.style.display = visible ? '' : 'none';
                    btn.style.opacity = visible ? '1' : '0.5';
                    btn.disabled = !visible;
                } else {
                    // 向後相容：根據星期文字顯示（0..6），多顆「日」都會一起顯示
                    const weekdayMap = { '日': 0, '一': 1, '二': 2, '三': 3, '四': 4, '五': 5, '六': 6 };
                    const weekdayText = btn.getAttribute('data-weekday');
                    const weekdayNum = weekdayMap[weekdayText];
                    const visible = dayIndexHasCourse.has(weekdayNum);
                    btn.style.display = visible ? '' : 'none';
