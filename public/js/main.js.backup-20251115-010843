            }
        }
        
        /**
         * 設置搜尋結果點擊事件委派
         * 使用事件委派可以避免 DOM 重新渲染後事件監聽器失效的問題
         */
        function setupSearchResultClickDelegation() {
            console.log('🔗 設置搜尋結果點擊事件委派...');
            
            // 在容器級別監聽點擊事件（包含日曆容器）
            const containerIds = [
                'eventsContainer',          // 主要事件容器（課程卡片）
                'todayEventsContainer',     // 今日事件容器
                'calendarContainer',        // 日曆容器（event-chip）
            ];
            
            let successCount = 0;
            
            containerIds.forEach(containerId => {
                const container = document.getElementById(containerId);
                
                if (!container) {
                    console.warn(`   ⚠️ 找不到容器 #${containerId}`);
                    return;
                }
                
                // 移除舊的監聽器（如果有）
                container.removeEventListener('click', handleSearchResultClick, true);
                
                // 添加新的監聽器（使用捕獲階段確保優先執行）
                container.addEventListener('click', handleSearchResultClick, true);
                
                console.log(`   ✅ 已在容器 #${containerId} 設置事件委派`);
                successCount++;
            });
            
            console.log(`✅ 事件委派設置完成: ${successCount}/${containerIds.length} 個容器`);
        }
        
        /**
         * 處理搜尋結果點擊（事件委派處理器）
         * @param {Event} e - 點擊事件
         */
        function handleSearchResultClick(e) {
            // 找到最近的事件元素（卡片或方塊）
            const eventElement = e.target.closest('.event-card, .today-event-card, .event-chip');
            
            if (!eventElement) return;
            
            // 檢查是否是搜尋結果
            const isSearchResult = eventElement.getAttribute('data-search-result') === 'true';
            
            if (!isSearchResult) return;
            
            // 檢查是否點擊了按鈕或互動元素
            const isInteractiveElement = 
                e.target.closest('button') || 
                e.target.closest('.attendance-btn') || 
                e.target.closest('.student-btn') ||
                e.target.closest('.btn') ||
                e.target.closest('a[href]') ||
                e.target.closest('input') ||
                e.target.closest('select') ||
                e.target.tagName === 'BUTTON' ||
                e.target.tagName === 'A' ||
                e.target.tagName === 'INPUT' ||
                e.target.tagName === 'SELECT';
            
            if (isInteractiveElement) {
                console.log('ℹ️ 點擊了互動元素，不觸發搜尋導航');
                return;
            }
            
            console.log('🎯 [事件委派] 檢測到搜尋結果點擊!');
            console.log('   元素類型:', eventElement.className);
            
            // 阻止事件繼續傳播和預設行為（避免與其他點擊事件衝突）
            e.stopPropagation();
            e.preventDefault();
            
            // 方法1: 從 data-search-event 屬性讀取（推薦）
            let fullEvent = null;
            const searchEventData = eventElement.getAttribute('data-search-event');
            
            if (searchEventData) {
                try {
                    fullEvent = JSON.parse(searchEventData);
                    console.log('   ✅ 從 data-search-event 讀取事件資料');
                } catch (error) {
                    console.warn('   ⚠️ 解析 data-search-event 失敗:', error);
                }
            }
            
            // 方法2: 從元素屬性中取得（備用）
            if (!fullEvent) {
                const eventId = eventElement.getAttribute('data-event-id');
                const eventTitle = eventElement.getAttribute('data-event-title');
                const eventInstructor = eventElement.getAttribute('data-event-instructor');
                const eventStart = eventElement.getAttribute('data-event-start');
                
                if (!eventId || !eventStart) {
                    console.error('❌ 事件資訊不完整，無法導航');
                    console.error('   ID:', eventId, 'Start:', eventStart);
                    return;
                }
                
                fullEvent = {
                    id: eventId,
                    title: eventTitle || '(無標題)',
                    instructor: eventInstructor,
                    start: eventStart
                };
                
                console.log('   ✅ 從卡片屬性構建事件物件');
            }
            
            // 方法3: 從事件列表中查找完整資料（補充資訊）
            const eventId = fullEvent.id;
            let completeEvent = null;
            
            // 優先從搜尋結果中查找
            if (window.filteredEvents && window.filteredEvents.length > 0) {
                completeEvent = window.filteredEvents.find(evt => 
                    evt.id === eventId || 
                    evt.uid === eventId || 
                    evt.evt_id === eventId
                );
            }
            
            // 如果沒找到，從所有事件中查找
            if (!completeEvent && window.allEvents) {
                completeEvent = window.allEvents.find(evt => 
                    evt.id === eventId || 
                    evt.uid === eventId || 
                    evt.evt_id === eventId
                );
            }
            
            // 合併資料（優先使用完整事件的資料）
            if (completeEvent) {
                fullEvent = {
                    ...fullEvent,
                    ...completeEvent
                };
                console.log('   ✅ 已合併完整事件資料');
            }
            
            console.log('   📊 最終事件物件:', {
                id: fullEvent.id,
                title: fullEvent.title,
                instructor: fullEvent.instructor,
                start: fullEvent.start
            });
            
            console.log('   🚀 開始導航...');
            
            // 調用導航函數
            try {
                navigateToEvent(fullEvent, {
                    source: 'search-click',
                    forceInstructorSelection: true
                });
            } catch (error) {
                console.error('❌ 導航失敗:', error);
                showToast(`❌ 跳轉失敗: ${error.message}`, 'error');
            }
        }
        
        /**
         * 高亮顯示搜尋結果
         * @param {Object} event - 要高亮的事件物件
         * @param {number} index - 當前結果索引
         */
        function highlightSearchResult(event, index, isManualNavigation = false) {
