        // 配色說明面板動態渲染
        function renderColorLegend() {
            // 🔥 獲取當前篩選條件
            const instructorFilter = document.getElementById('instructorSelect')?.value || '';
            const timeFilter = document.getElementById('timeFilter')?.value || '';
            const dateFilter = document.getElementById('dateFilter')?.value || '';

            // 🔥 獲取當前顯示的事件（根據篩選條件和視圖）
            let filteredEvents = allEvents.filter(event => {
                if (!event || !event.start || !event.end || !event.title || !event.instructor) return false;

                // 講師篩選
                if (instructorFilter && event.instructor !== instructorFilter) {
                    return false;
                }

                // 時段篩選
                if (timeFilter) {
                    const eventDate = new Date(event.start);
                    const hour = eventDate.getHours();
                    let timeMatch = false;
                    
                    switch (timeFilter) {
                        case 'morning':
                            timeMatch = hour >= 6 && hour < 12;
                            break;
                        case 'afternoon':
                            timeMatch = hour >= 12 && hour < 18;
                            break;
                        case 'evening':
                            timeMatch = hour >= 18 && hour < 24;
                            break;
                        default:
                            timeMatch = true;
                    }
                    
                    if (!timeMatch) return false;
                }

                // 指定日期篩選
                if (dateFilter) {
                    const eventDate = new Date(event.start);
                    const filterDate = new Date(dateFilter);
                    const eventYear = eventDate.getFullYear();
                    const eventMonth = eventDate.getMonth();
                    const eventDay = eventDate.getDate();
                    const filterYear = filterDate.getFullYear();
                    const filterMonth = filterDate.getMonth();
                    const filterDay = filterDate.getDate();
                    
                    if (eventYear !== filterYear || eventMonth !== filterMonth || eventDay !== filterDay) {
                        return false;
                    }
                }

                // 視圖篩選
                const eventDate = new Date(event.start);
                const now = new Date();
                
                let shouldShow = false;
                switch (currentView) {
                    case '今日':
                        const eventYear = eventDate.getFullYear();
                        const eventMonth = eventDate.getMonth();
                        const eventDay = eventDate.getDate();
                        const nowYear = now.getFullYear();
                        const nowMonth = now.getMonth();
                        const nowDay = now.getDate();
                        shouldShow = eventYear === nowYear && eventMonth === nowMonth && eventDay === nowDay;
                        break;
                    case '本週':
                        // 🔥 使用時間工具模組統一處理台北時區
                        const TimeUtilsFilter = window.TaipeiTimeUtils || {
                            getWeekStartInTaipei: (date) => {
                                const d = date || new Date();
                                const weekStart = new Date(d);
                                weekStart.setDate(d.getDate() - d.getDay());
                                weekStart.setHours(0, 0, 0, 0);
                                return weekStart;
                            },
                            getDateEndInTaipei: (date) => {
                                const d = date instanceof Date ? date : new Date(date);
                                d.setHours(23, 59, 59, 999);
                                return d;
                            },
                            isEventInDateRangeInTaipei: (event, rangeStart, rangeEnd) => {
                                if (!event || !event.start) return false;
                                const eventStart = new Date(event.start);
                                const eventEnd = event.end ? new Date(event.end) : eventStart;
                                return (eventStart <= rangeEnd && eventEnd >= rangeStart);
                            }
                        };
                        
                        // 🔥 使用 specialEventsState.currentViewDate 而不是 now，以支援週次導覽
                        // 🔥 本週視圖：從本週日到本週六（7天，不是8天）
                        const baseDate = specialEventsState.currentViewDate || now;
                        const weekStart = TimeUtilsFilter.getWeekStartInTaipei(baseDate); // 本週週日
                        const weekEnd = TimeUtilsFilter.getDateEndInTaipei(new Date(weekStart.getTime() + 6 * 24 * 60 * 60 * 1000)); // 本週週六
                        
                        shouldShow = TimeUtilsFilter.isEventInDateRangeInTaipei(event, weekStart, weekEnd);
                        break;
                    case '本月':
                        // 🔥 使用 specialEventsState.currentViewDate 而不是 now，以支援月份導覽
                        const monthBaseDate = specialEventsState.currentViewDate || now;
                        shouldShow = eventDate.getFullYear() === monthBaseDate.getFullYear() && 
                                   eventDate.getMonth() === monthBaseDate.getMonth();
                        break;
                    case '全部':
                    default:
                        // 🔥 "全部"視圖：如果日曆顯示中，根據日曆選擇的月份過濾
                        const calendarSection = document.getElementById('calendarSection');
                        const isCalendarVisible = calendarSection && calendarSection.style.display !== 'none';
                        
                        if (isCalendarVisible && specialEventsState.currentViewDate) {
                            // 使用日曆當前選擇的月份
                            const calendarYear = specialEventsState.currentViewDate.getFullYear();
                            const calendarMonth = specialEventsState.currentViewDate.getMonth();
                            shouldShow = eventDate.getFullYear() === calendarYear && 
                                       eventDate.getMonth() === calendarMonth;
                            
                            // 🔍 調試日志（僅在第一個事件時輸出，避免過多日志）
                            if (!window._debugLoggedOnce) {
                                console.log('🔍 全部視圖過濾狀態:', {
                                    日曆可見: isCalendarVisible,
                                    當前月份: `${calendarYear}年${calendarMonth + 1}月`,
                                    事件時間: `${eventDate.getFullYear()}年${eventDate.getMonth() + 1}月`,
                                    是否顯示: shouldShow
                                });
                                window._debugLoggedOnce = true;
                            }
                        } else {
                            // 日曆未顯示時，顯示所有課程
                            shouldShow = true;
                        }
                }
                
                return shouldShow;
            });

            // 🔥 提取當前顯示的課程類型
            const displayedCourseTypes = new Set();
            const displayedInstructors = new Set();
            let hasOtherTypes = false; // 🔥 追蹤是否有「其他類別」的課程
            
            filteredEvents.forEach(event => {
                if (event.title) {
                    const type = parseCourseType(event.title);
                    if (type && type !== 'UNKNOWN') {
                        // 🔥 檢查類型是否在 COURSE_TYPE_COLORS 中
                        if (COURSE_TYPE_COLORS && COURSE_TYPE_COLORS[type]) {
                            displayedCourseTypes.add(type);
                        } else {
                            // 🔥 如果類型不在顏色配置中，歸類為「其他類別」
                            hasOtherTypes = true;
                        }
                    } else if (type === 'UNKNOWN') {
                        hasOtherTypes = true; // 🔥 標記有未知類型
                    }
                }
                if (event.instructor) {
                    displayedInstructors.add(event.instructor);
                }
            });

            // 渲染課程類型配色（帶有複選框用於篩選）
            const courseLegend = document.getElementById('courseLegend');
            if (courseLegend && COURSE_TYPE_COLORS) {
                const filteredCourseTypes = Object.entries(COURSE_TYPE_COLORS)
                    .filter(([type]) => displayedCourseTypes.has(type));
                
                let legendHTML = '';
                if (filteredCourseTypes.length > 0) {
                    // 🔥 如果 selectedCourseTypes 是空的，預設全部選中
                    const shouldCheckAll = selectedCourseTypes.size === 0;
                    
                    legendHTML = filteredCourseTypes.map(([type, color]) => {
                        const isChecked = shouldCheckAll || selectedCourseTypes.has(type);
                        return `
                        <div class="legend-item legend-item-with-checkbox">
                            <label class="legend-checkbox-label">
                                <input 
                                    type="checkbox" 
                                    class="legend-checkbox" 
                                    data-course-type="${type}"
                                    ${isChecked ? 'checked' : ''}
                                    onchange="handleCourseTypeCheckboxChange('${type}', this.checked)"
                                >
                                <span class="legend-dot" style="background: ${color};"></span>
                                <span class="legend-text">${type}</span>
                            </label>
                        </div>
                    `;
                    }).join('');
                }
                
                // 🔥 如果有「其他類別」的課程，添加到顯示中（也帶 checkbox）
                if (hasOtherTypes) {
                    const shouldCheckAll = selectedCourseTypes.size === 0;
                    const isChecked = shouldCheckAll || selectedCourseTypes.has('其他類別');
                    legendHTML += `
                        <div class="legend-item legend-item-with-checkbox">
                            <label class="legend-checkbox-label">
                                <input 
                                    type="checkbox" 
                                    class="legend-checkbox" 
                                    data-course-type="其他類別"
                                    ${isChecked ? 'checked' : ''}
                                    onchange="handleCourseTypeCheckboxChange('其他類別', this.checked)"
                                >
                                <span class="legend-dot" style="background: #94a3b8;"></span>
                                <span class="legend-text">其他類別</span>
                            </label>
                        </div>
                    `;
                }
                
                if (legendHTML) {
                    courseLegend.innerHTML = legendHTML;
                } else {
                    courseLegend.innerHTML = '<div class="legend-item" style="color: rgba(51, 51, 51, 0.5); font-size: 0.85rem;">無課程類型</div>';
                }
            }
            
            // 渲染講師配色（只顯示當前篩選出的講師）
            const instructorLegend = document.getElementById('instructorLegend');
            if (instructorLegend && instructorColors) {
                const filteredInstructors = Object.entries(instructorColors)
                    .filter(([name]) => displayedInstructors.has(name));
                
                if (filteredInstructors.length > 0) {
                    instructorLegend.innerHTML = filteredInstructors.map(([name, color]) => `
                        <div class="legend-item">
                            <span class="legend-dot" style="background: ${color};"></span>
                            <span>${name}</span>
                        </div>
                    `).join('');
                } else {
                    instructorLegend.innerHTML = '<div class="legend-item" style="color: rgba(51, 51, 51, 0.5); font-size: 0.85rem;">無講師</div>';
                }
            }

            console.log('🎨 配色面板已更新:', {
                課程類型: Array.from(displayedCourseTypes),
                講師: Array.from(displayedInstructors)
            });
        }

        // ==================== 手機端性能優化 ====================
        const MobileOptimizer = {
            isMobile: /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || window.innerWidth <= 768,
            isLowEnd: (() => {
                const memory = navigator.deviceMemory;
                const cores = navigator.hardwareConcurrency;
                return (memory && memory < 4) || (cores && cores < 4);
            })(),
            
            init() {
                console.log('🔧 設備檢測:', {
                    isMobile: this.isMobile,
                    isLowEnd: this.isLowEnd,
                    memory: navigator.deviceMemory,
                    cores: navigator.hardwareConcurrency,
                    screenWidth: window.innerWidth
                });
                
                if (!this.isMobile && !this.isLowEnd) {
                    console.log('✅ 桌面端高性能設備，不需要額外優化');
                    return;
                }
                
                console.log('🔧 啟動手機端/低端設備優化');
                
                if (this.isLowEnd) this.simplifyAnimations();
                this.optimizeScroll();
                this.optimizeTouchEvents();
            },
            
            simplifyAnimations() {
                const style = document.createElement('style');
                style.id = 'low-end-optimizations';
                style.textContent = `
                    * { animation-duration: 0.25s !important; transition-duration: 0.25s !important; }
                    .glass-effect, .glassmorphism, .liquid-glass { backdrop-filter: blur(8px) !important; -webkit-backdrop-filter: blur(8px) !important; }
                    .event-card, .card, .modal-content { box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15) !important; }
                `;
                document.head.appendChild(style);
                console.log('✅ 已啟用低端設備優化');
            },
            
            optimizeScroll() {
                let scrollTimer;
                const scrollContainers = document.querySelectorAll('[id*="Container"], .scrollable');
                
                scrollContainers.forEach(container => {
                    container.addEventListener('scroll', () => {
                        clearTimeout(scrollTimer);
                        container.classList.add('is-scrolling');
                        scrollTimer = setTimeout(() => container.classList.remove('is-scrolling'), 150);
                    }, { passive: true });
                });
                
                if (!document.getElementById('scroll-optimizations')) {
                    const style = document.createElement('style');
                    style.id = 'scroll-optimizations';
                    style.textContent = `
                        .is-scrolling * { animation-play-state: paused !important; }
                        [id*="Container"], .scrollable { -webkit-overflow-scrolling: touch; scroll-behavior: smooth; }
                    `;
                    document.head.appendChild(style);
                }
                
                console.log('✅ 滾動性能優化已啟用');
            },
            
            optimizeTouchEvents() {
                let lastTouchEnd = 0;
                document.addEventListener('touchend', (e) => {
                    const now = Date.now();
                    if (now - lastTouchEnd <= 300) e.preventDefault();
                    lastTouchEnd = now;
                }, { passive: false });
                
                const style = document.createElement('style');
                style.textContent = `
                    button, .btn, [onclick], [role="button"] {
                        -webkit-tap-highlight-color: rgba(0, 0, 0, 0.1);
                        touch-action: manipulation;
                    }
                `;
                document.head.appendChild(style);
                
                console.log('✅ Touch 事件優化已啟用');
            }
        };

