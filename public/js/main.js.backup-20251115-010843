        // 儲存單筆簽到記錄 - 使用極速簽到 API (Google Sheets API 直連)
        // 🔥 更新：使用極速簽到 API，< 1秒回應
        async function saveAttendanceWithValidation(teacher, course, time, start, end, studentId, studentName, status) {
            const startTime = Date.now();
            
            try {
                const contextFallback = window.currentAttendanceData || {};
                const resolvedStart = start || contextFallback.start || contextFallback.courseStartTime || '';
                const resolvedEnd = end || contextFallback.end || '';
                const resolvedCourseName = contextFallback.originalTitle || course || contextFallback.course || '';
                const resolvedTeacherName = teacher || contextFallback.teacher || '';
                const resolvedTimeText = time || contextFallback.time || '';
                if (!resolvedStart) {
                    throw new Error('缺少課程開始時間，請重新開啟簽到視窗');
                }

                console.log('🚀 提交極速簽到記錄:', { studentName, course: resolvedCourseName, status, courseStartTime: resolvedStart });
                
                // 🎯 使用課程的實際日期，而不是當前日期
                const courseDate = new Date(resolvedStart);
                if (Number.isNaN(courseDate.getTime())) {
                    throw new Error('課程開始時間格式錯誤，請重新載入頁面');
                }
                
                // 🔧 修復：使用本地時間格式化，避免 UTC 轉換導致日期偏移
                const year = courseDate.getFullYear();
                const month = String(courseDate.getMonth() + 1).padStart(2, '0');
                const day = String(courseDate.getDate()).padStart(2, '0');
                const formattedDate = `${year}-${month}-${day}`;
                
                console.log('📅 課程日期（本地時間）:', formattedDate, '(原始值:', resolvedStart, ')');
                
                // 🎯 轉換簽到狀態為記號
                const mark = status === 'present' ? 'V' : status === 'absent' ? 'X' : '假';
                const eventId = contextFallback.eventId || '';
                const courseTopicMeta = contextFallback.courseTopic || '';
                const courseCategoryMeta = contextFallback.courseCategory || parseCourseType(contextFallback.originalTitle || resolvedCourseName) || '';
                const lessonUrlMeta = contextFallback.lessonUrl || '';
                const teacherMeta = resolvedTeacherName;
                const courseTimeMeta = resolvedTimeText;
                
                // 🔥 終極修復：從學生對象獲取原始索引（篩選前在 Google Sheets 中的位置）
                let courseType = null;
                let studentIndex = -1;
                
                // 先從已載入資料獲取課程類型
                if (window.loadedStudentsData && window.loadedStudentsData.course) {
                    courseType = window.loadedStudentsData.course;
                    console.log(`📦 從已載入資料獲取課程類型: ${courseType}`);
                    
                    // 🔥 關鍵修復：使用學生的 originalIndexInSheet（篩選前的原始索引）
                    // window.loadedStudentsData.students 是篩選後的列表（只包含當前時段的學生）
                    // 但每個學生都保存了 originalIndexInSheet 屬性（在 API 完整列表中的位置）
                    const student = window.loadedStudentsData.students.find(s => s.name === studentName);
                    
                    if (student && student.originalIndexInSheet !== undefined && student.originalIndexInSheet >= 0) {
                        studentIndex = student.originalIndexInSheet;  // 使用原始索引
                        console.log(`✅ 找到學生 ${studentName}:`);
                        console.log(`   - 原始索引（API完整列表）: ${studentIndex}`);
                        console.log(`   - Google Sheets 行號: Row ${7 + studentIndex}`);
                        console.log(`   - 篩選後列表中的位置: ${window.loadedStudentsData.students.findIndex(s => s.name === studentName)}`);
                    } else if (student && student.originalIndexInSheet === -1) {
                        console.warn(`⚠️ ${studentName} 是臨時學生（不在 Google Sheets 中），將使用 Fallback 模式`);
                        courseType = null; // 觸發 Fallback 模式
                    } else {
                        console.warn(`⚠️ 在已載入列表中找不到 ${studentName} 或缺少 originalIndexInSheet，將使用 Fallback 模式`);
                        courseType = null; // 觸發 Fallback 模式
                    }
                } else {
                    console.warn('⚠️ 無已載入的課程資料，將使用 Fallback 模式');
                }
                
                // 🚀 準備請求資料
                const requestBody = {
                    studentName: studentName,
                    courseName: resolvedCourseName,
                    date: formattedDate, // 使用課程日期，不是今天的日期
                    mark: mark,
                    teacher: teacherMeta,
                    courseTime: courseTimeMeta,
                    eventId: eventId,
                    courseTopic: courseTopicMeta,
                    courseCategory: courseCategoryMeta,
                    lessonUrl: lessonUrlMeta,
                    courseDisplayName: resolvedCourseName
                };
                
                // 🔥 終極修復 (2025-01-16): 使用 originalIndexInSheet 確保精確定位
                // 解決方案：
                //   1. API /api/students/by-course 返回完整學生列表（25位，順序正確）
                //   2. 前端在篩選前記錄每個學生的 originalIndexInSheet
                //   3. 篩選後只顯示當前時段的學生（例如只有1位）
                //   4. 簽到時使用 originalIndexInSheet（而不是篩選後列表的索引）
                // 效能：快速模式 ~500ms vs Fallback 模式 ~1000-1500ms
                if (courseType && studentIndex >= 0) {
                    requestBody.courseType = courseType;      // 課程類型（例如：SPM、SPIKE）
                    requestBody.studentIndex = studentIndex;  // 🔥 原始索引（篩選前在 API 完整列表中的位置）
                    console.log('🚀 使用快速模式（使用原始索引，精確定位）');
                    console.log(`   課程類型: ${courseType}`);
                    console.log(`   學生姓名: ${studentName}`);
                    console.log(`   原始索引: ${studentIndex} (篩選前在 API 完整列表中的位置)`);
                    console.log(`   目標行號: Row ${7 + studentIndex}`);
                } else {
                    console.log('⚠️ 使用 Fallback 模式（後端重新查詢 Google Sheets）');
                }
                
                // 🚀 發送到極速簽到 API
                const response = await fetch('/api/attendance/fast', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(requestBody)
                });
                
                const responseTime = Date.now() - startTime;
                console.log(`⚡ 極速簽到 API 回應時間: ${responseTime}ms`);
                
                if (!response.ok) {
                    const errorData = await response.json().catch(() => ({}));
                    throw new Error(errorData.error || errorData.message || `HTTP ${response.status}`);
                }
                
                const result = await response.json();
                
                console.log('✅ 極速簽到成功:', result);
                
                // 驗證返回結果
                if (!result.success) {
                    throw new Error(result.error || result.message || '簽到失敗');
                }
                
                // 返回完整的驗證結果（適配極速 API 格式）
                return {
                    success: true,
                    verified: true,
                    recordId: `${studentName}-${course}-${formattedDate}`, // 生成記錄ID
                    studentInfo: result.data,
                    duplicate: false,
                    responseTime: responseTime,
                    performance: result.performance,
                    timestamp: new Date().toISOString()
                };
                
            } catch (error) {
                console.error('❌ 極速簽到失敗:', error);
                
                // 區分錯誤類型
                if (error.name === 'AbortError' || error.message.includes('timeout')) {
                    throw new Error('網絡超時，請檢查連線');
                } else if (error.message.includes('找不到學生') || error.message.includes('STUDENT_NOT_FOUND')) {
                    throw new Error('找不到此學生，請確認學生姓名');
                } else if (error.message.includes('MISSING_PARAMS')) {
                    throw new Error('缺少必要參數');
                } else {
                    throw new Error(error.message || '提交失敗');
                }
            }
        }

