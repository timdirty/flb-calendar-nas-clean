        // 震動回饋函數
        function triggerHapticFeedback(type) {
            // 檢查是否支援震動API
            if (!navigator.vibrate) {
                console.log('📱 設備不支援震動功能');
                return;
            }

            // 檢查是否在手機端
            const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            if (!isMobile) {
                console.log('💻 非手機設備，跳過震動');
                return;
            }

            try {
                switch (type) {
                    case 'start':
                        // 開始集氣：輕微震動
                        navigator.vibrate(30);
                        console.log('📳 震動回饋：開始集氣');
                        break;
                    case 'loading':
                        // 載入中：漸強震動
                        navigator.vibrate([40, 60, 40]);
                        console.log('📳 震動回饋：載入中');
                        break;
                    case 'complete':
                        // 完成：強烈震動
                        navigator.vibrate([80, 50, 80]);
                        console.log('📳 震動回饋：完成');
                        break;
                    case 'release':
                        // 釋放：輕微震動
                        navigator.vibrate(20);
                        console.log('📳 震動回饋：釋放');
                        break;
                    default:
                        // 預設：短震動
                        navigator.vibrate(50);
                        console.log('📳 震動回饋：預設');
                }
            } catch (error) {
                console.warn('📳 震動功能執行失敗:', error);
            }
        }

