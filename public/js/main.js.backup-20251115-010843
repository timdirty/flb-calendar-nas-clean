                            const d = date || new Date();
                            const weekStart = new Date(d);
                            weekStart.setDate(d.getDate() - d.getDay());
                            weekStart.setHours(0, 0, 0, 0);
                            return weekStart;
                        },
                        getDateEndInTaipei: (date) => {
                            const d = date instanceof Date ? date : new Date(date);
                            d.setHours(23, 59, 59, 999);
                            return d;
                        }
                    };
                    
                    // 🔥 使用 specialEventsState.currentViewDate 以顯示正確的週範圍
                    // 🔥 本週視圖：從本週日到下週日（8天）
                    const weekBaseDate = specialEventsState.currentViewDate || now;
                    const weekStart = TimeUtilsRange.getWeekStartInTaipei(weekBaseDate); // 本週週日
                    const weekEnd = TimeUtilsRange.getDateEndInTaipei(new Date(weekStart.getTime() + 7 * 24 * 60 * 60 * 1000)); // 下週日
                    dateRange = `${weekStart.toLocaleDateString('zh-TW', { timeZone: 'Asia/Taipei' })} - ${weekEnd.toLocaleDateString('zh-TW', { timeZone: 'Asia/Taipei' })}`;
                    break;
                case '本月':
