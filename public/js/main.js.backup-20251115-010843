        // 🔥 學生卡片長按事件監聽器（2025-01-16 新增）
        function setupStudentCardLongPressListeners() {
            const studentCards = document.querySelectorAll('.student-card');
            console.log(`🔧 設置學生卡片長按監聽器，找到 ${studentCards.length} 個學生卡片`);
            
            studentCards.forEach((card, index) => {
                const studentName = card.dataset.studentId;
                if (!studentName) return;
                
                let longPressTimer = null;
                let longPressDuration = 800; // 長按800毫秒觸發
                
                // 🔥 移動端：touchstart + touchend
                card.addEventListener('touchstart', function(e) {
                    // 如果點擊的是按鈕，不觸發長按
                    if (e.target.closest('.attendance-btn')) return;
                    
                    console.log(`👆 觸摸開始：${studentName}`);
                    
                    longPressTimer = setTimeout(() => {
                        console.log(`⏰ 長按觸發：${studentName}`);
                        showStudentAttendanceRecordByName(studentName);
                        
                        // 震動反饋（如果支援）
                        if (navigator.vibrate) {
                            navigator.vibrate(50);
                        }
                    }, longPressDuration);
                }, { passive: true });
                
                card.addEventListener('touchend', function(e) {
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                        longPressTimer = null;
                    }
                }, { passive: true });
                
                card.addEventListener('touchmove', function(e) {
                    // 如果手指移動，取消長按
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                        longPressTimer = null;
                    }
                }, { passive: true });
                
                // 🔥 桌面端：右鍵菜單 (contextmenu)
                card.addEventListener('contextmenu', function(e) {
                    // 如果點擊的是按鈕，使用默認行為
                    if (e.target.closest('.attendance-btn')) return;
                    
                    e.preventDefault();
                    console.log(`🖱️ 右鍵點擊：${studentName}`);
                    showStudentAttendanceRecordByName(studentName);
                });
                
                // 🔥 桌面端：長按滑鼠左鍵
                card.addEventListener('mousedown', function(e) {
                    // 只處理滑鼠左鍵
                    if (e.button !== 0) return;
                    // 如果點擊的是按鈕，不觸發長按
                    if (e.target.closest('.attendance-btn')) return;
                    
                    console.log(`🖱️ 滑鼠按下：${studentName}`);
                    
                    longPressTimer = setTimeout(() => {
                        console.log(`⏰ 長按觸發：${studentName}`);
                        showStudentAttendanceRecordByName(studentName);
                    }, longPressDuration);
                });
                
                card.addEventListener('mouseup', function(e) {
                    if (longPressTimer) {
                        clearTimeout(longPressTimer);
                        longPressTimer = null;
