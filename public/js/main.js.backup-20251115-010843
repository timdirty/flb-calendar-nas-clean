        const ATTENDANCE_STATUS_LABELS = {
            present: '✅ 已出席，請繼續完成紀錄',
            leave: '🏥 今日請假，無需簽到',
            absent: '⚠️ 今日缺席，請留意',
            unknown: '🕒 尚未簽到，請儘快更新'
        };

        function resolveStudentAttendanceStatus(student, targetDateKey) {
            const fallback = {
                status: 'unknown',
                message: ATTENDANCE_STATUS_LABELS.unknown,
                record: null
            };
            if (!student || !targetDateKey) return fallback;
            const records = Array.isArray(student.attendance) ? student.attendance : [];
            const matched = records.find(entry => {
                if (!entry) return false;
                let entryKey = '';
                try {
                    if (entry.date instanceof Date) {
                        entryKey = formatDateKey(entry.date);
                    } else if (typeof entry.date === 'number') {
                        entryKey = formatDateKey(new Date(entry.date));
                    } else if (typeof entry.date === 'string') {
                        entryKey = entry.date.trim();
                    }
                } catch (err) {
                    entryKey = '';
                }
                return entryKey === targetDateKey;
            });
            if (!matched) return fallback;
            const presentValue = matched.present;
            if (presentValue === true) {
                return { status: 'present', message: ATTENDANCE_STATUS_LABELS.present, record: matched };
            }
            if (presentValue === false) {
                return { status: 'absent', message: ATTENDANCE_STATUS_LABELS.absent, record: matched };
            }
            if (typeof presentValue === 'string') {
                const normalized = presentValue.toLowerCase();
                if (normalized === 'leave') {
                    return { status: 'leave', message: ATTENDANCE_STATUS_LABELS.leave, record: matched };
                }
                if (normalized === 'absent' || normalized === 'absence') {
                    return { status: 'absent', message: ATTENDANCE_STATUS_LABELS.absent, record: matched };
                }
                if (normalized === 'present') {
                    return { status: 'present', message: ATTENDANCE_STATUS_LABELS.present, record: matched };
                }
            }
            return fallback;
        }

        function annotateStudentsWithAttendance(students, courseDate) {
            if (!Array.isArray(students) || !students.length) return [];
            let dateKey = '';
            try {
                if (courseDate instanceof Date) {
                    dateKey = formatDateKey(courseDate);
                } else if (courseDate) {
                    const parsed = new Date(courseDate);
                    if (!Number.isNaN(parsed.getTime())) {
                        dateKey = formatDateKey(parsed);
                    }
                }
            } catch (err) {
                dateKey = '';
            }
            return students.map(student => {
                const info = dateKey ? resolveStudentAttendanceStatus(student, dateKey) : {
                    status: 'unknown',
                    message: ATTENDANCE_STATUS_LABELS.unknown,
                    record: null
                };
                return Object.assign({}, student, {
                    attendanceStatus: info.status,
                    attendanceMessage: info.message,
                    attendanceRecord: info.record || null
                });
            });
        }

