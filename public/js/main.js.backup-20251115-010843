            // 開始長按計時
            refreshLongPressTimer = setInterval(() => {
                if (!refreshIsLongPressing) {
                    clearInterval(refreshLongPressTimer);
                    return;
                }
                
                const elapsed = Date.now() - refreshLongPressStartTime;
                refreshLongPressProgress = Math.min(elapsed / 3000, 1); // 3秒
                
                // 更新按鈕背景顏色
                const alpha = 0.2 + refreshLongPressProgress * 0.6;
                refreshButton.style.background = `rgba(255, 193, 7, ${alpha})`;
                
                // 更新圓形進度
                const degrees = refreshLongPressProgress * 360;
                progressRing.style.transform = `rotate(${degrees - 90}deg)`;
                progressRing.style.borderTopColor = `rgba(255, 193, 7, ${0.5 + refreshLongPressProgress * 0.5})`;
                progressRing.style.borderRightColor = `rgba(255, 152, 0, ${0.3 + refreshLongPressProgress * 0.7})`;
                
                // 顯示進度百分比
                const percentage = Math.floor(refreshLongPressProgress * 100);
                if (percentage % 20 === 0 && percentage > 0 && percentage < 100) {
                    console.log(`⏱️ 長按進度: ${percentage}%`);
                }
                
                if (refreshLongPressProgress >= 1) {
                    // 長按3秒完成，觸發完全重置
                    clearInterval(refreshLongPressTimer);
                    refreshIsLongPressing = false;
                    
                    // 移除進度環
