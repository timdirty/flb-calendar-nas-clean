        // 簡化版煙火 - 手機專用
        function createSimpleFirework(color) {
            const firework = document.createElement('div');
            firework.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                width: 6px;
                height: 6px;
                background: ${color};
                border-radius: 50%;
                pointer-events: none;
                z-index: 10000;
                transform: translate(-50%, -50%);
                box-shadow: 0 0 20px ${color};
            `;
            
            document.body.appendChild(firework);
            
            // 簡化動畫 - 只有8個粒子
            const particles = 8;
            const angleStep = (Math.PI * 2) / particles;
            
            for (let i = 0; i < particles; i++) {
                const particle = document.createElement('div');
                const angle = angleStep * i;
                const velocity = 30 + Math.random() * 40; // 減少速度
                const lifetime = 800 + Math.random() * 400; // 減少生命週期
                
                particle.style.cssText = `
                    position: fixed;
                    top: 50%;
                    left: 50%;
                    width: 3px;
                    height: 3px;
                    background: ${color};
                    border-radius: 50%;
                    pointer-events: none;
                    z-index: 10000;
                    transform: translate(-50%, -50%);
                    box-shadow: 0 0 8px ${color};
                `;
                
                document.body.appendChild(particle);
                
                // 簡化動畫循環
                const startTime = Date.now();
                const animate = () => {
                    const elapsed = Date.now() - startTime;
                    const progress = elapsed / lifetime;
                    
                    if (progress >= 1) {
                        particle.remove();
                        return;
                    }
                    
                    const x = Math.cos(angle) * velocity * progress;
                    const y = Math.sin(angle) * velocity * progress + (progress * progress * 50); // 簡化重力
                    const opacity = 1 - progress;
                    
                    particle.style.transform = `translate(${x - 1.5}px, ${y - 1.5}px)`;
                    particle.style.opacity = opacity;
                    
                    requestAnimationFrame(animate);
                };
                
                requestAnimationFrame(animate);
            }
            
            // 移除煙火本體
            setTimeout(() => {
                firework.remove();
            }, 100);
        }
        
        function createSingleFirework(color) {
