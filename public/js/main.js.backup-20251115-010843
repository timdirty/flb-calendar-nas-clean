                // 🔥 批量生成 HTML（使用 Promise.all 等待所有 async 函數完成）
                const batchHTMLArray = await Promise.all(batchEvents.map(event => createEventCard(event)));
                const batchHTML = batchHTMLArray.join('');
                tempDiv.innerHTML = batchHTML;
                
                // 將所有子元素移到 fragment
                while (tempDiv.firstChild) {
