                eventCard.classList.add('search-result-highlight');
            }, 2000);
        }
        
        /**
         * 導航到指定課程（自動切換視圖和篩選）
         * @param {Object} event - 課程事件物件
         */
        function navigateToEvent(event, options = {}) {
            if (!event) {
                console.error('❌ navigateToEvent: 事件物件為空');
                return;
            }
            
            console.log('🚀 開始導航到課程:', event.title);
            console.log('📊 完整課程資料:', JSON.stringify(event, null, 2));
            
            // ========== 1. 解析課程日期 ==========
            let eventDate;
            try {
                eventDate = new Date(event.start);
                if (isNaN(eventDate.getTime())) {
                    throw new Error('Invalid date');
                }
            } catch (error) {
                console.error('❌ 無法解析課程日期:', event.start, error);
                showToast('❌ 課程日期格式錯誤', 'error');
                return;
            }
            
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const eventDateKey = formatDateKey(eventDate);
            window.pendingCalendarTargetDate = eventDate.toISOString();
            window.pendingCalendarHighlightDateKey = eventDateKey;
            window.activeCalendarHighlightDateKey = eventDateKey;
            specialEventsState.currentViewDate = new Date(eventDate);
            
            // ========== 2. 判斷應該切換到哪個視圖 ==========
            let targetView = 'all'; // 預設為全部視圖
            const eventDateOnly = new Date(eventDate);
            eventDateOnly.setHours(0, 0, 0, 0);
            
            const normalizedCurrentView = window.currentView || currentView || '本週';
            if (eventDateOnly.getTime() === today.getTime()) {
                targetView = 'today';
                console.log('✅ 課程在今日');
            } else {
                switch (normalizedCurrentView) {
                    case '本週':
                        targetView = 'week';
                        console.log('📅 依據目前視圖：使用週視圖顯示課程');
                        break;
                    case '本月':
                        targetView = 'month';
                        console.log('📅 依據目前視圖：使用月視圖顯示課程');
                        break;
                    case '今日':
                        targetView = 'week';
                        console.log('📅 目前為今日視圖，改用週視圖顯示課程');
                        break;
                    case '全部':
                        targetView = 'all';
                        console.log('📅 依據目前視圖：維持全部視圖');
                        break;
                    default:
                        targetView = 'all';
                        console.log('ℹ️ 未識別的視圖狀態，使用全部視圖');
                }
            }
            
            console.log(`📅 課程日期: ${eventDate.toLocaleDateString('zh-TW')} ${eventDate.toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit' })}`);
            console.log(`🎯 目標視圖: ${targetView}`);
            
            // ========== 3. 提取講師名稱（嘗試多種方式） ==========
            let instructorName = null;
            
            // 方法1: 從事件屬性讀取
            if (event.instructor) {
                instructorName = event.instructor;
                console.log('✅ 從 event.instructor 讀取講師:', instructorName);
            } else if (event.teacher) {
                instructorName = event.teacher;
                console.log('✅ 從 event.teacher 讀取講師:', instructorName);
