        // HTML 屬性轉義函數
        function escapeHtmlAttr(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/\n/g, '&#10;')
                .replace(/\r/g, '&#13;');
        }

        // 週日曆渲染（優化效能）
        function renderWeekCalendar() {
            // 🔥 使用時間工具模組統一處理台北時區
            const TimeUtils = window.TaipeiTimeUtils || {
                getWeekStartInTaipei: (date) => {
                    const d = date || new Date();
                    const weekStart = new Date(d);
                    weekStart.setDate(d.getDate() - d.getDay());
                    weekStart.setHours(0, 0, 0, 0);
                    return weekStart;
                },
                getDateStartInTaipei: (date) => {
                    const d = date instanceof Date ? date : new Date(date);
                    d.setHours(0, 0, 0, 0);
                    return d;
                },
                getDateEndInTaipei: (date) => {
                    const d = date instanceof Date ? date : new Date(date);
                    d.setHours(23, 59, 59, 999);
                    return d;
                },
                formatDateKey: (date) => {
                    const d = date instanceof Date ? date : new Date(date);
                    const year = d.getFullYear();
                    const month = String(d.getMonth() + 1).padStart(2, '0');
                    const day = String(d.getDate()).padStart(2, '0');
                    return `${year}-${month}-${day}`;
                },
                formatDateForDisplay: (date) => {
                    const d = date instanceof Date ? date : new Date(date);
                    return `${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, '0')}/${String(d.getDate()).padStart(2, '0')}`;
                },
                isEventInDateRangeInTaipei: (event, rangeStart, rangeEnd) => {
                    if (!event || !event.start) return false;
                    const eventStart = new Date(event.start);
                    const eventEnd = event.end ? new Date(event.end) : eventStart;
                    return (eventStart <= rangeEnd && eventEnd >= rangeStart);
                },
                isSameDayInTaipei: (date1, date2) => {
                    const formatKey = (date) => {
                        const d = date instanceof Date ? date : new Date(date);
                        const year = d.getFullYear();
                        const month = String(d.getMonth() + 1).padStart(2, '0');
                        const day = String(d.getDate()).padStart(2, '0');
                        return `${year}-${month}-${day}`;
                    };
                    const key1 = formatKey(date1);
                    const key2 = formatKey(date2);
                    return key1 === key2;
                },
                getTodayInTaipei: () => {
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    return today;
                }
            };

            // 🔥 修復：使用時間工具模組獲取本週週日（台北時區）
            const currentDate = specialEventsState.currentViewDate || new Date();
            const startOfWeek = TimeUtils.getWeekStartInTaipei(currentDate);
            
            // 🔥 視圖改為 8 天：本週日 → 下週日
            //    星期標頭改為一橫排「日一二三四五六日」不換行
            const weekDays = ['日', '一', '二', '三', '四', '五', '六', '日']; // 8天（最後一天為下週日）
            const days = [];
            
            // 檢查效能模式
            const isPerformanceMode = window.animationManager && window.animationManager.performanceMode;
            
            for (let i = 0; i < 8; i++) { // 🔥 本週視圖：週日到下週日（8天）
                const day = new Date(startOfWeek);
                day.setDate(startOfWeek.getDate() + i);
                days.push(day);
            }
            
            const titleElem = document.getElementById('calendarTitle');
            if (titleElem) {
                // ✅ 依需求：顯示固定文案「本週 (週日 – 下週日)」
                titleElem.innerHTML = `
                    <i class=\"fas fa-calendar-week\"></i>
                    本週 (週日 – 下週日)
                `;
            }
            
            const container = document.getElementById('calendarView');
            if (!container) return;

            // 先取得篩選後的事件
            const filteredEvents = getFilteredEvents();
            console.log('📅 週日曆渲染 - 使用篩選後的事件數量:', filteredEvents.length);

            container.innerHTML = `
                <div class="calendar-grid calendar-grid-8">
                    ${weekDays.map(day => `<div class="calendar-day-header">${day}</div>`).join('')}
                    ${days.map(day => {
                        // 🔥 使用時間工具模組獲取日期範圍（台北時區）
                        const dayStart = TimeUtils.getDateStartInTaipei(day);
                        const dayEnd = TimeUtils.getDateEndInTaipei(day);
                        
                        // 🔥 使用時間工具模組進行日期範圍比較（台北時區）
                        const dayEvents = filteredEvents.filter(e => {
                            return TimeUtils.isEventInDateRangeInTaipei(e, dayStart, dayEnd);
                        });
                        
                        // 🔥 使用時間工具模組比較是否為今天（台北時區）
                        const today = TimeUtils.getTodayInTaipei ? TimeUtils.getTodayInTaipei() : new Date();
