        function getNextAutoRefreshTime() {
            if (!autoRefreshInterval || !autoRefreshStartTime) {
                return '自動刷新未啟動';
            }
            
            const elapsed = Date.now() - autoRefreshStartTime;
            const remaining = (30 * 1000) - (elapsed % (30 * 1000));
            const nextTime = new Date(Date.now() + remaining);
            
            const minutes = Math.floor(remaining / 60000);
            const seconds = Math.floor((remaining % 60000) / 1000);
            
            return {
                nextTime: nextTime.toLocaleTimeString('zh-TW'),
                remaining: `${minutes} 分 ${seconds} 秒`,
                remainingMs: remaining
            };
