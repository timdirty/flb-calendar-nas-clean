        // 生成出缺勤歷史記錄
        function generateAttendanceHistory(attendance) {
            if (!attendance || attendance.length === 0) {
                return '<div class="no-records">暫無出缺勤紀錄</div>';
            }
            
            // 按日期排序（最新的在前）
            const sortedAttendance = [...attendance].sort((a, b) => {
                const dateA = new Date(a.date || '1900-01-01');
                const dateB = new Date(b.date || '1900-01-01');
                return dateB - dateA;
            });
            
            return sortedAttendance.map(record => {
                const date = record.date || '未知日期';
                const status = record.present === true ? 'present' : 
                              record.present === false ? 'absent' : 
                              record.present === 'leave' ? 'leave' : 'unknown';
                const statusText = record.present === true ? '出席' : 
                                  record.present === false ? '缺席' : 
                                  record.present === 'leave' ? '請假' : '未知';
                const statusIcon = record.present === true ? 'fa-check-circle' : 
                                  record.present === false ? 'fa-times-circle' : 
                                  record.present === 'leave' ? 'fa-user-clock' : 'fa-question-circle';
                
                return `
                    <div class="attendance-record-item ${status}">
                        <div class="record-date">${date}</div>
                        <div class="record-status">
                            <i class="fas ${statusIcon}"></i>
                            <span>${statusText}</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

