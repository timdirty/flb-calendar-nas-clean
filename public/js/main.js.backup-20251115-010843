        // 🎨 從後端載入講師顏色配置
        async function loadTeacherColorsFromBackend() {
            try {
                console.log('🎨 開始從後端載入講師顏色...');
                const response = await fetch('/api/teachers');
                const data = await response.json();
                
                if (data.success && data.data && data.data.teachers) {
                    const teachers = data.data.teachers;
                    console.log('✅ 成功獲取講師資料:', teachers);
                    
                    // 將後端的顏色資料填充到 instructorColors
                    teachers.forEach(teacher => {
                        if (teacher.color && teacher.name) {
                            instructorColors[teacher.name] = teacher.color;
                            console.log(`✅ 載入講師 ${teacher.name} 的顏色: ${teacher.color}`);
                        }
                    });
                    
                    console.log('✅ 講師顏色載入完成:', instructorColors);
                    
                    // 🔄 若課程已載入，立即重新渲染以套用後端顏色設定
                    if (Array.isArray(allEvents) && allEvents.length > 0) {
                        console.log('🎨 檢測到課程資料已載入，重新渲染以套用講師顏色');
                        renderEvents();
                    }
                    return true;
                } else {
                    console.warn('⚠️ 後端沒有返回講師顏色資料');
                    return false;
                }
            } catch (error) {
                console.error('❌ 從後端載入講師顏色失敗:', error);
                return false;
            }
        }

