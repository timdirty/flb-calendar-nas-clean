                        // 顯示本週所有課程，包括已過期的（只要開始時間或結束時間在本週內）
                        return TimeUtils.isEventInDateRangeInTaipei(event, weekStart, weekEnd);
                    case '本月':
                        // 🔥 使用 specialEventsState.currentViewDate 以支援月份導覽
                        const monthBaseDate = specialEventsState.currentViewDate || now;
                        return eventDate.getFullYear() === monthBaseDate.getFullYear() &&
                               eventDate.getMonth() === monthBaseDate.getMonth();
                    case '全部':
                    default:
