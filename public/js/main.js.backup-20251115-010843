        // 更新所有倒數計時（🔥 優化：只更新可見範圍）
        function updateAllCountdowns() {
            const countdownElements = document.querySelectorAll('.countdown-timer');
            
            // 🔥 效能優化：只更新可見範圍 ± 300px 的倒數計時
            const viewportHeight = window.innerHeight;
            const buffer = 300; // 上下緩衝區域
            let visibleCount = 0;
            let totalCount = countdownElements.length;
            
            countdownElements.forEach(element => {
                // 檢查元素是否在可見範圍內
                const rect = element.getBoundingClientRect();
                const isVisible = rect.top < viewportHeight + buffer && rect.bottom > -buffer;
                
                // 只更新可見範圍的倒數計時
                if (!isVisible) {
                    return; // 跳過不可見的元素
                }
                
                visibleCount++;
                
                const startTime = element.dataset.startTime;
                const endTime = element.dataset.endTime;
                
                if (startTime && endTime) {
                    const countdown = calculateCountdown(startTime, endTime);
                    element.className = `countdown-timer ${countdown.status}`;
                    
                    // 🔥 如果課程已結束，顯示獨立的「上傳學習歷程」按鈕
                    if (countdown.status === 'overdue') {
                        // 獲取課程卡片的 eventId
                        const card = element.closest('.event-card');
                        const eventId = card ? card.dataset.eventId : '';
                        
                        // 🔥 從全域事件列表中查找對應的事件，獲取講師名稱
                        let instructor = '';
                        if (eventId && allEvents && allEvents.length > 0) {
                            const foundEvent = allEvents.find(evt => {
                                const evtId = evt.id || evt.uid || evt.evt_id || '';
                                return evtId === eventId;
