                animationDuration = 0.3;
                animationDelay = 0.04;
                console.log('⚡ 快速動畫模式：課程數量', totalCards, '只動畫前', maxAnimatedCards, '張');
            } else if (totalCards > 50) {
                // 50-100 個：動畫前 20 張
                maxAnimatedCards = 20;
                animationDuration = 0.4;
                animationDelay = 0.05;
                console.log('⚡ 標準動畫模式：課程數量', totalCards, '只動畫前', maxAnimatedCards, '張');
