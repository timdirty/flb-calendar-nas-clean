            }
        }

        // 🔍 自動選擇講師選項（提供搜尋與導航共用）
        function autoSelectInstructor(targetName, reason = '') {
            if (!targetName) {
                console.warn(`⚠️ 自動選擇講師失敗：講師名稱為空${reason ? `（${reason}）` : ''}`);
                return false;
            }

            const instructorSelect = document.getElementById('instructorSelect');

            if (!instructorSelect) {
                console.warn(`⚠️ 自動選擇講師失敗，原因：找不到講師選擇器${reason ? `（${reason}）` : ''}`);
                return false;
            }

            try {
                const options = Array.from(instructorSelect.options || []);

                if (options.length === 0) {
                    console.warn(`⚠️ 自動選擇講師失敗：選項列表為空${reason ? `（${reason}）` : ''}`);
                    return false;
                }

                const matchedOption = options.find(option => {
                    if (!option) return false;
                    const optionText = (option.text || '').trim();
                    const optionValue = (option.value || '').trim();

                    if (!optionText && !optionValue) return false;

                    if (optionText === targetName || optionValue === targetName) {
                        return true;
                    }

                    if (optionText.includes(targetName) || targetName.includes(optionText)) {
                        return true;
                    }

                    if (optionText.replace(/\s+/g, '') === targetName.replace(/\s+/g, '')) {
                        return true;
                    }

                    return false;
                });

                if (matchedOption) {
                    console.log(`🔄 自動選擇講師：「${matchedOption.text.trim()}」${reason ? `（${reason}）` : ''}`);
                    window.isAutoSelectingInstructor = true;
                    instructorSelect.value = matchedOption.value;
                    const changeEvent = new Event('change', { bubbles: true });
                    instructorSelect.dispatchEvent(changeEvent);
                    searchContext.autoSwitchedToAll = false;
                    
                    // 確保標記被重置
                    setTimeout(() => {
                        window.isAutoSelectingInstructor = false;
                    }, 100);
                    
                    return true;
                }

                console.warn(`⚠️ 無法匹配講師：「${targetName}」${reason ? `（${reason}）` : ''}`);
                return false;
            } catch (error) {
                console.error('❌ 自動選擇講師時發生錯誤:', error);
                window.isAutoSelectingInstructor = false;
                return false;
            }
        }

