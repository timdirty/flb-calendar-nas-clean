        // 今日課程區塊渲染（支持回調，確保渲染完成後才執行後續操作）
        function renderTodayEvents(callback) {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const todayStart = today.getTime();
            const todayEnd = todayStart + 86400000;

            // 🔥 獲取當前篩選條件
            const instructorFilter = document.getElementById('instructorSelect')?.value || '';
            const timeFilter = document.getElementById('timeFilter')?.value || '';

            // 🔥 應用篩選條件
            const todayEvents = allEvents.filter(e => {
                if (!e || !e.start) return false;
                
                const eventStart = new Date(e.start).getTime();
                const isToday = eventStart >= todayStart && eventStart < todayEnd;
                if (!isToday) return false;

                // 🔥 講師篩選
                if (instructorFilter && e.instructor !== instructorFilter) {
                    return false;
                }

                // 🔥 課程類型篩選（根據 checkbox 選擇）
                if (selectedCourseTypes.size > 0) {
                    const courseType = parseCourseType(e.title);
                    let displayType;
                    
                    // 🔥 判斷顯示類型
                    if (courseType && courseType !== 'UNKNOWN') {
                        // 檢查類型是否在 COURSE_TYPE_COLORS 中
                        if (COURSE_TYPE_COLORS && COURSE_TYPE_COLORS[courseType]) {
                            displayType = courseType;
                        } else {
                            // 不在顏色配置中的類型，歸類為「其他類別」
                            displayType = '其他類別';
                        }
                    } else {
                        displayType = '其他類別';
                    }
                    
                    if (!selectedCourseTypes.has(displayType)) {
                        return false;
                    }
                }

                // 🔥 時段篩選
                if (timeFilter) {
                    const eventDate = new Date(e.start);
                    const hour = eventDate.getHours();
                    let timeMatch = false;
                    
                    switch (timeFilter) {
                        case 'morning':
                            timeMatch = hour >= 6 && hour < 12;
                            break;
                        case 'afternoon':
                            timeMatch = hour >= 12 && hour < 18;
                            break;
                        case 'evening':
                            timeMatch = hour >= 18 && hour < 24;
                            break;
                        default:
                            timeMatch = true;
                    }
                    
                    if (!timeMatch) return false;
                }

                return true;
            }).sort((a, b) => {
                // 根據 sortDirection 決定排序方向
                const now = new Date();
                const eventA = new Date(a.start);
                const eventB = new Date(b.start);
                const endA = new Date(a.end);
                const endB = new Date(b.end);
                
                // 判斷課程是否正在進行中
                const isEventAOngoing = eventA <= now && endA > now;
                const isEventBOngoing = eventB <= now && endB > now;
                
                // 正在進行中的課程，距離為 0（最優先）
                const distanceA = isEventAOngoing ? 0 : Math.abs(now - eventA);
                const distanceB = isEventBOngoing ? 0 : Math.abs(now - eventB);
                
                // 根據排序方向決定排序
                let result = 0;
                if (distanceA !== distanceB) {
                    result = distanceA - distanceB;
                } else {
                    // 如果距離相同，按開始時間排序
                    result = eventA - eventB;
                }
                
                // 如果是「由遠到近」，反轉結果
                return sortDirection === 'far-to-near' ? -result : result;
            });

            const countElem = document.getElementById('todayCount');
            if (countElem) {
                countElem.textContent = todayEvents.length;
            }

            const grid = document.getElementById('todayEventsGrid');
            if (!grid) {
                // 即使沒有 grid 元素，也要執行回調
                if (callback) {
                    requestAnimationFrame(() => callback());
                }
                return;
            }

            if (todayEvents.length === 0) {
                grid.innerHTML = '<div class="no-events-today">今日沒有課程</div>';
                // 執行回調（無課程情況）
                if (callback) {
                    requestAnimationFrame(() => callback());
                }
                return;
            }

            grid.innerHTML = todayEvents.map(event => {
                const color = getCourseColor(event.title, event.instructor);
                const eventId = event.id || event.uid || event.evt_id || '';
                const startTime = formatTimeForDisplay(event.start);
                const endTime = event.end ? formatTimeForDisplay(event.end) : '';
                const timeRange = endTime ? `${startTime}-${endTime}` : startTime;
                const location = event.location || '';
                
                // 🌟 檢測是否為特殊事件
                const eventSpecialType = detectSpecialEventType(event.title);
                
                // 🎓 提取教案信息（同步版本，使用全域快取）
                const lessonInfo = extractLessonInfoSync(event);
                
                // 🔥 建立包含教案信息的詳細懸浮提示（JSON格式，用於後續渲染）
                const tooltipData = {
                    title: event.title || '未命名課程',
                    timeRange: timeRange,
                    instructor: event.instructor || '未指定講師',
                    specialType: eventSpecialType,
                    location: location,
                    lesson: lessonInfo,
                    eventId: eventId
                };
                
                // 轉義HTML屬性
                const escapedTooltipData = escapeHtmlAttr(JSON.stringify(tooltipData));
                const escapedEventId = escapeHtmlAttr(eventId);
                
                return `
                    <div class="today-event-card" 
                         style="background: ${color};" 
                         data-event-id="${escapedEventId}"
                         data-tooltip-info="${escapedTooltipData}"
                         onclick="if(typeof window.highlightEventCardFromCalendar === 'function') { console.log('🎯 今日課程-點擊課程:', '${escapedEventId}'); window.highlightEventCardFromCalendar('${escapedEventId}'); }">
                        <div class="today-event-time">${startTime}</div>
                        <div class="today-event-info">
