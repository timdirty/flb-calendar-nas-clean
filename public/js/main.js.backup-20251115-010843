            // 重試機制
            async retry(fn, context = null) {
                try {
                    const result = await fn();
                    this.retryCount = 0; // 重置重試計數
                    return result;
                } catch (error) {
                    this.retryCount++;
                    
                    if (this.retryCount <= this.maxRetries) {
                        console.warn(`⚠️ 重試 ${this.retryCount}/${this.maxRetries}:`, error.message);
                        this.showWarning(`正在重試... (${this.retryCount}/${this.maxRetries})`);
                        
                        // 等待後重試
                        await new Promise(resolve => setTimeout(resolve, this.retryDelay * this.retryCount));
                        return this.retry(fn, context);
                    } else {
                        console.error('❌ 重試失敗，已達到最大重試次數:', error);
                        this.showError(`操作失敗，已重試 ${this.maxRetries} 次`);
                        throw error;
                    }
                }
            }

            // 全域錯誤捕獲
            setupGlobalErrorHandling() {
                // 捕獲未處理的Promise錯誤
                window.addEventListener('unhandledrejection', (event) => {
                    console.error('❌ 未處理的Promise錯誤:', event.reason);
                    this.showError('發生未預期的錯誤，請重新整理頁面');
                    event.preventDefault();
                });

                // 捕獲JavaScript錯誤
                window.addEventListener('error', (event) => {
                    console.error('❌ JavaScript錯誤:', event.error);
                    const errorMsg = event.error ? event.error.message : event.message || '未知錯誤';
                    const errorLine = event.lineno ? ` (行 ${event.lineno})` : '';
                    const fullErrorMsg = `JavaScript錯誤${errorLine}: ${errorMsg}`;
                    
                    // 在頁面上顯示錯誤
                    this.showError(fullErrorMsg);
                    
                    // 同時添加到載入日誌（如果存在）
                    if (typeof addLoadingLog === 'function') {
                        addLoadingLog(`❌ ${fullErrorMsg}`, 'error');
                    }
                    
                    // 在頁面頂部顯示明顯的錯誤訊息
                    const errorDiv = document.createElement('div');
                    errorDiv.style.cssText = `
                        position: fixed;
                        top: 0;
                        left: 0;
                        right: 0;
                        background: #f44336;
                        color: white;
                        padding: 15px;
                        z-index: 999999;
                        font-size: 14px;
                        word-break: break-word;
                    `;
                    errorDiv.innerHTML = `
                        <strong>❌ JavaScript 錯誤：</strong><br>
                        ${fullErrorMsg}<br>
                        <small>請截圖此錯誤並回報</small>
                    `;
                    document.body.insertBefore(errorDiv, document.body.firstChild);
                });
            }
        }

