  async function deleteStudentFile(studentName, filename) {
    if (!currentCourse || !studentName || !filename) return false;
    if (!confirm('刪除此檔案？\n' + filename)) return false;
    try {
      var meta = buildRecordOperationMeta(studentName);
      await global.FLB.Api.deleteRecord({
        course: meta.course,
        period: meta.period,
        coursePeriod: meta.coursePeriod,
        date: meta.date,
        studentName: studentName,
        filename: filename,
        relativePath: meta.relativePath
      });
      // ✅ 局部更新：同步快取與目前畫面，不做整頁 reload
      try {
        var st = FLB.State.get();
        var cache = Object.assign({}, st.uploadedRecordsCache || {});
        var list = Array.isArray(cache.students) ? cache.students.slice() : [];
        var idx = list.findIndex(function (x) { return (x.studentName || '') === (studentName || ''); });
        if (idx >= 0) {
          var rec = Object.assign({}, list[idx]);
          var files = Object.assign({ photos: [], videos: [] }, rec.files || {});
          var baseName = String(filename).split('/').pop();
          files.photos = (files.photos || []).filter(function(n){ return !filenamesEqual(n, filename); });
          files.videos = (files.videos || []).filter(function(n){ return !filenamesEqual(n, filename); });
          rec.files = files;
          rec.photos = files.photos.length;
          rec.videos = files.videos.length;
          list[idx] = rec;
          cache.students = list;
          FLB.State.set({ uploadedRecordsCache: cache });
        }
      } catch (e) {}

      // ✅ 參照學生卡邏輯：以 data-filename 掃描節點（不使用 CSS.escape，提升 Safari 相容性）
      try {
        var baseName = String(filename).split('/').pop();
        var sid = encodeURIComponent(studentName || '');
        var drawerRoot = document.getElementById('recordsDrawerContent');
        var lists = [];
        // 列表視圖
        var listItem = document.getElementById('record-item-' + sid);
        if (listItem) lists.push(listItem);
        // 抽屜視圖
        if (drawerRoot) {
          var drawerItem = drawerRoot.querySelector('.record-item[data-student="' + sid + '"]');
          if (drawerItem) lists.push(drawerItem);
        }
        lists.forEach(function (recItem) {
          var previews = recItem.querySelectorAll('.file-previews .file-preview.existing[data-filename]');
          Array.prototype.slice.call(previews).forEach(function (n) {
            var f = n.getAttribute('data-filename') || '';
            if (filenamesEqual(f, filename)) {
              try { if (n.parentNode) n.parentNode.removeChild(n); } catch (e) {}
            }
          });
          // 重算統計
          try {
            var stats = recItem.querySelector('.record-item-stats');
            if (stats) {
              var photosNow = recItem.querySelectorAll('.file-previews .file-preview.existing img').length;
              var videosNow = recItem.querySelectorAll('.file-previews .file-preview.existing video').length;
              stats.innerHTML = '<span><i class="fas fa-camera"></i> ' + photosNow + '</span><span><i class="fas fa-video"></i> ' + videosNow + '</span>';
            }
          } catch (e) {}
        });
      } catch (e) {}

      // 移除學生卡上的縮圖與更新膠囊/指標
      try {
        if (window.FLB && FLB.State) {
          var st2 = FLB.State.get();
          var students = st2.students || [];
          var curIdx = -1;
          try {
            if (window.NormalizeUtils && NormalizeUtils.isSameStudent) {
              curIdx = students.findIndex(function (s) { return NormalizeUtils.isSameStudent(s && s.name, studentName); });
            }
          } catch (e) {}
          if (curIdx < 0) curIdx = students.findIndex(function (s) { return (s && s.name) === studentName; });
          if (curIdx >= 0) {
            var isPhoto = filename.indexOf('photo') !== -1;
            var type = isPhoto ? 'photos' : 'videos';
            var container = document.getElementById(type + '-preview-' + curIdx);
            if (container) {
              var node2 = null;
              var sel = '.file-preview.existing[data-filename]';
              var items = container.querySelectorAll(sel);
              var baseName2 = String(filename).split('/').pop();
              Array.prototype.some.call(items, function (n) { var f = n.getAttribute('data-filename') || ''; if (f === filename || f === baseName2 || f.endsWith('/' + baseName2)) { node2 = n; return true; } return false; });
              if (!node2) {
                try { node2 = document.querySelector('.file-preview.existing[data-filename="' + CSS.escape(filename) + '"]'); } catch (e) {}
              }
              if (node2 && node2.parentNode) { try { node2.parentNode.removeChild(node2); } catch (e) {} }
            }
            // 更新既有計數
            ensureStudentFileEntry(curIdx, students[curIdx]);
            var base = studentFiles[curIdx];
            base.existingCounts = base.existingCounts || { photos: 0, videos: 0, text: 0 };
            if (isPhoto) { base.existingCounts.photos = Math.max(0, (base.existingCounts.photos || 0) - 1); }
            else { base.existingCounts.videos = Math.max(0, (base.existingCounts.videos || 0) - 1); }
            var count = getTotalCount(curIdx, isPhoto ? 'photos' : 'videos');
            var required = isPhoto ? 3 : 1;
            updateIndicator(curIdx, isPhoto ? 'photo' : 'video', count >= required);
            try { updateCapsule(curIdx); } catch (e) {}
            try { renderBottomTabs(); } catch (e) {}
            checkUploadReady(curIdx, { silent: true });
      try { renderDrawerFromState(); } catch (e) {}
      try { updateRecordsFabBadge(); } catch (e) {}
          }
        }
      } catch (e) {}

      showToast('已刪除檔案', 'success');
    } catch (e) {
      console.error('刪除檔案失敗', e);
      showToast('刪除檔案失敗：' + (e.message || ''), 'error');
    }
    return false;
  }

