  // 將後端既有記錄帶入原預覽欄位與評論，並更新指標與計數
  function applyExistingRecordToCard(index, student, uploaded) {
    try {
      var photosPreview = document.getElementById('photos-preview-' + index);
      var videosPreview = document.getElementById('videos-preview-' + index);
      var cmt = document.getElementById('comment-' + index);
      if (!studentFiles[index]) studentFiles[index] = { photos: [], videos: [], comment: '', baselineComment: '' };
      var base = studentFiles[index];
      // 清空暫存（避免重複累積）
      base.photos = [];
      base.videos = [];
      base.comment = uploaded.comment || '';
      base.baselineComment = uploaded.comment || '';
      var existingPhotos = (uploaded.files && Array.isArray(uploaded.files.photos)) ? uploaded.files.photos.slice() : [];
      var existingVideos = (uploaded.files && Array.isArray(uploaded.files.videos)) ? uploaded.files.videos.slice() : [];
      // ✅ 僅渲染伺服器命名規則的檔案（含 photo/video 標記），避免誤用本地原始檔名造成 404
      existingPhotos = existingPhotos.filter(function (fn) { return typeof fn === 'string' && /photo/i.test(fn); });
      existingVideos = existingVideos.filter(function (fn) { return typeof fn === 'string' && /video/i.test(fn); });
      base.existingCounts = { photos: existingPhotos.length, videos: existingVideos.length, text: (uploaded.comment || '').length };
      var preserveNewPhotoNodes = photosPreview ? Array.prototype.slice.call(photosPreview.querySelectorAll('.file-preview.new-upload')) : [];
      var preserveNewVideoNodes = videosPreview ? Array.prototype.slice.call(videosPreview.querySelectorAll('.file-preview.new-upload')) : [];

      if (photosPreview) {
        photosPreview.innerHTML = '';
        existingPhotos.forEach(function (fn) {
          var url = buildRecordFileUrl(uploaded, fn);
          photosPreview.insertAdjacentHTML('beforeend',
            '<div class="file-preview existing preview-clickable lazy" data-filename="' + FLB.Course.escapeHtml(fn) + '" data-preview-type="image" data-preview-url="' + url + '">' +
              '<img data-src="' + url + '" loading="lazy" alt="' + FLB.Course.escapeHtml(fn) + '">' +
              '<button class="remove-btn" title="刪除此照片" onclick="return deleteStudentFile(\'' + (student.name || '') + '\', \'' + String(fn).replace(/'/g, "\\'") + '\')"><i class="fas fa-times"></i></button>' +
            '</div>'
          );
        });
        // 若已有伺服器檔案，移除等待同步臨時縮圖，避免重複
        if (existingPhotos.length > 0) {
          preserveNewPhotoNodes.forEach(function (node) {
            if (node.getAttribute('data-awaiting-sync') === '1') {
              // ✅ 已同步到正式清單：移除臨時縮圖，避免重複
              revokePreviewObjectUrl(node);
              try { if (node.parentNode) node.parentNode.removeChild(node); } catch (e) {}
            } else {
              photosPreview.appendChild(node);
            }
          });
        } else {
          preserveNewPhotoNodes.forEach(function (node) { photosPreview.appendChild(node); });
        }
      }
      if (videosPreview) {
        videosPreview.innerHTML = '';
        existingVideos.forEach(function (fn) {
          var url = buildRecordFileUrl(uploaded, fn);
          var posterCached = videoPosterCache[url] || '';
          videosPreview.insertAdjacentHTML('beforeend',
            '<div class="file-preview existing preview-clickable lazy" data-filename="' + FLB.Course.escapeHtml(fn) + '" data-preview-type="video" data-preview-url="' + url + '">' +
              '<video data-src="' + url + '" preload="none" muted playsinline crossorigin="anonymous"' + (posterCached ? (' poster="' + posterCached + '"') : '') + '></video>' +
              '<img class="video-poster" src="' + (posterCached || '') + '" alt="poster" ' + (posterCached ? '' : 'style="display:none"') + ' />' +
              '<button class="remove-btn" title="刪除此影片" onclick="return deleteStudentFile(\'' + (student.name || '') + '\', \'' + String(fn).replace(/'/g, "\\'") + '\')"><i class="fas fa-times"></i></button>' +
            '</div>'
          );
        });
        if (existingVideos.length > 0) {
          preserveNewVideoNodes.forEach(function (node) {
            if (node.getAttribute('data-awaiting-sync') === '1') {
              revokePreviewObjectUrl(node);
              try { if (node.parentNode) node.parentNode.removeChild(node); } catch (e) {}
            } else {
              videosPreview.appendChild(node);
            }
          });
        } else {
          preserveNewVideoNodes.forEach(function (node) { videosPreview.appendChild(node); });
        }
      }
      // 帶入既存評論（可再編輯）
      if (cmt && (uploaded.comment || '').length) {
        cmt.value = uploaded.comment || '';
        // 觸發一次 input 以同步計數/草稿/指標
        var ev = document.createEvent('Event'); ev.initEvent('input', true, true); cmt.dispatchEvent(ev);
