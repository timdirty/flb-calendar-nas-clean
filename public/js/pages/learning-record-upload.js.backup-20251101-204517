      var ovFiles = Array.prototype.slice.call((photosInput && photosInput.files) || []);
      var images = ovFiles.filter(function(f){ return /^image\//i.test(f.type); });
      var videos = ovFiles.filter(function(f){ return /^video\//i.test(f.type); });
      try {
        var processed = await maybeCompressFiles(images, 'photos');
        processed.forEach(function (f) {
          try { formData.append('overviewPhotos', f, (f && f.name) ? f.name : 'overview.jpg'); }
          catch (e) { formData.append('overviewPhotos', f); }
        });
      } catch (e) {
        images.forEach(function (f) {
          try { formData.append('overviewPhotos', f, (f && f.name) ? f.name : 'overview.jpg'); }
          catch (e2) { formData.append('overviewPhotos', f); }
        });
      }
      videos.forEach(function (f) {
        try { formData.append('videos', f, (f && f.name) ? f.name : 'overview.mp4'); }
        catch (e2) { formData.append('videos', f); }
      });
      // 指示伺服器存放在 課程/課程總覽/ 目錄（由後端決定實作）
      try { var metaPath = buildRecordOperationMeta('課程總覽'); if (metaPath && metaPath.coursePeriod) formData.append('coursePeriod', metaPath.coursePeriod); if (metaPath && metaPath.relativePath) formData.append('relativePath', metaPath.relativePath); } catch (e) {}
      formData.append('overviewFolder', '課程總覽');
      // 使用帶進度的 POST，避免視覺卡死
      incActiveUpload(-1);
      var data = await global.FLB.Api.uploadRecordWithProgress(formData, function (p) {
        try { if (ucTask) UploadCenter.update(-1, 'overview', ucTask.fileIndex || 0, p); } catch (e) {}
        if (!silent && btn) btn.innerHTML = '<span class="loading"></span> 上傳中 ' + Math.max(0, Math.min(100, Math.round(p))) + '%';
      }).finally(function(){ try { decActiveUpload(-1); } catch (e) {} });
      if (!silent && btn) { btn.classList.remove('uploading'); btn.classList.add('success'); btn.innerHTML = '<i class="fas fa-check"></i> 上傳成功'; }
      try { if (ucTask) UploadCenter.done(-1, 'overview', ucTask.fileIndex || 0); } catch (e) {}
      showToast('課程總覽上傳成功！', 'success');
      try { clearOverviewDraft(); } catch (e) {}
      // ✅ 重新載入一次記錄，並加上延遲補抓（處理 NAS 寫入延遲）
      try { await loadUploadedRecordsForCurrentCourse(); } catch (e) {}
      try { schedulePostUploadRefresh(2); } catch (e) {}
      if (!silent && btn) setTimeout(function () { btn.classList.remove('success'); btn.innerHTML = '<i class="fas fa-cloud-upload-alt"></i> 上傳課程總覽'; btn.disabled = false; }, 3000);
    } catch (e) {
      console.error('上傳總覽失敗', e);
      if (!silent && btn) { btn.classList.remove('uploading'); btn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> 上傳失敗，請重試'; btn.disabled = false; }
      try { if (ucTask) UploadCenter.fail(-1, 'overview', ucTask.fileIndex || 0, e && e.message); } catch (e2) {}
      showToast('上傳失敗: ' + (e.message || ''), 'error');
    }
  }

