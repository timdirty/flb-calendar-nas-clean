  // 💤 懶載入：觀察容器中的 img/video，進入可視區才設定 src
  var __lazyObserver = null;
  function setupLazyMedia(root) {
    try {
      var scope = root || document;
      var nodes = scope.querySelectorAll('img[data-src], video[data-src]');
      if (!nodes || nodes.length === 0) return;
      if (!('IntersectionObserver' in window)) {
        // 瀏覽器不支援 IO，直接套用 src（已附 loading="lazy"，仍具一定節省）
        Array.prototype.forEach.call(nodes, function (el) { applyLazySrc(el); });
        return;
      }
      if (!__lazyObserver) {
        __lazyObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              applyLazySrc(el);
              try { __lazyObserver.unobserve(el); } catch (e) {}
            }
          });
        }, { root: null, rootMargin: '1200px 0px', threshold: 0.01 });
      }
      Array.prototype.forEach.call(nodes, function (el) { try { __lazyObserver.observe(el); } catch (e) { applyLazySrc(el); } });
      // 🚀 預先載入最前面的幾個媒體，加速首屏縮圖
      try {
        for (var i = 0; i < Math.min(8, nodes.length); i++) { applyLazySrc(nodes[i]); }
      } catch (e) {}
    } catch (e) { /* 忽略懶載入錯誤 */ }
  }

  function applyLazySrc(el) {
    try {
      var src = el.getAttribute('data-src');
      if (!src) return;
      var wrap = el.closest('.file-preview');
      if (el.tagName === 'IMG') {
        el.setAttribute('src', src);
        el.removeAttribute('data-src');
        el.addEventListener('load', function onLoad() { try { el.removeEventListener('load', onLoad); if (wrap) wrap.classList.remove('lazy'); } catch (e) {} });
      } else if (el.tagName === 'VIDEO') {
        try { el.setAttribute('crossorigin', 'anonymous'); } catch (e) {}
        el.setAttribute('src', src);
        el.setAttribute('preload', 'metadata');
        if (typeof el.load === 'function') el.load();
        el.removeAttribute('data-src');
        var removeLazy = function () {
          try {
            // 僅在已具備 poster 或 readyState 足夠時移除骨架，避免黑屏
            if (wrap && (!el.getAttribute('poster') && !(el.readyState >= 2))) return;
            if (wrap) wrap.classList.remove('lazy');
          } catch (e) {}
        };
        el.addEventListener('loadeddata', function onVD() { try { el.removeEventListener('loadeddata', onVD); removeLazy(); } catch (e) {} });
        // 後備：稍晚再嘗試移除
        setTimeout(removeLazy, 1500);
        try { generateVideoPoster(el); } catch (e) {}
      }
    } catch (e) { /* 略過 */ }
  }

  // 🎞️ 生成影片縮圖（第一幀），加快辨識
  function generateVideoPoster(videoEl) {
    try {
      if (!videoEl || videoEl.tagName !== 'VIDEO') return;
      if (videoEl.__hasPoster) return;
      var capture = function () {
        try {
          var vw = Number(videoEl.videoWidth || 0);
          var vh = Number(videoEl.videoHeight || 0);
          if (!vw || !vh) return;
          // ✅ 維持原始比例：以單一縮放係數限制最長邊，不做雙軸獨立壓縮
          var maxW = 320, maxH = 320; // 目標上限（正方形縮圖）
          var scale = Math.min(maxW / vw, maxH / vh, 1);
          var w = Math.max(1, Math.round(vw * scale));
          var h = Math.max(1, Math.round(vh * scale));
          var canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          var ctx = canvas.getContext('2d');
          ctx.drawImage(videoEl, 0, 0, w, h);
          var data = canvas.toDataURL('image/jpeg', 0.7);
          if (data && data.length > 32) {
            videoEl.setAttribute('poster', data);
            videoEl.__hasPoster = true;
            try {
              var wrap = videoEl.closest('.file-preview');
              var key = videoEl.getAttribute('src') || videoEl.getAttribute('data-src') || (wrap && (wrap.getAttribute('data-preview-url') || wrap.getAttribute('data-filename'))) || '';
              if (key) videoPosterCache[key] = data;
              // 同步覆蓋層 IMG，避免 iOS 忽略 poster 導致黑屏/變形
              if (wrap) {
                var overlay = wrap.querySelector('img.video-poster');
                if (!overlay) {
                  try {
                    var img = document.createElement('img');
                    img.className = 'video-poster';
                    img.alt = 'poster';
                    img.src = data;
                    wrap.appendChild(img);
                  } catch (e) {}
                } else {
                  overlay.src = data;
                  overlay.style.display = 'block';
                }
              }
            } catch (e) {}
          }
        } catch (e) {}
      };
      if (videoEl.readyState >= 2) {
        capture();
      } else {
        var tryMeta = function () { try { videoEl.removeEventListener('loadedmetadata', tryMeta); capture(); } catch (e) {} };
        var tryData = function () { try { videoEl.removeEventListener('loadeddata', tryData); capture(); } catch (e) {} };
        videoEl.addEventListener('loadedmetadata', tryMeta);
        videoEl.addEventListener('loadeddata', tryData);
        // ⏱️ 最後兜底：稍後再嘗試一次
        setTimeout(capture, 500);
      }
    } catch (e) {}
  }
