  async function uploadStudentRecord(studentIndex) {
    var student = currentCourse && currentCourse.students && currentCourse.students[studentIndex];
    var btn = document.getElementById('upload-btn-' + studentIndex);
    if (!student || !currentCourse) return;
    // 🛡️ 若背景批次觸發，可能沒有對應的按鈕 DOM，這裡提供安全替身避免例外
    if (!btn) {
      btn = { classList: { add: function(){}, remove: function(){}, contains: function(){ return false; } }, disabled: false, innerHTML: '' };
    }
    if (uploadingStudents[studentIndex]) return;
    if (!hasPendingChanges(studentIndex) && !btn.disabled) return;
    
    // 🔒 檢查重試次數上限
    if (!uploadRetryCount[studentIndex]) uploadRetryCount[studentIndex] = 0;
    if (uploadRetryCount[studentIndex] >= MAX_UPLOAD_RETRIES) {
      console.error('❌ 學生', student.name, '已達到重試上限', MAX_UPLOAD_RETRIES, '次，停止自動上傳');
      btn.classList.add('error');
      btn.innerHTML = '<i class="fas fa-ban"></i> 已達重試上限，請檢查網路';
      btn.disabled = true;
      showToast(student.name + ' 上傳失敗次數過多，已停止自動重試', 'error');
      return;
    }
    
    cancelAutoUpload(studentIndex);
    uploadingStudents[studentIndex] = true;
    var baseState = studentFiles[studentIndex] || (studentFiles[studentIndex] = { photos: [], videos: [], comment: '', baselineComment: '' });
    var pendingPhotos = (baseState.photos || []).slice();
    var pendingVideos = (baseState.videos || []).slice();
    var pendingComment = baseState.comment || '';
    var includePhotos = pendingPhotos.length > 0;
    var includeVideos = pendingVideos.length > 0;
    var includeComment = (pendingComment != null && String(pendingComment).length >= 1 && pendingComment !== (baseState.baselineComment || ''));
    var uploadSucceeded = false;
    try {
      btn.classList.add('uploading');
      btn.disabled = true;
      updateUploadProgressDisplay(studentIndex, 0);
      resetFileUploadStates(studentIndex); // 📊 重置所有檔案上傳狀態
      var formData = new FormData();
      var opMeta = buildRecordOperationMeta(student.name);
      var parsed = global.FLB.Course.parseTitle(currentCourse.title || '');
      var parsedCourse = parsed && parsed.courseName ? parsed.courseName : '';
      var parsedPeriodRaw = parsed && parsed.period ? parsed.period : '';
      var courseValue = (opMeta.course || currentCourse.courseName || parsedCourse || '').trim();
      var periodValue = (opMeta.period || parsedPeriodRaw.replace(/\s+/g, '') || '').trim();
      if (!courseValue) {
        courseValue = (parsedCourse || (currentCourse.title || '').split(' ')[0] || 'COURSE').trim();
      }
      if (!periodValue) {
        var derivedPeriod = opMeta.coursePeriod ? opMeta.coursePeriod.split('-').slice(1).join('-') : '';
        periodValue = (derivedPeriod || parsedPeriodRaw.replace(/\s+/g, '') || '0000').trim();
      }
      var dateValue = opMeta.date || (currentCourse.start ? formatDateTWISO(new Date(currentCourse.start)) : '');

      // 🔀 並行上傳：多檔案時採用每檔一請求 + 併發限制，加速上傳
      try { lastSubmittedSnapshot[studentIndex] = computeChangeSnapshot(studentIndex); } catch (e) {}
      var USE_PARALLEL_UPLOADS = ((pendingPhotos.length + pendingVideos.length) > 1);
      if (USE_PARALLEL_UPLOADS) {
        // 先把本地檔顯示到抽屜（同步中）
        try { mergeLocalUploadedRecord(studentIndex, student); } catch (e) {}

        var fileProgressMap = {}; // key: type-index -> percent
        function updateOverallButtonProgress() {
          try {
            var keys = Object.keys(fileProgressMap);
            var sum = keys.reduce(function (s, k) { return s + (fileProgressMap[k] || 0); }, 0);
            var totalUnits = Math.max(1, keys.length + (includeComment ? 1 : 0));
            var commentPct = 0;
            var commentFillNode = document.getElementById('comment-progress-fill-' + studentIndex);
            if (commentFillNode) {
              var m = (commentFillNode.style.width || '0%').match(/(\d+)%/);
              commentPct = m ? (parseInt(m[1], 10) || 0) : 0;
            }
            var overall = Math.min(100, Math.round((sum + commentPct) / totalUnits));
            updateUploadProgressDisplay(studentIndex, overall);
            var bar = document.getElementById('cap-bar-' + studentIndex);
            var fill2 = bar && bar.querySelector('.fill');
            if (fill2) fill2.style.width = String(overall) + '%';
          } catch (e) {}
        }

        function buildBaseForm() {
          var fd = new FormData();
          fd.append('course', courseValue);
          fd.append('period', periodValue);
          fd.append('date', dateValue);
          if (opMeta.coursePeriod) fd.append('coursePeriod', opMeta.coursePeriod);
          if (opMeta.relativePath) fd.append('relativePath', opMeta.relativePath);
          fd.append('studentName', student.name);
          return fd;
        }

        function uploadOne(type, file, idx) {
          var MAX_RETRY = 2;
          function attempt(n) {
            return new Promise(function (resolve, reject) {
              try {
                var fd = buildBaseForm();
                if (type === 'photos') {
                  try { fd.append('photos', file, (file && file.name) ? file.name : 'photo.jpg'); } catch (e) { fd.append('photos', file); }
                } else {
                  try { fd.append('videos', file, (file && file.name) ? file.name : 'video.mp4'); } catch (e) { fd.append('videos', file); }
                }
                var key = type + '-' + idx;
                fileProgressMap[key] = 0;
