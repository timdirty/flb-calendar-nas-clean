  <style>
      /* 📱 模板面板手機優化：縮小字體、避免換行 */
      @media (max-width: 480px) {
        #commentTemplatesPanel .nav-btn,
        #videoTemplatesPanel .nav-btn { font-size: 13px; padding: 8px 10px; white-space: nowrap; }
        #commentTemplatesPanel .template-item .template-title,
        #videoTemplatesPanel .template-item .template-title { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        #templateTargetList label span,
        #videoTemplateTargetList label span { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: calc(100% - 28px); display: inline-block; }
        /* 標題與按鈕在窄螢幕自動換行 */
        #commentTemplatesPanel .panel-header,
        #videoTemplatesPanel .panel-header { flex-wrap: wrap !important; gap: 8px; }
        #commentTemplatesPanel .panel-header .panel-actions,
        #videoTemplatesPanel .panel-header .panel-actions { width: 100%; justify-content: space-between; }
        #commentTemplatesPanel .panel-grid,
        #videoTemplatesPanel .panel-grid { grid-template-columns: 1fr; }
      }
      /* 超窄螢幕 <= 360px：再縮小一階 */
      @media (max-width: 360px) {
        #commentTemplatesPanel .nav-btn,
        #videoTemplatesPanel .nav-btn { font-size: 12px; padding: 7px 8px; }
        #commentTemplatesPanel .template-title,
        #videoTemplatesPanel .template-title { font-size: 13px; }
      }
      /* 桌面也盡量避免長字換行，維持一致外觀 */
      #commentTemplatesPanel .nav-btn,
      #videoTemplatesPanel .nav-btn { white-space: nowrap; }
      #templateTargetList label span,
      #videoTemplateTargetList label span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      /* 🎞️ 影片模板列表：縮小每個預覽的視窗高度，避免佔位過大影響閱讀 */
      #videoTemplatesPanel #videoTemplateList .template-item video {
        display: block;
        width: 100%;
        height: 140px;            /* 預設高度較小，方便同頁多列閱讀 */
        object-fit: contain;      /* 不拉伸，維持比例 */
        background: #0b1220;      /* 深底，提升對比 */
        border-radius: 8px;
      }
      @media (max-width: 480px) {
        #videoTemplatesPanel #videoTemplateList .template-item video { height: 110px; }
      }

      /* 📱 極窄螢幕 360–420px：標題列二排、左右留白更小、按鈕更緊湊 */
      @media (min-width: 360px) and (max-width: 420px) {
        #commentTemplatesPanel .panel-header,
        #videoTemplatesPanel .panel-header { padding: 10px 12px !important; flex-wrap: wrap !important; gap: 8px; }
        #commentTemplatesPanel .panel-header .panel-actions,
        #videoTemplatesPanel .panel-header .panel-actions { width: 100%; justify-content: space-between; }
        #commentTemplatesPanel .nav-btn,
        #videoTemplatesPanel .nav-btn { font-size: 12.5px; padding: 7px 10px; }
      }

      /* 📱 中等螢幕 420–520px：輕量緊湊（約 0.9x） */
      @media (min-width: 420px) and (max-width: 520px) {
        #commentTemplatesPanel .panel-header,
        #videoTemplatesPanel .panel-header { padding: 12px 14px !important; }
        #commentTemplatesPanel .nav-btn,
        #videoTemplatesPanel .nav-btn { font-size: 13px; padding: 8px 12px; }
        #commentTemplatesPanel .template-title,
        #videoTemplatesPanel .template-title { font-size: 15px; }
      }

      /* ☁️ 上傳中心 FAB 進度環（以 CSS 變數 --ucp 控制進度%） */
      #uploadCenterFab.progress { position: fixed; }
      #uploadCenterFab.progress::before {
        content: '';
        position: absolute;
        inset: -6px; /* 外圈厚度 */
        border-radius: 50%;
        background: conic-gradient(#10b981 var(--ucp, 0%), #e5e7eb 0);
        -webkit-mask: radial-gradient(farthest-side, transparent 70%, #000 71%);
                mask: radial-gradient(farthest-side, transparent 70%, #000 71%);
        pointer-events: none;
      }

      /* 🧩 課程總覽：行動裝置友善輸入布局 */
      .ov-grid { display:grid; grid-template-columns: 1fr 1fr; gap:10px; }
      .ov-col-2 { grid-column: 1 / -1; }
      .ov-input { height:34px; }
      .comment-area.ov-input, input.comment-area.ov-input { height:34px !important; min-height:34px !important; padding:6px 10px !important; line-height:1.2 !important; }
      @media (max-width: 520px) {
        .ov-grid { grid-template-columns: 1fr; }
      }

      /* 模式切換條：左右排列（藍色調，符合頁面設計語言） */
      .mode-switch-bar { position: sticky; top: 8px; z-index: 6; margin-bottom: 10px; }
      /* 兩組懸浮選單不覆蓋：當學生籤列吸附時，模式切換往下讓位 */
      body.with-sticky-tabs #modeSwitchBar,
      body.with-sticky-tabs #modeSwitchBarOv { top: 64px; }
      /* 層級：學生籤列在上，模式切換其下，但視覺可疊加（陰影） */
      .lr-top-tabs.is-sticky { position: sticky; top: 8px; z-index: 8; }
      #modeSwitchBar, #modeSwitchBarOv { z-index: 7; }
      .mode-switch-inner { display:flex; flex-direction: row; flex-wrap: nowrap; gap:10px; align-items:center; justify-content:center; background: rgba(239,246,255,0.9); border:1px solid rgba(59,130,246,0.25); padding:8px 10px; border-radius:16px; box-shadow: 0 8px 18px rgba(59,130,246,0.18); }
      .mode-switch-inner .nav-btn { flex:1 1 0; border-radius:999px; padding:10px 14px; font-size:14px; line-height:1; border:1.5px solid rgba(59,130,246,0.55); background: linear-gradient(180deg, #eaf2ff, #dbeafe); color:#0f2a59; font-weight:800; letter-spacing: 0.5px; }
      .mode-switch-inner .nav-btn.active { border-color:#3b82f6; box-shadow: 0 14px 26px rgba(59,130,246,0.32); background: linear-gradient(180deg, #dbeafe, #bfdbfe); color:#0b1f46; transform: translateY(-1px); }
      @media (max-width: 420px) { .mode-switch-inner { gap:8px; padding:6px 8px; } .mode-switch-inner .nav-btn { padding:8px 12px; font-size:13px; } }

      /* 頂部學生籤列：目前學生更醒目（金色描邊+微底色） */
      .lr-top-tabs .tab-item.active { border:2px solid #3b82f6 !important; background: linear-gradient(180deg, #eaf2ff, #dbeafe) !important; color:#0b1f46 !important; box-shadow: 0 14px 28px rgba(59,130,246,0.34) !important; transform: translateY(-1px) scale(1.07); }
      .lr-top-tabs .tab-item { border:1px solid rgba(59,130,246,0.45); background: rgba(219,234,254,0.55); color:#0f2a59; }

      /* 自動跳至總覽後的高亮效果 */
      .overview-highlight { box-shadow:0 0 0 3px rgba(16,185,129,.35) inset, 0 0 0 0 rgba(16,185,129,.0); animation: ovPulse 1.6s ease 2; }
      @keyframes ovPulse { 0% { box-shadow:0 0 0 3px rgba(16,185,129,.35) inset; } 100% { box-shadow:0 0 0 0 rgba(16,185,129,0) inset; } }
    </style>
</head>
