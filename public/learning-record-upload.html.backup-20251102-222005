                      .capbar{ position:absolute; left:10px; right:10px; bottom:8px; height:6px; border-radius:999px; background:linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,.25)); box-shadow: inset 0 1px 2px rgba(0,0,0,.06); }
                      .capbar .fill{ position:absolute; left:0; top:0; bottom:0; width:0; background:linear-gradient(90deg, #7dd3fc, #60a5fa); border-radius:999px; transition: width .45s cubic-bezier(.22,.61,.36,1); overflow:hidden; filter: drop-shadow(0 0 6px rgba(96,165,250,.45)); }
