                            </div>
                            <div class="ov-col-2">
                                <div style="font-size:12px;color:#475569;margin-bottom:4px">學生姓名（以空白分隔）</div>
                                <textarea id="ov_names" class="comment-area" rows="2" inputmode="text" autocapitalize="off" autocomplete="off" spellcheck="false" placeholder="範例：石介紹 王小明 李同學"></textarea>
                            </div>
                            <div>
                                <div style="font-size:12px;color:#475569;margin-bottom:4px">上課人數</div>
                                <input id="ov_count" type="number" inputmode="numeric" min="0" class="comment-area ov-input" placeholder="0" />
                            </div>
                            <div>
                                <div style="font-size:12px;color:#475569;margin-bottom:4px">講師姓名</div>
                                <input id="ov_teacher" class="comment-area ov-input" autocomplete="name" />
                            </div>
                            <div class="ov-col-2">
                                <div style="font-size:12px;color:#475569;margin-bottom:4px">課程主題</div>
                                <input id="ov_topic" class="comment-area ov-input" />
                            </div>
                        </div>
                    </div>
                    <!-- 🧾 預覽區塊移除：避免頁面過長（需求調整） -->
                    <div class="upload-area">
                        <label class="upload-label">🧑‍🏫 課堂狀況紀錄（講師填寫）</label>
                        <textarea class="comment-area" id="ov_perf" placeholder="學生的狀況與表現..." rows="4"></textarea>
                        <textarea class="comment-area" id="ov_issue" placeholder="遇到的問題..." rows="3" style="margin-top:8px"></textarea>
                        <textarea class="comment-area" id="ov_solution" placeholder="解決的方法..." rows="3" style="margin-top:8px"></textarea>
                    </div>

                    <!-- ✅ 改為同步狀態顯示（自動同步開啟，無需手動按鈕） -->
                    <div class="upload-btn" id="overviewSyncStatus" style="cursor:default">
                        <i class="fas fa-cloud"></i> 自動同步
                        <span class="capbar" style="position:relative; display:block; margin-top:8px; height:6px;">
                            <span class="fill" id="overviewSyncFill" style="width:0%"></span>
                            <span class="pct" id="overviewSyncText" style="position:absolute; right:4px; bottom:12px;">待命</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 預留：底部學生標籤（Desktop 可開） -->
    <div id="bottomTabs" class="lr-bottom-tabs" style="display:none"></div>

    <!-- 評語模板面板（簡易彈出層） -->
    <div id="commentTemplatesPanel" style="display:none; position:fixed; inset:0; z-index:1002;">
        <div style="position:absolute; inset:0; background:rgba(15,23,42,0.35);" onclick="closeCommentTemplatesPanel()"></div>
        <div style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:min(880px, calc(100% - 32px)); max-height:80vh; overflow:auto; background:#fff; border-radius:16px; box-shadow:0 20px 40px rgba(0,0,0,0.2);">
            <div class="panel-header" style="display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border-bottom:1px solid rgba(0,0,0,0.06)">
                <div class="template-title" style="font-weight:800"><i class="fas fa-quote-right"></i> 評語模板</div>
                <div class="panel-actions" style="display:flex; gap:8px">
                    <button class="nav-btn" onclick="addCurrentCommentAsTemplate()"><i class="fas fa-plus"></i> 加入目前評語</button>
                    <button class="nav-btn" onclick="closeCommentTemplatesPanel()"><i class="fas fa-times"></i> 關閉</button>
                </div>
            </div>
            <div class="panel-grid" style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; padding:16px;">
                <div style="border:1px solid rgba(0,0,0,0.06); border-radius:12px; padding:12px;">
                    <div style="font-weight:700; margin-bottom:8px">模板列表（最多 10 則）</div>
                    <div id="templateList"></div>
                </div>
                <div style="border:1px solid rgba(0,0,0,0.06); border-radius:12px; padding:12px;">
                    <div style="font-weight:700; margin-bottom:8px">套用至學生</div>
                    <div style="margin-bottom:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap">
                        <button class="nav-btn" onclick="selectAllTemplateTargets(true)"><i class="fas fa-check-double"></i> 全選</button>
                        <button class="nav-btn" onclick="selectAllTemplateTargets(false)"><i class="fas fa-undo"></i> 全不選</button>
                        <label style="display:inline-flex; align-items:center; gap:6px; font-weight:700"><input id="applyOnlyEmpty" type="checkbox" checked /> 僅填空白</label>
                    </div>
                    <div id="templateTargetList" style="max-height:38vh; overflow:auto; border:1px dashed rgba(0,0,0,0.08); border-radius:8px; padding:8px;"></div>
                    <div style="margin-top:12px; display:flex; gap:8px; justify-content:flex-end">
                        <button class="nav-btn" onclick="applySelectedTemplate()"><i class="fas fa-magic"></i> 套用到已選</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 影片模板面板 -->
    <div id="videoTemplatesPanel" style="display:none; position:fixed; inset:0; z-index:1002;">
        <div style="position:absolute; inset:0; background:rgba(15,23,42,0.35);" onclick="closeVideoTemplatesPanel()"></div>
        <div style="position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:min(880px, calc(100% - 32px)); max-height:80vh; overflow:auto; background:#fff; border-radius:16px; box-shadow:0 20px 40px rgba(0,0,0,0.2);">
            <div class="panel-header" style="display:flex; align-items:center; justify-content:space-between; padding:14px 16px; border-bottom:1px solid rgba(0,0,0,0.06)">
                <div class="template-title" style="font-weight:800"><i class="fas a-film"></i> 影片模板</div>
                <div class="panel-actions" style="display:flex; gap:8px">
                    <button class="nav-btn" onclick="addLatestVideoToTemplates()"><i class="fas fa-plus"></i> 加入最近影片</button>
                    <button class="nav-btn" onclick="closeVideoTemplatesPanel()"><i class="fas fa-times"></i> 關閉</button>
                </div>
            </div>
            <div class="panel-grid" style="display:grid; grid-template-columns: 1fr 1fr; gap:16px; padding:16px;">
                <div style="border:1px solid rgba(0,0,0,0.06); border-radius:12px; padding:12px;">
                    <div style="font-weight:700; margin-bottom:8px">模板列表（最多 8 筆）</div>
                    <div id="videoTemplateList"></div>
                </div>
                <div style="border:1px solid rgba(0,0,0,0.06); border-radius:12px; padding:12px;">
                    <div style="font-weight:700; margin-bottom:8px">套用至學生</div>
                    <div style="margin-bottom:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap">
                        <button class="nav-btn" onclick="selectAllVideoTargets(true)"><i class="fas fa-check-double"></i> 全選</button>
                        <button class="nav-btn" onclick="selectAllVideoTargets(false)"><i class="fas fa-undo"></i> 全不選</button>
                        <label style="display:inline-flex; align-items:center; gap:6px; font-weight:700"><input id="videoApplyOnlyEmpty" type="checkbox" checked /> 僅當前無影片</label>
                    </div>
                    <div id="videoTemplateTargetList" style="max-height:38vh; overflow:auto; border:1px dashed rgba(0,0,0,0.08); border-radius:8px; padding:8px;"></div>
                    <div style="margin-top:12px; display:flex; gap:8px; justify-content:flex-end">
                        <button class="nav-btn" onclick="applySelectedVideoTemplate()"><i class="fas fa-magic"></i> 套用到已選</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 背景上傳中心：浮動按鈕 + 抽屜 -->
    <button id="uploadCenterFab" title="背景上傳" onclick="openUploadCenter()" style="position:fixed; right:16px; bottom:86px; width:52px; height:52px; border-radius:26px; border:none; background:#0ea5e9; color:#fff; box-shadow:0 6px 18px rgba(0,0,0,0.2); z-index:1000; display:flex; align-items:center; justify-content:center;">
        <i class="fas fa-cloud-upload-alt"></i>
        <span id="uploadCenterBadge" style="position:absolute; top:-6px; right:-6px; background:#f97316; color:#fff; min-width:20px; height:20px; border-radius:10px; display:none; align-items:center; justify-content:center; font-size:12px; font-weight:800; padding:0 6px; box-shadow:0 4px 10px rgba(0,0,0,0.25);"></span>
    </button>
    <div id="uploadCenterBackdrop" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.25); z-index:999;" onclick="closeUploadCenter()"></div>
    <div id="uploadCenterDrawer" style="position:fixed; left:0; right:0; bottom:0; height:55vh; background:#fff; border-top-left-radius:14px; border-top-right-radius:14px; box-shadow:0 -10px 24px rgba(0,0,0,0.18); z-index:1000; transform:translateY(110%); transition:transform .25s ease; display:none;">
        <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 14px; border-bottom:1px solid rgba(0,0,0,0.06)">
            <div style="font-weight:800"><i class="fas fa-cloud-upload-alt"></i> 背景上傳中心</div>
            <div style="display:flex; gap:8px">
                <button id="uploadCenterClose" class="nav-btn" onclick="closeUploadCenter()"><i class="fas fa-times"></i> 關閉</button>
            </div>
        </div>
        <div id="uploadCenterList" style="padding:10px 12px; max-height: calc(55vh - 56px); overflow:auto;"></div>
    </div>

    <!-- 左下角返回浮動按鈕 -->
    <button id="backFab" title="返回行事曆" style="position:fixed; left:16px; bottom:16px; width:52px; height:52px; border-radius:26px; border:none; background:#64748b; color:#fff; box-shadow:0 6px 18px rgba(0,0,0,0.2); z-index:1000; display:flex; align-items:center; justify-content:center;">
        <i class="fas fa-arrow-left"></i>
    </button>
    <!-- 左下角查課程（位於返回之上） -->
    <button id="coursePickerFab" title="查課程/換課程" style="position:fixed; left:16px; bottom:76px; width:52px; height:52px; border-radius:26px; border:none; background:#0ea5e9; color:#fff; box-shadow:0 6px 18px rgba(0,0,0,0.2); z-index:1000; display:flex; align-items:center; justify-content:center;">
        <i class="fas fa-search"></i>
    </button>

    <!-- 📱 浮動篩選選單（僅在課程清單 step 顯示） -->
    <button id="filterFab" title="篩選" style="position:fixed; left:16px; bottom:136px; width:52px; height:52px; border-radius:26px; border:none; background:#10b981; color:#fff; box-shadow:0 6px 18px rgba(0,0,0,0.2); z-index:1000; display:none; align-items:center; justify-content:center;">
        <i class="fas fa-sliders-h"></i>
    </button>
    <div id="filterDrawer" style="position:fixed; left:0; right:0; bottom:0; height:auto; max-height:70vh; background:#fff; border-top-left-radius:16px; border-top-right-radius:16px; box-shadow:0 -10px 24px rgba(0,0,0,0.18); z-index:1000; transform:translateY(110%); transition:transform .25s ease; display:block;">
        <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 14px; border-bottom:1px solid rgba(0,0,0,0.06)">
            <div style="font-weight:800"><i class="fas fa-sliders-h"></i> 篩選課程</div>
            <div style="display:flex; gap:8px">
                <button id="filterCloseBtn" class="nav-btn"><i class="fas fa-times"></i> 關閉</button>
            </div>
        </div>
        <div style="padding:12px 14px; overflow:auto; max-height:calc(70vh - 56px)">
            <!-- 📅 星期快速篩選（Mobile 抽屜） -->
            <div id="m_weekdayFilterBar" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:12px;">
                <style>
                  .wd-btn{ background:rgba(255,255,255,.98); border:1px solid rgba(59,130,246,.25); color:#0f172a; font-weight:800; border-radius:999px; padding:6px 10px; font-size:13px; box-shadow:0 4px 12px rgba(59,130,246,.10); }
                  .wd-btn.active{ background:rgba(16,185,129,.12); border-color:rgba(16,185,129,.45); color:#065f46; box-shadow:0 6px 16px rgba(16,185,129,.16); }
                </style>
                <button type="button" class="wd-btn" data-wd="1">一</button>
                <button type="button" class="wd-btn" data-wd="2">二</button>
                <button type="button" class="wd-btn" data-wd="3">三</button>
                <button type="button" class="wd-btn" data-wd="4">四</button>
                <button type="button" class="wd-btn" data-wd="5">五</button>
                <button type="button" class="wd-btn" data-wd="6">六</button>
                <button type="button" class="wd-btn" data-wd="7">日</button>
            </div>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px">
                <div>
                    <label class="filter-label" style="font-weight:700; font-size:13px">範圍</label>
                    <select id="m_rangeFilter" class="filter-select"><option value="today">今日已結束</option><option value="week">本週課程</option></select>
                </div>
                <div>
                    <label class="filter-label" style="font-weight:700; font-size:13px">日期</label>
                    <input type="date" id="m_datePicker" class="filter-select" />
                </div>
                <div>
                    <label class="filter-label" style="font-weight:700; font-size:13px">狀態</label>
                    <select id="m_statusFilter" class="filter-select"><option value="all">全部</option><option value="completed">已結束</option><option value="upcoming">尚未開始</option></select>
                </div>
                <div>
                    <label class="filter-label" style="font-weight:700; font-size:13px">講師</label>
                    <select id="m_instructorFilter" class="filter-select"><option value="">全部講師</option></select>
                </div>
                <div style="grid-column:1 / -1">
                    <label class="filter-label" style="font-weight:700; font-size:13px">類別</label>
                    <select id="m_courseTypeFilter" class="filter-select"><option value="">全部類別</option></select>
                </div>
                <div style="grid-column:1 / -1">
                    <label class="filter-label" style="font-weight:700; font-size:13px">學生</label>
                    <input id="m_studentSearch" class="filter-select" placeholder="輸入學生姓名" />
                </div>
            </div>
        </div>
    </div>

    <!-- 浮動進度指示（全域） -->
    <div id="progressIndicator" style="position:fixed;right:10px;bottom:64px;left:10px;z-index:998"></div>

    <!-- FAB：已上傳記錄抽屜 -->
    <button id="recordsFab" title="已上傳記錄">
        <i class="fas fa-folder-open"></i>
        <span id="recordsFabBadge">0</span>
    </button>
    <div id="recordsBackdrop" style="display:none; position:fixed; inset:0; background:rgba(15,23,42,0.25); z-index:998;" onclick="document.getElementById('recordsFab').click()"></div>
    <div id="recordsDrawer">
        <div class="drawer-header" style="padding:12px 16px;border-bottom:1px solid rgba(0,0,0,0.08);display:flex;justify-content:space-between;align-items:center; gap:8px;">
            <div class="drawer-title" style="font-weight:600"><i class="fas fa-folder-open"></i> 已上傳記錄</div>
            <button id="recordsDrawerClose" class="nav-btn"><i class="fas fa-times"></i> 關閉</button>
        </div>
        <div id="recordsDrawerContent" style="height:calc(60vh - 48px);overflow:auto;padding:12px 16px"></div>
    </div>

    <!-- 歷史記錄面板 -->
    <div class="history-panel" id="historyPanel">
        <div class="history-header">
            <h2><i class="fas fa-history"></i> 歷史記錄</h2>
            <button class="history-close" onclick="closeHistory()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="history-content">
            <div class="history-filters">
                <div class="filter-group">
                    <label class="filter-label">學期</label>
                    <select class="filter-select" id="filterSemester" onchange="loadHistory()">
                        <option value="">當前學期</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">課程</label>
                    <select class="filter-select" id="filterCourse" onchange="loadHistory()">
                        <option value="">全部課程</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label class="filter-label">日期</label>
                    <input type="date" class="filter-select" id="filterDate" onchange="loadHistory()">
                </div>
            </div>
            <div class="history-records" id="historyRecords">
                <!-- 歷史記錄將動態載入 -->
            </div>
        </div>
    </div>

    <!-- 圖片 / 影片預覽疊層 -->
    <div id="previewOverlay" class="preview-overlay" aria-hidden="true">
        <div class="preview-overlay-backdrop"></div>
        <div class="preview-overlay-content">
            <button id="previewOverlayClose" class="preview-overlay-close">
                <i class="fas fa-times"></i>
            </button>
            <div id="previewOverlayBody" class="preview-overlay-body"></div>
        </div>
    </div>

    <!-- 懸浮：課程總覽整體進度條（自動顯示/隱藏） -->
    <div id="overviewFloatBar" style="position:fixed; right:14px; bottom:86px; z-index:999; display:none; background:rgba(255,255,255,.86); border:1px solid rgba(0,0,0,.06); border-radius:999px; box-shadow:0 10px 20px rgba(2,6,23,.18); padding:8px 12px; min-width:180px; cursor:pointer">
      <div class="float-line">
        <div style="font-weight:800; color:#0f172a; font-size:12px; margin-bottom:6px"><i class="fas fa-clipboard-list"></i> 課程總覽上傳</div>
        <div style="height:8px; background:#e5e7eb; border-radius:999px; overflow:hidden"><div id="overviewFloatFill" style="height:100%; width:0%; background:#60a5fa; transition:width .35s ease"></div></div>
      </div>
      <div id="overviewFloatDot" class="float-dot" style="display:none; width:28px; height:28px; border-radius:50%; background:conic-gradient(#60a5fa 0%, #e5e7eb 0%); box-shadow:0 6px 14px rgba(2,6,23,.20);"></div>
    </div>
</body>
</html>
