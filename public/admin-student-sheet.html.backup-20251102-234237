<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FLB 行事曆系統 - 學生試算表管理</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" referrerpolicy="no-referrer">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Microsoft JhengHei', Arial, sans-serif;
            background: #F8F9FC;
            min-height: 100vh;
            color: #1F2937;
        }

        .page-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 32px 24px 80px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
            padding: 24px 28px;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.18), rgba(129, 140, 248, 0.16));
            border-radius: 18px;
            border: 1px solid rgba(99, 102, 241, 0.25);
            box-shadow: 0 18px 32px rgba(79, 70, 229, 0.12);
        }

        header h1 {
            font-size: 1.9rem;
            color: #1E1B4B;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        header h1 i {
            color: #4338CA;
        }

        header p {
            color: #4338CA;
            font-size: 0.95rem;
        }

        header > .btn {
            margin-left: auto;
        }

        .toolbar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 20px;
        }

        .filters-panel {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(129, 140, 248, 0.1));
            padding: 18px;
            border-radius: 14px;
            margin-bottom: 18px;
            border: 1px solid rgba(129, 140, 248, 0.2);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .filter-group label {
            font-size: 0.85rem;
            font-weight: 600;
            color: #4338CA;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .filter-group input,
        .filter-group select {
            padding: 10px 12px;
            border-radius: 10px;
            border: 1px solid rgba(99, 102, 241, 0.3);
            background: #FFFFFF;
            font-size: 0.95rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .filter-group input:focus,
        .filter-group select:focus {
            border-color: #6366F1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
            outline: none;
        }

        .filter-toggle {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            color: #4338CA;
            font-weight: 600;
        }

        .parent-helper {
            margin-top: 8px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }

        .parent-helper input,
        .parent-helper select {
            padding: 8px 10px;
            border-radius: 8px;
            border: 1px solid #D1D5DB;
            font-size: 0.9rem;
        }

        .parent-helper select {
            min-width: 220px;
        }

        .field-hint {
            display: block;
            margin-top: 6px;
            font-size: 0.75rem;
            color: #6B7280;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 8px;
            border: none;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #6366F1, #8B5CF6);
            color: #FFFFFF;
            box-shadow: 0 6px 12px rgba(99, 102, 241, 0.25);
        }

        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 16px rgba(99, 102, 241, 0.35);
        }

        .btn-secondary {
            background: #E5E7EB;
            color: #1F2937;
        }

        .btn-secondary:hover {
            background: #D1D5DB;
        }

        .btn-danger {
            background: linear-gradient(135deg, #EF4444, #DC2626);
            color: #FFFFFF;
        }

        .table-wrapper {
            background: #FFFFFF;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
            padding: 16px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 960px;
        }

        thead {
            background: linear-gradient(135deg, #EEF2FF, #E0E7FF);
        }

        th {
            text-align: left;
            padding: 14px 12px;
            font-size: 0.9rem;
            color: #4338CA;
            letter-spacing: 0.02em;
            white-space: nowrap;
        }

        tbody tr {
            border-bottom: 1px solid #F3F4F6;
            transition: background 0.2s ease;
        }

        tbody tr:hover {
            background: #F8FAFC;
        }

        td {
            padding: 12px;
            font-size: 0.92rem;
            color: #374151;
            vertical-align: top;
            max-width: 320px;
        }

        td .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .badge-success {
            background: rgba(16, 185, 129, 0.12);
            color: #047857;
        }

        .badge-warning {
            background: rgba(245, 158, 11, 0.15);
            color: #B45309;
        }

        .badge-danger {
            background: rgba(239, 68, 68, 0.15);
            color: #B91C1C;
        }

        .table-actions {
            display: flex;
            gap: 8px;
        }

        .actions-column,
        td.actions-column {
            position: sticky;
            right: 0;
            background: #FFFFFF;
            box-shadow: -6px 0 12px rgba(15, 23, 42, 0.05);
            z-index: 5;
            min-width: 150px;
        }

        .btn-sm {
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 0.85rem;
        }

        .status-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 18px;
            color: #6B7280;
            font-size: 0.9rem;
        }

        .status-bar span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .toast {
            position: fixed;
            top: 24px;
            right: 24px;
            background: #1F2937;
            color: #FFFFFF;
            padding: 12px 18px;
            border-radius: 10px;
            box-shadow: 0 12px 24px rgba(17, 24, 39, 0.18);
            display: none;
            min-width: 220px;
            z-index: 2000;
        }

        .toast.show {
            display: block;
            animation: fadeInUp 0.3s ease forwards;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .modal-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.55);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 3000;
            padding: 24px;
        }

        .modal-backdrop.show {
            display: flex;
        }

        .modal {
            background: #FFFFFF;
            width: min(960px, 100%);
            max-height: 90vh;
            border-radius: 16px;
            box-shadow: 0 20px 48px rgba(15, 23, 42, 0.25);
            display: flex;
            flex-direction: column;
        }

        .modal-header {
            padding: 20px 24px;
            border-bottom: 1px solid #E5E7EB;
        }

        .modal-header h2 {
            font-size: 1.3rem;
            color: #1F2937;
        }

        .modal-body {
            padding: 20px 24px;
            overflow-y: auto;
        }

        .modal-footer {
            padding: 18px 24px;
            border-top: 1px solid #E5E7EB;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group label {
            font-size: 0.9rem;
            font-weight: 600;
            color: #4B5563;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #D1D5DB;
            font-size: 0.95rem;
            transition: border 0.2s ease, box-shadow 0.2s ease;
        }

        .form-group textarea {
            min-height: 110px;
            resize: vertical;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            border-color: #6366F1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
            outline: none;
        }

        .empty-placeholder {
            padding: 48px 24px;
            text-align: center;
            color: #6B7280;
        }

        .badge-boolean {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 600;
            background: rgba(99, 102, 241, 0.12);
            color: #4338CA;
        }

        @media (max-width: 768px) {
            header {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .page-container {
                padding: 24px 16px 64px;
            }

            header > .btn {
                margin-left: 0;
                width: 100%;
                justify-content: center;
            }

            table {
                min-width: 720px;
            }
        }
    </style>
</head>
<body>
    <div class="page-container">
        <header>
            <div>
                <h1><i class="fas fa-table-list"></i> 學生試算表管理</h1>
                <p>直接對應 Google Sheets「學生Data(Sync Notion Class)」子資料庫，支援讀取、編輯與新增。</p>
            </div>
            <button class="btn btn-secondary" onclick="window.location.href='admin-dashboard.html'">
                <i class="fas fa-arrow-left"></i> 返回管理控制台
            </button>
        </header>

        <div class="toolbar">
            <button id="refreshBtn" class="btn btn-secondary">
                <i class="fas fa-rotate"></i> 重新整理
            </button>
            <button id="forceRefreshBtn" class="btn btn-secondary">
                <i class="fas fa-bolt"></i> 強制重新抓取
            </button>
            <button id="addStudentBtn" class="btn btn-primary">
                <i class="fas fa-user-plus"></i> 新增學生
            </button>
        </div>

        <section class="filters-panel">
            <div class="filter-group">
                <label for="filterKeyword"><i class="fas fa-search"></i> 關鍵字搜尋</label>
                <input type="text" id="filterKeyword" placeholder="輸入學生姓名、課程名稱、家長或 LINE User ID">
            </div>
            <div class="filter-group">
                <label for="filterCourse"><i class="fas fa-book"></i> 課程名稱</label>
                <select id="filterCourse">
                    <option value="">全部</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="filterCategory"><i class="fas fa-layer-group"></i> 課程類型</label>
                <select id="filterCategory">
                    <option value="">全部</option>
                </select>
            </div>
            <div class="filter-group">
                <label for="filterRemaining"><i class="fas fa-chart-line"></i> 剩餘堂數</label>
                <select id="filterRemaining">
                    <option value="all">全部</option>
                    <option value="zero">僅顯示 0 堂</option>
                    <option value="low">僅顯示 ≦ 5 堂</option>
                </select>
            </div>
            <div class="filter-toggle">
                <input type="checkbox" id="filterMissingUserId">
                <label for="filterMissingUserId"><i class="fas fa-id-card-alt"></i> 僅顯示缺少 userId</label>
            </div>
        </section>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th style="width: 72px;">#</th>
                        <th>學生姓名</th>
                        <th>課程名稱</th>
                        <th>剩餘堂數</th>
                        <th>課程類型</th>
                        <th>家長姓名 / 聯絡</th>
                        <th>LINE User ID</th>
                        <th>備註</th>
                        <th class="actions-column">操作</th>
                    </tr>
                </thead>
                <tbody id="studentTableBody">
                    <tr>
                        <td colspan="9" class="empty-placeholder">載入中...</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="status-bar">
            <span id="statusSummary"><i class="fas fa-chart-bar"></i> -</span>
            <span id="statusTimestamp"><i class="fas fa-clock"></i> -</span>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <datalist id="parentNameOptions"></datalist>

    <div class="modal-backdrop" id="editorModal">
        <div class="modal">
            <div class="modal-header">
                <h2 id="modalTitle">學生資料編輯</h2>
            </div>
            <div class="modal-body">
                <form id="studentForm">
                    <div class="form-grid" id="formFields"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelEditBtn">
                    <i class="fas fa-times"></i> 取消
                </button>
                <button type="button" class="btn btn-primary" id="saveStudentBtn">
                    <i class="fas fa-save"></i> 儲存變更
                </button>
            </div>
        </div>
    </div>

    <script src="js/admin-student-sheet.js?v=2025-11-02-total-opt"></script>
</body>
</html>
