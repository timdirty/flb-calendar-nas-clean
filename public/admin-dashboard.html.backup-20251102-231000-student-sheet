        // 更新狀態徽章
        function updateAutoSyncStatus(settings) {
            const statusBadge = document.getElementById('autoSyncStatus');
            
            if (!settings.enabled) {
                statusBadge.textContent = '已停用';
                statusBadge.style.backgroundColor = '#666';
            } else if (!settings.autoUpdateEnabled) {
                statusBadge.textContent = '手動模式';
                statusBadge.style.backgroundColor = '#ff9800';
            } else if (settings.hasSchedule || settings.hasInterval) {
                statusBadge.textContent = '運作中';
                statusBadge.style.backgroundColor = '#4caf50';
            } else {
                statusBadge.textContent = '未啟動';
                statusBadge.style.backgroundColor = '#f44336';
            }
        }
        
        // 更新設定預覽
        function updateAutoSyncPreview() {
            const enabled = document.getElementById('autoSyncEnabled').checked;
            const autoUpdate = document.getElementById('autoUpdateEnabled').checked;
            const dailyTime = document.getElementById('dailyUpdateTime').value;
            const interval = parseInt(document.getElementById('intervalMinutes').value) || 0;
            
            let preview = '';
            
            if (!enabled) {
                preview = '<span style="color: #666;">⚠️ 自動更新功能已停用</span>';
            } else if (!autoUpdate) {
                preview = '<span style="color: #ff9800;">📌 僅手動模式，不會自動更新</span>';
            } else {
                preview += '<div style="color: #4caf50;">✅ 自動更新已啟用</div>';
                
                if (dailyTime) {
                    preview += `<div>📅 每天 ${dailyTime} 自動更新</div>`;
                }
                
                if (interval > 0) {
                    const hours = Math.floor(interval / 60);
                    const mins = interval % 60;
                    let intervalText = '';
                    if (hours > 0) intervalText += `${hours}小時`;
                    if (mins > 0) intervalText += `${mins}分鐘`;
                    preview += `<div>⏱️ 每 ${intervalText} 自動更新</div>`;
                }
                
                if (!dailyTime && interval === 0) {
                    preview += '<div style="color: #ff9800;">⚠️ 請至少設定一種更新方式</div>';
                }
            }
            
            document.getElementById('autoSyncPreviewContent').innerHTML = preview;
        }

