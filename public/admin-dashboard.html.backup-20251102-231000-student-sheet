        async function quickClearCache() {
            if (!confirm('確定要清除所有緩存嗎？')) {
                return;
            }
            
            try {
                showToast('⏳ 正在清除緩存...', 'info');
                const response = await fetch('/api/cache/clear', { method: 'POST' });
