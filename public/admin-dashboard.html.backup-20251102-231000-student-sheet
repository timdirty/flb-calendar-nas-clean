        document.addEventListener('DOMContentLoaded', () => {
          document.getElementById('tempStudentDate').addEventListener('change', updateAvailableTimes);
          document.getElementById('tempStudentCourse').addEventListener('change', () => {
            if (document.getElementById('tempStudentDate').value) {
