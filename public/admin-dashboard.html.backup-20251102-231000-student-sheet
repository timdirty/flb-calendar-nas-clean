        /**
         * 提交請假表單（支援批次提交多位學生）
         */
        async function submitLeaveForm(event) {
            event.preventDefault();
            
            const courseType = document.getElementById('leaveCourseType').value;
            const date = document.getElementById('leaveDate').value;
            const reasonSelect = document.getElementById('leaveReason').value;
            const reasonCustom = document.getElementById('leaveReasonCustom').value;
            const notifyNow = document.getElementById('leaveNotifyNow').checked;
            
            // 決定最終的請假原因
            const reason = reasonSelect === '其他' ? reasonCustom : reasonSelect;
            
            // 檢查是否選擇了學生
            if (selectedStudentsForLeave.length === 0) {
                showToast('❌ 請至少選擇一位學生', 'error');
                return;
            }
            
            console.log('🏥 批次提交請假:', { 
                students: selectedStudentsForLeave, 
                courseType, 
                date, 
                reason, 
                notifyNow 
            });
            
            // 顯示載入中
            const submitBtn = event.target.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> 處理中... (${selectedStudentsForLeave.length} 位學生)`;
            
            try {
                // 🔥 構建批次請假資料（每位學生使用自己的課程）
                const students = selectedStudentsForLeave.map(student => ({
                    name: student.name,
                    course: student.course, // ✅ 使用學生自己的課程
                    date: date,
                    reason: reason,
                    notify: notifyNow
                }));
                
                const response = await fetch('/api/leave-attendance', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ students })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    const successCount = result.results?.filter(r => r.success).length || selectedStudentsForLeave.length;
                    const failCount = result.results?.filter(r => !r.success).length || 0;
                    
                    let message = `✅ ${successCount} 位學生請假登記成功`;
                    if (notifyNow) {
                        message += `，通知已發送`;
                    }
                    if (failCount > 0) {
                        message += `\n⚠️ ${failCount} 位失敗`;
                    }
                    
                    showToast(message, failCount > 0 ? 'warning' : 'success');
                    resetLeaveForm();
                    await loadLeaveRecords(); // 重新載入記錄
                } else {
                    showToast(`❌ 請假登記失敗: ${result.error}`, 'error');
                }
                
            } catch (error) {
                console.error('❌ 批次請假登記失敗:', error);
                showToast('❌ 請假登記失敗，請重試', 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        /**
         * 🚀 多日期版提交（每個日期都建立請假記錄，並可逐日發送通知）
         */
        async function submitLeaveFormMulti(event) {
            event.preventDefault();

            const courseType = document.getElementById('leaveCourseType').value;
            const dateValue = document.getElementById('leaveDate').value;
            const reasonSelect = document.getElementById('leaveReason').value;
            const reasonCustom = document.getElementById('leaveReasonCustom').value;
            const notifyNow = document.getElementById('leaveNotifyNow').checked;

            const reason = reasonSelect === '其他' ? reasonCustom : reasonSelect;

            if (selectedStudentsForLeave.length === 0) {
                showToast('❌ 請至少選擇一位學生', 'error');
                return;
            }

            const dates = (selectedLeaveDates && selectedLeaveDates.length > 0)
                ? [...selectedLeaveDates]
                : (dateValue ? [dateValue] : []);
            if (dates.length === 0) {
                showToast('❌ 請至少加入一個請假日期', 'error');
                return;
            }

            console.log('🏥 多日期提交請假:', {
                students: selectedStudentsForLeave,
                courseType,
                dates,
                reason,
                notifyNow
            });

            const submitBtn = event.target.querySelector('button[type="submit"]');
            const originalText = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class=\"fas fa-spinner fa-spin\"></i> 處理中... (${selectedStudentsForLeave.length} 位 × ${dates.length} 日)`;

            try {
                const mergeCarousel = (document.getElementById('leaveMergeCarousel')?.checked ?? true);
                const students = [];
                for (const s of selectedStudentsForLeave) {
                    for (const d of dates) {
                        students.push({
                            name: s.name,
                            course: s.course,
                            date: d,
                            reason: reason,
                            // ✅ 若選擇合併，交由後端智慧合併通知；否則前端逐則通知
                            notify: !!(notifyNow && mergeCarousel)
                        });
                    }
                }

                const resp = await fetch('/api/leave-attendance', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ students })
                });
                const result = await resp.json();

                if (result.success) {
                    const successCount = result.results?.filter(r => r.success).length || students.length;
                    const failCount = result.results?.filter(r => !r.success).length || 0;

                    if (notifyNow && !mergeCarousel) {
                        // 逐日逐筆通知（不合併）
                        let ok = 0, bad = 0;
                        for (const s of students) {
                            try {
                                const res = await fetch('/api/notify-leave', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        studentName: s.name,
                                        courseName: s.course,
                                        date: s.date,
                                        reason: s.reason,
                                        targets: ['staff', 'parent']
                                    })
                                });
                                const jr = await res.json();
                                if (jr && jr.success) ok++; else bad++;
                            } catch (err) {
                                console.error('❌ 通知失敗:', err);
                                bad++;
                            }
                            // 若要更穩健可加入短延遲避免限速
                            // await new Promise(r => setTimeout(r, 120));
                        }
                        let msg = `✅ ${successCount} 筆請假登記成功，已發送 ${ok} 則通知`;
                        if (failCount > 0) msg += `，⚠️ ${failCount} 筆登記失敗`;
                        if (bad > 0) msg += `，⚠️ ${bad} 則通知失敗`;
                        showToast(msg, (failCount > 0 || bad > 0) ? 'warning' : 'success');
                    } else if (notifyNow && mergeCarousel) {
                        // 後端已合併通知
                        let msg = `✅ ${successCount} 筆請假登記成功，已發送合併通知（Carousel）`;
                        if (failCount > 0) msg += `，⚠️ ${failCount} 筆登記失敗`;
                        showToast(msg, failCount > 0 ? 'warning' : 'success');
                    } else {
                        let msg = `✅ ${successCount} 筆請假登記成功（未立即通知）`;
                        if (failCount > 0) msg += `\n⚠️ ${failCount} 筆失敗`;
                        showToast(msg, failCount > 0 ? 'warning' : 'success');
                    }

                    resetLeaveForm();
                    await loadLeaveRecords();
                } else {
                    showToast(`❌ 請假登記失敗: ${result.error}`, 'error');
                }

            } catch (error) {
                console.error('❌ 多日期請假登記失敗:', error);
                showToast('❌ 請假登記失敗，請重試', 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalText;
            }
        }

        /**
         * 載入請假記錄
         */
        async function loadLeaveRecords() {
            try {
                const response = await fetch('/api/leave-records');
                const data = await response.json();
                
                if (data.success) {
                    allLeaveRecords = data.records || [];
                    filteredLeaveRecords = [...allLeaveRecords];
                    allLeaveRecordsCache = [...allLeaveRecords];  // 🔥 快取所有記錄供編輯功能使用
                    console.log(`📝 載入 ${allLeaveRecords.length} 筆請假記錄`);
                    renderLeaveRecords();
                } else {
                    throw new Error(data.error || '載入失敗');
                }
                
            } catch (error) {
                console.error('❌ 載入請假記錄失敗:', error);
                showToast('載入請假記錄失敗', 'error');
                document.getElementById('leaveRecordsTableBody').innerHTML = `
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 20px; color: #f44336;">
                            載入失敗，請重新整理
                        </td>
                    </tr>
                `;
            }
