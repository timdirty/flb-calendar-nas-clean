        // ==================== 提示訊息 ====================
        // ==================== Toast 浮動通知系統 ====================
        // 🔥 新的 Toast 系統
        function showToast(message, type = 'info', duration = 3000) {
            const container = document.getElementById('toastContainer');
            
            // 圖標映射
            const icons = {
                success: '✅',
                error: '❌',
                warning: '⚠️',
                info: 'ℹ️'
            };
            
            // 創建 toast 元素
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.innerHTML = `
                <span class="toast-icon">${icons[type] || icons.info}</span>
                <span class="toast-message">${message}</span>
                <button class="toast-close" onclick="this.parentElement.remove()">×</button>
            `;
            
            container.appendChild(toast);
            
            // 自動移除
            if (duration > 0) {
                setTimeout(() => {
                    toast.classList.add('removing');
                    setTimeout(() => toast.remove(), 300);
                }, duration);
            }
        }

        // 保留舊函數名稱以維持相容性
        function showAlert(message, type = 'info', duration = 3000) {
            showToast(message, type, duration);
        }

        // ==================== 載入所有數據 ====================
        async function loadAllData() {
            await Promise.all([
                loadSystemConfig(),
                loadTeachers(),
                loadNotificationConfig(),
                loadGoogleConfig()
            ]);
        }

        // ==================== 系統配置 ====================
        async function loadSystemConfig() {
            try {
                // 🔥 修復：改為從後端 API 載入
                const response = await fetch('/api/system-settings');
                const result = await response.json();
                
                let config = {};
                if (result.success && result.data) {
                    config = result.data;
                    currentConfig.system = config;
                    console.log('✅ 從後端載入系統配置:', config);
                } else {
                    console.warn('⚠️ 後端沒有配置，使用預設值');
                    // 使用預設值
                    config = {
                        apiEventsUrl: '/api/events',
                        apiTeachersUrl: '/api/teachers',
                        apiStudentsUrl: '/api/students',
                        apiRemindersUrl: '/api/reminders',
                        cacheEventExpiry: 30,
                        cacheTeacherExpiry: 60,
                        cacheStudentExpiry: 30,
                        cacheEnabled: true,
                        defaultView: 'today',
                        autoRefreshInterval: 0,
                        showPastEvents: true,
                        smartFilterEnabled: true,
                        dateRange: {
                            futureDays: 30,
                            pastDays: 7
                        }
                    };
                }
                
                // 填充表單
                document.getElementById('apiEventsUrl').value = config.apiEventsUrl || '/api/events';
                document.getElementById('apiTeachersUrl').value = config.apiTeachersUrl || '/api/teachers';
                document.getElementById('apiStudentsUrl').value = config.apiStudentsUrl || '/api/students';
                document.getElementById('apiRemindersUrl').value = config.apiRemindersUrl || '/api/reminders';
                
                document.getElementById('cacheEventExpiry').value = config.cacheEventExpiry || 30;
                document.getElementById('cacheTeacherExpiry').value = config.cacheTeacherExpiry || 60;
                document.getElementById('cacheStudentExpiry').value = config.cacheStudentExpiry || 30;
                document.getElementById('cacheEnabled').checked = config.cacheEnabled !== false;
                
                document.getElementById('defaultView').value = config.defaultView || 'today';
                document.getElementById('autoRefreshInterval').value = config.autoRefreshInterval || 0;
                document.getElementById('showPastEvents').checked = config.showPastEvents !== false;
                document.getElementById('smartFilterEnabled').checked = config.smartFilterEnabled !== false;
                
                const dateRange = config.dateRange || {};
                document.getElementById('futureDays').value = dateRange.futureDays ?? config.futureDays ?? 30;
                document.getElementById('pastDays').value = dateRange.pastDays ?? config.pastDays ?? 7;
            } catch (error) {
                console.error('載入系統配置失敗:', error);
                showAlert('❌ 載入系統配置失敗：' + error.message, 'error');
            }
        }

        async function saveSystemConfig() {
            try {
                const config = {
                    apiEventsUrl: document.getElementById('apiEventsUrl').value,
                    apiTeachersUrl: document.getElementById('apiTeachersUrl').value,
                    apiStudentsUrl: document.getElementById('apiStudentsUrl').value,
                    apiRemindersUrl: document.getElementById('apiRemindersUrl').value,
                    
                    cacheEventExpiry: parseInt(document.getElementById('cacheEventExpiry').value),
                    cacheTeacherExpiry: parseInt(document.getElementById('cacheTeacherExpiry').value),
                    cacheStudentExpiry: parseInt(document.getElementById('cacheStudentExpiry').value),
                    cacheEnabled: document.getElementById('cacheEnabled').checked,
                    
                    defaultView: document.getElementById('defaultView').value,
                    autoRefreshInterval: parseInt(document.getElementById('autoRefreshInterval').value),
                    showPastEvents: document.getElementById('showPastEvents').checked,
                    smartFilterEnabled: document.getElementById('smartFilterEnabled').checked,
                    
                    dateRange: {
                        futureDays: parseInt(document.getElementById('futureDays').value, 10),
                        pastDays: parseInt(document.getElementById('pastDays').value, 10)
                    }
                };
                
                // 🔥 修復：改為保存到後端 API
                const response = await fetch('/api/system-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(config)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    currentConfig.system = config;
                    console.log('✅ 系統配置已保存到後端:', config);
                    showAlert('✅ 系統配置已儲存', 'success');
                } else {
                    throw new Error(result.message || '儲存失敗');
                }
            } catch (error) {
                console.error('儲存系統配置失敗:', error);
                showAlert('❌ 儲存失敗：' + error.message, 'error');
            }
        }

