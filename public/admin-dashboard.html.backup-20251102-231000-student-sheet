        // 🔥 全域變數：儲存原始課程長度（分鐘）
        let originalCourseDuration = 0;
        
        /**
         * 🔥 預填當前事件的時間到改時間欄位
         */
        function fillCurrentEventTime() {
            // 從 adminEvents 中找到當前事件
            const event = window.adminEvents?.find(e => e.id === adminSelectedEventId);
            if (!event) return;
            
            // 將 Unix timestamp 轉換為 datetime-local 格式
            const startTime = new Date(event.dtstart * 1000);
            const endTime = new Date(event.dtend * 1000);
            
            // 🔥 計算原始課程長度（毫秒 → 分鐘）
            originalCourseDuration = Math.round((endTime - startTime) / 1000 / 60);
            
            // 格式化為 YYYY-MM-DDThh:mm
            const formatDateTime = (date) => {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                return `${year}-${month}-${day}T${hours}:${minutes}`;
            };
            
            document.getElementById('newStartTime').value = formatDateTime(startTime);
            document.getElementById('newEndTime').value = formatDateTime(endTime);
            
            // 🔥 更新課程長度顯示
            updateCourseDurationDisplay();
            
            console.log('✅ 已預填當前事件時間，課程長度:', originalCourseDuration, '分鐘');
        }
        
        /**
         * 🔥 更新課程長度顯示
         */
        function updateCourseDurationDisplay() {
            const durationSpan = document.getElementById('courseDuration');
            if (!durationSpan) return;
            
            const hours = Math.floor(originalCourseDuration / 60);
            const minutes = originalCourseDuration % 60;
            
            if (hours > 0 && minutes > 0) {
                durationSpan.textContent = `${hours} 小時 ${minutes} 分鐘`;
            } else if (hours > 0) {
                durationSpan.textContent = `${hours} 小時`;
            } else {
                durationSpan.textContent = `${minutes} 分鐘`;
            }
        }
        
        /**
         * 🔥 處理開始時間變化（自動調整結束時間以保持課程長度）
         */
        function handleStartTimeChange() {
            const startTimeInput = document.getElementById('newStartTime');
            const endTimeInput = document.getElementById('newEndTime');
            
            if (!startTimeInput.value || originalCourseDuration === 0) return;
            
            // 獲取新的開始時間
            const newStartTime = new Date(startTimeInput.value);
            
            // 🔥 自動計算結束時間 = 開始時間 + 原始課程長度
            const newEndTime = new Date(newStartTime.getTime() + originalCourseDuration * 60 * 1000);
            
            // 格式化並設定結束時間
            const year = newEndTime.getFullYear();
            const month = String(newEndTime.getMonth() + 1).padStart(2, '0');
            const day = String(newEndTime.getDate()).padStart(2, '0');
            const hours = String(newEndTime.getHours()).padStart(2, '0');
            const minutes = String(newEndTime.getMinutes()).padStart(2, '0');
            
            endTimeInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
            
            console.log('⏰ 開始時間變更，自動調整結束時間以保持', originalCourseDuration, '分鐘長度');
        }
        
        /**
         * 🔥 處理結束時間變化（自動調整開始時間以保持課程長度）
         */
        function handleEndTimeChange() {
            const startTimeInput = document.getElementById('newStartTime');
            const endTimeInput = document.getElementById('newEndTime');
            
            if (!endTimeInput.value || originalCourseDuration === 0) return;
            
            // 獲取新的結束時間
            const newEndTime = new Date(endTimeInput.value);
            
            // 🔥 自動計算開始時間 = 結束時間 - 原始課程長度
            const newStartTime = new Date(newEndTime.getTime() - originalCourseDuration * 60 * 1000);
            
            // 格式化並設定開始時間
            const year = newStartTime.getFullYear();
            const month = String(newStartTime.getMonth() + 1).padStart(2, '0');
            const day = String(newStartTime.getDate()).padStart(2, '0');
            const hours = String(newStartTime.getHours()).padStart(2, '0');
            const minutes = String(newStartTime.getMinutes()).padStart(2, '0');
            
            startTimeInput.value = `${year}-${month}-${day}T${hours}:${minutes}`;
            
            console.log('⏰ 結束時間變更，自動調整開始時間以保持', originalCourseDuration, '分鐘長度');
        }
        
        /**
         * 🔥 載入講師列表到選擇器（從 teacher_data.json 讀取講師名稱）
         */
        async function loadTeacherListToSelect() {
            try {
                // 🔥 從 /api/teachers 讀取（後端會載入 teacher_data.json）
                const response = await fetch('/api/teachers');
                const result = await response.json();
                
                if (result.success && result.data && result.data.teachers) {
                    const select = document.getElementById('substituteTeacher');
                    // 清空現有選項（保留第一個提示選項）
                    select.innerHTML = '<option value="">請選擇代課講師...</option>';
                    
                    // 🔥 從 teacher_data.json 的 teachers 陣列中讀取講師 name 欄位
                    // 這個 name 會用來更新行事曆名稱（例如：[代課-YOKI]）
                    result.data.teachers.forEach(teacher => {
                        const option = document.createElement('option');
                        option.value = teacher.name;  // 使用 name 欄位，這會用來更新行事曆標題
                        option.textContent = teacher.name;
                        select.appendChild(option);
                    });
                    
                    console.log('✅ 已從 teacher_data.json 載入講師列表:', result.data.teachers.length, '位');
                } else {
                    console.error('❌ 載入講師列表失敗');
                }
            } catch (error) {
                console.error('❌ 載入講師列表錯誤:', error);
            }
        }
        
        /**
         * 確認特殊事件標記
         */
        async function confirmSpecialEventMark() {
            if (!adminSelectedEventId || !adminSelectedEventType) {
                showToast('❌ 請選擇特殊事件類型', 'error');
                return;
            }
            
            const note = document.getElementById('specialEventNote').value;
            
            // 🔥 構建請求資料，根據類型包含額外欄位
            const requestData = {
                eventId: adminSelectedEventId,
                specialType: adminSelectedEventType,
                note: note
            };
            
            // 🔥 如果是「改時間」，需要收集新的時間
            if (adminSelectedEventType === '改時間') {
                const newStartTimeStr = document.getElementById('newStartTime').value;
                const newEndTimeStr = document.getElementById('newEndTime').value;
                
                if (!newStartTimeStr || !newEndTimeStr) {
                    showToast('❌ 請選擇新的上課時間', 'error');
                    return;
                }
                
                // 轉換為 Unix timestamp
                const newStartTime = Math.floor(new Date(newStartTimeStr).getTime() / 1000);
                const newEndTime = Math.floor(new Date(newEndTimeStr).getTime() / 1000);
                
                if (newEndTime <= newStartTime) {
                    showToast('❌ 結束時間必須晚於開始時間', 'error');
                    return;
                }
                
                requestData.newStartTime = newStartTime;
                requestData.newEndTime = newEndTime;
                
                console.log('📝 改時間資料:', {
                    原始: { start: newStartTimeStr, end: newEndTimeStr },
                    Unix: { start: newStartTime, end: newEndTime }
                });
            }
            
            // 🔥 如果是「代課」，需要收集代課講師
            if (adminSelectedEventType === '代課') {
                const substituteTeacher = document.getElementById('substituteTeacher').value;
                
                if (!substituteTeacher) {
                    showToast('❌ 請選擇代課講師', 'error');
                    return;
                }
                
                requestData.substituteTeacher = substituteTeacher;
                
                console.log('📝 代課資料:', { teacher: substituteTeacher });
            }
            
            try {
                showToast('處理中...', 'info');
                
                console.log('📤 發送標記請求:', requestData);
                
                const response = await fetch('/api/events/mark-special', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(requestData)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    let message = '✅ 特殊事件標記成功';
                    if (adminSelectedEventType === '改時間') {
                        message += '\n⏰ 課程時間已更新';
                    } else if (adminSelectedEventType === '代課') {
                        message += `\n👨‍🏫 代課講師：${requestData.substituteTeacher}`;
                    }
                    showToast(message, 'success');
                    closeSpecialEventModal();
                    // 重新載入課程
                    await loadAdminEvents();
                } else {
                    throw new Error(result.error || '標記失敗');
                }
            } catch (error) {
                console.error('❌ 標記失敗:', error);
                showToast('❌ 標記失敗：' + error.message, 'error');
            }
        }
        
        /**
         * 移除特殊事件標記
         */
        async function removeSpecialEventMark() {
            if (!adminSelectedEventId) {
                showToast('❌ 無效的課程', 'error');
                return;
            }
            
            if (!confirm('確定要移除此課程的特殊事件標記嗎？')) {
                return;
            }
            
            try {
                showToast('處理中...', 'info');
                
                const response = await fetch('/api/events/remove-special', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        eventId: adminSelectedEventId
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showToast('✅ 特殊事件標記已移除', 'success');
                    closeSpecialEventModal();
                    // 重新載入課程
                    await loadAdminEvents();
                } else {
                    throw new Error(result.error || '移除失敗');
                }
            } catch (error) {
                console.error('❌ 移除失敗:', error);
                showToast('❌ 移除失敗：' + error.message, 'error');
            }
        }
        
        /**
         * 當切換到特殊事件頁面時載入課程
         */
        const originalNavigateTo = window.navigateTo;
        window.navigateTo = function(pageId, group, name, event) {
            originalNavigateTo(pageId, group, name, event);
            if (pageId === 'special-events' && adminAllEvents.length === 0) {
                loadAdminEvents();
            }
        };
    </script>
</body>
</html>
