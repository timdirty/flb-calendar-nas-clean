        async function loadCacheStatus() {
            try {
                const grid = document.getElementById('cacheStatusGrid');
                
                const caches = [
                    {name: '事件緩存', key: 'synology_events_cache_v2'},
                    {name: '講師緩存', key: 'flb_teachers_cache'},
                    {name: '學生緩存', key: 'flb_students_cache'}
                ];
                
                grid.innerHTML = caches.map(cache => {
                    const data = localStorage.getItem(cache.key);
                    const size = data ? (data.length / 1024).toFixed(2) : '0';
                    const count = data ? JSON.parse(data).length || 1 : 0;
                    
                    return `
                        <div class="stat-card">
                            <h3>${size} KB</h3>
                            <p>${cache.name}</p>
                            <small>${count} 項目</small>
                        </div>
                    `;
                }).join('');
                
                // 更新儲存空間資訊
                updateStorageInfo();
            } catch (error) {
                console.error('載入緩存狀態失敗:', error);
            }
        }

        function updateStorageInfo() {
            let localStorageSize = 0;
            let localStorageCount = 0;
            for (let key in localStorage) {
                if (localStorage.hasOwnProperty(key)) {
                    localStorageSize += localStorage[key].length;
                    localStorageCount++;
                }
            }
            
            let sessionStorageSize = 0;
            let sessionStorageCount = 0;
            for (let key in sessionStorage) {
                if (sessionStorage.hasOwnProperty(key)) {
                    sessionStorageSize += sessionStorage[key].length;
                    sessionStorageCount++;
                }
            }
            
            document.getElementById('localStorageSize').textContent = (localStorageSize / 1024).toFixed(2) + ' KB';
            document.getElementById('localStorageCount').textContent = localStorageCount;
            document.getElementById('sessionStorageSize').textContent = (sessionStorageSize / 1024).toFixed(2) + ' KB';
            document.getElementById('sessionStorageCount').textContent = sessionStorageCount;
        }

