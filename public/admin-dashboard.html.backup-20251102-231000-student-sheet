        /**
         * 篩選臨時學生列表
         */
        function filterTemporaryStudents() {
            const typeFilter = document.getElementById('tempStudentTypeFilter')?.value || '';
            const courseFilter = document.getElementById('tempStudentCourseFilter')?.value || '';
            const dateFrom = document.getElementById('tempStudentDateFrom')?.value || '';
            const dateTo = document.getElementById('tempStudentDateTo')?.value || '';
            const nameSearch = document.getElementById('tempStudentNameSearch')?.value.trim().toLowerCase() || '';
            
            // 篩選邏輯
            filteredTempStudents = allTempStudents.filter(student => {
                // 類型篩選
                if (typeFilter) {
                    const studentType = student.type === 'makeup' ? '補課' : '體驗';
                    if (studentType !== typeFilter) return false;
                }
                
                // 課程篩選
                if (courseFilter && student.course !== courseFilter) return false;
                
                // 日期範圍篩選
                if (dateFrom && student.scheduledDate < dateFrom) return false;
                if (dateTo && student.scheduledDate > dateTo) return false;
                
                // 姓名搜尋
                if (nameSearch && !student.name?.toLowerCase().includes(nameSearch)) return false;
                
                return true;
            });
            
            // 更新計數
            const countElement = document.getElementById('tempStudentCount');
            if (countElement) {
                countElement.textContent = filteredTempStudents.length;
            }
            
            // 渲染篩選後的結果
            renderFilteredTempStudents();
            
            console.log(`🔍 篩選結果: ${filteredTempStudents.length} / ${allTempStudents.length}`);
        }
        
