            tbody.innerHTML = Object.entries(teachers).map(([name, userId]) => {
                // ✅ 確保所有欄位都有值，避免 undefined
                const teacherName = String(name || '未知講師');
                const teacherUserId = String(userId || '');
                
                // ✅ 為 onclick 屬性準備安全的參數
                const nameParam = JSON.stringify(teacherName);
                
                // 轉義顯示內容
                const safeName = escapeHtml(teacherName);
                const safeUserId = escapeHtml(teacherUserId);
                const color = getTeacherColor(teacherName);
                
                return `
