                const liffClientId = document.getElementById('liffClientId').value.trim();
                
                if (!lineToken) {
                    showAlert('❌ 請輸入 LINE Channel Access Token', 'error');
                    return;
                }
                
                // 驗證 Token 格式
                if (lineToken.length < 100) {
                    showAlert('⚠️ Token 長度似乎不正確，請確認是否複製完整', 'warning');
                }
                
                const response = await fetch('/api/line-config', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        lineChannelToken: lineToken,
                        liffClientId: liffClientId
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showAlert('✅ LINE 配置儲存成功！\n⚠️ 請重啟 Docker 服務以載入新配置', 'success');
                    
