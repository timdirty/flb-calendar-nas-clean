        function updateSpecialEventsPreview() {
            const preview = document.getElementById('specialEventsPreview');
            if (!preview) return;
            
            const types = ['停課', '體驗', '代課', '改時間'];
            const icons = {
                '停課': '🔴',
                '體驗': '🟢',
                '代課': '🔵',
                '改時間': '🟠'
            };
            
            let html = '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px;">';
            
            types.forEach(type => {
                const keywordsInput = document.getElementById(`keywords_${type}`);
                const enabledCheckbox = document.getElementById(`enabled_${type}`);
                const colorInput = document.getElementById(`color_${type}`);
                
                if (!keywordsInput || !enabledCheckbox || !colorInput) return;
                
                const keywords = keywordsInput.value.split(',').map(k => k.trim()).filter(k => k);
                const enabled = enabledCheckbox.checked;
                const color = colorInput.value;
                
                html += `
                    <div style="border: 2px solid ${color}; border-radius: 12px; padding: 15px; 
                                background: ${enabled ? 'white' : '#f5f5f5'}; 
                                opacity: ${enabled ? '1' : '0.5'};">
