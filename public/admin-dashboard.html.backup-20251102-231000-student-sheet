                document.getElementById('periodParsedSuccess').textContent = successCount;
                document.getElementById('periodParsedFail').textContent = failCount;
                document.getElementById('periodTotal').textContent = students.length;
                
                const successRate = students.length > 0 
                    ? ((successCount / students.length) * 100).toFixed(1) + '%'
                    : '0%';
                document.getElementById('periodSuccessRate').textContent = successRate;
                
