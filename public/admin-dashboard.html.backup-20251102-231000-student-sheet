        /**
         * 標準化課程名稱（轉大寫、去除前後空白）
         */
        function normalizeCourseType(courseType) {
            if (!courseType) return '';
            return courseType.toString().trim().toUpperCase();
        }
        
        /**
         * 載入課程類別（自動模糊匹配大小寫與空白）
         */
        async function loadCourseTypesForLeave() {
            try {
                const response = await fetch('/api/students');
                const data = await response.json();
                
                // 提取所有不重複的課程類別
                const students = data.students || [];
                console.log(`📚 取得學生資料: ${students.length} 位學生`);
                
                if (students.length === 0) {
                    console.warn('⚠️ 無學生資料');
                    return;
                }
                
                // 🔥 使用 Map 來追蹤標準化名稱，確保只保留大寫版本
                const courseMap = new Map();
                students.forEach(student => {
                    if (student.course) {
                        const normalized = normalizeCourseType(student.course);
                        if (normalized && !courseMap.has(normalized)) {
                            courseMap.set(normalized, normalized);  // 保留大寫版本
                        }
                    }
                });
                
                // 轉換為陣列並排序
                const courses = Array.from(courseMap.values()).sort();
                
                console.log(`📚 載入 ${courses.length} 個課程類別（已標準化）:`, courses);
                
                // 填充到表單的課程選擇
                const courseSelect = document.getElementById('leaveCourseType');
                courseSelect.innerHTML = '<option value="">請選擇課程類別</option>';
                courses.forEach(course => {
                    const option = document.createElement('option');
                    option.value = course;
                    option.textContent = course;
                    courseSelect.appendChild(option);
                });
                
                // 填充到篩選器的課程選擇
                const filterSelect = document.getElementById('leaveFilterCourse');
                filterSelect.innerHTML = '<option value="">全部</option>';
                courses.forEach(course => {
                    const option = document.createElement('option');
                    option.value = course;
                    option.textContent = course;
                    filterSelect.appendChild(option);
                });
                
            } catch (error) {
                console.error('❌ 載入課程類別失敗:', error);
                showToast('載入課程類別失敗', 'error');
            }
        }

        /**
         * 根據課程載入學生列表（支援模糊匹配 + 剩餘堂數篩選）
         */
        async function loadStudentsForLeave() {
            const courseType = document.getElementById('leaveCourseType').value;
            const studentSelect = document.getElementById('leaveStudentSelect');
            
            if (!courseType) {
                studentSelect.innerHTML = '<option value="">請先選擇課程類別</option>';
                leaveStudentsCache = [];
                return;
            }
            
            try {
                const response = await fetch('/api/students');
                const data = await response.json();
                
                const students = data.students || [];
                
                // 🔥 使用標準化比較，支援大小寫與空白模糊匹配
                const normalizedCourseType = normalizeCourseType(courseType);
                let matchedStudents = students.filter(s => 
                    normalizeCourseType(s.course) === normalizedCourseType
                );
                
                // 🔥 獲取學生篩選規則配置（與補課學生邏輯一致）
                let minRemainingClasses = 1; // 預設最小堂數
                try {
                    const filterResponse = await fetch('/api/student-filter-config');
                    const filterResult = await filterResponse.json();
                    if (filterResult.success && filterResult.config) {
                        minRemainingClasses = filterResult.config.minRemainingClasses || 1;
                        console.log(`📋 學生篩選規則 - 最小剩餘堂數: ${minRemainingClasses}`);
                    }
                } catch (error) {
                    console.warn('⚠️ 無法載入學生篩選配置，使用預設值:', error);
                }
                
                // 🔥 根據剩餘堂數篩選學生
                const totalMatched = matchedStudents.length;
                leaveStudentsCache = matchedStudents.filter(s => {
                    const remaining = parseInt(s.remaining) || 0;
                    return remaining >= minRemainingClasses;
                });
                
                console.log(`🔍 ${courseType} 學生篩選結果: ${leaveStudentsCache.length} / ${totalMatched} 位學生 (剩餘堂數 >= ${minRemainingClasses})`);
                
                studentSelect.innerHTML = '';
                if (leaveStudentsCache.length === 0) {
                    studentSelect.innerHTML = '<option value="">該課程無符合條件的學生（剩餘堂數不足）</option>';
                } else {
                    // 按姓名排序
                    leaveStudentsCache.sort((a, b) => a.name.localeCompare(b.name, 'zh-TW'));
                    
                    leaveStudentsCache.forEach(student => {
                        const option = document.createElement('option');
                        option.value = student.name;
                        // 顯示剩餘堂數資訊
                        const remainingDisplay = student.remaining ? ` [剩餘${student.remaining}堂]` : '';
                        option.textContent = `${student.name}${remainingDisplay}`;
                        studentSelect.appendChild(option);
                    });
                }
                
                // 清空搜尋
                document.getElementById('leaveStudentSearch').value = '';
                
            } catch (error) {
                console.error('❌ 載入學生列表失敗:', error);
                showToast('載入學生列表失敗', 'error');
            }
        }

