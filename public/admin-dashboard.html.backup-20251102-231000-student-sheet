            try {
                const response = await fetch('/api/students');
                const result = await response.json();
                
                if (result.success && result.students) {
                    // 🔥 修復：使用正確的資料格式 result.students
                    // 只保留正常學生（不包含臨時學生）
                    let students = result.students.filter(s => !s.id || !s.id.startsWith('temp_'));
                    
                    // 🔥 獲取學生篩選規則配置
                    let minRemainingClasses = 1; // 預設最小堂數
                    try {
                        const filterResponse = await fetch('/api/student-filter-config');
                        const filterResult = await filterResponse.json();
                        if (filterResult.success && filterResult.config) {
                            minRemainingClasses = filterResult.config.minRemainingClasses || 1;
