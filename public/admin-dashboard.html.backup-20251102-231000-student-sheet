        /**
         * 執行匹配測試
         */
        async function runMatchTest() {
            try {
                const courseName = document.getElementById('testCourseName').value.trim();
                const weekday = document.getElementById('testWeekday').value;
                const startTime = document.getElementById('testStartTime').value;
                const endTime = document.getElementById('testEndTime').value;
                
                if (!courseName) {
                    showAlert('請輸入課程名稱', 'warning');
                    return;
                }
                
                if (!startTime || !endTime) {
                    showAlert('請輸入完整的時間範圍', 'warning');
                    return;
                }
                
                showAlert('🔄 正在測試匹配...', 'info');
                
                // 載入課程匹配器（使用簡單穩定版）
                if (typeof CourseStudentMatcher === 'undefined') {
                    // 動態載入
                    const script = document.createElement('script');
                    script.src = '/js/modules/course-student-matcher.js?v=2025-02-01-stable';
                    document.head.appendChild(script);
                    await new Promise(resolve => script.onload = resolve);
                }
                
                // 獲取學生資料
                const response = await fetch('/api/students');
                const studentData = await response.json();
                
                // 構建測試事件
                const testEvent = {
                    title: courseName,
                    weekday: weekday,
                    start: `2025-01-01T${startTime}:00`,
                    end: `2025-01-01T${endTime}:00`
                };
                
                // 使用匹配器查找學生
                const matchedStudents = CourseStudentMatcher.findStudentsByCourse(
                    courseName, 
                    studentData,
                    { event: testEvent, minConfidence: 60 }
                );
                
                // 顯示結果
                const resultsDiv = document.getElementById('matchTestResults');
                let html = '<div style="background: #f9fafb; padding: 20px; border-radius: 12px; margin-top: 20px;">';
                html += `<h3 style="margin-bottom: 15px; color: #374151;">
                    <i class="fas fa-list"></i> 匹配結果 (找到 ${matchedStudents.length} 位學生)
                </h3>`;
                
                if (matchedStudents.length === 0) {
                    html += '<p style="color: #9ca3af;">沒有找到匹配的學生</p>';
                } else {
                    html += '<div style="overflow-x: auto;">';
                    html += '<table style="width: 100%; border-collapse: collapse; background: white;">';
                    html += '<thead><tr style="background: #e5e7eb;">';
                    html += '<th style="padding: 10px; text-align: left;">學生</th>';
                    html += '<th style="padding: 10px; text-align: left;">Period</th>';
                    html += '<th style="padding: 10px; text-align: left;">信心度</th>';
                    html += '<th style="padding: 10px; text-align: left;">匹配原因</th>';
                    html += '</tr></thead><tbody>';
                    
                    matchedStudents.forEach(student => {
                        const confidence = student._matchConfidence || 0;
                        const reason = student._matchReason || '-';
                        const confidenceColor = confidence >= 90 ? '#10b981' : confidence >= 70 ? '#f59e0b' : '#ef4444';
                        
                        html += '<tr style="border-bottom: 1px solid #e5e7eb;">';
                        html += `<td style="padding: 10px;">${student.name}</td>`;
                        html += `<td style="padding: 10px; font-family: monospace;">${student.period || '-'}</td>`;
                        html += `<td style="padding: 10px; font-weight: 600; color: ${confidenceColor};">${confidence} 分</td>`;
                        html += `<td style="padding: 10px; font-size: 0.85rem;">${reason}</td>`;
                        html += '</tr>';
                    });
                    
                    html += '</tbody></table></div>';
                }
                
                html += '</div>';
                resultsDiv.innerHTML = html;
                
                showAlert(`✅ 測試完成！找到 ${matchedStudents.length} 位學生`, 'success');
            } catch (error) {
                console.error('測試失敗:', error);
                showAlert('❌ 測試失敗: ' + error.message, 'error');
            }
        }
        
