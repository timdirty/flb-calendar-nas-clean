        // ==================== 導航切換 ====================
        function navigateTo(pageId, groupName, pageName, event) {
            // 更新側邊欄 active 狀態
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            
            // 如果有 event，使用它來找到點擊的元素；否則通過 pageId 找到對應的導航項
            if (event && event.target) {
                const navItem = event.target.closest('.nav-item');
                if (navItem) {
                    navItem.classList.add('active');
                }
            } else {
                // 通過 data-page 屬性找到對應的導航項
                const navItems = document.querySelectorAll('.nav-item');
                navItems.forEach(item => {
                    const onClick = item.getAttribute('onclick');
                    if (onClick && onClick.includes(`'${pageId}'`)) {
                        item.classList.add('active');
                    }
                });
            }

            // 更新麵包屑
            document.getElementById('breadcrumb-group').textContent = groupName;
            document.getElementById('breadcrumb-page').textContent = pageName;

            // 更新內容顯示
            document.querySelectorAll('.page-content').forEach(content => content.classList.remove('active'));
            const targetPage = document.getElementById(pageId);
            if (targetPage) {
                targetPage.classList.add('active');
            }

            // 手機版自動關閉側邊欄
            if (window.innerWidth <= 768) {
                document.getElementById('sidebar').classList.remove('show');
            }

            // 載入對應數據
            switch(pageId) {
                case 'dashboard':
                    loadDashboardStats();
                    break;
                case 'teachers':
                    loadTeachers();
                    break;
                case 'students':
                    loadStudents();
                    break;
                case 'logs':
                    loadLogs();
                    break;
                case 'cache':
                    loadCacheStatus();
                    break;
                case 'special-events':
                    loadSpecialEventsConfig();
                    loadAdminEvents(); // 🔥 載入課程資料，讓特殊事件標記功能可用
                    break;
                case 'student-filter':
                    loadStudentFilterConfig();
                    break;
                case 'course-categories':
                    loadCourseCategoriesConfig();
                    break;
                case 'temporary-students':
                    ensureTempStudentFormSetup();
                    loadTemporaryStudents();
                    loadStudentListForTempSelect();
                    loadParentUsers(); // 🔥 載入家長資料
                    break;
                case 'student-leave':
                    initStudentLeave();
                    break;
            }
        }

        // ==================== 手機版選單控制 ====================
        function toggleMobileSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('show');
        }

        // 點擊側邊欄外部時關閉（手機版）
        document.addEventListener('click', function(e) {
            const sidebar = document.getElementById('sidebar');
            const toggle = document.querySelector('.mobile-menu-toggle');
            
            if (window.innerWidth <= 768 && 
                sidebar.classList.contains('show') && 
                !sidebar.contains(e.target) && 
                !toggle.contains(e.target)) {
                sidebar.classList.remove('show');
            }
        });

        // ==================== 儀表板統計載入 ====================
        async function loadDashboardStats() {
            try {
                // 載入講師數量
                const teachersResponse = await fetch('/api/teachers');
                if (teachersResponse.ok) {
                    const teachersData = await teachersResponse.json();
                    // 處理不同的回應格式
                    let teachersCount = 0;
                    if (Array.isArray(teachersData)) {
                        teachersCount = teachersData.length;
                    } else if (teachersData.data && Array.isArray(teachersData.data)) {
                        teachersCount = teachersData.data.length;
                    } else if (teachersData.data && teachersData.data.teachers) {
                        teachersCount = Object.keys(teachersData.data.teachers).length;
                    }
                    document.getElementById('statInstructors').textContent = teachersCount;
                }

                // 載入學生數量
                const studentsResponse = await fetch('/api/students');
                if (studentsResponse.ok) {
                    const studentsData = await studentsResponse.json();
                    // 處理不同的回應格式
                    let studentsCount = 0;
                    if (Array.isArray(studentsData)) {
                        studentsCount = studentsData.length;
                    } else if (studentsData.data && Array.isArray(studentsData.data)) {
                        studentsCount = studentsData.data.length;
                    } else if (studentsData.success && studentsData.data) {
                        studentsCount = Array.isArray(studentsData.data) ? studentsData.data.length : 0;
                    }
                    document.getElementById('statStudents').textContent = studentsCount;
                }

                // 載入課程類型數量（從系統設定中取得）
                const settingsResponse = await fetch('/api/system-settings');
                if (settingsResponse.ok) {
                    const settings = await settingsResponse.json();
                    const courseTypes = settings.courseCategories || [];
                    document.getElementById('statCourseTypes').textContent = courseTypes.length || 0;
                }

                // 載入本月課程數量
                const now = new Date();
                const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
                const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
                
                const eventsResponse = await fetch('/api/events');
                if (eventsResponse.ok) {
                    const eventsData = await eventsResponse.json();
                    // 處理不同的回應格式
                    let events = [];
                    if (Array.isArray(eventsData)) {
                        events = eventsData;
                    } else if (eventsData.events && Array.isArray(eventsData.events)) {
                        events = eventsData.events;
                    } else if (eventsData.data && Array.isArray(eventsData.data)) {
                        events = eventsData.data;
                    } else if (eventsData.success && eventsData.data && Array.isArray(eventsData.data)) {
                        events = eventsData.data;
                    }
                    
                    const thisMonthEvents = events.filter(event => {
                        const eventDate = new Date(event.start);
                        return eventDate >= firstDay && eventDate <= lastDay;
                    });
                    document.getElementById('statEvents').textContent = thisMonthEvents.length || 0;
                }

                // 本月簽到數（這個需要根據實際的簽到 API 調整）
                document.getElementById('statAttendance').textContent = '-';

                // 待發通知數（暫時顯示為 0）
                document.getElementById('statReminders').textContent = '0';

            } catch (error) {
                console.error('❌ 載入儀表板統計失敗:', error);
            }
        }

