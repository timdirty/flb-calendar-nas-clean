        async function refreshPeriodAnalysis() {
            try {
                showAlert('🔄 正在分析學生時段資料...', 'info');
                
                // 獲取學生資料
                const response = await fetch('/api/students');
                const data = await response.json();
                
                if (!data.students || !Array.isArray(data.students)) {
                    throw new Error('學生資料格式錯誤');
                }
                
                const students = data.students;
                let successCount = 0;
                let failCount = 0;
                const failedStudents = [];
                
                // 分析每個學生的 periodParsed
                students.forEach(student => {
                    if (student.periodParsed && student.periodParsed.startTime && student.periodParsed.endTime) {
                        successCount++;
                    } else if (student.period) {
                        failCount++;
                        failedStudents.push(student);
                    }
