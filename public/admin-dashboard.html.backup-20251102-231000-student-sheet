        /**
         * 篩選請假記錄
         */
        function filterLeaveRecords() {
            const courseFilter = document.getElementById('leaveFilterCourse').value.toLowerCase();
            const dateFrom = document.getElementById('leaveFilterDateFrom').value;
            const dateTo = document.getElementById('leaveFilterDateTo').value;
            const studentFilter = document.getElementById('leaveFilterStudent').value.toLowerCase();
            
            filteredLeaveRecords = allLeaveRecords.filter(record => {
                // 課程篩選
                if (courseFilter && record.course.toLowerCase() !== courseFilter) {
                    return false;
                }
                
                // 日期範圍篩選
                if (dateFrom && record.date < dateFrom) {
                    return false;
                }
                if (dateTo && record.date > dateTo) {
                    return false;
                }
                
                // 學生姓名篩選
                if (studentFilter && !record.studentName.toLowerCase().includes(studentFilter)) {
                    return false;
                }
                
                return true;
            });
            
            console.log(`🔍 篩選結果: ${filteredLeaveRecords.length}/${allLeaveRecords.length} 筆`);
            renderLeaveRecords();
        }

        /**
         * 渲染請假記錄表格
         */
        function renderLeaveRecords() {
            const tbody = document.getElementById('leaveRecordsTableBody');
            
            // 更新記錄數量顯示
            const countElement = document.getElementById('leaveRecordCount');
            if (countElement) {
                countElement.textContent = filteredLeaveRecords.length;
            }
            
            if (filteredLeaveRecords.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 40px;">
                            <i class="fas fa-inbox" style="color: #d1d5db; font-size: 3rem; margin-bottom: 15px; display: block;"></i>
                            <p style="color: #999; font-size: 1.1rem; margin: 0;">${allLeaveRecords.length === 0 ? '尚無請假記錄' : '無符合的記錄'}</p>
                            <p style="color: #ccc; font-size: 0.9rem; margin-top: 8px;">請使用上方表單登記學生請假</p>
                        </td>
                    </tr>
                `;
                return;
            }
            
            tbody.innerHTML = filteredLeaveRecords.filter(record => record).map(record => {
                
                const notifyStatus = record.notified === true
                    ? '<span style="color: #4caf50;">✓ 已通知</span>' 
                    : '<span style="color: #ff9800;">⊗ 未通知</span>';
                
                let registeredTime = '未知';
                try {
                    if (record.registeredAt) {
                        const date = new Date(record.registeredAt);
                        if (!isNaN(date.getTime())) {
                            registeredTime = date.toLocaleString('zh-TW', {
                                timeZone: 'Asia/Taipei',
                                month: '2-digit',
                                day: '2-digit',
                                hour: '2-digit',
                                minute: '2-digit'
                            });
                        }
                    }
                } catch (error) {
                    console.warn('日期格式錯誤:', record.registeredAt);
                }
                
                // 確保所有欄位都有值，避免 undefined
                const studentName = String(record.studentName || '未知');
                const course = String(record.course || '未知');
                const date = String(record.date || '未知');
                const weekday = String(record.weekday || '');
                const reason = String(record.reason || '未填寫');
                
                // 轉義所有用戶輸入的內容
                const safeName = escapeHtml(studentName);
                const safeCourse = escapeHtml(course);
                const safeDate = escapeHtml(date);
                const safeWeekday = escapeHtml(weekday);
                const safeReason = escapeHtml(reason);
                
                // 為 onclick 屬性準備安全的參數（確保 JSON.stringify 不會返回 undefined）
                const nameParam = JSON.stringify(studentName);
                const courseParam = JSON.stringify(course);
                const dateParam = JSON.stringify(date);
                const reasonParam = JSON.stringify(reason);
                const weekdayParam = JSON.stringify(weekday);
                
                // 🔥 準備記錄 ID 參數
                const recordId = String(record.id || '');
                const idParam = JSON.stringify(recordId);
                
                return `
                    <tr>
                        <td>${safeName}</td>
                        <td>${safeCourse}</td>
                        <td>${safeDate}</td>
                        <td>星期${safeWeekday}</td>
                        <td>${safeReason}</td>
                        <td>${registeredTime}</td>
                        <td>${notifyStatus}</td>
                        <td>
                            <div style="display: flex; gap: 5px;">
                                <button class="btn btn-sm btn-primary" 
                                        onclick='editLeaveRecord(${idParam})'
                                        title="編輯">
                                    <i class="fas fa-edit"></i>
                                </button>
                                ${record.notified !== true ? `
                                    <button class="btn btn-sm btn-secondary" 
                                            onclick='sendLeaveNotificationForRecord(this, ${nameParam}, ${courseParam}, ${dateParam}, ${reasonParam}, ${weekdayParam})'
                                            title="發送通知">
                                        <i class="fas fa-paper-plane"></i>
                                    </button>
                                ` : ''}
                                <button class="btn btn-sm btn-danger" 
                                        onclick='cancelLeaveRecord(this, ${nameParam}, ${courseParam}, ${dateParam})'
                                        title="取消請假">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // 🔥 請假記錄編輯相關變數
        let editingLeaveRecordId = null;
        let allLeaveRecordsCache = [];  // 快取所有請假記錄
        
        /**
         * 編輯請假記錄（使用 Modal）
         */
        async function editLeaveRecord(recordId) {
            try {
                editingLeaveRecordId = recordId;
                console.log('📝 編輯請假記錄:', recordId);
                
                // 🔥 從快取或記錄列表中找到記錄
                let record = allLeaveRecordsCache.find(r => r.id === recordId);
                
                if (!record) {
                    // 如果快取中沒有，從 filteredLeaveRecords 中找
                    record = filteredLeaveRecords.find(r => r.id === recordId);
                }
                
                if (!record) {
                    showToast('❌ 找不到該請假記錄', 'error');
                    return;
                }
                
                // 填充表單
                document.getElementById('editLeaveStudentName').value = record.studentName || '';
                document.getElementById('editLeaveCourse').value = record.course || '';
                document.getElementById('editLeaveDate').value = record.date || '';
                
                // 設定請假原因
                const reasonSelect = document.getElementById('editLeaveReason');
                const reasonCustom = document.getElementById('editLeaveReasonCustom');
                const predefinedReasons = ['生病', '家庭因素', '臨時有事', '學校考試'];
                
                if (predefinedReasons.includes(record.reason)) {
                    reasonSelect.value = record.reason;
                    reasonCustom.style.display = 'none';
                } else if (record.reason && record.reason !== '未填寫') {
                    reasonSelect.value = '其他';
                    reasonCustom.style.display = 'block';
                    reasonCustom.value = record.reason;
                } else {
                    reasonSelect.value = '';
                    reasonCustom.style.display = 'none';
                }
                
                // 顯示 Modal
                document.getElementById('editLeaveRecordModal').style.display = 'block';
                document.body.style.overflow = 'hidden';
                
            } catch (error) {
                console.error('載入請假記錄失敗:', error);
                showToast('❌ 載入失敗：' + error.message, 'error');
            }
        }
        
        /**
         * 關閉請假編輯 Modal
         */
        function closeLeaveEditModal() {
            document.getElementById('editLeaveRecordModal').style.display = 'none';
            document.body.style.overflow = 'auto';
            editingLeaveRecordId = null;
        }
        
        /**
         * 處理編輯請假原因變更
         */
        function handleEditLeaveReasonChange() {
            const reasonSelect = document.getElementById('editLeaveReason');
            const customInput = document.getElementById('editLeaveReasonCustom');
            
            if (reasonSelect.value === '其他') {
                customInput.style.display = 'block';
                customInput.required = true;
            } else {
                customInput.style.display = 'none';
                customInput.required = false;
                customInput.value = '';
