                    } catch (error) {
                        console.warn('⚠️ 無法載入學生篩選配置，使用預設值:', error);
                    }
                    
                    // 🔥 根據剩餘堂數篩選學生
                    const totalStudents = students.length;
                    allStudentsForSelection = students.filter(s => {
                        const remaining = parseInt(s.remaining) || 0;
                        return remaining >= minRemainingClasses;
                    });
                    
                    console.log(`🔍 學生篩選結果: ${allStudentsForSelection.length} / ${totalStudents} 位學生 (剩餘堂數 >= ${minRemainingClasses})`);
                    
                    courseTimeOptions = {};
                    
