        /**
         * 重新整理請假記錄
         */
        async function refreshLeaveRecords() {
            const btn = event.target.closest('button');
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 載入中';
            btn.disabled = true;
            
