        // New function
        async function updateAvailableTimes() {
          const date = document.getElementById('tempStudentDate').value;
          if (!date) return;

          const course = document.getElementById('tempStudentCourse').value.trim().toUpperCase();

          try {
            const response = await fetch(`/api/events?date=${date}`);
            const data = await response.json();

            if (data.success) {
              let events = data.data || [];

              // 僅保留與所選日期相同的事件（以本地時區判斷）
              const selectedDate = date; // yyyy-mm-dd
              const toYMD = (dt) => {
                const y = dt.getFullYear();
                const m = String(dt.getMonth() + 1).padStart(2, '0');
                const d = String(dt.getDate()).padStart(2, '0');
                return `${y}-${m}-${d}`;
              };
              events = events.filter(ev => {
                try {
                  const local = new Date(ev.start);
                  return toYMD(local) === selectedDate;
                } catch (_) { return false; }
              });

              // Filter by course if provided
              if (course) {
                events = events.filter(event => event.title.toUpperCase().includes(course));
              }

              // Generate time options
              const timeOptions = events
                .map(event => (event.title || '').trim())
                .filter(title => title);

              // Remove duplicates
              const uniqueOptions = [...new Set(timeOptions)];

              const select = document.getElementById('tempStudentTimeSelect');
              select.innerHTML = uniqueOptions.map(opt => `<option value="${opt}">${opt}</option>`).join('') + 
                                 (uniqueOptions.length > 0 ? '<option value="__custom__">自訂時段</option>' : '');

              if (uniqueOptions.length === 0) {
                setCustomTimeMode();
              }
            }
          } catch (error) {
            console.error('Failed to fetch available times:', error);
          }
        }

