        // ==================== 講師管理 ====================
        async function loadTeachers() {
            try {
                const response = await fetch('/api/teachers');
                const data = await response.json();
                
                if (data.success && data.data && data.data.teachers) {
                    // 🔥 修復：儲存完整的陣列格式（包含 color）
                    const teachersArray = data.data.teachers;
                    
                    // 為了向後兼容，同時維護物件格式
                    const teachersObject = {};
                    teachersArray.forEach(teacher => {
                        teachersObject[teacher.name] = teacher.userId;
                    });
                    
                    currentConfig.teachers = teachersObject;
                    currentConfig.teachersArray = teachersArray; // 保存完整陣列（包含顏色）
                    console.log('✅ 載入講師資料:', teachersArray);
                    renderTeachersTable();
                    renderTeacherColors();
                } else {
                    console.warn('⚠️ 講師資料格式不正確');
                    currentConfig.teachers = {};
                    currentConfig.teachersArray = [];
                    renderTeachersTable();
                }
