    <script>
        // 🔥 進階搜尋幫助提示功能
        function initSearchHelp() {
            const helpBtn = document.getElementById('searchHelpBtn');
            const helpTooltip = document.getElementById('searchHelpTooltip');
            const helpClose = document.getElementById('searchHelpClose');
            const searchSuggestions = document.getElementById('searchSuggestions');
            
            if (!helpBtn || !helpTooltip || !helpClose) {
                console.warn('⚠️ 搜尋幫助元素不完整');
                return;
            }
            
            // 顯示幫助提示
            helpBtn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                
                const isVisible = helpTooltip.style.display === 'block';
                
                if (isVisible) {
                    helpTooltip.style.display = 'none';
                } else {
                    // 隱藏搜尋建議
                    if (searchSuggestions) {
                        searchSuggestions.style.display = 'none';
                    }
                    
                    helpTooltip.style.display = 'block';
                    console.log('💡 顯示進階搜尋幫助');
                }
            });
            
            // 關閉幫助提示
            helpClose.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                helpTooltip.style.display = 'none';
                console.log('✅ 關閉進階搜尋幫助');
            });
            
            // 點擊頁面其他地方關閉幫助提示
            document.addEventListener('click', (e) => {
                if (helpTooltip.style.display === 'block') {
                    if (!helpTooltip.contains(e.target) && !helpBtn.contains(e.target)) {
                        helpTooltip.style.display = 'none';
                    }
                }
            });
            
            // 點擊範例代碼自動填入搜尋框
            const examples = helpTooltip.querySelectorAll('.search-help-example code');
            examples.forEach(example => {
                example.style.cursor = 'pointer';
                example.title = '點擊試用此範例';
                
                example.addEventListener('click', () => {
                    const searchInput = document.getElementById('globalSearch');
                    if (searchInput) {
                        const exampleText = example.textContent.trim();
                        searchInput.value = exampleText;
                        
                        // 觸發搜尋
                        if (typeof window.searchManager !== 'undefined' && window.searchManager) {
                            window.searchManager.performSearch(exampleText);
                        }
                        
                        // 關閉幫助提示
                        helpTooltip.style.display = 'none';
                        
                        // 聚焦搜尋框
                        searchInput.focus();
                        
                        console.log('✅ 使用範例:', exampleText);
                    }
                });
            });
            
            console.log('✅ 進階搜尋幫助功能初始化完成');
        }
        
        // 🔍 搜尋功能獨立初始化（最高優先級）
        function ensureSearchInitialized() {
            console.log('🔍 [獨立] 檢查搜尋功能初始化狀態...');
            
            // 檢查必要條件
            const searchInput = document.getElementById('globalSearch');
            const hasSearchManager = typeof window.SearchManager !== 'undefined';
            const hasInstance = window.searchManager !== null && typeof window.searchManager !== 'undefined';
            
            console.log('🔍 [獨立] 搜尋功能狀態:', {
                '搜尋輸入框': searchInput ? '✅ 存在' : '❌ 不存在',
                'SearchManager類別': hasSearchManager ? '✅ 已載入' : '❌ 未載入',
                'searchManager實例': hasInstance ? '✅ 已創建' : '❌ 未創建'
            });
            
            if (searchInput && hasSearchManager && !hasInstance) {
                console.log('🔍 [獨立] 條件滿足，立即初始化搜尋功能！');
                try {
                    window.searchManager = new window.SearchManager();
                    window.searchManager.init(window.performGlobalSearch, window.highlightSearchResult);
                    console.log('✅ [獨立] 搜尋功能初始化成功！');
                } catch (error) {
                    console.error('❌ [獨立] 搜尋功能初始化失敗:', error);
                }
            } else if (!searchInput) {
                console.warn('⏳ [獨立] 搜尋輸入框尚未準備好，500ms 後重試...');
                setTimeout(ensureSearchInitialized, 500);
            } else if (!hasSearchManager) {
                console.warn('⏳ [獨立] SearchManager 尚未載入，500ms 後重試...');
                setTimeout(ensureSearchInitialized, 500);
            } else if (hasInstance) {
                console.log('✅ [獨立] 搜尋功能已經初始化，無需重複初始化');
            }
        }
        
        // 等待所有defer腳本載入完成
        window.addEventListener('load', () => {
            console.error('🎉 頁面完全載入！');
            
            // 🔥 初始化進階搜尋幫助功能
            setTimeout(initSearchHelp, 100);
            
            // 🔍 立即嘗試初始化搜尋功能
            setTimeout(ensureSearchInitialized, 100);
            
            // 🔍 備用初始化（1秒後）
            setTimeout(() => {
                if (!window.searchManager && typeof window.initializeSearch === 'function') {
                    console.log('🔍 [備用] 觸發 initializeSearch()');
                    window.initializeSearch();
                }
            }, 1000);
            
            // 🔍 最後備用初始化（3秒後）
            setTimeout(ensureSearchInitialized, 3000);
        });
        
        // 🔍 DOM 載入完成後也嘗試初始化
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                console.log('📄 DOM 載入完成，嘗試初始化搜尋...');
                setTimeout(ensureSearchInitialized, 500);
            });
        } else {
            console.log('📄 DOM 已經載入，立即嘗試初始化搜尋...');
            setTimeout(ensureSearchInitialized, 100);
        }
    </script>
