        // 載入排程器狀態
        async function loadSchedulerStatus() {
            try {
                const response = await fetch('/api/reminder-scheduler/status', {
                    timeout: 10000
                });
                const data = await response.json();
                
                if (data.success) {
                    const status = data.data;
                    const statusElement = document.getElementById('schedulerStatus');
                    const lastRunElement = document.getElementById('lastRunTime');
                    const autoGeneratedElement = document.getElementById('autoGenerated');
                    
                    // 更詳細的狀態顯示
                    if (status.isRunning && status.hasSchedule) {
                        statusElement.textContent = '🟢 運行中 (每5分鐘檢查)';
                        statusElement.style.color = '#28a745';
                    } else if (status.hasSchedule) {
                        statusElement.textContent = '🟡 已排程但未運行';
                        statusElement.style.color = '#ffc107';
                    } else {
                        statusElement.textContent = '🔴 已停止';
                        statusElement.style.color = '#dc3545';
                    }
                    
                    // 顯示最後執行時間
                    if (status.lastRunTime) {
                        const lastRun = new Date(status.lastRunTime);
                        const now = new Date();
                        const diffMinutes = Math.floor((now - lastRun) / (1000 * 60));
                        
                        if (diffMinutes < 1) {
                            lastRunElement.textContent = '剛剛';
                        } else if (diffMinutes < 60) {
                            lastRunElement.textContent = `${diffMinutes}分鐘前`;
                        } else {
                            const diffHours = Math.floor(diffMinutes / 60);
                            lastRunElement.textContent = `${diffHours}小時前`;
                        }
                    } else {
                        lastRunElement.textContent = '從未執行';
                    }
                    
                    // 顯示運行時間
                    const uptimeElement = document.getElementById('schedulerUptime');
                    if (status.uptimeMinutes !== undefined) {
                        if (status.uptimeMinutes < 60) {
                            uptimeElement.textContent = `${status.uptimeMinutes}分鐘`;
                        } else {
                            const hours = Math.floor(status.uptimeMinutes / 60);
                            const minutes = status.uptimeMinutes % 60;
                            uptimeElement.textContent = `${hours}小時${minutes}分鐘`;
                        }
                    } else {
                        uptimeElement.textContent = '0分鐘';
                    }
                    
                    // 計算自動生成的提醒數量
                    try {
                        const remindersResponse = await fetch('/api/reminders', { timeout: 5000 });
                        const remindersData = await remindersResponse.json();
                    if (remindersData.success) {
                        const autoGenerated = remindersData.data.filter(r => r.autoGenerated).length;
                            autoGeneratedElement.textContent = autoGenerated;
                        }
                    } catch (reminderError) {
                        console.error('載入提醒資料失敗:', reminderError);
                        autoGeneratedElement.textContent = '載入中...';
                    }
                    
