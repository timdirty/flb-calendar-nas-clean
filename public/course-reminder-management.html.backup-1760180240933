        // 發送提醒
        async function sendReminder(reminderId) {
            if (!reminderId) {
                showError('無效的提醒ID');
                return;
            }

            // 防止重複點擊
            const button = document.querySelector(`[data-action="send-reminder"][data-reminder-id="${reminderId}"]`);
            if (button && button.disabled) {
                console.log('提醒正在發送中，請稍候...');
                return;
            }

            // 禁用按鈕防止重複點擊
            if (button) {
                button.disabled = true;
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> 發送中...';
            }

            try {
                const response = await fetch(`/api/reminders/${reminderId}/send`, {
                    method: 'POST',
                    timeout: 15000
                });

                const data = await response.json();
                
                if (data.success) {
                    showSuccess('提醒發送成功');
                    loadReminders();
                } else {
                    showError(data.message || '發送提醒失敗');
                }
            } catch (error) {
                console.error('發送提醒錯誤:', error);
                if (error.name === 'TypeError' && error.message.includes('fetch')) {
                    showError('網路連線錯誤，請檢查服務器狀態');
                } else {
                    showError('發送提醒時發生錯誤: ' + error.message);
                }
            } finally {
                // 恢復按鈕狀態
                if (button) {
                    button.disabled = false;
                    button.innerHTML = '<i class="fas fa-paper-plane"></i> 發送';
                }
            }
        }

