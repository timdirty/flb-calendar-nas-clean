        // 顯示學生提醒列表
        function displayStudentReminders() {
            const container = document.getElementById('studentReminderList');
            
            if (studentReminders.length === 0) {
                container.innerHTML = '<div class="loading">暫無學生提醒資料</div>';
                return;
            }
            
            // 獲取當前篩選狀態
            const activeFilter = document.querySelector('.student-reminder-filters .filter-btn.active');
            const statusFilter = activeFilter ? activeFilter.dataset.status : 'all';
            
            // 根據狀態篩選
            let filteredReminders = studentReminders;
            if (statusFilter !== 'all') {
                filteredReminders = studentReminders.filter(reminder => reminder.status === statusFilter);
            }
            
            if (filteredReminders.length === 0) {
                const statusText = {
                    'all': '全部',
                    'pending': '待發送',
                    'sent': '已發送',
                    'failed': '發送失敗'
                };
                container.innerHTML = `<div class="loading">暫無${statusText[statusFilter]}的學生提醒</div>`;
                return;
            }
            
            // 按時間排序
            filteredReminders.sort((a, b) => {
                const timeA = new Date(`${a.courseDate}T${a.courseTime}:00`);
                const timeB = new Date(`${b.courseDate}T${b.courseTime}:00`);
                return timeA - timeB;
            });
            
            container.innerHTML = filteredReminders.map(reminder => createStudentReminderHTML(reminder)).join('');
        }

