                if (response.ok) {
                    const data = await response.json();
                    const reminders = data.data || [];
                    
                    // 計算統計數據（使用台灣時區）
                    const now = getTaiwanNow();
                    const startOfWeek = new Date(now);
                    startOfWeek.setDate(startOfWeek.getDate() - startOfWeek.getDay());
                    const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
                    
                    const weeklySent = reminders.filter(r => 
                        r.status === 'sent' && 
                        new Date(r.createdAt) >= startOfWeek
                    ).length;
                    
                    const monthlySent = reminders.filter(r => 
                        r.status === 'sent' && 
                        new Date(r.createdAt) >= startOfMonth
                    ).length;
                    
                    const totalSent = reminders.filter(r => r.status === 'sent').length;
                    const totalAttempts = reminders.length;
                    const successRate = totalAttempts > 0 ? Math.round((totalSent / totalAttempts) * 100) : 0;
                    
                    // 計算平均回應時間（模擬數據）
                    const avgResponseTime = Math.round(Math.random() * 5) + 1; // 1-5秒
                    
                    // 更新統計顯示
                    document.getElementById('weeklySent').textContent = weeklySent;
                    document.getElementById('monthlySent').textContent = monthlySent;
                    document.getElementById('successRate').textContent = successRate + '%';
                    document.getElementById('avgResponseTime').textContent = avgResponseTime + 's';
                    
                    console.log('📊 統計分析數據已更新:', {
                        weeklySent,
                        monthlySent,
                        successRate,
                        avgResponseTime
                    });
                }
            } catch (error) {
                console.error('❌ 載入統計分析數據失敗:', error);
            }
        }

