        // 載入課前提醒詳情
        async function loadBeforeClassDetails() {
            try {
                const response = await fetch('/api/reminders');
                const data = await response.json();
                
                if (data.success) {
                    const beforeClassReminders = data.data.filter(r => r.type === 'before-class');
                    const detailsContainer = document.getElementById('beforeClassDetails');
                    
                    if (beforeClassReminders.length > 0) {
                        const reminder = beforeClassReminders[0]; // 取第一個課前提醒
                        
                        // 計算課程時間（正確解析台灣時間）
                        const [year, month, day] = reminder.courseDate.split('-').map(Number);
                        const [hour, minute] = reminder.courseTime.split(':').map(Number);
                        const courseDateTime = new Date(year, month - 1, day, hour, minute, 0);
                        const courseTimeStr = courseDateTime.toLocaleString('zh-TW', {
                            timeZone: 'Asia/Taipei',
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit',
                            hour: '2-digit',
                            minute: '2-digit',
                            second: '2-digit'
                        });
                        
                        // 計算課前提醒時間
                        const beforeClassDateTime = new Date(reminder.scheduledTime);
                        const beforeClassTimeStr = beforeClassDateTime.toLocaleString('zh-TW', {
                            timeZone: 'Asia/Taipei',
                            year: 'numeric',
                            month: '2-digit',
                            day: '2-digit',
                            hour: '2-digit',
                            minute: '2-digit',
                            second: '2-digit'
                        });
                        
                        // 計算倒數計時
                        const now = new Date();
                        const diff = beforeClassDateTime.getTime() - now.getTime();
                        let countdownStr = '已過期';
                        
                        if (diff > 0) {
                            const hours = Math.floor(diff / (1000 * 60 * 60));
                            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                            const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                            countdownStr = `${hours}小時${minutes}分鐘${seconds}秒`;
                        }
                        
                        // 更新顯示
                        document.getElementById('courseTimeDetail').textContent = courseTimeStr;
                        document.getElementById('beforeClassTimeDetail').textContent = beforeClassTimeStr;
                        document.getElementById('reminderStatusDetail').textContent = reminder.status === 'sent' ? '已發送' : '待發送';
                        document.getElementById('countdownDetail').textContent = countdownStr;
                        
                        detailsContainer.style.display = 'block';
                    } else {
                        detailsContainer.style.display = 'none';
                    }
                }
            } catch (error) {
                console.error('❌ 載入課前提醒詳情失敗:', error);
            }
        }
        
        // 載入跳過課程列表
        function loadSkippedCoursesList(skippedCourses) {
