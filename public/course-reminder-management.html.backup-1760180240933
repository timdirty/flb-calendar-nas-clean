        // 清理過期的提醒ID
        function cleanupExpiredReminders() {
            const currentTime = Date.now();
            const expiredThreshold = 24 * 60 * 60 * 1000; // 24小時

            reminders = reminders.filter(reminder => {
                const reminderTime = new Date(reminder.createdAt).getTime();
                const isExpired = (currentTime - reminderTime) > expiredThreshold;
                
                if (isExpired && reminder.status === 'sent') {
                    console.log(`清理過期提醒: ${reminder.id}`);
                    return false;
                }
                return true;
            });
        }

        // 生成模擬提醒資料
        function generateMockReminders() {
            const mockReminders = [];
            const today = getTaiwanNow(); // 使用台灣時區
            
            // 只生成當日和隔日提醒，不生成課前提醒
            for (let i = 0; i < 6; i++) {
                const futureDate = new Date(today);
                futureDate.setDate(futureDate.getDate() + i);
                const year = futureDate.getFullYear();
                const month = String(futureDate.getMonth() + 1).padStart(2, '0');
                const day = String(futureDate.getDate()).padStart(2, '0');
                
                const reminder = {
                    id: `reminder_${i + 1}`,
                    teacherName: teachers[i % teachers.length]?.name || `講師${i + 1}`,
                    courseName: `課程${i + 1}`,
                    courseDate: `${year}-${month}-${day}`,
                    courseTime: `${8 + i}:00`,
                    type: ['today', 'tomorrow'][i % 2], // 只生成當日和隔日提醒
                    message: `這是第${i + 1}個提醒訊息`,
                    status: ['sent', 'pending'][i % 2],
                    createdAt: new Date().toISOString()
                };
                mockReminders.push(reminder);
            }
            
            return mockReminders;
        }

        // 篩選提醒
        function filterReminders(filterType) {
            currentFilter = filterType;
            
            // 更新篩選按鈕狀態
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            const activeBtn = document.querySelector(`[data-filter="${filterType}"]`);
            if (activeBtn) {
                activeBtn.classList.add('active');
            }
            
            // 根據篩選類型過濾提醒（使用台灣時區）
            const today = getTaiwanToday();
            const tomorrow = getTaiwanTomorrow();
            
            filteredReminders = reminders.filter(reminder => {
                const reminderDate = reminder.courseDate;
                
                switch (filterType) {
                    case 'today':
                        // 當日提醒：日期為今天
                        return reminderDate === today;
                    case 'tomorrow':
                        // 隔日提醒：日期為明天
                        return reminderDate === tomorrow;
                    case 'all':
                    default:
                        // 全部提醒：只顯示今天和未來的提醒，過濾掉昨天的提醒
                        return reminderDate >= today;
                }
            });
            
            // 更新篩選計數
            updateFilterCount();
            
            // 重新顯示提醒
            displayFilteredReminders();
        }
        
