        // 點擊模態框外部關閉
        window.onclick = function(event) {
            const modal = document.getElementById('createReminderModal');
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        }

        // 顯示按行事曆重置模態框
        function showResetByCalendarModal() {
            const modal = document.getElementById('resetByCalendarModal');
            if (!modal) {
                // 創建模態框
                createResetByCalendarModal();
            }
            document.getElementById('resetByCalendarModal').style.display = 'block';
            loadInstructorsForReset();
        }

        // 關閉按行事曆重置模態框
        function closeResetByCalendarModal() {
            document.getElementById('resetByCalendarModal').style.display = 'none';
        }

        // 創建按行事曆重置模態框
        function createResetByCalendarModal() {
            const modalHTML = `
                <div id="resetByCalendarModal" class="modal">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2>按行事曆重置提醒</h2>
                            <span class="close" onclick="closeResetByCalendarModal()">&times;</span>
                        </div>
                        <div class="modal-body">
                            <form id="resetByCalendarForm">
                                <div class="form-group">
                                    <label for="resetInstructor">選擇講師:</label>
                                    <select id="resetInstructor" name="instructor" required>
                                        <option value="">請選擇講師</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="resetReminderType">提醒類型:</label>
                                    <select id="resetReminderType" name="reminderType">
                                        <option value="">所有提醒</option>
                                        <option value="today">當日提醒</option>
                                        <option value="tomorrow">隔日提醒</option>
                                        <option value="before-class">課前提醒</option>
                                    </select>
                                </div>
                                <div class="form-actions">
                                    <button type="submit" class="btn btn-warning">重置提醒</button>
                                    <button type="button" class="btn btn-secondary" onclick="closeResetByCalendarModal()">取消</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            `;
            document.body.insertAdjacentHTML('beforeend', modalHTML);
            
            // 綁定表單提交事件
            document.getElementById('resetByCalendarForm').addEventListener('submit', handleResetByCalendar);
        }

        // 載入講師列表
        async function loadInstructorsForReset() {
            try {
                const response = await fetch('/api/teachers');
                const data = await response.json();
                
                const select = document.getElementById('resetInstructor');
                select.innerHTML = '<option value="">請選擇講師</option>';
                
                if (data.success && data.teachers) {
                    data.teachers.forEach(teacher => {
                        const option = document.createElement('option');
                        option.value = teacher.name;
                        option.textContent = teacher.name;
                        select.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('載入講師列表失敗:', error);
                showError('載入講師列表失敗');
            }
        }

        // 處理按行事曆重置
        async function handleResetByCalendar(e) {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            const instructor = formData.get('instructor');
            const reminderType = formData.get('reminderType');
            
            if (!instructor) {
                showError('請選擇講師');
                return;
            }
            
            if (!confirm(`確定要重置 ${instructor} 的${reminderType || '所有'}提醒嗎？`)) {
                return;
            }
            
            try {
                showInfo('正在重置提醒...');
                
                const response = await fetch('/api/reminders/reset-by-calendar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ instructor, reminderType })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    showSuccess(data.message);
                    closeResetByCalendarModal();
                    loadReminders(); // 重新載入提醒列表
                } else {
                    showError(data.message);
                }
            } catch (error) {
                console.error('重置提醒失敗:', error);
                showError('重置提醒失敗');
            }
        }

        // 顯示課前提醒重置模態框
        function showResetBeforeClassByCalendarModal() {
            const modal = document.getElementById('resetBeforeClassByCalendarModal');
            if (!modal) {
                // 創建模態框
                createResetBeforeClassByCalendarModal();
