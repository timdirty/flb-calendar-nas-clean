        // 更新系統時間顯示
        // ==================== 台灣時區工具函數 ====================
        // 所有時間處理都應該使用這些函數，確保統一使用台灣時區 (UTC+8)
        
        /**
         * 獲取當前台灣時間的 Date 物件
         * @returns {Date} 台灣時區的當前時間
         */
        function getTaiwanNow() {
            const now = new Date();
            // 轉換為台灣時區
            const taiwanTimeStr = now.toLocaleString('en-US', { timeZone: 'Asia/Taipei' });
            return new Date(taiwanTimeStr);
        }
        
        /**
         * 獲取台灣今天的日期字串 (YYYY-MM-DD)
         * @returns {string} 格式: YYYY-MM-DD
         */
        function getTaiwanToday() {
            const now = getTaiwanNow();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }
        
        /**
         * 獲取台灣明天的日期字串 (YYYY-MM-DD)
         * @returns {string} 格式: YYYY-MM-DD
         */
        function getTaiwanTomorrow() {
            const now = getTaiwanNow();
            const tomorrow = new Date(now);
            tomorrow.setDate(tomorrow.getDate() + 1);
            const year = tomorrow.getFullYear();
            const month = String(tomorrow.getMonth() + 1).padStart(2, '0');
            const day = String(tomorrow.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }
        
        /**
         * 格式化為台灣時區的時間字串
         * @param {string|Date} dateInput - 日期輸入
         * @returns {string} 格式化的台灣時間字串
         */
        function formatToTaiwanTime(dateInput) {
            try {
                let date;
                if (typeof dateInput === 'string') {
                    date = new Date(dateInput);
                } else if (dateInput instanceof Date) {
                    date = dateInput;
                } else {
                    return '無效時間';
                }
                
                // 檢查是否為有效日期
                if (isNaN(date.getTime())) {
                    return '無效時間';
                }
                
                // 使用 toLocaleString 並指定台北時區
                return date.toLocaleString('zh-TW', {
                    timeZone: 'Asia/Taipei',
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: false
                });
            } catch (error) {
                console.error('時間格式化錯誤:', error);
                return '格式化失敗';
            }
        }
        
        /**
         * 格式化為台灣時區的日期字串 (YYYY/MM/DD)
         * @param {string|Date} dateInput - 日期輸入
         * @returns {string} 格式化的日期字串
         */
        function formatToTaiwanDate(dateInput) {
            try {
                let date;
                if (typeof dateInput === 'string') {
                    date = new Date(dateInput);
                } else if (dateInput instanceof Date) {
                    date = dateInput;
                } else {
                    return '無效日期';
                }
                
                if (isNaN(date.getTime())) {
                    return '無效日期';
                }
                
                return date.toLocaleString('zh-TW', {
                    timeZone: 'Asia/Taipei',
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit'
                });
            } catch (error) {
                console.error('日期格式化錯誤:', error);
                return '格式化失敗';
            }
        }
        
        /**
         * 將台灣日期時間字串轉換為 Date 物件
         * @param {string} dateStr - 日期字串 (YYYY-MM-DD)
         * @param {string} timeStr - 時間字串 (HH:mm)
         * @returns {Date} Date 物件
         */
        function createTaiwanDateTime(dateStr, timeStr) {
            try {
                // 組合日期和時間字串
                const dateTimeStr = `${dateStr}T${timeStr}:00`;
                
                // 創建 Date 物件並轉換為台灣時區
                const utcDate = new Date(dateTimeStr + '+08:00'); // 明確指定 +08:00 時區
                
                return utcDate;
            } catch (error) {
                console.error('創建台灣時間錯誤:', error);
                return new Date();
            }
        }
        
