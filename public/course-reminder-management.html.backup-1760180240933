        // 個別重置課前提醒
        async function resetBeforeClassIndividual(reminderId, courseName) {
            if (!reminderId) {
                showError('提醒ID不存在');
                return;
            }
            
            if (!confirm(`確定要重置「${courseName}」的課前提醒嗎？`)) {
                return;
            }
            
            try {
                showInfo('正在重置課前提醒...');
                
                const response = await fetch('/api/reminders/reset-before-class-individual', {
                    method: 'POST',
