        // 解析課程標題 - 支援多種格式
        function parseCourseTitle(fullTitle) {
            if (!fullTitle) {
                return { courseName: '', timeInfo: '', weekday: '', location: '' };
            }

            console.log(`🔍 解析課程標題: "${fullTitle}"`);

            // 定義多種課程標題格式的正則表達式
            const patterns = [
                // 格式1: "SPIKE PRO 日 10:00-12:00 第3週" - 處理包含空格的課程名稱
                /^([A-Z]+(?:\s+[A-Z]+)*)\s+([一二三四五六日])\s+(\d{1,2}:\d{2})-(\d{1,2}:\d{2})(?:\s+(.+?))?(?:\s+第\d+週.*)?$/,
                // 格式2: "ESM 六 9:30-10:30 到府 第4週請假"
                /^([A-Z]+)\s+([一二三四五六日])\s+(\d{1,2}:\d{2})-(\d{1,2}:\d{2})\s+(.+?)(?:\s+第\d+週.*)?$/,
                // 格式3: "SPM 三1630-1730 到府 第3週" - 處理星期後直接跟時間的格式
                /^([A-Z]+)\s+([一二三四五六日])(\d{4})-(\d{4})\s+(.+?)(?:\s+第\d+週.*)?$/,
                // 格式4: "BOOST 六 1530-1700 到府"
                /^([A-Z]+)\s+([一二三四五六日])\s+(\d{4})-(\d{4})\s+(.+?)(?:\s+第\d+週.*)?$/,
                // 格式5: "SPIKE 六 9:30-10:30"
                /^([A-Z]+)\s+([一二三四五六日])\s+(\d{1,2}:\d{2})-(\d{1,2}:\d{2})(?:\s+(.+?))?(?:\s+第\d+週.*)?$/,
                // 格式6: "ESM 六 1530-1700"
                /^([A-Z]+)\s+([一二三四五六日])\s+(\d{4})-(\d{4})(?:\s+(.+?))?(?:\s+第\d+週.*)?$/,
                // 格式7: "ESM 六 0930-1100 到府"
                /^([A-Z]+)\s+([一二三四五六日])\s+(\d{4})-(\d{4})\s+(.+?)(?:\s+第\d+週.*)?$/
            ];

            for (const pattern of patterns) {
                const match = fullTitle.match(pattern);
                if (match) {
                    const courseName = match[1];
                    const weekday = match[2];
                    const startTime = match[3];
                    const endTime = match[4];
                    const location = match[5] || '';
                    
                    // 標準化時間格式
                    const normalizeTime = (time) => {
                        if (time.includes(':')) {
                            // 格式如 "9:30" -> "0930"
                            const [h, m] = time.split(':');
                            return h.padStart(2, '0') + m;
                        }
                        return time; // 已經是 "0930" 格式
                    };
                    
                    const normalizedStartTime = normalizeTime(startTime);
                    const normalizedEndTime = normalizeTime(endTime);
                    const timeInfo = `${weekday} ${normalizedStartTime}-${normalizedEndTime}`;
                    
                    console.log(`✅ 成功解析課程標題:`, {
                        original: fullTitle,
                        courseName,
                        weekday,
                        startTime,
                        endTime,
                        location,
                        timeInfo
                    });
                    
                    return {
                        courseName,
                        timeInfo,
                        weekday,
                        location,
                        startTime: normalizedStartTime,
                        endTime: normalizedEndTime
                    };
                }
            }
            
            console.log(`❌ 無法解析課程標題: "${fullTitle}"`);
            return { courseName: '', timeInfo: '', weekday: '', location: '' };
        }

        // 匹配學生資料 - 改進版本
        function matchStudentsForCourse(courseTitle, students) {
            if (!courseTitle || !students || !Array.isArray(students)) {
                console.log('❌ 無效的課程標題或學生資料');
                return [];
            }

            const parsed = parseCourseTitle(courseTitle);
            if (!parsed.courseName) {
                console.log('❌ 無法解析課程標題');
                return [];
            }

            console.log(`🔍 開始匹配學生資料:`, {
                courseTitle,
                parsed,
                totalStudents: students.length
            });

            const matchedStudents = students.filter(student => {
                // 檢查課程名稱匹配
                const courseMatch = student.course && 
                    student.course.replace(/\s+/g, '').toLowerCase() === parsed.courseName.replace(/\s+/g, '').toLowerCase();
                
                if (!courseMatch) {
                    return false;
                }

                // 檢查時間匹配
                let timeMatch = false;
                if (student.period && parsed.timeInfo) {
                    // 標準化學生時間格式
                    const normalizeStudentTime = (timeStr) => {
                        if (!timeStr) return '';
                        return timeStr
                            .replace(/\s*第[一二三四五六七八九十\d]+周\s*/gi, '')
                            .replace(/\s*Week\s*\d+\s*/gi, '')
                            .replace(/\s*week\s*\d+\s*/gi, '')
                            .replace(/\s+/g, '')
                            .toLowerCase();
                    };

                    const cleanStudentPeriod = normalizeStudentTime(student.period);
                    const cleanTargetTime = normalizeStudentTime(parsed.timeInfo);

                    // 多種匹配方式
                    timeMatch = cleanStudentPeriod === cleanTargetTime ||
                               cleanStudentPeriod.includes(cleanTargetTime) ||
                               cleanTargetTime.includes(cleanStudentPeriod) ||
                               // 支援 "三 1630-1730 到府" 與 "三1630-1730到府" 的匹配
                               cleanStudentPeriod.replace(/\s+/g, '') === cleanTargetTime.replace(/\s+/g, '');
                }

                const isMatch = courseMatch && timeMatch;
                
                if (isMatch) {
                    console.log(`✅ 匹配到學生:`, {
                        name: student.name,
                        course: student.course,
                        period: student.period,
                        courseMatch,
                        timeMatch
                    });
                }

                return isMatch;
            });

            console.log(`📊 匹配結果: ${matchedStudents.length} 個學生匹配到課程 "${courseTitle}"`);
            return matchedStudents;
        }

