<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>課程題型提醒管理系統</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        /* 與 perfect-calendar-optimized-complete 統一的配色方案 */
        :root {
            --primary-color: #4f46e5;
            --secondary-color: #06b6d4;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --error-color: #ef4444;
            --glass-bg: rgba(255, 255, 255, 0.1);
            --glass-border: rgba(255, 255, 255, 0.2);
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            --animation-duration: 0.3s;
            --transition-duration: 0.2s;
            --animation-timing: cubic-bezier(0.4, 0, 0.2, 1);
        }

        @media (max-width: 480px) {
            :root {
                --animation-duration: 0.15s;
                --transition-duration: 0.1s;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            min-height: 100vh;
            padding: 10px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.9) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            box-shadow: var(--shadow-lg);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            padding: 30px 20px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, rgba(255,255,255,0.1) 0%, transparent 50%, rgba(255,255,255,0.1) 100%);
            animation: shimmer 3s ease-in-out infinite;
        }

        @keyframes shimmer {
            0%, 100% { transform: translateX(-100%); }
            50% { transform: translateX(100%); }
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            font-weight: 700;
            position: relative;
            z-index: 1;
        }

        .header p {
            font-size: 1.1rem;
            opacity: 0.9;
            position: relative;
            z-index: 1;
        }

        /* 480px 響應式優化 */
        @media (max-width: 480px) {
            body {
                padding: 5px;
            }
            
            .container {
                border-radius: 15px;
            }
            
            .header {
                padding: 20px 15px;
            }
            
            .header h1 {
                font-size: 1.8rem;
                margin-bottom: 8px;
            }
            
            .header p {
                font-size: 1rem;
            }
        }

        .main-content {
            padding: 30px;
        }

        .tabs {
            display: flex;
            margin-bottom: 30px;
            background: rgba(248, 250, 252, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 2px solid rgba(226, 232, 240, 0.5);
            overflow-x: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }

        .tabs::-webkit-scrollbar {
            display: none;
        }

        .tab {
            flex: 1;
            min-width: 120px;
            padding: 15px 20px;
            cursor: pointer;
            border: none;
            background: none;
            font-size: 1.1rem;
            font-weight: 600;
            color: #6b7280;
            transition: all var(--transition-duration) var(--animation-timing);
            border-bottom: 3px solid transparent;
            white-space: nowrap;
            position: relative;
        }

        .tab:hover {
            color: var(--primary-color);
            background: rgba(79, 70, 229, 0.05);
            transform: translateY(-1px);
        }

        .tab.active {
            color: var(--primary-color);
            background: white;
            box-shadow: var(--shadow-sm);
            border-bottom-color: var(--primary-color);
        }

        .tab.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
            border-radius: 2px 2px 0 0;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .settings-section {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            padding: 20px;
            margin: 20px 0;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .settings-section h3 {
            color: #fff;
            margin-bottom: 20px;
            font-size: 1.2em;
        }

        .skipped-courses-list {
            max-height: 400px;
            overflow-y: auto;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 6px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
        }

        .skipped-course-item {
            padding: 12px 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: background-color 0.2s;
        }

        .skipped-course-item:hover {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .skipped-course-item:last-child {
            border-bottom: none;
        }

        .skipped-course-info {
            flex: 1;
        }

        .skipped-course-title {
            font-weight: 600;
            color: #333;
            margin-bottom: 4px;
        }

        .skipped-course-meta {
            font-size: 0.85rem;
            color: #666;
            display: flex;
            gap: 12px;
        }

        .skipped-course-keywords {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .keyword-badge {
            background: #ffc107;
            color: #212529;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .no-skipped-courses {
            padding: 40px 20px;
            text-align: center;
            color: #666;
        }

        .no-skipped-courses i {
            font-size: 2rem;
            margin-bottom: 12px;
            color: #28a745;
        }

        .form-row {
            display: flex;
            gap: 20px;
            align-items: end;
            margin-bottom: 15px;
        }

        .form-row .form-group {
            margin-bottom: 0;
        }

        .form-row label {
            color: #fff;
            margin-bottom: 5px;
            display: block;
        }

        .form-row input[type="checkbox"] {
            margin-right: 8px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 1rem;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #4facfe;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        /* 地址映射列表樣式 */
        .mapping-list {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 15px;
            max-height: 300px;
            overflow-y: auto;
        }

        .mapping-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 15px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            margin-bottom: 10px;
            transition: all 0.3s ease;
        }

        .mapping-item:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

        .mapping-item:last-child {
            margin-bottom: 0;
        }

        .mapping-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .mapping-original {
            font-weight: 600;
            color: #fff;
            font-size: 0.9em;
        }

        .mapping-display {
            color: #e0e0e0;
            font-size: 0.8em;
        }

        .mapping-actions {
            display: flex;
            gap: 5px;
        }

        .mapping-actions button {
            padding: 5px 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.8em;
            transition: all 0.2s ease;
        }

        .mapping-actions .edit-btn {
            background: #4facfe;
            color: white;
        }

        .mapping-actions .edit-btn:hover {
            background: #3d8bfe;
        }

        .mapping-actions .delete-btn {
            background: #ff6b6b;
            color: white;
        }

        .mapping-actions .delete-btn:hover {
            background: #ff5252;
        }

        .empty-mapping {
            text-align: center;
            color: #ccc;
            font-style: italic;
            padding: 20px;
        }

        /* 學生提醒篩選按鈕樣式 */
        .student-reminder-filters {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            backdrop-filter: blur(10px);
        }

        .student-reminder-filters .filter-btn {
            padding: 8px 16px;
            border: none;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9em;
        }

        .student-reminder-filters .filter-btn:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
        }

        .student-reminder-filters .filter-btn.active {
            background: #4facfe;
            box-shadow: 0 4px 15px rgba(79, 172, 254, 0.3);
        }

        .btn {
            padding: 12px 25px;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition-duration) var(--animation-timing);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left var(--transition-duration) var(--animation-timing);
        }

        .btn:hover::before {
            left: 100%;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .btn-success {
            background: linear-gradient(135deg, var(--success-color) 0%, #34d399 100%);
            color: white;
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(16, 185, 129, 0.3);
        }

        .btn-warning {
            background: linear-gradient(135deg, var(--warning-color) 0%, #fbbf24 100%);
            color: white;
        }

        .btn-warning:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(245, 158, 11, 0.3);
        }

        .btn-danger {
            background: linear-gradient(135deg, var(--error-color) 0%, #f87171 100%);
            color: white;
        }

        .btn-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(239, 68, 68, 0.3);
        }

        .btn-info {
            background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
            color: white;
        }

        .btn-info:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(6, 182, 212, 0.3);
        }

        .filter-section {
            background: rgba(248, 250, 252, 0.8);
            backdrop-filter: blur(10px);
            border-radius: 15px;
            padding: 20px;
            margin: 20px 0;
            border: 1px solid rgba(226, 232, 240, 0.5);
        }

        .filter-section h3 {
            margin: 0 0 15px 0;
            color: #374151;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .filter-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }

        .filter-btn {
            padding: 10px 16px;
            border: 2px solid transparent;
            border-radius: 10px;
            background: white;
            color: #6b7280;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--transition-duration) var(--animation-timing);
            display: flex;
            align-items: center;
            gap: 6px;
            box-shadow: var(--shadow-sm);
        }

        .filter-btn:hover {
            background: rgba(79, 70, 229, 0.05);
            color: var(--primary-color);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .filter-btn.active {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            border-color: var(--primary-color);
            box-shadow: var(--shadow-md);
        }

        .filter-btn.active:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .filter-info {
            text-align: right;
            color: #6b7280;
            font-size: 0.9rem;
            font-weight: 500;
        }

        /* 浮動通知樣式 */
        .floating-notification {
            position: fixed;
            top: 20px;
            right: 20px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            padding: 15px 20px;
            border-radius: 10px;
            box-shadow: var(--shadow-lg);
            z-index: 10000;
            max-width: 300px;
            transform: translateX(100%);
            transition: transform var(--animation-duration) var(--animation-timing);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .floating-notification.show {
            transform: translateX(0);
        }

        .floating-notification.success {
            background: linear-gradient(135deg, var(--success-color) 0%, #059669 100%);
        }

        .floating-notification.error {
            background: linear-gradient(135deg, var(--error-color) 0%, #dc2626 100%);
        }

        .floating-notification.warning {
            background: linear-gradient(135deg, var(--warning-color) 0%, #d97706 100%);
        }

        .floating-notification .icon {
            font-size: 1.2rem;
        }

        .floating-notification .content {
            flex: 1;
        }

        .floating-notification .title {
            font-weight: 600;
            margin-bottom: 4px;
        }

        .floating-notification .message {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        .floating-notification .close {
            background: none;
            border: none;
            color: white;
            font-size: 1.2rem;
            cursor: pointer;
            padding: 0;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: background-color var(--transition-duration);
        }

        .floating-notification .close:hover {
            background: rgba(255, 255, 255, 0.2);
        }

        /* 手機版浮動通知優化 */
        @media (max-width: 480px) {
            .floating-notification {
                top: 10px;
                right: 10px;
                left: 10px;
                max-width: none;
                padding: 12px 16px;
            }
        }

        .reminder-list {
            background: #f8f9ff;
            border-radius: 15px;
            padding: 20px;
            margin-top: 20px;
        }

        .reminder-item {
            background: white;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            border-left: 4px solid #4facfe;
        }

        .reminder-item.urgent {
            border-left-color: #ff6b6b;
        }

        .reminder-item.warning {
            border-left-color: #f093fb;
        }

        .reminder-header {
            display: flex;
            justify-content: between;
            align-items: center;
            margin-bottom: 10px;
        }

        .reminder-title {
            font-size: 1.2rem;
            font-weight: 600;
            color: #333;
        }

        .reminder-type {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .reminder-type.today {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
            color: white;
            box-shadow: 0 2px 4px rgba(255, 107, 107, 0.3);
        }

        .reminder-type.tomorrow {
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            color: white;
            box-shadow: 0 2px 4px rgba(79, 172, 254, 0.3);
        }

        .reminder-type.before-class {
            background: #4facfe;
            color: white;
        }

        /* 計時器樣式 */
        .timer-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 30px;
            color: white;
            box-shadow: 0 8px 32px rgba(102, 126, 234, 0.3);
        }

        .timer-section h3 {
            margin: 0 0 20px 0;
            font-size: 1.2em;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .system-time-display {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        
        .time-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }
        
        .time-label {
            font-size: 0.9em;
            opacity: 0.9;
            margin-bottom: 8px;
        }
        
        .time-value {
            font-size: 1.4em;
            font-weight: bold;
            font-family: 'Courier New', monospace;
            margin-bottom: 5px;
        }
        
        .time-desc {
            font-size: 0.8em;
            opacity: 0.8;
        }
        
        /* 課前提醒詳情樣式 */
        .before-class-details {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 15px;
            margin-top: 15px;
        }
        
        .before-class-details h4 {
            color: #495057;
            margin-bottom: 15px;
            font-size: 1.1em;
        }
        
        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        
        .detail-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            background: white;
            border-radius: 6px;
            border: 1px solid #e9ecef;
        }
        
        .detail-label {
            font-weight: 600;
            color: #495057;
            font-size: 0.9em;
        }
        
        .detail-value {
            color: #007bff;
            font-weight: 500;
            font-size: 0.9em;
        }
        
        @media (max-width: 768px) {
            .details-grid {
                grid-template-columns: 1fr;
            }
        }
        
        .timer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        /* 480px 響應式優化 */
        @media (max-width: 480px) {
            .system-time-display {
                grid-template-columns: 1fr;
                gap: 10px;
            }
            
            .time-card {
                padding: 15px;
                margin-bottom: 8px;
            }
            
            .time-value {
                font-size: 1.2em;
            }
            
            .timer-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }
            
            .timer-card {
                padding: 12px;
                margin-bottom: 8px;
            }
            
            .timer-value {
                font-size: 1.2em;
            }
            
            .timer-desc {
                font-size: 0.75em;
            }
            
            .settings-section {
                padding: 15px;
                margin-bottom: 20px;
            }
            
            .form-row {
                flex-direction: column;
                gap: 10px;
            }
            
            .form-group {
                margin-bottom: 15px;
            }
            
            .form-group label {
                font-size: 0.9em;
                margin-bottom: 5px;
            }
            
            .form-control {
                width: 100% !important;
                font-size: 0.9em;
                padding: 8px;
            }
            
            .btn {
                padding: 8px 12px;
                font-size: 0.85em;
                margin: 2px;
            }
            
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
            }
            
            .stat-card {
                padding: 12px;
            }
            
            .stat-number {
                font-size: 1.5em;
            }
            
            .stat-label {
                font-size: 0.8em;
            }
            
            .reminder-item {
                padding: 12px;
                margin-bottom: 10px;
            }
            
            .reminder-details h4 {
                font-size: 1em;
                margin-bottom: 8px;
            }
            
            .reminder-meta {
                font-size: 0.8em;
            }
            
            .reminder-actions {
                flex-direction: column;
                gap: 5px;
            }
            
            .reminder-actions .btn {
                width: 100%;
                margin: 2px 0;
            }
        }

        .timer-card {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .timer-label {
