        // 發送單個學生提醒
        async function sendStudentReminder(reminderId) {
            try {
                const reminder = studentReminders.find(r => r.id === reminderId);
                if (!reminder) {
                    showError('找不到指定的提醒');
                    return;
                }

                console.log('📤 發送學生提醒:', reminder.studentName);
                
                const response = await fetch(`/api/student-reminders/${reminderId}/send`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        message: reminder.message,
                        parentUserId: reminder.parentUserId
                    })
                });

                if (response.ok) {
                    reminder.status = 'sent';
                    displayStudentReminders();
                    updateStudentStats();
                    showSuccess(`已發送提醒給 ${reminder.studentName} 的家長`);
                } else {
                    reminder.status = 'failed';
                    displayStudentReminders();
                    showError('發送提醒失敗');
                }
            } catch (error) {
                console.error('❌ 發送學生提醒失敗:', error);
                showError('發送提醒失敗');
            }
        }

        // 發送所有學生提醒
        async function sendAllStudentReminders() {
            try {
                const pendingReminders = studentReminders.filter(r => r.status === 'pending');
                if (pendingReminders.length === 0) {
                    showWarning('沒有待發送的提醒');
                    return;
                }

                showInfo(`開始發送 ${pendingReminders.length} 個學生提醒...`);
                
                let successCount = 0;
                let failCount = 0;

                for (const reminder of pendingReminders) {
                    try {
                        await sendStudentReminder(reminder.id);
                        successCount++;
                        // 避免發送過快
                        await new Promise(resolve => setTimeout(resolve, 1000));
                    } catch (error) {
                        failCount++;
                        console.error(`發送提醒失敗 ${reminder.studentName}:`, error);
                    }
                }

                displayStudentReminders();
                updateStudentStats();
                showSuccess(`發送完成！成功：${successCount}，失敗：${failCount}`);
                
            } catch (error) {
                console.error('❌ 批量發送學生提醒失敗:', error);
                showError('批量發送失敗');
            }
        }

