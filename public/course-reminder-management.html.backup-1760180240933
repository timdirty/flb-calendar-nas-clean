        // 設置事件監聽器
        function setupEventListeners() {
            // 移除舊的事件監聽器，避免重複綁定
            const existingListener = document.querySelector('[data-listener="main"]');
            if (existingListener) {
                existingListener.removeEventListener('click', handleMainClick);
            }

            // 分頁切換
            document.querySelectorAll('.tab').forEach(tab => {
                // 移除舊的監聽器
                tab.removeEventListener('click', handleTabClick);
                tab.addEventListener('click', handleTabClick);
            });

            // 篩選按鈕事件
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.removeEventListener('click', handleFilterClick);
                btn.addEventListener('click', handleFilterClick);
            });
            
            // 儲列篩選按鈕事件
            document.querySelectorAll('.queue-filter-btn').forEach(btn => {
                btn.removeEventListener('click', handleQueueFilterClick);
                btn.addEventListener('click', handleQueueFilterClick);
            });

            // 按鈕事件 - 使用命名函數避免重複綁定
            document.addEventListener('click', handleMainClick);
            
            // 新增地址映射按鈕事件
            const addMappingBtn = document.getElementById('addAddressMapping');
            if (addMappingBtn) {
                addMappingBtn.addEventListener('click', addAddressMapping);
            }

            // 學生提醒篩選按鈕事件
            document.querySelectorAll('.student-reminder-filters .filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    // 移除所有按鈕的 active 類別
                    document.querySelectorAll('.student-reminder-filters .filter-btn').forEach(b => b.classList.remove('active'));
                    // 為當前按鈕添加 active 類別
                    this.classList.add('active');
                    // 重新顯示學生提醒
                    displayStudentReminders();
                });
            });
        }

        // 分頁點擊處理函數
        function handleTabClick(e) {
            const tabName = e.currentTarget.getAttribute('data-tab');
            switchTab(tabName);
        }

        // 篩選按鈕點擊處理函數
        function handleFilterClick(e) {
            const filterType = e.currentTarget.getAttribute('data-filter');
            filterReminders(filterType);
        }
        
        // 儲列篩選按鈕點擊處理函數
        function handleQueueFilterClick(e) {
            const queueType = e.currentTarget.getAttribute('data-queue');
            const status = e.currentTarget.getAttribute('data-status');
            
            // 更新按鈕狀態
            document.querySelectorAll(`[data-queue="${queueType}"].queue-filter-btn`).forEach(btn => {
                btn.classList.remove('active');
            });
            e.currentTarget.classList.add('active');
            
            // 重新顯示該儲列
            displayQueueReminders(queueType);
        }

        // 顯示浮動通知
        function showFloatingNotification(type, title, message, duration = 5000) {
            const notification = document.createElement('div');
            notification.className = `floating-notification ${type}`;
            
            const icons = {
                success: 'fas fa-check-circle',
                error: 'fas fa-exclamation-circle',
                warning: 'fas fa-exclamation-triangle',
                info: 'fas fa-info-circle'
            };
            
            notification.innerHTML = `
                <i class="icon ${icons[type] || icons.info}"></i>
                <div class="content">
                    <div class="title">${title}</div>
                    <div class="message">${message}</div>
                </div>
                <button class="close" onclick="closeFloatingNotification(this)">
                    <i class="fas fa-times"></i>
                </button>
            `;
            
            document.body.appendChild(notification);
            
            // 觸發動畫
            setTimeout(() => {
                notification.classList.add('show');
            }, 100);
            
            // 自動關閉
            if (duration > 0) {
                setTimeout(() => {
                    closeFloatingNotification(notification.querySelector('.close'));
                }, duration);
            }
        }

        // 關閉浮動通知
        function closeFloatingNotification(closeButton) {
            const notification = closeButton.closest('.floating-notification');
            if (notification) {
                notification.classList.remove('show');
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 300);
            }
        }

        // 替換原有的 showError 和 showSuccess 函數
        function showError(message) {
            showFloatingNotification('error', '錯誤', message);
        }

        function showSuccess(message) {
            showFloatingNotification('success', '成功', message);
        }

        function showWarning(message) {
            showFloatingNotification('warning', '警告', message);
        }

        function showInfo(message) {
            showFloatingNotification('info', '資訊', message);
        }

        // 主要點擊處理函數
        function handleMainClick(e) {
                if (e.target.matches('[data-action]')) {
                    const action = e.target.getAttribute('data-action');
                    handleButtonClick(action, e.target);
                }
        }

        // 處理按鈕點擊
        function handleButtonClick(action, element) {
            switch(action) {
                case 'create-reminder':
