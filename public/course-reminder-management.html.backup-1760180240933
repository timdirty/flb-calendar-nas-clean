                    break;
                case 'run-scheduler':
                    runSchedulerNow();
                    break;
                case 'refresh-scheduler':
                    refreshSchedulerStatus();
                    break;
                case 'set-admin':
                    setAdmin();
                    break;
                case 'save-student-reminder-settings':
                    saveStudentReminderSettings();
                    break;
                case 'load-student-reminder-settings':
                    loadStudentReminderSettings();
