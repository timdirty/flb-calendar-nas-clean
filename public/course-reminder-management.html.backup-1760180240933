        // 載入提醒資料
        async function loadReminders() {
            try {
                // 檢查是否在提醒管理頁面或學生提醒管理頁面
                const reminderPage = document.getElementById('reminders');
                const studentReminderPage = document.getElementById('studentReminders');
                if ((!reminderPage || reminderPage.style.display === 'none') && 
                    (!studentReminderPage || studentReminderPage.style.display === 'none')) {
