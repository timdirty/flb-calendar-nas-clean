        window.stopScheduler = stopScheduler;
        window.runSchedulerNow = runSchedulerNow;
        window.refreshSchedulerStatus = refreshSchedulerStatus;
        window.saveStudentReminderEdit = saveStudentReminderEdit;
        window.saveReminderEdit = saveReminderEdit;
        window.closeModal = closeModal;
        window.showCreateReminderModal = showCreateReminderModal;
        window.closeCreateReminderModal = closeCreateReminderModal;
        window.refreshReminders = refreshReminders;
        window.testCourseMatching = testCourseMatching;
        window.parseCourseTitle = parseCourseTitle;
