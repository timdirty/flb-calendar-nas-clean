                container.innerHTML = `
                    <div class="no-skipped-courses">
                        <i class="fas fa-check-circle"></i>
                        <div>目前沒有跳過的課程</div>
                        <small>所有課程都會正常產生提醒</small>
                    </div>
                `;
                return;
            }
            
            const coursesHtml = skippedCourses.map(course => {
                const courseDate = new Date(course.start);
                const formattedDate = `${courseDate.getFullYear()}/${(courseDate.getMonth() + 1).toString().padStart(2, '0')}/${courseDate.getDate().toString().padStart(2, '0')}`;
                const formattedTime = `${courseDate.getHours().toString().padStart(2, '0')}:${courseDate.getMinutes().toString().padStart(2, '0')}`;
                
                const keywordsHtml = course.matchedKeywords.map(keyword => 
                    `<span class="keyword-badge">${keyword}</span>`
                ).join('');
                
                return `
                    <div class="skipped-course-item">
                        <div class="skipped-course-info">
                            <div class="skipped-course-title">${course.title}</div>
                            <div class="skipped-course-meta">
                                <span><i class="fas fa-user"></i> ${course.instructor}</span>
                                <span><i class="fas fa-calendar"></i> ${formattedDate}</span>
                                <span><i class="fas fa-clock"></i> ${formattedTime}</span>
