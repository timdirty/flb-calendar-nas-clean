        // 顯示特定儲列的提醒
        function displayQueueReminders(queueType) {
            // 修正課前提醒的ID
            const actualQueueType = queueType === 'before-class' ? 'beforeClass' : queueType;
            const queueList = document.getElementById(`${actualQueueType}QueueList`);
            const queueCount = document.getElementById(`${actualQueueType}Count`);
            
            // 檢查DOM元素是否存在
            if (!queueList || !queueCount) {
                console.error(`找不到儲列元素: ${queueType}QueueList 或 ${queueType}Count`);
                return;
            }
            
            // 篩選對應類型的提醒
            let queueReminders = reminders.filter(reminder => {
                if (queueType === 'today') {
                    // 當日提醒：只顯示今天的課程（使用台灣時區）
                    const todayStr = getTaiwanToday();
                    return reminder.type === 'today' && reminder.courseDate === todayStr;
                } else if (queueType === 'tomorrow') {
                    // 隔日提醒：只顯示明天的課程（使用台灣時區）
                    const tomorrowStr = getTaiwanTomorrow();
                    return reminder.type === 'tomorrow' && reminder.courseDate === tomorrowStr;
                } else if (queueType === 'before-class') {
                    // 課前提醒：只顯示今天的課程，且課程還沒開始（使用台灣時區）
                    const todayStr = getTaiwanToday();
                    
                    if (reminder.type === 'before-class' && reminder.courseDate === todayStr) {
                        // 檢查課程時間是否還沒開始
                        try {
                            const courseTime = createTaiwanDateTime(reminder.courseDate, reminder.courseTime);
                            const now = getTaiwanNow();
                            return courseTime > now;
                        } catch (error) {
                            console.error('解析課程時間失敗:', error);
                            return false;
                        }
                    }
                    return false;
                }
                return false;
            });
            
            // 應用狀態篩選
            const activeFilter = document.querySelector(`[data-queue="${queueType}"].queue-filter-btn.active`);
            if (activeFilter) {
                const statusFilter = activeFilter.dataset.status;
                if (statusFilter !== 'all') {
                    queueReminders = queueReminders.filter(reminder => reminder.status === statusFilter);
                }
            }
            
            // 更新計數
            queueCount.textContent = queueReminders.length;
            
            if (queueReminders.length === 0) {
                const filterText = activeFilter ? activeFilter.textContent : '全部';
                queueList.innerHTML = `<div class="loading">暫無${getQueueTypeName(queueType)}${filterText}提醒</div>`;
                return;
            }
            
            // 按時間排序
            queueReminders.sort((a, b) => {
                const dateA = new Date(`${a.courseDate}T${a.courseTime || '00:00'}:00`);
                const dateB = new Date(`${b.courseDate}T${b.courseTime || '00:00'}:00`);
                return dateA - dateB;
            });
            
            // 渲染提醒列表
            queueList.innerHTML = queueReminders.map(reminder => createQueueItemHTML(reminder)).join('');
        }
        
        // 獲取儲列類型名稱
        function getQueueTypeName(queueType) {
            const names = {
                'today': '當日',
                'tomorrow': '隔日',
                'before-class': '課前'
            };
            return names[queueType] || queueType;
        }
        
