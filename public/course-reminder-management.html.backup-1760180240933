            // 根據提醒的日期動態計算標籤，使用台灣時區
            const today = getTaiwanToday();
            const tomorrow = getTaiwanTomorrow();
            
            const reminderDate = reminder.courseDate;
            
            if (reminderDate === today) {
                // 檢查是否為課前提醒（課程時間前30分鐘內）（使用台灣時區）
                if (reminder.courseTime) {
                    try {
                        // 使用台灣時區工具函數創建課程時間
                        const courseTime = createTaiwanDateTime(reminderDate, reminder.courseTime);
                        
                        // 計算課前提醒時間（30分鐘前）
                        const beforeClassTime = new Date(courseTime.getTime() - (30 * 60 * 1000));
                        const currentTime = getTaiwanNow();
                        
                        if (currentTime >= beforeClassTime && currentTime < courseTime) {
                            return '課前';
                        }
                    } catch (error) {
                        console.error('計算課前提醒時間失敗:', error);
                    }
                }
                return '當日';
            } else if (reminderDate === tomorrow) {
                return '隔日';
            } else {
                // 對於其他日期，根據原始 type 或預設為隔日
                const labels = {
                    'today': '當日',
                    'tomorrow': '隔日',
                    'before-class': '課前'
                };
                return labels[reminder.type] || '隔日';
            }
        }

