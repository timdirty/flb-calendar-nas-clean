            color: #ffc107;
        }

        .log-stat .stat-value.info {
            color: #17a2b8;
        }

        .logs-list {
            max-height: 500px;
            overflow-y: auto;
            border: 1px solid #e9ecef;
            border-radius: 6px;
        }

        .log-item {
            padding: 12px 15px;
            border-bottom: 1px solid #f1f3f4;
            display: flex;
            align-items: flex-start;
            gap: 15px;
            transition: background-color 0.2s ease;
        }

        .log-item:hover {
            background-color: #f8f9fa;
        }

        .log-item:last-child {
            border-bottom: none;
        }

        .log-timestamp {
            font-size: 12px;
            color: #666;
            white-space: nowrap;
            min-width: 120px;
        }

        .log-level {
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
            text-transform: uppercase;
            min-width: 50px;
            text-align: center;
        }

        .log-level.error {
            background: #f8d7da;
            color: #721c24;
        }

        .log-level.warn {
            background: #fff3cd;
            color: #856404;
        }

        .log-level.info {
            background: #d1ecf1;
            color: #0c5460;
        }

        .log-source {
            font-size: 12px;
            color: #007bff;
            background: #e7f3ff;
            padding: 2px 6px;
            border-radius: 4px;
            min-width: 80px;
            text-align: center;
        }

        .log-message {
            flex: 1;
            font-size: 14px;
            color: #333;
            word-break: break-word;
        }

        .log-item.error .log-message {
            color: #dc3545;
        }

        .log-item.warn .log-message {
            color: #856404;
        }

        .log-item.info .log-message {
            color: #0c5460;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1><i class="fas fa-bell"></i> 課程題型提醒管理系統</h1>
            <p>自動化課程提醒與LINE通知管理</p>
        </div>

        <div class="main-content">
            <div class="tabs">
                <button class="tab active" data-tab="reminders">
                    <i class="fas fa-bell"></i> 提醒管理
                </button>
                <button class="tab" data-tab="schedule">
                    <i class="fas fa-clock"></i> 排程設定
                </button>
                <button class="tab" data-tab="templates">
                    <i class="fas fa-file-alt"></i> 訊息範本
                </button>
                <button class="tab" data-tab="scheduler">
                    <i class="fas fa-cogs"></i> 自動排程器
                </button>
                <button class="tab" data-tab="analytics">
                    <i class="fas fa-chart-bar"></i> 統計分析
                </button>
                <button class="tab" data-tab="logs">
                    <i class="fas fa-terminal"></i> 系統日誌
                </button>
                <button class="tab" data-tab="student-reminders">
                    <i class="fas fa-users"></i> 學生家長提醒
                </button>
            </div>

            <!-- 提醒管理頁面 -->
            <div id="reminders" class="tab-content active">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-number" id="totalReminders">0</div>
                        <div class="stat-label">總提醒數</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="sentToday">0</div>
                        <div class="stat-label">今日已發送</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="pendingReminders">0</div>
                        <div class="stat-label">待發送</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number" id="activeTeachers">0</div>
                        <div class="stat-label">活躍講師</div>
                    </div>
                </div>

                <div class="form-group">
                    <button class="btn btn-primary" data-action="create-reminder">
                        <i class="fas fa-plus"></i> 新增提醒
                    </button>
                    <button class="btn btn-success" data-action="refresh-reminders">
                        <i class="fas fa-sync"></i> 重新整理
                    </button>
                    <button class="btn btn-warning" data-action="reset-today-reminders" title="重置今日提醒狀態">
                        <i class="fas fa-undo"></i> 重置今日提醒
                    </button>
                    <button class="btn btn-warning" data-action="cleanup-duplicates" title="清理重複提醒">
                        <i class="fas fa-broom"></i> 清理重複
                    </button>
                    <button class="btn btn-info" onclick="showResetByCalendarModal()" title="按行事曆重置提醒">
                        <i class="fas fa-calendar-alt"></i> 按行事曆重置
                    </button>
                    <button class="btn btn-warning" onclick="showResetBeforeClassByCalendarModal()" title="按行事曆重置課前提醒">
                        <i class="fas fa-clock"></i> 重置課前提醒
                    </button>
                    <button class="btn btn-warning" onclick="runDiagnostic()" title="檢查系統狀態">
                        <i class="fas fa-stethoscope"></i> 診斷
                    </button>
                    <button class="btn btn-info" onclick="quickFix()" title="快速修復常見問題">
                        <i class="fas fa-wrench"></i> 修復
                    </button>
                </div>

                <!-- 三種儲列佈局 -->
                <div class="reminder-queues">
                    <!-- 當日提醒儲列 -->
                    <div class="queue-container" id="todayQueue">
                        <div class="queue-header">
                            <h3><i class="fas fa-calendar-day"></i> 當日提醒</h3>
                            <div class="queue-timer">
                                <span class="timer-label">下次發送:</span>
                                <span class="timer-value" id="todayTimer">--:--:--</span>
                            </div>
                            <div class="queue-stats">
                                <span class="queue-count" id="todayCount">0</span>
                                <span class="queue-label">個提醒</span>
                            </div>
                        </div>
                        <div class="queue-filters">
                            <button class="queue-filter-btn active" data-queue="today" data-status="all">全部</button>
                            <button class="queue-filter-btn" data-queue="today" data-status="pending">待發送</button>
                            <button class="queue-filter-btn" data-queue="today" data-status="sent">已發送</button>
                            <button class="queue-filter-btn" data-queue="today" data-status="failed">發送失敗</button>
                        </div>
                        <div class="queue-list" id="todayQueueList">
                            <div class="loading">
                                <i class="fas fa-spinner fa-spin"></i> 載入中...
                            </div>
                        </div>
                    </div>
                    
                    <!-- 隔日提醒儲列 -->
                    <div class="queue-container" id="tomorrowQueue">
                        <div class="queue-header">
                            <h3><i class="fas fa-calendar-plus"></i> 隔日提醒</h3>
                            <div class="queue-timer">
                                <span class="timer-label">下次發送:</span>
                                <span class="timer-value" id="tomorrowTimer">--:--:--</span>
                            </div>
                            <div class="queue-stats">
                                <span class="queue-count" id="tomorrowCount">0</span>
                                <span class="queue-label">個提醒</span>
                            </div>
                        </div>
                        <div class="queue-filters">
                            <button class="queue-filter-btn active" data-queue="tomorrow" data-status="all">全部</button>
                            <button class="queue-filter-btn" data-queue="tomorrow" data-status="pending">待發送</button>
                            <button class="queue-filter-btn" data-queue="tomorrow" data-status="sent">已發送</button>
                            <button class="queue-filter-btn" data-queue="tomorrow" data-status="failed">發送失敗</button>
                        </div>
                        <div class="queue-list" id="tomorrowQueueList">
                            <div class="loading">
                                <i class="fas fa-spinner fa-spin"></i> 載入中...
                            </div>
                        </div>
                    </div>
                    
                    <!-- 課前提醒儲列 -->
                    <div class="queue-container" id="beforeClassQueue">
                        <div class="queue-header">
                            <h3><i class="fas fa-clock"></i> 課前提醒</h3>
                            <div class="queue-timer">
                                <span class="timer-label">下次發送:</span>
                                <span class="timer-value" id="beforeClassTimer">--:--:--</span>
                            </div>
                            <div class="queue-stats">
                                <span class="queue-count" id="beforeClassCount">0</span>
                                <span class="queue-label">個提醒</span>
                            </div>
                        </div>
                        <div class="queue-filters">
                            <button class="queue-filter-btn active" data-queue="before-class" data-status="all">全部</button>
                            <button class="queue-filter-btn" data-queue="before-class" data-status="pending">待發送</button>
                            <button class="queue-filter-btn" data-queue="before-class" data-status="sent">已發送</button>
                            <button class="queue-filter-btn" data-queue="before-class" data-status="failed">發送失敗</button>
                        </div>
                        <div class="queue-list" id="beforeClassQueueList">
                            <div class="loading">
                                <i class="fas fa-spinner fa-spin"></i> 載入中...
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 排程設定頁面 -->
            <div id="schedule" class="tab-content">
                <h2><i class="fas fa-clock"></i> 自動排程設定</h2>
                
                <!-- 執行計時器顯示 -->
                <div class="timer-section">
                    <h3><i class="fas fa-stopwatch"></i> 系統時間與排程</h3>
                    
                    <!-- 系統時間顯示 -->
                    <div class="system-time-display">
                        <div class="time-card">
                            <div class="time-label">🕐 台灣時間</div>
                            <div class="time-value" id="systemTime">載入中...</div>
                            <div class="time-desc">系統讀取時間 (UTC+8)</div>
                        </div>
                        <div class="time-card">
                            <div class="time-label">🌍 UTC時間</div>
                            <div class="time-value" id="utcTime">載入中...</div>
                            <div class="time-desc">協調世界時</div>
                        </div>
                    </div>
                    
                    <!-- 課前提醒時間詳情 -->
                    <div class="before-class-details" id="beforeClassDetails" style="display: none;">
                        <h4><i class="fas fa-info-circle"></i> 課前提醒時間詳情</h4>
                        <div class="details-grid">
                            <div class="detail-item">
                                <div class="detail-label">課程時間：</div>
                                <div class="detail-value" id="courseTimeDetail">-</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">課前提醒時間：</div>
                                <div class="detail-value" id="beforeClassTimeDetail">-</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">提醒狀態：</div>
                                <div class="detail-value" id="reminderStatusDetail">-</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">倒數計時：</div>
                                <div class="detail-value" id="countdownDetail">-</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="timer-grid">
                        <div class="timer-card">
                            <div class="timer-label">學生提醒</div>
                            <div class="timer-value" id="studentReminderTimer">計算中...</div>
                            <div class="timer-desc">每天 19:30-19:35</div>
                        </div>
                        <div class="timer-card">
                            <div class="timer-label">排程檢查</div>
                            <div class="timer-value" id="schedulerCheckTimer">計算中...</div>
                            <div class="timer-desc">每 5 分鐘</div>
                        </div>
                        <div class="timer-card">
                            <div class="timer-label">今日提醒</div>
                            <div class="timer-value" id="todayReminderTimer">計算中...</div>
                            <div class="timer-desc">每小時整點</div>
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>當日提醒時間</label>
                    <input type="time" id="todayReminderTime" value="08:00">
                </div>

                <div class="form-group">
                    <label>隔日提醒時間</label>
                    <input type="time" id="tomorrowReminderTime" value="18:00">
                </div>

                <div class="form-group">
                    <label>課前提醒時間（分鐘）</label>
                    <input type="number" id="beforeClassMinutes" value="30" min="5" max="120">
                </div>

                <div class="form-group">
                    <label>
                        <input type="checkbox" id="enableAutoReminders" checked>
                        啟用自動提醒
                    </label>
                </div>

                <!-- 學生提醒設定區域 -->
                <div class="settings-section">
                    <h3><i class="fas fa-users"></i> 學生家長提醒設定</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="studentReminderEnabled" checked>
                                啟用學生家長提醒
                            </label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="studentReminderHour">觸發時間：</label>
                            <select id="studentReminderHour" class="form-control" style="width: 80px; display: inline-block;">
                                <option value="0">00</option>
                                <option value="1">01</option>
                                <option value="2">02</option>
                                <option value="3">03</option>
                                <option value="4">04</option>
                                <option value="5">05</option>
                                <option value="6">06</option>
                                <option value="7">07</option>
                                <option value="8">08</option>
                                <option value="9">09</option>
                                <option value="10">10</option>
                                <option value="11">11</option>
                                <option value="12">12</option>
                                <option value="13">13</option>
                                <option value="14">14</option>
                                <option value="15">15</option>
                                <option value="16">16</option>
                                <option value="17">17</option>
                                <option value="18">18</option>
                                <option value="19" selected>19</option>
                                <option value="20">20</option>
                                <option value="21">21</option>
                                <option value="22">22</option>
                                <option value="23">23</option>
                            </select>
                            <span style="margin: 0 5px;">:</span>
                            <select id="studentReminderMinute" class="form-control" style="width: 80px; display: inline-block;">
                                <option value="0">00</option>
                                <option value="5">05</option>
                                <option value="10">10</option>
                                <option value="15">15</option>
                                <option value="20">20</option>
                                <option value="25">25</option>
                                <option value="30" selected>30</option>
                                <option value="35">35</option>
                                <option value="40">40</option>
                                <option value="45">45</option>
                                <option value="50">50</option>
                                <option value="55">55</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="studentReminderDuration">執行窗口（分鐘）：</label>
                            <input type="number" id="studentReminderDuration" class="form-control" value="5" min="1" max="60" style="width: 100px; display: inline-block;">
                        </div>
                    </div>
                    <div class="form-row">
                        <button class="btn btn-success" data-action="save-student-reminder-settings">
                            <i class="fas fa-save"></i> 儲存學生提醒設定
                        </button>
                    </div>
                </div>

                <!-- 跳過關鍵字設定區域 -->
                <div class="settings-section">
                    <h3><i class="fas fa-ban"></i> 跳過關鍵字設定</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="skipKeywordsEnabled" checked>
                                啟用跳過關鍵字功能
                            </label>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="skipKeywordsInput">跳過關鍵字（用逗號分隔）：</label>
                            <input type="text" id="skipKeywordsInput" class="form-control" 
                                   placeholder="停課,請假" 
                                   value="停課,請假">
                            <small class="form-text text-muted">
                                當行事曆標題包含這些關鍵字時，系統會自動跳過所有相關提醒
                            </small>
                        </div>
                    </div>
                    <div class="form-row">
                        <button class="btn btn-warning" data-action="save-skip-keywords">
                            <i class="fas fa-save"></i> 儲存跳過關鍵字設定
                        </button>
                    </div>
                </div>

                <!-- 地址映射設定區域 -->
                <div class="settings-section">
                    <h3><i class="fas fa-map-marker-alt"></i> 地址映射設定</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <small class="form-text text-muted">
                                設定特定地址的顯示名稱，讓提醒訊息更友善易讀
                            </small>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="addressMappingList">地址映射列表：</label>
                            <div id="addressMappingList" class="mapping-list">
                                <!-- 動態生成的映射項目 -->
                            </div>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="newAddressInput">原始地址：</label>
                            <input type="text" id="newAddressInput" class="form-control" 
                                   placeholder="台北市中正區開封街1段2號9樓">
                        </div>
                        <div class="form-group">
                            <label for="newDisplayNameInput">顯示名稱：</label>
                            <input type="text" id="newDisplayNameInput" class="form-control" 
                                   placeholder="FunLearnBar站前教室">
                        </div>
                        <div class="form-group">
                            <button class="btn btn-primary" id="addAddressMapping">
                                <i class="fas fa-plus"></i> 新增映射
                            </button>
                        </div>
                    </div>
                    <div class="form-row">
                        <button class="btn btn-success" data-action="save-address-mappings">
                            <i class="fas fa-save"></i> 儲存地址映射設定
                        </button>
                    </div>
                </div>

                <!-- 跳過課程列表區域 -->
                <div class="settings-section">
                    <h3><i class="fas fa-list"></i> 跳過課程列表</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <small class="form-text text-muted">
                                以下課程因包含跳過關鍵字，將不會產生任何提醒
                            </small>
                        </div>
                    </div>
                    <div id="skippedCoursesList" class="skipped-courses-list">
                        <div class="loading">
                            <i class="fas fa-spinner fa-spin"></i> 載入中...
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary" data-action="save-schedule">
                    <i class="fas fa-save"></i> 儲存設定
                </button>
            </div>

            <!-- 訊息範本頁面 -->
            <div id="templates" class="tab-content">
                <h2><i class="fas fa-file-alt"></i> 訊息範本管理</h2>
                
                <div class="form-group">
                    <label>當日提醒範本</label>
                    <textarea id="todayTemplate" rows="8" placeholder="輸入當日提醒訊息範本..."></textarea>
                </div>

                <div class="form-group">
                    <label>隔日提醒範本</label>
                    <textarea id="tomorrowTemplate" rows="8" placeholder="輸入隔日提醒訊息範本..."></textarea>
                </div>

                <div class="form-group">
                    <label>課前提醒範本</label>
                    <textarea id="beforeClassTemplate" rows="8" placeholder="輸入課前提醒訊息範本..."></textarea>
                </div>

                <div class="form-group">
                    <label>學生提醒範本</label>
                    <textarea id="studentTemplate" rows="10" placeholder="輸入學生提醒訊息範本..."></textarea>
                </div>

                <button class="btn btn-primary" data-action="save-templates">
                    <i class="fas fa-save"></i> 儲存範本
                </button>
                
                <!-- 保留字元說明 -->
                <div class="template-variables">
                    <h4><i class="fas fa-info-circle"></i> 可用變數說明</h4>
                    <div class="variables-grid">
                        <div class="variable-group">
                            <h5>基本資訊</h5>
                            <div class="variable-item">
                                <code>{teacherName}</code>
                                <span>講師姓名</span>
                            </div>
                            <div class="variable-item">
                                <code>{courseName}</code>
                                <span>課程名稱</span>
                            </div>
                            <div class="variable-item">
                                <code>{courseTime}</code>
                                <span>課程時間</span>
                            </div>
                            <div class="variable-item">
                                <code>{courseDate}</code>
                                <span>課程日期</span>
                            </div>
                            <div class="variable-item">
                                <code>{location}</code>
                                <span>地點</span>
                            </div>
                            <div class="variable-item">
                                <code>{description}</code>
                                <span>描述</span>
                            </div>
                            <div class="variable-item">
                                <code>{lessonPlanUrl}</code>
                                <span>教案連結</span>
                            </div>
                            <div class="variable-item">
                                <code>{googleMapsUrl}</code>
                                <span>Google地圖連結</span>
                            </div>
                        </div>
                        
                        <div class="variable-group">
                            <h5>時間相關</h5>
                            <div class="variable-item">
                                <code>{currentTime}</code>
                                <span>當前時間</span>
                            </div>
                            <div class="variable-item">
                                <code>{currentDate}</code>
                                <span>當前日期</span>
                            </div>
                            <div class="variable-item">
                                <code>{weekday}</code>
                                <span>星期幾</span>
                            </div>
                            <div class="variable-item">
                                <code>{timeUntilClass}</code>
                                <span>距離上課時間</span>
                            </div>
                        </div>
                        
                        <div class="variable-group">
                            <h5>提醒類型</h5>
                            <div class="variable-item">
                                <code>{reminderType}</code>
                                <span>提醒類型 (today/tomorrow/before-class)</span>
                            </div>
                            <div class="variable-item">
                                <code>{reminderTypeText}</code>
                                <span>提醒類型文字 (當日/隔日/課前)</span>
                            </div>
                        </div>
                        
                        <div class="variable-group">
                            <h5>系統資訊</h5>
                            <div class="variable-item">
