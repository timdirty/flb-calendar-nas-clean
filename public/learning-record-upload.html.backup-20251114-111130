      /* 液態玻璃 FAB 共用樣式 */
      .glass-fab {
        position:fixed;
        width:56px;
        height:56px;
        border-radius:999px;
        border:1.5px solid var(--glass-border, rgba(255,255,255,0.55));
        background:linear-gradient(135deg, var(--glass-bg-start, rgba(255,255,255,0.82)), var(--glass-bg-end, rgba(226,232,240,0.45)));
        color:var(--glass-ink, #0f172a);
        box-shadow:0 18px 36px rgba(15,23,42,0.18);
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:20px;
        backdrop-filter:blur(18px);
        -webkit-backdrop-filter:blur(18px);
        transition:transform .2s ease, box-shadow .2s ease;
        z-index:1000;
      }
      .glass-fab:hover { transform: translateY(-2px); box-shadow:0 22px 40px rgba(15,23,42,0.22); }
      .glass-fab:active { transform: scale(0.94); }
