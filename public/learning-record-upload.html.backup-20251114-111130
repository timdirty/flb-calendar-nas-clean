                        </div>
                    </div>
                </div>
            </div>
            
            <!-- 記錄列表區 -->
            <div class="history-records-container">
                <div id="historyRecords" class="history-records-list">
                    <!-- 初始載入提示 -->
                    <div class="history-loading">
                        <i class="fas fa-spinner fa-spin" style="font-size:32px; color:#10b981;"></i>
                        <p style="margin-top:12px; color:#64748b;">載入歷史記錄中...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 圖片 / 影片預覽疊層 -->
    <div id="previewOverlay" class="preview-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="previewOverlayTitle">
        <div class="preview-overlay-backdrop" aria-label="關閉預覽"></div>
        <div class="preview-overlay-content">
            <h2 id="previewOverlayTitle" class="sr-only">媒體預覽</h2>
            <button id="previewOverlayClose" class="preview-overlay-close" aria-label="關閉預覽" type="button">
                <i class="fas fa-times" aria-hidden="true"></i>
                <span class="sr-only">關閉</span>
            </button>
            <div id="previewOverlayBody" class="preview-overlay-body" role="region" aria-label="預覽內容"></div>
        </div>
    </div>

    <!-- 懸浮：課程總覽整體進度條（自動顯示/隱藏） -->
    <div id="overviewFloatBar" style="position:fixed; right:14px; bottom:86px; z-index:999; display:none; background:rgba(255,255,255,.86); border:1px solid rgba(0,0,0,.06); border-radius:999px; box-shadow:0 10px 20px rgba(2,6,23,.18); padding:8px 12px; min-width:180px; cursor:pointer">
      <div class="float-line">
        <div style="font-weight:800; color:#0f172a; font-size:12px; margin-bottom:6px"><i class="fas fa-clipboard-list"></i> 課程總覽上傳</div>
        <div style="height:8px; background:#e5e7eb; border-radius:999px; overflow:hidden"><div id="overviewFloatFill" style="height:100%; width:0%; background:#60a5fa; transition:width .35s ease"></div></div>
      </div>
      <div id="overviewFloatDot" class="float-dot" style="display:none; width:28px; height:28px; border-radius:50%; background:conic-gradient(#60a5fa 0%, #e5e7eb 0%); box-shadow:0 6px 14px rgba(2,6,23,.20);"></div>
    </div>

    <div id="posterErrorPanel" class="poster-error-panel" role="status" aria-live="polite"></div>
</body>
</html>
