# 🚀 生產環境配置範例
# 複製此文件為 .env.production 並根據實際情況修改

# ==================== 基本配置 ====================
NODE_ENV=production
PORT=3002
TZ=Asia/Taipei

# ==================== Feature Flags ====================
# Phase 1: 基礎設施（健康檢查等）
USE_ROUTES_PHASE1=false

# Phase 2: 獨立模組（假期、深度連結等）
USE_ROUTES_PHASE2=false

# Phase 3: 學生管理（學生、簽到、補課、請假）
USE_ROUTES_PHASE3=false

# Phase 4: 通知系統（通知、提醒、LINE）
USE_ROUTES_PHASE4=false

# Phase 5: 媒體系統（Drive上傳、媒體、學習記錄）
USE_ROUTES_PHASE5=false

# Phase 6: 日曆核心（暫未實施）
USE_ROUTES_PHASE6=false

# ==================== 排程控制 ====================
DISABLE_AUTO_REMINDERS=false
ENABLE_DAILY_REPORT=true

# ==================== Synology Calendar ====================
SYNOLOGY_CALENDAR_BASE_URL=你的_Synology_NAS_URL
SYNOLOGY_CALENDAR_USERNAME=你的用戶名
SYNOLOGY_CALENDAR_PASSWORD=你的密碼
SYNOLOGY_CALENDAR_ID=你的日曆ID

# ==================== Synology Drive ====================
SYNOLOGY_DRIVE_ROOT=/Fun Learn Bar/FLB-Learning-Portfolio

# ==================== Google Sheets ====================
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./path/to/service-account-key.json
STUDENT_SHEET_ID=你的學生試算表ID
GROUP_SHEET_ID=你的群組試算表ID

# ==================== LINE ====================
LINE_CHANNEL_ACCESS_TOKEN=你的LINE_Channel_Access_Token
LINE_CHANNEL_SECRET=你的LINE_Channel_Secret
LIFF_ID=你的LIFF_ID

# ==================== 管理員 ====================
ADMIN_PASSWORD=請設置強密碼

# ==================== 監控建議 ====================
# 建議使用 PM2 或類似工具進行進程管理和監控
# pm2 start server.js --name flb-calendar-nas --env production
# pm2 monit
