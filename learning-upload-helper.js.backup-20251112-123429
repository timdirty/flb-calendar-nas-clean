            photos: [],
            videos: [],
            summary: null,
            metadata: null
        };

        // 上傳照片
        if (photos.length > 0) {
            console.log('📸 [Drive 上傳] 上傳', photos.length, '張課程總覽照片');
            
            for (let i = 0; i < photos.length; i++) {
                const photo = photos[i];
