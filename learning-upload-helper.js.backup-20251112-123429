        const {
            semester,
            courseName,
            date,
            topic,
            photos = [],
            videos = [],
            summary = ''
        } = params;

        console.log('📤 [學習歷程] 上傳課程總覽:', {
            semester,
            courseName,
            date,
            photoCount: photos.length,
            videoCount: videos.length
        });

