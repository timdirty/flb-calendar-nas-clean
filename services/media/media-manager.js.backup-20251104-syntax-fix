/**
 * 整合媒體管理服務（統一存儲版）
 * - 所有媒體檔案（照片、影片）存放在同一個學習歷程目錄
 * - 使用檔名後綴區分：video.mp4（原始）、video.webm（轉碼）、video.thumb.jpg（縮圖）
 */

const path = require('path');
const fs = require('fs');
const fsPromises = fs.promises;
const crypto = require('crypto');

const safeFile = require('../../utils/safe-file-operations');
const MediaSessionRegistry = require('./media-session-registry');
const mediaStorage = require('./media-storage');
const mediaIndex = require('./media-index');
const mediaTranscoder = require('./media-transcoder');
const photoQueueManager = require('./photo-queue-manager');

const SESSION_ROOT = path.join(__dirname, '..', '..', 'data', 'media-sessions');
const registry = new MediaSessionRegistry(SESSION_ROOT);
registry.startCleanup();

function generateId() {
    return crypto.randomUUID();
}

function toRelative(filePath) {
    if (!filePath) return null;
    try {
        const relative = path.relative(mediaStorage.MEDIA_ROOT, filePath);
        return relative.split(path.sep).join('/');
    } catch (e) {
        console.error('❌ 轉換相對路徑失敗:', e);
        return null;
    }
}

/**
 * 生成安全的檔名（保留中文，移除特殊字元）
 */
function normalizeFilename(originalName, fallbackExt = '.mp4') {
    try {
        const ext = String(path.extname(originalName || '') || fallbackExt || '.mp4').toLowerCase();
        const base = path.basename(originalName || '', ext) || 'video';
        const safeName = base.replace(/[<>:"/\\|?*]/g, '').trim() || 'video';
        const stamp = Date.now();
        return `${safeName}-${stamp}${ext}`;
    } catch (e) {
        console.error('❌ 正規化檔名失敗:', e);
        return `video-${Date.now()}${fallbackExt}`;
    }
}

/**
 * 生成影片相關檔名（原始、轉碼、縮圖）
 */
function generateVideoFilenames(originalName) {
    try {
        const ext = path.extname(originalName);
        const base = path.basename(originalName, ext);
        const timestamp = Date.now();
        
        return {
            origin: `${base}-${timestamp}${ext}`,           // 原始影片
            transcoded: `${base}-${timestamp}.webm`,        // 轉碼影片
            thumbnail: `${base}-${timestamp}.thumb.jpg`     // 縮圖
        };
    } catch (e) {
        console.error('❌ 生成影片檔名失敗:', e);
        const ts = Date.now();
        return {
            origin: `video-${ts}.mp4`,
            transcoded: `video-${ts}.webm`,
            thumbnail: `video-${ts}.thumb.jpg`
        };
    }
}

