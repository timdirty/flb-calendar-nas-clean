## LIFF 整合規範

### 初始化
```javascript
async function initializeLIFF() {
    try {
        await liff.init({ liffId: LIFF_ID });
        
        if (!liff.isLoggedIn()) {
            liff.login();
            return;
        }
        
        const profile = await liff.getProfile();
        currentUser = {
            userId: profile.userId,
            displayName: profile.displayName,
            pictureUrl: profile.pictureUrl
        };
        
        console.log('✅ LIFF 初始化成功:', currentUser.displayName);
        await autoBindInstructor();
        
    } catch (error) {
        console.error('❌ LIFF 初始化失敗:', error);
    }
}
```

### 自動綁定講師
```javascript
async function autoBindInstructor() {
    if (!currentUser?.userId) return;
    
    const teacher = window.teacherDataCache?.find(
        t => t.userId === currentUser.userId
    );
    
    if (teacher) {
        console.log('✅ 自動綁定講師:', teacher.name);
        selectInstructor(teacher.name);
    }
}
```

